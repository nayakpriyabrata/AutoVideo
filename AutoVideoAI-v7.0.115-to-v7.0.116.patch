+                {'kind': 'keypoint', 'start': 2.0 + MIN_GAP / 2, 'end': 4.0, 'title': 'b'}]
+    assert [card['title'] for card in resolve(touching)] == ['a']        # fades would overlap
+    apart = [{'kind': 'keypoint', 'start': 0.0, 'end': 2.0, 'title': 'a'},
