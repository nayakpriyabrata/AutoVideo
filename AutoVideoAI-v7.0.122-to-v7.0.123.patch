+    at.run()
+    assert not at.exception, [str(item.value) for item in at.exception]
+    at.button(key='queue-run-create').click()
+    at.run()
+    assert not at.exception, [str(item.value) for item in at.exception]
+    created = at.session_state['job_id']
+    job = install / 'outputs' / created
+    assert job_cast(job)[0]['id'] == character['id']
+    notice = next(item.value for item in at.success if item.value.startswith('Created job'))
+    assert 'cast: Mira the presenter' in notice and 'channel: ' in notice
