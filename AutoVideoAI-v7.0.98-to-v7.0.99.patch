+++ b/tests/test_v799_approval_pending.py	2026-10-26 11:54:36.000000000 +0000
@@ -0,0 +1,294 @@
+"""v7.0.99: a saved Flow video request can be waiting for an approval click, and that is now said out loud.
+
+Field case (job 20261022-143856-7-small-daily-habits-tha-9729, 2026-10-26 14:50 IST): the saved project
+showed the agent turn
+
+    "I'm going to generate 1 video clip interpolating between your start and end frames using Omni 1.1
+     Flash in 16:9 at 360p for 6 seconds. Would you like me to kick off this 1 video generation, costing
+     5 credits?"   [Approve] [Always approve] [Reject]
+
+The card had never been clicked, so no video existed; each download-only recovery honestly found nothing and
+paused again. Nothing in the app named the card.
+
+These tests cover the read-only evidence, the pure click guard, the message/preflight text and the CLI
+plumbing. No browser is opened and no credit is spent: the "browser" here is a fake that only records calls.
+"""
+import json
+
+import pytest
+
+from engine import flow_pending_approval as fpa
+from engine.flow_resume_safety import FlowResumeBlocked, check_job
+from tools import flow_resume_preflight as preflight
+
+JOB = '20261022-143856-7-small-daily-habits-tha-9729'
+PROJECT = 'https://flow.google.com/project/37d8cf57-12b4-4a85-9934-5580e90d3781'
+QUESTION = ("I'm going to generate 1 video clip interpolating between your start and end frames using Omni 1.1 "
+            "Flash in 16:9 at 360p for 6 seconds. Would you like me to kick off this 1 video generation, "
+            "costing 5 credits? ")
+
+
+def _job(tmp_path):
+    job = tmp_path / JOB
+    (job / 'flow' / 'shots' / 'shot_014').mkdir(parents=True)
+    (job / 'production_manifest.json').write_text('{"shots": []}')
+    return job
+
+
+def _journal(job, kind='video', phase='submitted', status='pending', reservations=None, name='take_01.mp4'):
+    path = job / 'flow' / 'shots' / 'shot_014' / (name + '.flow-request.json')
+    payload = {'kind': kind, 'scope': 'video_flow_v1' if kind == 'video' else 'isolated_image_v1',
+               'phase': phase, 'status': status, 'project_url': PROJECT, 'baseline': [], 'signature': ''}
+    if reservations is not None:
+        payload['approval_reservations'] = reservations
+    path.write_text(json.dumps(payload))
+    return path
+
+
+def _ledger(journal, *events):
+    lines = ''.join(json.dumps({'event': event, 'take': journal.name}) + '\n' for event in events)
+    journal.with_name(journal.name[:-len('.flow-request.json')] + '.submit-ledger.jsonl').write_text(lines)
+
+
+# ----------------------------------------------------------------- read-only evidence
+
+def test_submitted_without_an_approval_is_flagged_as_a_pending_card(tmp_path):
+    journal = _journal(_job(tmp_path))
+    _ledger(journal, 'intent', 'submitted')
+    row = fpa.evidence_for(journal)
+    assert row['submitted'] is True and row['approved'] is False
+    assert row['needs_approval_card'] is True and row['suspected_pending'] is True
+    assert 'waiting on its Approve/Reject card' in row['reason']
+    assert row['shot_id'] == 'shot_014'
+
+
+def test_a_recorded_approval_click_clears_the_flag(tmp_path):
+    journal = _journal(_job(tmp_path))
+    _ledger(journal, 'intent', 'submitted', 'approval')
+    row = fpa.evidence_for(journal)
+    assert row['approved'] is True and row['suspected_pending'] is False
+    assert 'already reserved/clicked' in row['reason']
+
+
+def test_a_journal_reservation_also_counts_as_an_approval_attempt(tmp_path):
+    journal = _journal(_job(tmp_path), reservations=[{'key': 'k', 'cost': 5, 'status': 'reserved'}])
+    row = fpa.evidence_for(journal)
+    assert row['approved'] is True and row['suspected_pending'] is False
+    assert row['cost'] == 5
+
+
+def test_an_image_request_never_needs_a_card(tmp_path):
+    journal = _journal(_job(tmp_path), kind='image', phase='submitted')
+    row = fpa.evidence_for(journal)
+    assert row['needs_approval_card'] is False and row['suspected_pending'] is False
+    assert 'free' in row['reason']
+
+
+def test_a_downloaded_request_is_not_pending(tmp_path):
+    journal = _journal(_job(tmp_path), status='downloaded')
+    _ledger(journal, 'intent', 'submitted')
+    assert fpa.evidence_for(journal)['suspected_pending'] is False
+
+
+def test_the_phase_alone_is_enough_when_the_ledger_is_missing(tmp_path):
+    journal = _journal(_job(tmp_path), phase='submission_uncertain')
+    assert fpa.evidence_for(journal)['suspected_pending'] is True
+
+
+def test_the_command_uses_the_recorded_cost_when_it_is_known(tmp_path):
+    journal = _journal(_job(tmp_path), reservations=[])
+    _ledger(journal, 'intent', 'submitted')
+    row = fpa.evidence_for(journal)
+    assert fpa.approve_command(JOB, row) == (
+        f'python3 cli.py v3 approve-request {JOB} --shot-id shot_014 --confirm-credits <credits on the card>')
+    row['cost'] = 5
+    assert fpa.approve_command(JOB, row).endswith('--confirm-credits 5')
+
+
+# ----------------------------------------------------------------- the click guard
+
+def test_the_guard_refuses_a_card_that_is_not_visible():
+    allowed, reason = fpa.approval_decision({'visible': False}, 5)
+    assert not allowed and 'no clickable Approve control' in reason
+
+
+def test_the_guard_refuses_an_unreadable_cost():
+    allowed, reason = fpa.approval_decision({'visible': True, 'cost': None, 'video': True}, 5)
+    assert not allowed and 'readable credit cost' in reason
+
+
+def test_the_guard_refuses_an_image_card():
+    allowed, reason = fpa.approval_decision({'visible': True, 'cost': 0, 'video': False}, 0)
+    assert not allowed and 'not a video generation request' in reason
+
+
+def test_the_guard_refuses_a_different_cost_than_the_one_confirmed():
+    allowed, reason = fpa.approval_decision({'visible': True, 'cost': 5, 'video': True}, 9)
+    assert not allowed and 'but the card asks for 5' in reason
+    assert '--confirm-credits 5' in reason
+
+
+def test_the_guard_refuses_without_a_confirmed_cost():
+    allowed, reason = fpa.approval_decision({'visible': True, 'cost': 5, 'video': True}, None)
+    assert not allowed and 'pass --confirm-credits 5' in reason
+
+
+def test_the_guard_allows_exactly_the_stated_cost():
+    allowed, reason = fpa.approval_decision({'visible': True, 'cost': 5, 'video': True}, 5)
+    assert allowed and '5 credits' in reason
+
+
+# ----------------------------------------------------------------- what the panel and tools say
+
+def test_the_blocked_resume_message_names_the_card_and_the_approve_command(tmp_path):
+    job = _job(tmp_path)
+    journal = _journal(job)
+    _ledger(journal, 'intent', 'submitted')
+    message = str(FlowResumeBlocked(check_job(job)))
+    assert 'that card was never approved' in message
+    assert f'approve-request {JOB} --shot-id shot_014 --confirm-credits N' in message
+    assert 'the download after it is free' in message
+
+
+def test_the_preflight_reports_the_approval_state(tmp_path, capsys):
+    job = _job(tmp_path)
+    journal = _journal(job, reservations=[{'key': 'k', 'cost': 5, 'status': 'reserved'}])
+    _ledger(journal, 'intent', 'submitted')
+    argv = __import__('sys').argv
+    __import__('sys').argv = ['flow_resume_preflight.py', str(job)]
+    try:
+        assert preflight.main() == 3
+    finally:
+        __import__('sys').argv = argv
+    printed = capsys.readouterr().out
+    assert 'Approval:     an approval was already clicked for this request' in printed
+    assert 'Recover:      python3 cli.py v3 recover-flow-video' in printed
+
+
+def test_the_preflight_offers_the_approve_command_when_no_click_is_recorded(tmp_path, capsys):
+    job = _job(tmp_path)
+    journal = _journal(job)
+    _ledger(journal, 'intent', 'submitted')
+    argv = __import__('sys').argv
+    __import__('sys').argv = ['flow_resume_preflight.py', str(job)]
+    try:
+        assert preflight.main() == 3
+    finally:
+        __import__('sys').argv = argv
+    printed = capsys.readouterr().out
+    assert 'no approval click is recorded' in printed
+    assert f'Approve once: python3 cli.py v3 approve-request {JOB} --shot-id shot_014 --confirm-credits' in printed
+
+
+# ----------------------------------------------------------------- the provider wiring (fake browser)
+
+class FakeBridge:
+    """Only what approve_recorded_card touches; nothing here reaches Flow."""
+
+    def __init__(self, probe, click_ok=True, reason=''):
+        self._probe = probe
+        self._click_ok = click_ok
+        self._reason = reason
+        self.calls = []
+        self.last_agent_confirmation = {}
+
+    def ensure_project(self, project, project_url):
+        self.calls.append(('ensure_project', project_url))
+
+    def pending_approval_card(self, timeout_s=5):
+        self.calls.append(('probe', timeout_s))
+        return dict(self._probe)
+
+    def confirm_agent_generation(self, timeout_s=12, approval='once', max_credits=None):
+        self.calls.append(('click', approval, max_credits, timeout_s))
+        self.last_agent_confirmation = ({'cost': self._probe.get('cost'), 'clicked': 'Approve'}
+                                       if self._click_ok else
+                                       {'cost': self._probe.get('cost'), 'clicked': None,
+                                        'blocked': True, 'reason': self._reason})
+        return self._click_ok
+
+
+def _provider_with(fake):
+    from engine.providers.flow_browser import FlowBrowserProvider
+    provider = FlowBrowserProvider.__new__(FlowBrowserProvider)
+    provider._ensure = lambda: fake
+    return provider
+
+
+def _video_request(tmp_path, cost=None):
+    journal = _journal(_job(tmp_path))
+    data = json.loads(journal.read_text())
+    if cost is not None:
+        data['approval_reservations'] = [{'key': 'k', 'cost': cost, 'status': 'reserved'}]
+    journal.write_text(json.dumps(data))
+    return journal
+
+
+def test_the_provider_clicks_once_when_the_confirmed_cost_matches(tmp_path):
+    journal = _video_request(tmp_path)
+    fake = FakeBridge({'visible': True, 'cost': 5, 'video': True, 'question': QUESTION})
+    info = _provider_with(fake).approve_recorded_card('job', str(journal), project_url=PROJECT,
+                                                      confirm_credits=5)
+    assert info['clicked_once'] is True and info['cost'] == 5
+    assert ('click', 'once', 5, 20) in fake.calls          # never 'always approve'
+    assert [call[0] for call in fake.calls] == ['ensure_project', 'probe', 'click']
+
+
+def test_the_provider_never_clicks_when_the_cost_differs(tmp_path):
+    journal = _video_request(tmp_path)
+    fake = FakeBridge({'visible': True, 'cost': 5, 'video': True, 'question': QUESTION})
+    with pytest.raises(Exception) as error:
+        _provider_with(fake).approve_recorded_card('job', str(journal), project_url=PROJECT, confirm_credits=50)
+    assert 'nothing was clicked' in str(error.value).lower() or 'asks for 5' in str(error.value)
+    assert not any(call[0] == 'click' for call in fake.calls)
+
+
+def test_the_provider_never_clicks_without_a_visible_card(tmp_path):
+    journal = _video_request(tmp_path)
+    fake = FakeBridge({'visible': False, 'cost': None, 'video': False, 'question': ''})
+    with pytest.raises(Exception):
+        _provider_with(fake).approve_recorded_card('job', str(journal), project_url=PROJECT, confirm_credits=5)
+    assert not any(call[0] == 'click' for call in fake.calls)
+
+
+def test_the_provider_reports_a_refused_click(tmp_path):
+    journal = _video_request(tmp_path)
+    fake = FakeBridge({'visible': True, 'cost': 5, 'video': True, 'question': QUESTION},
+                      click_ok=False, reason='This approval card is already reserved; no duplicate click')
+    with pytest.raises(Exception) as error:
+        _provider_with(fake).approve_recorded_card('job', str(journal), project_url=PROJECT, confirm_credits=5)
+    assert 'already reserved' in str(error.value)
+
+
+def test_an_old_journal_for_another_project_is_refused(tmp_path):
+    journal = _video_request(tmp_path)
+    fake = FakeBridge({'visible': True, 'cost': 5, 'video': True})
+    with pytest.raises(ValueError):
+        _provider_with(fake).approve_recorded_card(
+            'job', str(journal), project_url='https://flow.google.com/project/08d0cf93-326d-43a8-bb93-4b36653721c1',
+            confirm_credits=5)
+    assert not any(call[0] == 'probe' for call in fake.calls)
+
