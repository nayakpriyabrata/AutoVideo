diff -ruN -x RELEASE_MANIFEST.json -x '*.pyc' -x __pycache__ a/tests/test_v787_auto_resume_download.py b/tests/test_v787_auto_resume_download.py
--- a/tests/test_v787_auto_resume_download.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_v787_auto_resume_download.py	2026-10-24 06:29:03.267350288 +0000
@@ -0,0 +1,136 @@
+"""v7.0.87: a saved image whose download was interrupted resumes automatically (download-only).
+
+The regression: recover() wraps the browser-closed error in FlowRequestPending, and the strict
+frame failure treated any FlowRequestPending as final, so no automatic retry ever started.
+No browser or network: Flow providers and generation are faked. Nothing here submits a request.
+"""
+import json
+from pathlib import Path
+from types import SimpleNamespace as NS
+
+import pytest
+
+from engine import auto_resume as ar
+from engine.factory import Factory
+from engine.providers.flow_browser import (FlowBrowserClosedError, FlowRequestPending,
+                                           FlowServiceBusy, FlowReferenceUnavailable)
+from engine.automatic_recovery import recoverable_download_interruption
+
+SETTINGS = {'flow_auto_recovery': True}
+
+
+def checkpoint_error(cause):
+    """Mirror flow_image_transaction.recover(): the last error is re-raised as a pending checkpoint."""
+    try:
+        raise FlowRequestPending('Image recovery checkpoint retained: ' + str(cause)) from cause
+    except FlowRequestPending as pending:
+        return pending
+
+
+def test_download_checkpoint_is_retried_but_plain_pending_and_auth_are_not():
+    assert ar.strict_failure_action(SETTINGS, checkpoint_error(FlowBrowserClosedError(
+        'Image download target closed; reconnect and recover the saved exact request')), False) == 'retry'
+    assert ar.strict_failure_action(SETTINGS, checkpoint_error(FlowServiceBusy('high demand')), False) == 'retry'
+    # Unchanged: a submitted request whose download is unknown may have spent credits.
+    assert ar.strict_failure_action(SETTINGS, FlowRequestPending('submitted, download unknown'), False) == 'fail'
+    # Checkpoint around a non-browser cause, or around an auth/quota-style reason: no unattended retry.
+    assert ar.strict_failure_action(SETTINGS, checkpoint_error(RuntimeError('boom')), False) == 'fail'
+    assert ar.strict_failure_action(SETTINGS, checkpoint_error(
+        FlowBrowserClosedError('sign in required')), False) == 'fail'
+    assert ar.strict_failure_action({'flow_auto_recovery': False}, checkpoint_error(
+        FlowBrowserClosedError('x')), False) == 'fail'
+
+
+def test_exact_strict_chain_from_the_user_log_is_retried():
+    # RuntimeError(...) from checkpoint from FlowBrowserClosedError: the chain in the failed job.
+    try:
+        try:
+            raise FlowBrowserClosedError('Image download target closed; reconnect and recover the saved exact request')
+        except FlowBrowserClosedError as last:
+            raise FlowRequestPending('Image recovery checkpoint retained: ' + str(last)) from last
+    except FlowRequestPending as pending:
+        try:
+            raise RuntimeError('Strict --frame-source flow: shot_006 opening frame failed after 1 attempts.') from pending
+        except RuntimeError as error:
+            assert recoverable_download_interruption(error.__cause__)
+            assert ar.strict_failure_action(SETTINGS, error.__cause__, False) == 'retry'
+
+
+class FakeProvider:
+    def __init__(self):
+        self.closed = 0
+
+    def _ensure(self):
+        return self
+
+    def close(self):
+        self.closed += 1
+
+
+def make_job(tmp_path, monkeypatch):
+    monkeypatch.setenv('HOME', str(tmp_path / 'home'))
+    f = Factory(str(tmp_path / 'outputs'), str(tmp_path / 'data/jobs.db'))
+    job = f.create_job('Download interruption resume', dry_run=True)
+    root = Path(f.pm.job_dir(job))
+    journal = root / 'storyboard' / 'shot_006_open.jpg.flow-request.json'
+    journal.parent.mkdir(parents=True, exist_ok=True)
+    journal.write_text(json.dumps({
+        'schema_version': 1, 'scope': 'isolated_image_v1', 'kind': 'image', 'status': 'pending',
+        'phase': 'submitted', 'request_hash': 'h', 'project_name': 'AutoVideo-Image-test',
+        'project_url': 'https://flow.google.com/project/e4596779-749d-4f16-bdd2-f2fd15d085b9',
+        'reference_hashes': {}, 'submitted_prompt': 'p', 'source_prompt': 'p', 'shot_id': 'shot_006',
+        'vertical': False, 'signature': ''}))
+    import engine.providers.flow_browser as fb
+    monkeypatch.setattr(fb, 'FlowBrowserProvider', FakeProvider)
+    return f, job, root
+
+
+def test_blocked_download_checkpoint_schedules_download_only_wait(tmp_path, monkeypatch):
+    import engine.flow_image_transaction as tx
+    calls = []
+    def fake_generate(provider, shot, compiled, output, vertical, request_hash):
+        calls.append(output)  # download-only recovery attempt; never a new submission
+        raise checkpoint_error(FlowBrowserClosedError('Image download target closed'))
+    monkeypatch.setattr(tx, 'generate', fake_generate)
+    f, job, root = make_job(tmp_path, monkeypatch)
+
+    result = f.run_job(job, progress_cb=None)
+    assert result['status'] == 'paused' and 'download-only' in result['message']
+    assert len(calls) == 1
+    journal = json.loads((root / 'storyboard/shot_006_open.jpg.flow-request.json').read_text())
+    assert journal['status'] == 'pending' and journal['phase'] == 'submitted'  # request kept
+
+    # Studio's job thread and the CLI both record the returned result with after_run.
+    state = ar.after_run(f, job, result, None, now=1000.0)
+    assert state['state'] == 'waiting' and state['attempts'] == 1
+    assert state['next_at'] == 1000.0 + ar.BACKOFF_MINUTES[0] * 60
+    assert 'download-only' in state['reason'] or 'interrupted' in state['reason']
+    report = json.loads((root / 'logs/resume-reconciliation.json').read_text())
+    assert report['recoverable_only'] is True and report['unresolved_count'] == 1
+
+
+def test_plain_pending_request_still_stops_without_a_wait(tmp_path, monkeypatch):
+    import engine.flow_image_transaction as tx
+    monkeypatch.setattr(tx, 'generate', lambda *a, **k: (_ for _ in ()).throw(
+        FlowRequestPending('submitted, download unknown')))
+    f, job, root = make_job(tmp_path, monkeypatch)
+    with pytest.raises(Exception):
+        f.run_job(job, progress_cb=None)
+    state = ar.after_run(f, job, None, 'Saved request unresolved', now=1000.0)
+    assert state['state'] == 'stopped'
+
+
+def test_cli_and_automation_paths_record_the_wait(tmp_path, monkeypatch):
+    import engine.flow_image_transaction as tx
+    monkeypatch.setattr(tx, 'generate', lambda *a, **k: (_ for _ in ()).throw(
+        checkpoint_error(FlowBrowserClosedError('Image download target closed'))))
+    f, job, root = make_job(tmp_path, monkeypatch)
+    import cli
+    result = cli._run_and_record(f, job, None)
+    assert result['status'] == 'paused'
+    assert ar.load(root)['state'] == 'waiting'
+
+
+def test_reference_failures_are_not_treated_as_download_checkpoint():
+    assert not recoverable_download_interruption(FlowReferenceUnavailable('Overlay blocks reference upload'))
+    assert not recoverable_download_interruption(checkpoint_error(FlowReferenceUnavailable('x')))
