diff -ruN -x RELEASE_MANIFEST.json -x '*.pyc' a/tests/test_v784_key_profiles.py b/tests/test_v784_key_profiles.py
--- a/tests/test_v784_key_profiles.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_v784_key_profiles.py	2026-10-24 04:36:18.814857086 +0000
@@ -0,0 +1,71 @@
+"""v7.0.84: Gemini key profiles from .env are found whenever they are added, with clear reasons for entries not used."""
+import pytest
+
+import engine.audio.tts as TTS
+
+SECRET_ASUS = "asus-secret-value"
+SECRET_ODD = "odd-secret-value"
+SECRET_DEFAULT = "default-secret-value"
+
+
+@pytest.fixture
+def env(monkeypatch, tmp_path):
+    import os
+    for name in list(os.environ):
+        if name == "GEMINI_API_KEY" or name.upper().startswith("GEMINI_API_KEY"):
+            monkeypatch.delenv(name, raising=False)
+    dotenv = tmp_path / ".env"
+    monkeypatch.setattr(TTS, "gemini_env_files", lambda: [dotenv])
+    return monkeypatch, dotenv
+
+
+def test_keys_added_to_env_file_after_start_are_listed_without_restart(env):
+    monkeypatch, dotenv = env
+    assert TTS.gemini_key_profiles() == []
+    dotenv.write_text("GEMINI_API_KEY=" + SECRET_DEFAULT + "\nGEMINI_API_KEY_ASUS=" + SECRET_ASUS + "\n", encoding="utf-8")
+    assert TTS.gemini_key_profiles() == ["default", "asus"]
+    assert TTS.gemini_api_key("asus") == SECRET_ASUS
+
+
+def test_lowercase_hyphen_and_digit_names_are_accepted(env):
+    monkeypatch, dotenv = env
+    dotenv.write_text("GEMINI_API_KEY_paid=" + SECRET_ASUS + "\nGEMINI_API_KEY-third=" + SECRET_ODD
+                      + "\nGEMINI_API_KEY2=" + SECRET_DEFAULT + "\n", encoding="utf-8")
+    assert TTS.gemini_key_profiles() == ["paid", "third", "2"]
+    assert TTS.gemini_api_key("paid") == SECRET_ASUS
+    assert TTS.gemini_api_key("third") == SECRET_ODD
+    assert TTS.gemini_key_problems() == []
+
+
+def test_two_entries_with_one_name_are_reported_and_only_one_is_used(env):
+    monkeypatch, dotenv = env
+    dotenv.write_text("GEMINI_API_KEY_ASUS=" + SECRET_ASUS + "\ngemini_api_key_asus=" + SECRET_ODD + "\n", encoding="utf-8")
+    assert TTS.gemini_key_profiles() == ["asus"]
+    assert TTS.gemini_api_key("asus") == SECRET_ASUS  # canonical uppercase spelling wins
+    problems = TTS.gemini_key_problems()
+    assert len(problems) == 1 and "two entries define key profile 'asus'" in problems[0]
+
+
+def test_empty_named_profile_and_unrecognised_names_are_reported_without_values(env):
+    monkeypatch, dotenv = env
+    dotenv.write_text("GEMINI_API_KEY=\nGEMINI_API_KEY_EMPTY=\nGEMINI_API_KEY_=" + SECRET_ODD + "\n"
+                      "GEMINI_API_KEYS_X=" + SECRET_ASUS + "\nGEMINI_API_KEY_ASUS=" + SECRET_DEFAULT + "\n", encoding="utf-8")
+    assert TTS.gemini_key_profiles() == ["asus"]
+    problems = TTS.gemini_key_problems()
+    text = repr(problems)
+    assert any("GEMINI_API_KEY_EMPTY: value is empty" in p for p in problems)
+    assert any("GEMINI_API_KEYS_X" in p and "not recognised" in p for p in problems)
+    assert not any("GEMINI_API_KEY=" in p for p in problems)  # a blank default line is normal
+    assert SECRET_ODD not in text and SECRET_ASUS not in text and SECRET_DEFAULT not in text
+
+
+def test_process_environment_wins_over_env_file(env):
+    monkeypatch, dotenv = env
+    dotenv.write_text("GEMINI_API_KEY_ASUS=" + SECRET_ODD + "\n", encoding="utf-8")
+    monkeypatch.setenv("GEMINI_API_KEY_ASUS", SECRET_ASUS)
+    assert TTS.gemini_api_key("asus") == SECRET_ASUS
+
+
+def test_missing_profile_error_still_names_the_variable(env):
+    with pytest.raises(RuntimeError, match="GEMINI_API_KEY_NOPE is not configured"):
+        TTS.gemini_api_key("nope")
