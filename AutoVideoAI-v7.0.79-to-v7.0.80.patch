diff -ruN a/tests/test_v780_batch_reuse.py b/tests/test_v780_batch_reuse.py
--- a/tests/test_v780_batch_reuse.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_v780_batch_reuse.py	2026-10-22 10:40:50.000000000 +0000
@@ -0,0 +1,92 @@
+"""v7.0.80: a saved language batch is reused, a failed hook draft redoes only the hooks, and a wrong-script
+narration stops before any TTS call.
+
+No browser, Gemini or TTS call is made: the batch functions are replaced by recorders.
+"""
+import json
+
+import pytest
+
+import engine.speech_cards as SC
+from engine.production import digest
+
+
+def test_foreign_script_words_flags_only_wrong_script_letters():
+    assert SC.foreign_script_words('ଆମ βαğβαğ ହୋଇ ଯାଏ।', 'or') == ['βαğβαğ']
+    assert SC.foreign_script_words('ନମସ୍କାର, ଏହା ଠିକ୍।', 'or') == []
+    assert SC.foreign_script_words('कभी सोचा है, आज।', 'hi') == []
+    assert SC.foreign_script_words('Hello there', 'en') == []  # English is not checked
+    # Pure Latin brand names and loanwords are legitimate in a native narration.
+    assert SC.foreign_script_words('ଇନଷ୍ଟାଗ୍ରାମ Instagram ଆଜି', 'or') == []
+    # Latin letters mixed into a native word are not.
+    assert SC.foreign_script_words('ଆମରmeaning ଠିକ', 'or') == ['ଆମରmeaning']
+
+
+def test_wrong_script_narration_stops_before_any_tts(monkeypatch):
+    calls = []
+    monkeypatch.setattr(SC, 'prepare_edition', lambda *a, **k: calls.append(a) or {})
+    scripts = {'en': 'Master narration.', 'or': 'ଆମ βαğβαğ ହୋଇ ଯାଏ।'}
+    monkeypatch.setattr(SC, 'prepare_localized_scripts', lambda *a, **k: {'scripts': scripts})
+    with pytest.raises(ValueError, match='outside its script: βαğβαğ.*no TTS was started'):
+        SC.prepare_batch('/tmp/unused', 'Master narration.', 'en', ['en', 'or'])
+    assert calls == []
+
+
+def _batch_root(tmp_path, hooks_ready_or=True):
+    root = tmp_path / 'job'
+    (root / 'production').mkdir(parents=True)
+    bundles = {}
+    for lang in ('en', 'or'):
+        folder = root / 'speech-editions' / lang / 'k'
+        folder.mkdir(parents=True)
+        audio = folder / 'voice.mp3'
+        audio.write_bytes(b'x' * 4096)
+        bundles[lang] = {'audio': str(audio), 'audio_sha256': digest(audio), 'duration': 10.0,
+                         'script': 'Master narration.' if lang == 'en' else 'ଓଡ଼ିଆ ବର୍ଣ୍ଣନା।',
+                         'language': lang, 'text_cards': True, 'educational': False, 'hooks': True,
+                         'hooks_ready': hooks_ready_or if lang == 'or' else True, 'cards': []}
+    (root / 'production' / 'language_editions.json').write_text(json.dumps({
+        'source_language': 'en', 'editions': ['en', 'or'], 'prepare_audio': True, 'bundles': bundles}))
+    return root
+
+
+def _recorders(monkeypatch):
+    seen = {'batch': [], 'cards': []}
+    monkeypatch.setattr(SC, 'prepare_batch', lambda *a, **k: seen['batch'].append(a) or {'bundles': {}})
+
+    def cards(bundle, cleanup='delete-after-read'):
+        seen['cards'].append(bundle['language'])
+        return dict(bundle, hooks_ready=True, hooks_error='')
+    monkeypatch.setattr(SC, 'complete_edition_cards', cards)
+    return seen
+
+
+def test_complete_saved_batch_is_reused_without_any_rerun(monkeypatch, tmp_path):
+    seen = _recorders(monkeypatch)
+    root = _batch_root(tmp_path, hooks_ready_or=True)
+    SC.prepare_selected_editions(root, 'Master narration.', 'en', {}, None, text_cards=True, hooks=True)
+    assert seen == {'batch': [], 'cards': []}
+
+
+def test_failed_hook_draft_redoes_only_the_hooks(monkeypatch, tmp_path):
+    seen = _recorders(monkeypatch)
+    root = _batch_root(tmp_path, hooks_ready_or=False)
+    SC.prepare_selected_editions(root, 'Master narration.', 'en', {}, None, text_cards=True, hooks=True)
+    assert seen['batch'] == []            # no localization, TTS or card drafting again
+    assert seen['cards'] == ['or']        # only the language whose hook draft is missing
+    saved = json.loads((root / 'production' / 'language_editions.json').read_text())
+    assert saved['bundles']['or']['hooks_ready'] is True
+
+
+def test_hook_redo_failure_is_recorded_and_the_batch_is_still_reused(monkeypatch, tmp_path):
+    seen = _recorders(monkeypatch)
+
+    def failing(bundle, cleanup='delete-after-read'):
+        raise RuntimeError('hook drafting unavailable')
+    monkeypatch.setattr(SC, 'complete_edition_cards', failing)
+    root = _batch_root(tmp_path, hooks_ready_or=False)
+    SC.prepare_selected_editions(root, 'Master narration.', 'en', {}, None, text_cards=True, hooks=True)
+    assert seen['batch'] == []
+    saved = json.loads((root / 'production' / 'language_editions.json').read_text())
+    assert saved['bundles']['or']['hooks_ready'] is False
+    assert 'hook drafting unavailable' in saved['bundles']['or']['hooks_error']
diff -ruN a/tests/test_v780_tts_resilience.py b/tests/test_v780_tts_resilience.py
--- a/tests/test_v780_tts_resilience.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_v780_tts_resilience.py	2026-10-22 10:41:53.000000000 +0000
@@ -0,0 +1,134 @@
+"""v7.0.80: Gemini TTS sends the documented request, survives slow long narrations, and reuses finished parts.
+
+The Gemini calls use a fake ``requests.post``; no network is used. Audio is real: a short PCM tone is
+converted with ffmpeg, so the ffmpeg/ffprobe binaries must be on PATH (see the full-suite note in
+GEMINI_SUBMIT_AND_CARDS_V7_0_79.md).
+"""
+import base64
+import json
+
+import pytest
+import requests
+
+import engine.audio.tts as TTS
+
+
+def _pcm_base64(seconds=0.5):
+    raw = b"\x00\x20" * int(24000 * seconds)  # 24 kHz, 16-bit mono silence with a tiny level
+    return base64.b64encode(raw).decode("ascii")
+
+
+class FakeResponse:
+    def __init__(self, status=200, body=None, text=""):
+        self.status_code = status
+        self._body = body
+        self.text = text
+
+    def json(self):
+        return self._body
+
+
+def _ok():
+    return FakeResponse(200, {"audio": _pcm_base64()})
+
+
+@pytest.fixture
+def gemini(monkeypatch):
+    monkeypatch.setenv("GEMINI_API_KEY", "test-key")
+    monkeypatch.setattr(TTS.time, "sleep", lambda seconds: None)
+    calls = []
+
+    def install(responses):
+        calls.clear()  # each install starts a new request log
+        queue = list(responses)
+
+        def fake_post(url, headers=None, json=None, timeout=None):
+            calls.append({"url": url, "headers": headers, "json": json, "timeout": timeout})
+            item = queue.pop(0) if queue else _ok()
+            if isinstance(item, BaseException):
+                raise item
+            return item
+
+        monkeypatch.setattr(requests, "post", fake_post)
+        return calls
+
+    return install
+
+
+def test_request_is_the_documented_json_with_no_unknown_annotation(gemini, tmp_path):
+    calls = gemini([])
+    TTS.GeminiTTSProvider().synth("Hello there.", "voice", str(tmp_path / "out.mp3"), language="en", style="")
+    body = calls[0]["json"]
+    annotation = body["input"][0]["content"][0]["annotations"][0]
+    assert annotation == {"type": "speech_metadata", "style": annotation["style"]}
+    assert "UNKNOWN" not in json.dumps(body)
+    assert calls[0]["headers"]["x-goog-api-key"] == "test-key"
+    assert calls[0]["timeout"] == TTS.GEMINI_TTS_TIMEOUT
+
+
+def test_timeout_is_retried_and_the_part_succeeds(gemini, tmp_path):
+    calls = gemini([requests.exceptions.ReadTimeout("read timed out"), _ok()])
+    result = TTS.GeminiTTSProvider().synth("Short Odia line.", "voice", str(tmp_path / "out.mp3"),
+                                           language="or", style="")
+    assert len(calls) == 2
+    assert result["duration"] > 0
+    assert not (tmp_path / "out.mp3.parts").exists()  # finished parts are cleared after success
+
+
+def test_rejected_request_fails_at_once_without_retrying(gemini, tmp_path):
+    calls = gemini([FakeResponse(400, None, "bad annotation")])
+    with pytest.raises(RuntimeError, match="rejected the request \\(HTTP 400\\)"):
+        TTS.GeminiTTSProvider().synth("Short line.", "voice", str(tmp_path / "out.mp3"), language="or", style="")
+    assert len(calls) == 1
+
+
+def test_persistent_timeouts_give_up_after_the_configured_attempts(gemini, tmp_path):
+    calls = gemini([requests.exceptions.ReadTimeout("slow")] * TTS.GEMINI_TTS_ATTEMPTS)
+    with pytest.raises(RuntimeError, match="failed for a .* part after 3 attempts"):
+        TTS.GeminiTTSProvider().synth("Short line.", "voice", str(tmp_path / "out.mp3"), language="or", style="")
+    assert len(calls) == TTS.GEMINI_TTS_ATTEMPTS
+
+
+def test_long_narration_is_split_and_finished_parts_are_reused(gemini, tmp_path):
+    text = " ".join(f"This is sentence number {i} of the narration." for i in range(200))
+    parts = TTS.split_speech_text(text)
+    assert len(parts) >= 4
+    # Call 1 and 2 succeed, call 3 is rejected: the first two parts are on disk when the run fails.
+    calls = gemini([_ok(), _ok(), FakeResponse(400, None, "rejected")])
+    out = str(tmp_path / "out.mp3")
+    with pytest.raises(RuntimeError):
+        TTS.GeminiTTSProvider().synth(text, "voice", out, language="en", style="")
+    assert len(calls) == 3
+    # The retry sends only the parts that never finished.
+    calls = gemini([])
+    result = TTS.GeminiTTSProvider().synth(text, "voice", out, language="en", style="")
+    assert len(calls) == len(parts) - 2
+    assert result["duration"] > 0
+
+
+def test_split_keeps_every_word_in_order_and_respects_the_limit():
+    odia = ("ଆମ ମଧ୍ୟରୁ ଅଧିକାଂଶ ଲୋକ ନିରବତାକୁ ଦୂର କରିବା ପାଇଁ ପ୍ରଥମ କଥାଟି କହିଦେଇଥା’ନ୍ତି। ") * 40
+    parts = TTS.split_speech_text(odia)
+    assert len(parts) > 1
+    assert all(len(p) <= TTS.GEMINI_TTS_CHUNK_CHARS for p in parts)
+    assert " ".join(parts).split() == odia.split()
+
+
+def test_split_breaks_a_sentence_with_no_end_on_a_space():
+    text = " ".join(["word"] * 1000)  # one sentence, no full stop
+    parts = TTS.split_speech_text(text)
+    assert len(parts) > 1
+    assert all(len(p) <= TTS.GEMINI_TTS_CHUNK_CHARS for p in parts)
+    assert " ".join(parts).split() == text.split()
+
+
+def test_short_text_is_one_part():
+    assert TTS.split_speech_text("Just one short sentence.") == ["Just one short sentence."]
+    assert TTS.split_speech_text("   ") == []
+
+
+def test_odia_gemini_failure_says_no_english_fallback_and_needs_a_native_file(gemini, tmp_path):
+    gemini([FakeResponse(400, None, "rejected")])
+    with pytest.raises(RuntimeError, match="No English fallback.*native Odia voice file"):
+        TTS.synthesize_narration("ଆମେ କଥା କହିବା।", "gemini-native-odia", str(tmp_path / "o.mp3"),
+                                 provider="gemini", language="or", style="")
