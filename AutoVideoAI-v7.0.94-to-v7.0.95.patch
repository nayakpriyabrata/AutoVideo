+# A logo per language
+# --------------------------------------------------------------------------- #
+def _png(path, colour=(200, 40, 40)):
+    from PIL import Image
+    path.parent.mkdir(parents=True, exist_ok=True)
+    Image.new('RGB', (64, 64), colour).save(path)
+    return path
+
+
+def test_one_profile_stores_a_logo_per_language(tmp_path):
