+def _indus(system: str, user: str, model: str) -> str:
+    """Indus AI: Sarvam's Indic chat model through the official API (SARVAM_API_KEY).
+
+    The consumer Indus app has no API; this calls the same model family directly.
+    Reasoning is switched off so the token budget goes to the script, not hidden reasoning.
