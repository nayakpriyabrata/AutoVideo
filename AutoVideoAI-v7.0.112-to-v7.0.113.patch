+def caption_evidence(job_root, code, entry, *, measure=False):
+    """What the *current export* actually shows, and whether that contradicts the job (v7.0.113).
+
+    Returns ``{'looks_like_text': bool|None, 'source': ..., 'detail': str, 'disputed': bool}``.
+
+    A record can be wrong about a file - and in the field it was: the plan said ``captions: false``, the file had
+    captions, because the narration-fit step re-enabled them. So when the job asks for no transcript, the export's
+    own picture is the evidence: the detections recorded at render time, or, with ``measure=True``, a fresh
+    sampling of the file.
+    """
+    path = Path(str(entry.get('path') or ''))
+    result = {'looks_like_text': None, 'source': '', 'detail': '', 'disputed': False}
+    if not path.is_file():
+        return result
+    detected = entry.get('captions_detected') or {}
+    if detected.get('checked') and not measure:
+        result.update(looks_like_text=bool(detected.get('looks_like_text')), source='recorded',
+                      detail=str(detected.get('detail') or ''))
+        return result
+    if measure:
+        try:
+            from .render.caption_check import probe
+            fresh = probe(path)
+            if fresh.get('checked'):
+                result.update(looks_like_text=bool(fresh.get('looks_like_text')), source='measured now',
+                              detail=str(fresh.get('detail') or ''))
+                return result
+        except Exception:
+            pass
+    if detected.get('checked'):
+        result.update(looks_like_text=bool(detected.get('looks_like_text')), source='recorded',
+                      detail=str(detected.get('detail') or ''))
+    return result
+
+
+def _captions_contradict(job_root, code, entry, *, wants, measure=False):
+    """True when this export must be rendered again because it shows the wrong thing.
+
+    Two pieces of evidence, in order: the export's own provenance (``captions_burned``) and its picture. The job's
+    wish is the reference. A file that was already re-rendered once and still disagrees is not re-rendered again
+    for ever: it is marked ``captions_disputed`` and explained instead.
+    """
+    if entry.get('status') != 'exported' or entry.get('captions_disputed'):
+        return False
+    # Measuring costs a few frame reads, so it is only done when this job asks for NO transcript - that is the
+    # direction nobody can see from the record alone, and the one the field report was about.
+    evidence = caption_evidence(job_root, code, entry, measure=bool(measure) and not wants)
+    shown = evidence['looks_like_text']
+    if shown is None:
+        # No picture evidence yet: fall back to what the export recorded it burned.
+        from . import finishing_studio as finish
+        prov = _read(Path(str(entry.get('path') or '')).with_suffix('.provenance.json'), {}) or {}
+        if 'captions_burned' in prov:
+            shown = bool(prov.get('captions_burned'))
+    return shown is not None and bool(shown) != bool(wants)
+
