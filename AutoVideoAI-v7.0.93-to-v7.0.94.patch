+"""v7.0.94: image requests can use the credit approval guard; an early wait end is always logged.
+
+Field case (job 20261022-143856-7-small-daily-habits-tha-9729, shot_023 opening frame, 2026-10-25 19:18-19:23 IST):
+the image path set the approval journal but never the outstanding request id. Every wait on that bridge therefore
+refused the approval probe at its first check, and returned after about 40 s with no log line.
+
+Fakes only: no browser, no Flow, no submission, no credits. The guard is unchanged: a card with no visible cost is
+never clicked, a card above max_generation_credits (0 for images) is refused, and a card is clicked only once.
+"""
+import json
+import re
+
+import pytest
+from PIL import Image
+
+from engine import flow_image_transaction as tx
+from engine.providers.flow_browser import FlowBrowser, FlowRequestPending
+
+
+class FakeButton:
+    def __init__(self, name): self.name = name; self.clicked = 0
+    def is_visible(self, timeout=0): return True
+    def is_enabled(self, timeout=0): return True
+    def click(self, **kwargs): self.clicked += 1
+
+
+class FakeRole:
+    def __init__(self, page, pattern): self.page = page; self.pattern = pattern; self.first = self
+    def is_visible(self, timeout=0): return any(self.pattern.search(n) for n in self.page.buttons)
+    def is_enabled(self, timeout=0): return True
+    def count(self): return len([n for n in self.page.buttons if self.pattern.search(n)])
+    def nth(self, i):
+        names = [n for n in self.page.buttons if self.pattern.search(n)]
+        return self.page.buttons[names[i]]
+    def click(self, **kwargs):
+        for n, b in self.page.buttons.items():
+            if self.pattern.search(n): b.clicked += 1; return
+
+
+class FakePage:
+    def __init__(self, body, buttons):
+        self.body = body; self.buttons = {n: FakeButton(n) for n in buttons}
+    def inner_text(self, sel): return self.body
+    def get_by_role(self, role, name=None): return FakeRole(self, name)
+    def get_by_text(self, text, exact=False): return FakeRole(self, re.compile(text))
+    def wait_for_timeout(self, ms): pass
+
+
+def browser_with(page):
+    b = FlowBrowser.__new__(FlowBrowser)
+    b._page = page
+    b.ui = {"actions": {"agent_confirmation_buttons": ["Approve", "Always approve", "Generate"]}}
+    b.network_issue_detected = lambda: False
+    return b
+
+
+@pytest.fixture
+def image(tmp_path):
+    output = tmp_path / 'job' / 'storyboard' / 'shot_023_open.jpg'
+    output.parent.mkdir(parents=True)
+    tx.write_json(tx.journal_path(output), {'scope': tx.SCOPE, 'kind': 'image', 'status': 'pending',
+                                            'phase': 'submitted', 'request_hash': 'h-023',
+                                            'approval_reservations': []})
+    return output
+
+
+def test_zero_cost_card_is_approved_for_an_image_request(image):
+    page = FakePage("Would you like me to kick off this image generation, costing 0 credits?",
+                    ["Approve", "Always approve", "Reject"])
+    b = browser_with(page)
+    tx.approval_context(b, image, {'request_hash': 'h-023'})
+    assert b.confirm_agent_generation(timeout_s=1, approval="once", max_credits=0) is True
+    assert page.buttons["Approve"].clicked == 1
+    assert page.buttons["Always approve"].clicked == 0
+    saved = json.loads(tx.journal_path(image).read_text())
+    assert [r['cost'] for r in saved['approval_reservations']] == [0]
+
+
+def test_paid_card_is_refused_for_an_image_request(image):
+    page = FakePage("Would you like me to kick off this image generation, costing 7 credits?",
+                    ["Approve", "Always approve", "Reject"])
+    b = browser_with(page)
+    tx.approval_context(b, image, {'request_hash': 'h-023'})
+    assert not b.confirm_agent_generation(timeout_s=1, approval="once", max_credits=0)
+    assert page.buttons["Approve"].clicked == 0
+    assert b.last_agent_confirmation["blocked"] is True
+    assert b.last_agent_confirmation["cost"] == 7
+    assert 'credit guard' in b.last_agent_confirmation["reason"]
+
+
+def test_card_without_a_visible_cost_is_never_clicked(image):
+    page = FakePage("Would you like me to kick off this image generation?", ["Approve", "Reject"])
+    b = browser_with(page)
+    tx.approval_context(b, image, {'request_hash': 'h-023'})
+    assert not b.confirm_agent_generation(timeout_s=1, approval="once", max_credits=0)
+    assert page.buttons["Approve"].clicked == 0
+
+
+def test_the_same_zero_cost_card_is_clicked_only_once(image):
+    page = FakePage("Would you like me to kick off this image generation, costing 0 credits?",
+                    ["Approve", "Reject"])
+    b = browser_with(page)
+    tx.approval_context(b, image, {'request_hash': 'h-023'})
+    assert b.confirm_agent_generation(timeout_s=1, approval="once", max_credits=0) is True
+    assert not b.confirm_agent_generation(timeout_s=1, approval="once", max_credits=0)
+    assert page.buttons["Approve"].clicked == 1
+
+
+def test_without_a_request_id_the_probe_still_refuses(image):
+    """The 7.0.93 behaviour that caused the silent short waits. Kept on purpose: an unsolicited approval is refused."""
+    page = FakePage("costing 0 credits", ["Approve"])
+    b = browser_with(page)
+    b._approval_journal = str(tx.journal_path(image))
+    assert not b.confirm_agent_generation(timeout_s=1, approval="once", max_credits=0)
+    assert b.last_agent_confirmation["blocked"] is True
+    assert page.buttons["Approve"].clicked == 0
+
+
+def test_a_refused_approval_ends_the_wait_with_a_logged_reason(image, capsys, monkeypatch):
+    b = browser_with(FakePage("", []))
+    tx.approval_context(b, image, {'request_hash': 'h-023'})
+    monkeypatch.setattr(b, 'detect_failure', lambda: None)
+    monkeypatch.setattr(b, 'detect_service_busy', lambda: None)
+
+    def refused(**kwargs):
+        b.last_agent_confirmation = {"blocked": True, "reason": "credit guard: 7 > 0", "clicked": None}
+        return False
+    monkeypatch.setattr(b, 'confirm_agent_generation', refused)
+    assert b.wait_for_agent_generation(timeout_s=5, required_kind='image', transactional_images=True,
+                                       exclude_labels=[]) is False
+    out = capsys.readouterr().out
+    assert 'Approval refused: credit guard: 7 > 0' in out
+    assert 'No card was clicked' in out
+
+
+def test_reservations_written_during_the_wait_survive_a_journal_write(image):
+    request = json.loads(tx.journal_path(image).read_text())
+    disk = json.loads(tx.journal_path(image).read_text())
+    disk['approval_reservations'] = [{'key': 'k1', 'cost': 0, 'status': 'reserved', 'at': 1.0}]
+    disk['approval_credit_total_reserved'] = 0
+    tx.journal_path(image).write_text(json.dumps(disk))
+    tx.sync_approval_reservations(image, request)
+    assert request['approval_reservations'][0]['key'] == 'k1'
+
+
+# ---- recover(): the wait runs with the approval context, and reservations are synced afterwards -----------------
+
+class Provider:
+    def __init__(self, bridge): self.bridge = bridge
+    def _ensure(self): return self.bridge
+    def close(self): pass
+
+
+class Bridge:
+    normalize_project_url = staticmethod(FlowBrowser.normalize_project_url)
+
+    def __init__(self, tiles):
+        self.tiles = list(tiles); self.project = 'https://flow.google.com/project/dddddddd-dddd-dddd-dddd-dddddddddddd'
+        self.seen = None; self.wait_calls = 0
+
+    def current_project_url(self): return self.project
+    def ensure_project(self, *a, **k): self.project = k.get('project_url') or self.project
+    def media_assets(self): return [dict(t) for t in self.tiles]
+    def download_latest_asset(self, *a, **k): raise AssertionError('no downloads in this test')
+
+    def wait_for_agent_generation(self, **kwargs):
+        self.wait_calls += 1
+        self.seen = (getattr(self, '_approval_journal', None), getattr(self, '_awaiting_request_id', None),
+                     getattr(self, '_approval_card_limit', None))
+        return False
+
+
+def test_recover_gives_the_wait_an_approval_context_and_keeps_the_fresh_request_signal(tmp_path):
+    job = tmp_path / 'job-approval'
+    (job / 'storyboard').mkdir(parents=True)
+    output = job / 'storyboard' / 'shot_023_open.jpg'
+    ref = tmp_path / 'location_master.jpg'
+    Image.new('RGB', (128, 96), 'red').save(ref)
+    tx.write_json(tx.journal_path(output), {
+        'schema_version': 1, 'scope': tx.SCOPE, 'kind': 'image', 'status': 'pending',
+        'phase': 'submitted', 'submission_acknowledged': True, 'project_url': Bridge({}).project,
+        'project_name': 'AutoVideo-Image-test', 'capture_probes': {}, 'baseline': [], 'signature': '',
+        'submitted_prompt': 'x', 'request_hash': 'h-023', 'reference_hashes': {str(ref): tx.sha(str(ref))},
+        'approval_reservations': []})
+    bridge = Bridge([{'kind': 'image', 'sig': '/asb/new-location',
+                      'tile_hint': "Tile displaying a user's image AV_197ff6e22dbe_location_master.jpg",
+                      'hint': "Tile displaying a user's image AV_197ff6e22dbe_location_master.jpg"}])
+    request = json.loads(tx.journal_path(output).read_text())
+    with pytest.raises(FlowRequestPending) as info:
+        tx.recover(Provider(bridge), request, output, compiled={})
+    assert info.value.fresh_request_allowed is True
+    assert bridge.wait_calls == 1
+    journal_seen, awaiting, limit = bridge.seen
+    assert journal_seen == str(tx.journal_path(output))
+    assert awaiting == 'image:h-023'
+    assert limit == 1
