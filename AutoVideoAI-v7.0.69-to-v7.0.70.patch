+    payload = {
+        "model": model,
+        "messages": [{"role": "system", "content": system}, {"role": "user", "content": user}],
+        "temperature": 0.4,
+        "max_tokens": int(os.getenv("SARVAM_MAX_TOKENS", "4096")),
+        "reasoning_effort": None,
+    }
+    r = requests.post("https://api.sarvam.ai/v1/chat/completions",
+                      headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
+                      json=payload, timeout=180)
+    if r.status_code >= 400:
+        # Never echo the response body or the key: only the status belongs in the error.
+        raise RuntimeError(f"Indus AI (Sarvam) request failed with HTTP {r.status_code}")
+    choice = (r.json().get("choices") or [{}])[0]
+    return (choice.get("message") or {}).get("content") or ""
+
