+# ---------- FFmpeg: the edition video shows what the job chose ----------
+
+def _frame(video, t, out_png):
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-ss', f'{t:.2f}', '-i', str(video), '-frames:v', '1', str(out_png)],
+                   check=True)
+    from PIL import Image
+    return Image.open(out_png).convert('RGB')
+
+
+def _render_edition(tmp_path, name, *, text_cards, educational, hooks, cards_draft=True, hooks_draft=True, monkeypatch=None):
+    """One Hindi edition from real media. Returns the exported path."""
+    from engine.language_editions import render_job_editions
+    job = tmp_path / name / 'job'
+    (job / 'render').mkdir(parents=True)
+    (job / 'production').mkdir()
