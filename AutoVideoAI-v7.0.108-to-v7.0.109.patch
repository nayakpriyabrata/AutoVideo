+def _finished(job, code, captions):
+    """Make the render record claim a finished export, so the next render can be reasoned about."""
+    export = job / 'language_editions' / 'run' / 'exports' / (code + '-run.mp4')
+    export.parent.mkdir(parents=True, exist_ok=True)
+    export.write_bytes(b'video')
+    record = {'schema_version': 1, 'editions': {code: {
+        'status': 'exported', 'path': str(export), 'sha256': 'whatever', 'audio_sha256': 'x',
+        'captions': captions, 'render_copy': str(job / 'render' / (job.name + '-' + code + '-edition.mp4'))}}}
+    (job / 'production' / 'language_editions_render.json').write_text(json.dumps(record), encoding='utf-8')
+    return export
+
+
+def test_a_video_burned_with_the_wrong_transcript_counts_as_out_of_date(tmp_path):
+    from engine.language_editions import _bundle_is_current
+    job = _state_job(tmp_path)
+    bundle = json.loads((job / 'production' / 'language_editions.json').read_text())['bundles']['hi']
+    entry = {'status': 'exported', 'audio_sha256': 'x', 'path': str(job / 'v.mp4'), 'captions': True}
+    (job / 'v.mp4').write_bytes(b'v')
+    assert _bundle_is_current(job, 'hi', bundle, entry, verify=False, transcript=True) is True
+    assert _bundle_is_current(job, 'hi', bundle, entry, verify=False, transcript=False) is False
+    entry['captions'] = False
+    assert _bundle_is_current(job, 'hi', bundle, entry, verify=False, transcript=False) is True
+    assert _bundle_is_current(job, 'hi', bundle, entry, verify=False, transcript=True) is False
+
