diff -ruN -x RELEASE_MANIFEST.json -x '*.pyc' a/tests/test_v785_voice_reuse.py b/tests/test_v785_voice_reuse.py
--- a/tests/test_v785_voice_reuse.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_v785_voice_reuse.py	2026-10-24 04:57:01.513757472 +0000
@@ -0,0 +1,126 @@
+"""v7.0.85: a job reuses the approved voices from Create step 4 and never repeats TTS for a settings change.
+
+Only card and hook drafts are redrawn when a flag differs. No network: TTS, Gemini Web and cards are faked.
+"""
+import json
+from pathlib import Path
+
+import pytest
+
+import engine.speech_cards as SC
+from engine.production import save, digest
+
+EN = 'Start with one small habit today. Repeat it for one week.'
+HI = 'आज एक छोटी आदत से शुरुआत करें। एक हफ्ते तक इसे दोहराएँ।'
+OR_GOOD = 'ଆଜି ଏକ ଛୋଟ ଅଭ୍ୟାସରୁ ଆରମ୍ଭ କରନ୍ତୁ। ଏକ ସପ୍ତାହ ଧରି ଏହାକୁ ଦୋହରାନ୍ତୁ।'
+LANGS = ['en', 'hi', 'or']
+
+
+@pytest.fixture
+def world(tmp_path, monkeypatch):
+    monkeypatch.setenv('AUTOVIDEO_SHARED_ROOT', str(tmp_path / 'shared'))
+    rec = {'tts': [], 'loc': [], 'cards': [], 'batch_calls': []}
+
+    def fake_edition(root, script, language, **kw):
+        rec['tts'].append(language)
+        audio = Path(root) / 'speech-editions' / language / 'fp' / 'voice.mp3'
+        audio.parent.mkdir(parents=True, exist_ok=True)
+        audio.write_bytes(b'x' * 4096)
+        words = audio.parent / 'words.json'
+        words.write_text(json.dumps([{'word': 'a', 'start': 0.0, 'end': 1.0}]))
+        (audio.parent / 'production').mkdir(exist_ok=True)
+        (audio.parent / 'production' / 'speech_cards.json').write_text(json.dumps({'fingerprint': 'f', 'cards': []}))
+        return {'audio': str(audio), 'audio_sha256': digest(audio), 'duration': 3.0, 'script': script,
+                'language': language, 'words': str(words), 'cards': [], 'timing_source': 'test',
+                'text_cards': kw.get('text_cards', True), 'educational': kw.get('educational', False),
+                'hooks': kw.get('hooks', False), 'topic': kw.get('topic', ''),
+                'card_provider': kw.get('card_provider', 'gemini-web')}
+
+    def fake_cards(bundle, cleanup):
+        rec['cards'].append((bundle['language'], bool(bundle.get('text_cards')), bool(bundle.get('educational')),
+                             bool(bundle.get('hooks'))))
+        return dict(bundle, cards=[], hooks_ready=bool(bundle.get('hooks')))
+
+    def fake_loc(*a, **k):
+        rec['loc'].append(1)
+        raise AssertionError('no localization expected')
+
+    monkeypatch.setattr(SC, 'prepare_edition', fake_edition)
+    monkeypatch.setattr(SC, 'complete_edition_cards', fake_cards)
+    monkeypatch.setattr(SC, 'prepare_localized_scripts', fake_loc)
+    monkeypatch.setattr(SC, 'validate_words', lambda *a, **k: None)
+    from engine.finishing_studio import shared_root
+    return {'rec': rec, 'shared': shared_root(), 'root': tmp_path}
+
+
+def _approved_batch(world):
+    from engine.speech_cards import localization_key
+    key = localization_key(EN, 'en', LANGS)
+    loc = world['shared'] / 'speech_preparation' / 'scripts' / key
+    loc.mkdir(parents=True, exist_ok=True)
+    state = {'schema_version': 1, 'phase': 'scripts_approved', 'fingerprint': key, 'source_language': 'en',
+             'source_script': EN, 'editions': LANGS, 'scripts': {'en': EN, 'hi': HI, 'or': OR_GOOD},
+             'reviewed': {x: True for x in LANGS}}
+    save(loc / 'localized_scripts.json', state)
+    batch = SC.prepare_batch(world['shared'] / 'speech_preparation' / 'batch', EN, 'en', LANGS, provider='auto',
+                             localized_scripts=state['scripts'], text_cards=True, educational=False, hooks=False)
+    assert batch['phase'] == 'ready_for_review'
+    return batch
+
+
+def _job(world, batch, **flags):
+    job = world['root'] / 'job'
+    (job / 'production').mkdir(parents=True)
+    (job / 'narration').mkdir()
+    bundles = SC.attach_prepared_batch(job, batch)
+    settings = {'tts_provider': 'auto', 'gemini_chat_cleanup': 'keep'}
+    save(job / 'production' / 'language_editions.json', {
+        'source_language': 'en', 'editions': LANGS, 'profiles': {}, 'prepare_audio': True, 'bundles': bundles,
+        'status': 'prepared batch attached', 'text_cards': True, 'hooks_enabled': False, 'educational': False, 'topic': 't'})
+    return job, settings
+
+
+def test_matching_settings_reuse_every_voice_without_tts_or_redraw(world):
+    batch = _approved_batch(world)
+    world['rec']['tts'].clear(); world['rec']['cards'].clear()
+    job, settings = _job(world, batch)
+    SC.prepare_selected_editions(job, EN, 'en', settings, None, text_cards=True, hooks=False, educational=False, topic='t')
+    assert world['rec']['tts'] == []
+    assert world['rec']['cards'] == []
+    assert world['rec']['loc'] == []
+
+
+def test_educational_change_redraws_cards_but_keeps_every_voice(world):
+    batch = _approved_batch(world)
+    world['rec']['tts'].clear(); world['rec']['cards'].clear()
+    job, settings = _job(world, batch)
+    SC.prepare_selected_editions(job, EN, 'en', settings, None, text_cards=True, hooks=False, educational=True, topic='t')
+    assert world['rec']['tts'] == []
+    assert [row[0] for row in world['rec']['cards']] == LANGS
+    assert all(row[2] is True for row in world['rec']['cards'])
+    saved = json.loads((job / 'production' / 'language_editions.json').read_text())
+    assert saved['educational'] is True and all(b['educational'] for b in saved['bundles'].values())
+
+
+def test_hooks_requested_later_draft_hooks_only(world):
+    batch = _approved_batch(world)
+    world['rec']['tts'].clear(); world['rec']['cards'].clear()
+    job, settings = _job(world, batch)
+    SC.prepare_selected_editions(job, EN, 'en', settings, None, text_cards=True, hooks=True, educational=False, topic='t')
+    assert world['rec']['tts'] == []
+    assert all(row[3] is True for row in world['rec']['cards'])
+
+
+def test_no_attached_voices_still_generates_them_once(world):
+    _approved_batch(world)
+    world['rec']['tts'].clear()
+    job = world['root'] / 'plain-job'
+    (job / 'production').mkdir(parents=True)
+    (job / 'narration').mkdir()
+    save(job / 'production' / 'language_editions.json', {
+        'source_language': 'en', 'editions': LANGS, 'profiles': {}, 'prepare_audio': True, 'bundles': {},
+        'status': 'awaiting narration preparation', 'text_cards': True, 'hooks_enabled': False, 'educational': False, 'topic': 't'})
+    SC.prepare_selected_editions(job, EN, 'en', {'tts_provider': 'auto', 'gemini_chat_cleanup': 'keep'}, None,
+                                 text_cards=True, hooks=False, educational=False, topic='t')
+    assert sorted(world['rec']['tts']) == sorted(LANGS)  # genuine first generation, from the approved snapshot
+    assert world['rec']['loc'] == []
