+"""v7.0.73: the English master gets the profile intro/outro, and finished editions are copied into render/.
+
+FFmpeg-free: the Finishing Studio plan and render steps are stubbed so the
+orchestration (plan editing, skip rules, render/ copies, record) is exercised.
+"""
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+from engine import language_editions as le  # noqa: E402
+from engine import finishing_studio as finish  # noqa: E402
+
+
+def _write(path, data):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    if isinstance(data, bytes):
+        path.write_bytes(data)
+    else:
+        path.write_text(json.dumps(data, indent=2), encoding='utf8')
+    return path
+
+
+def _job(tmp_path, *, with_intro=True, languages=('en', 'hi')):
+    job = tmp_path / 'outputs' / 'job-42'
+    (job / 'render').mkdir(parents=True)
+    (job / 'production').mkdir()
+    final = _write(job / 'render' / 'job-42-final.mp4', b'final-master')
+    profile_assets = {'logo': {'path': str(tmp_path / 'logo.png'), 'sha256': 'x'}}
+    if with_intro:
+        profile_assets['intro'] = {'path': str(tmp_path / 'intro.mp4'), 'sha256': 'x'}
+        profile_assets['outro'] = {'path': str(tmp_path / 'outro.mp4'), 'sha256': 'x'}
+    profile = _write(tmp_path / 'profile-en.json', {'schema_version': 1, 'name': 'Skill Shift',
+                                                     'names': {}, 'assets': profile_assets})
+    _write(job / 'production' / 'language_editions.json', {
+        'source_language': 'en', 'editions': list(languages), 'profiles': {'en': str(profile)},
+        'bundles': {code: {'audio_sha256': 'a'} for code in languages if code != 'en'}})
+    return job, final
+
+
+def _fake_create_plan(source, selection, *, languages, output_root, **kwargs):
+    folder = Path(output_root) / '20261021-000000-aaaaaaaa'
+    folder.mkdir(parents=True, exist_ok=True)
+    assets = {'intro': {'path': 'i'}, 'outro': {'path': 'o'}, 'logo': {'path': 'l'}}
+    plan = {'schema_version': 2, 'state': 'draft', 'source': {'path': str(source), 'sha256': 'x', 'duration': 3},
+            'shared_music': {'path': 'm'}, 'shared_music_license': 'licence',
+            'editions': {code: {'channel': {'name': 'Skill Shift'}, 'assets': dict(assets), 'narration': {'path': 'n'},
+                                'cards': [{'text': 'c'}], 'words': {'path': 'w'}, 'music': None,
+                                'script': 'x', 'timing_source': 'y', 'reviewed': False}
+                         for code in languages},
+            'captions': True, 'source_language': kwargs.get('source_language')}
+    path = folder / 'plan.json'
+    path.write_text(json.dumps(plan), encoding='utf8')
+    calls.append({'kwargs': kwargs, 'languages': list(languages)})
+    return path
+
+
+calls = []
+
+
+def _fake_set_edition(plan_path, language, *, reviewed=False, **_):
+    plan = json.loads(Path(plan_path).read_text(encoding='utf8'))
+    plan['editions'][language]['reviewed'] = bool(reviewed)
+    plan['state'] = 'reviewed'
+    Path(plan_path).write_text(json.dumps(plan), encoding='utf8')
+    return Path(plan_path)
+
+
+def _fake_render(plan_path, language, *, progress=None):
+    plan = json.loads(Path(plan_path).read_text(encoding='utf8'))
+    edition = plan['editions'][language]
+    # The primary branding must not carry over any narration, cards, captions, music, logo or name.
+    assert edition['narration'] is None and edition['cards'] == [] and edition['words'] is None
+    assert edition['music'] is None and set(edition['assets']) <= {'intro', 'outro'}
+    assert edition['channel'] == {'name': '', 'display_name': ''}
+    assert plan['shared_music'] is None
+    out = Path(plan_path).parent / 'exports' / (language + '-' + Path(plan_path).parent.name + '.mp4')
+    out.parent.mkdir(exist_ok=True)
+    out.write_bytes(b'branded-' + language.encode())
+    return out
+
+
+@pytest.fixture(autouse=True)
+def _stub_ffmpeg(monkeypatch):
+    calls.clear()
+    monkeypatch.setattr(finish, 'create_plan', _fake_create_plan)
+    monkeypatch.setattr(finish, 'set_edition', _fake_set_edition)
+    monkeypatch.setattr(finish, 'render', _fake_render)
+
+
+def test_primary_gets_intro_and_outro_and_copy_in_render(tmp_path):
+    job, final = _job(tmp_path)
+    report = le.render_primary_branding(job, final)
+    assert report['status'] == 'exported'
+    branded = job / 'render' / 'job-42-en-branded.mp4'
+    assert branded.is_file() and branded.read_bytes() == b'branded-en'
+    assert final.read_bytes() == b'final-master'  # the unbranded master stays as it was
+    assert calls[0]['kwargs']['use_clean_master'] is False
+    assert calls[0]['kwargs']['captions'] is False
+    record = json.loads((job / 'production' / 'language_editions_render.json').read_text(encoding='utf8'))
+    assert record['primary']['status'] == 'exported'
+    assert record['primary']['render_copy'] == str(branded)
+
+
+def test_primary_skipped_without_intro_or_outro(tmp_path):
+    job, final = _job(tmp_path, with_intro=False)
+    report = le.render_primary_branding(job, final)
+    assert report == {'status': 'no_intro_outro', 'language': 'en'}
+    assert calls == []
+    assert not (job / 'render' / 'job-42-en-branded.mp4').exists()
+
+
+def test_single_language_job_is_untouched(tmp_path):
+    job = tmp_path / 'outputs' / 'job-7'
+    (job / 'render').mkdir(parents=True)
+    final = _write(job / 'render' / 'job-7-final.mp4', b'x')
+    assert le.render_primary_branding(job, final) == {'status': 'not_requested'}
+    assert calls == []
+
+
+def test_missing_final_is_reported_not_raised(tmp_path):
+    job, final = _job(tmp_path)
+    final.unlink()
+    report = le.render_primary_branding(job, final)
+    assert report['status'] == 'failed' and 'missing' in report['error']
+
+
+def test_finished_editions_are_copied_into_render_and_idempotent(tmp_path):
+    job, _final = _job(tmp_path)
+    export = _write(job / 'language_editions' / 'stamp' / 'exports' / 'hi-stamp.mp4', b'hindi-video')
+    record = {'editions': {'hi': {'status': 'exported', 'path': str(export),
+                                  'sha256': finish._hash(export)}}}
+    assert le._sync_render_copies(job, record) is True
+    target = job / 'render' / 'job-42-hi-edition.mp4'
+    assert target.read_bytes() == b'hindi-video'
+    assert record['editions']['hi']['render_copy'] == str(target)
+    assert le._sync_render_copies(job, record) is False  # second pass: nothing to do
+
+
+def test_stale_render_copy_is_replaced_and_export_kept(tmp_path):
+    job, _final = _job(tmp_path)
+    export = _write(job / 'language_editions' / 's' / 'exports' / 'or-s.mp4', b'odia')
+    record = {'editions': {'or': {'status': 'exported', 'path': str(export), 'sha256': 'does-not-match'}}}
+    # A stale render/ copy that differs from the export is replaced, so the copy must verify.
+    _write(job / 'render' / 'job-42-or-edition.mp4', b'stale')
+    assert le._sync_render_copies(job, record) is True
+    assert record['editions']['or']['status'] == 'exported'
+    assert (job / 'render' / 'job-42-or-edition.mp4').read_bytes() == b'odia'
+
+
+def test_render_language_outputs_skips_current_primary(tmp_path, monkeypatch):
+    job, final = _job(tmp_path)
+    le.render_primary_branding(job, final)
+    calls.clear()
+    monkeypatch.setattr(le, 'render_job_editions', lambda *a, **k: {'status': 'exported', 'editions': {}})
+    report = le.render_language_outputs(job)
+    assert report['primary']['status'] == 'exported'
+    assert calls == []  # primary already current: no second plan or render
diff -ruN a/tools/update_v772_to_v773.py b/tools/update_v772_to_v773.py
--- a/tools/update_v772_to_v773.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/update_v772_to_v773.py	2026-10-21 10:34:42.000000000 +0000
@@ -0,0 +1,148 @@
+#!/usr/bin/env python3
+"""Apply the v7.0.73 update (language outputs, music level, cleanup keeps language videos) to a v7.0.72 installation.
+
+Usage (run from the existing installation folder, after extracting the 7.0.72 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.73/tools/update_v772_to_v773.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.73/tools/update_v772_to_v773.py . --apply    # installs the code
+
+Only code and documentation are replaced. Outputs, saved jobs, browser profiles,
+music, characters and channel profiles are never copied, moved or deleted.
+A file you changed locally is preserved and the update stops before touching anything.
+Stop the dashboard before --apply.
+"""
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = [
+    'LANGUAGE_OUTPUTS_V7_0_73.md',
+    'VERSION',
+    'app.py',
+    'cli.py',
+    'engine/audio/music_overlay.py',
+    'engine/clipping.py',
+    'engine/factory.py',
+    'engine/finishing_studio.py',
+    'engine/language_editions.py',
+    'engine/post_job_cleanup.py',
+    'engine/presentation.py',
+    'engine/render/ffmpeg_renderer.py',
+    'engine/storage_manager.py',
+    'tests/test_v773_cleanup_keeps_language_videos.py',
+    'tests/test_v773_language_outputs.py',
+    'tools/update_v772_to_v773.py',
+]
+# Files as they exist in 7.0.72: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['df2e046c87f2dc9b86f1af20da505f87d8b112311ada4a9bbea3ce986e034cde'],
+    'app.py': ['5ce6ff21129bf41569415fd68da1c9c61283e82c6326bb96f99ff8007f65e693'],
+    'cli.py': ['833e47556113af25548f70c5a4e737367056da48d91e75375c9f51d912c108ff'],
+    'engine/audio/music_overlay.py': ['b730bad9bc784da931a481d677cda87fdd55ab4e5d4a19c404ba187015439adb'],
+    'engine/clipping.py': ['6908bbe32478c3dd034cf41bb79a7dbf1fe7bc3e5555cf5dcb4dd33fc5724d57'],
+    'engine/factory.py': ['2eb15d004ab492dca8badc70166219453b7badaff59229ed902b5a81370898f4'],
+    'engine/finishing_studio.py': ['7b53d24e7ba337df1fd291191723cc5ad52dcad40a19841d04e832732bb32ad8'],
+    'engine/language_editions.py': ['10fdefa8205edb01aec847c0719b457cfb9a0812b841a11c987e9a94f7dd585d'],
+    'engine/post_job_cleanup.py': ['69e230e560818373238e532a756c4b0c6919a6eceda446b94a16bd46bf97a80b'],
+    'engine/presentation.py': ['0cdeb36d587c8872ab9719a54ec809d9b6327b111a09628bae7bdc0624ee0f01'],
+    'engine/render/ffmpeg_renderer.py': ['677ecdf8248a772195a223371d6f5dbaf7bd9598b66c0b385ac65dc44c61cb1b'],
+    'engine/storage_manager.py': ['f6dc269b87fa8c41078aea1063c696dfcda5f9526b2eaa68b05c30005565569b'],
+}
+ACCEPTED_INSTALLS = ('7.0.72', '7.0.73')  # 7.0.73 allows a safe re-run after success
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError('This update requires an installed 7.0.72 (found ' + current + '). '
+                         'Run ../AutoVideoAI-v7.0.72/tools/update_v771_to_v772.py first (7.0.70 to 7.0.71 to 7.0.72 is a chain).')
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the 7.0.73 folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        if destination.exists() and sha(destination) not in ALLOWED.get(name, []) + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+    plan = {'target': str(target), 'installed_version': current, 'apply': args.apply,
+            'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every 7.0.73 code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v7.0.72-to-v7.0.73-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to 7.0.73. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat).')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
+        raise SystemExit(1)
