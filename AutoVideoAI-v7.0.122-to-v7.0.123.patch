+# ------------------------------------------------------------------------ 3. choosing a saved image
+def test_a_blocked_frame_lists_its_saved_images_and_keeps_the_one_chosen(install):
+    job = make_job(install, '20261031-121949-growth', shots=57)
+    output = make_frame(job)
+    blocked = flow_choice.blocked_frames(job)
+    assert [row['image'] for row in blocked] == ['shot_051_open.jpg']
+    assert blocked[0]['count'] == 2
+    result = flow_choice.keep(job, 'shot_051_open.jpg', 1)
+    assert result['kept'].endswith('.probe-01.jpg')
+    assert output.is_file()
+    assert hashlib.sha256(output.read_bytes()).hexdigest() == result['sha256']
+    assert 'no Flow credit spent' in result['note']
+    journal = json.loads(Path(str(output) + '.flow-request.json').read_text(encoding='utf-8'))
+    assert journal['status'] == 'downloaded'
+    assert journal['capture_method'] == 'reviewed_candidate_choice'
+    assert journal['reviewed_choice']['file'].endswith('.probe-01.jpg')
+    # the other image is still there, and the frame is no longer waiting
+    assert Path(result['probe']).is_file()
+    assert flow_choice.all_frames(job) == []
+
+
+def test_a_changed_candidate_is_refused_with_the_reason(install):
+    job = make_job(install, '20261031-121949-growth', shots=57)
+    output = make_frame(job)
+    probe = Path(str(output) + '.probe-00.jpg')
+    Image.new('RGB', (160, 90), (10, 200, 10)).save(probe)
+    rows = flow_choice.candidates(output)
+    assert rows[1]['usable'] is False or rows[0]['usable'] is False
+    with pytest.raises(ValueError) as error:
+        flow_choice.keep(job, 'shot_051_open.jpg', 1)
+    assert 'no longer matches the checksum' in str(error.value) or 'cannot be used' in str(error.value)
+    assert not output.is_file()
+
