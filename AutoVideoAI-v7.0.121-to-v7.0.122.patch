+#!/usr/bin/env python3
+"""Apply the v7.0.122 update to a v7.0.121 installation.
+
+Two reports on the same page after v7.0.121: "its only showing for the video which is have an activie job
+already" and "its not picking the selected charecter for the video generation".
+
+1. **The cast is carried, and visible.** Create shows the character choice as its own step (it used to hide
+   inside a collapsed "Characters and recovery preferences · optional" expander), the narration batch records
+   the chosen characters, *Run your prepared voices* asks for the character and writes it into the new job, a
+   job without a storyboard can be given one from the new **Cast** panel in Queue & Resume, and the CLI gained
+   ``v3 use-voices --cast`` plus ``v3 cast <job>``.
+
+2. **Every prepared narration is offered.** The batch picker used to hide a batch as soon as a job held its
+   voices and only read finished batches inside the Active job, so only the newest Create step 4 session ever
+   appeared. It now lists them all - unused first - and says where each one's voices live.
+
+Usage (run from the existing installation folder, after extracting the 7.0.122 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.122-Cast-And-Every-Batch/tools/update_v7121_to_v7122.py .            # dry run
+    python3 ../AutoVideoAI-v7.0.122-Cast-And-Every-Batch/tools/update_v7121_to_v7122.py . --apply    # install
+
+Only code, documentation and tests are replaced. Outputs, saved jobs, speech batches, Flow journals, browser
+profiles and ``music_library/`` are never copied, moved or deleted. Stop the dashboard before --apply.
+"""
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = [
+    'VERSION', 'app.py', 'cli.py', 'engine/cast.py', 'engine/batch_actions.py',
+    'engine/speech_batches.py', 'engine/speech_cards.py',
+    'tests/test_v7121_run_prepared_voices.py', 'tests/test_v7122_cast_and_every_batch.py',
+    'CAST_AND_EVERY_BATCH_V7_0_122.md', 'tools/update_v7121_to_v7122.py',
+]
+# Files as they exist in 7.0.121: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['5d2e777ff57c1caa665fc56700bf39be4461e43efd3377c850717639909d8f46'],
+    'app.py': ['03b28c3ef8d8bfb51c55b54d4b6c5ab9684092894e6b4f7608a270cd65a9d536'],
+    'cli.py': ['a78b716c67a0487bf59d4163a584c00287d5402e32cad95f6566b2f062dbf0f1'],
+    'engine/cast.py': ['bb6c5dcf0981f4b06a8d11343cf2ad5916239553a1e45db3df75daf09ff162d8'],
+    'engine/batch_actions.py': ['dc19b2172f2e5192a553a59ae9dd71f48875796824d1261fc2655d482fdff91c'],
+    'engine/speech_batches.py': ['5928bd9c7d4c5707e05c41624ae65f26024bc653fbc57b5db6781bcd8081698b'],
+    'engine/speech_cards.py': ['169a0826319128106014ac3e60c50b23046fecaa68221df5d5b0429b1cae3f21'],
+    'tests/test_v7121_run_prepared_voices.py': ['51972756d19bcfcf3c9153ef8e670ada23ed44f7da6171d4c91db1e413f5b903'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.121', '7.0.122')  # 7.0.122 allows a safe re-run after success
+
+# An older installation must walk the zips one at a time; this one knows the step before it.
+EARLIER_STEPS = [
+    ('7.0.120', '7.0.121', 'tools/update_v7120_to_v7121.py'),
+]
+
+
+def chain_message(current, version):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.121 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.121 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.121 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this ' + version + ' update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current, source.name or '7.0.122'))
+    new_version = (source / 'VERSION').read_text(encoding='utf-8').strip()
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the ' + new_version +
+                         ' folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        allowed = ALLOWED.get(name, [])
+        if destination.exists() and allowed and sha(destination) not in allowed + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+        if destination.exists() and not allowed and sha(destination) != expected[name]:
+            # A file this release introduces must not overwrite a different file that already sits at that path.
+            raise ValueError('A different file already exists where this update installs ' + name +
+                             '; preserved it and changed nothing. Move it aside and run the update again.')
+    plan = {'target': str(target), 'installed_version': current, 'new_version': new_version,
+            'apply': args.apply, 'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every ' + new_version + ' code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v' + current + '-to-v' + new_version + '-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to ' + new_version + '. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat), then check the install with:')
+        print('    python3 cli.py v3 self-check')
+        print('Then open Jobs & Recovery > Queue & Resume. "Run your prepared voices" lists every finished '
+              'narration; choose the batch, choose the character in "Character in this video", state the rights '
+              'and press "Create the job from these voices". A saved job that has not planned its scenes can be '
+              'given its character in the "Cast" panel on the same page. Command line: python3 cli.py v3 '
+              'use-voices --list, then --create-job --rights own_content [--cast <character id>], and '
+              'python3 cli.py v3 cast <job> [--set <character id>].')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
+        raise SystemExit(1)
