+#!/usr/bin/env python3
+"""Apply the v7.0.116 update to a v7.0.115 installation.
+
+One field report on the Odia edition, with a screenshot: a single frame showed **two pop-up cards overlapping** - the
+bold KEY POINT panel, and behind it a second panel of the same shape with the rest of the sentence.
+
+Both were real, and both lists were drawn by the same render:
+
+* ``bundle['cards']`` - the job's copied cards, drafted from the original English card pass and stored on the
+  language's narration; drawn in their own loop as full-frame images;
+* ``production/speech_cards.json`` - the edition's own cards, drafted for this language from its own reviewed
+  narration and drawn by ``speech_cards.render()``.
+
+They are anchored to the same spoken sentence, so when their windows differ by a few tenths of a second they land on
+top of each other. Nothing compared the two lists - only hooks were ever checked against cards.
+
+v7.0.116 draws **one card at a time**, from either list:
+
+1. ``engine/render/card_slots.py`` (new) holds the rule: cards only (hooks are pills in another band), a 0.15 s beat
+   between two cards, and, when two collide, the card from the language's own drafted file wins - it was written for
+   this narration, in this language. A duplicate of the same text is drawn once.
+2. The edition render applies it before anything is drawn, so the dropped card is never encoded.
+3. ``graphics-<lang>.json`` and the export's provenance record what was drawn, ``cards_on_screen_at_once`` (1), and
+   what gave way; the job record, the panel warning and the listing's ``--files`` view repeat it. Nothing changes
+   silently, and no card is deleted from your saved files - only the duplicate draw is skipped.
+
+Nothing is re-recorded, no Flow credit is spent, and no new video request is opened by this update. An edition has to
+be rendered again to see the fix, which uses the saved narration and the approved picture.
+"""
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = [
+    'VERSION',
+    'engine/finishing_studio.py', 'engine/language_editions.py', 'engine/edition_files.py',
+    'engine/render/card_slots.py',
+    'tests/test_v7116_one_card_at_a_time.py',
+    'ONE_CARD_AT_A_TIME_V7_0_116.md', 'tools/update_v7115_to_v7116.py',
+]
+# Files as they exist in 7.0.110: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['5b9bf5f5dd00aea55ac89a2ec026374fa24de90505a14e32e7c2e3bd8d03f106'],
+    'engine/finishing_studio.py': ['27b6806d5f5f5eab2f8c9bd916ad3da1755125f0212b47775387e296bcf2ec8e'],
+    'engine/language_editions.py': ['81df39d7f3d976613c1da4be56abdf10fa5d207f48d16832c92f6d913db91b02'],
+    'engine/edition_files.py': ['b48f4ccca88120805bac8ad4faf840ce09618f829028e1c7be2310809899aabe'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.115', '7.0.116')  # 7.0.116 allows a safe re-run after success
+
+# The 7.0.116 zip carries the 7.0.115 update; apply that first on an older installation.
+EARLIER_STEPS = [
+    ('7.0.114', '7.0.115', 'tools/update_v7114_to_v7115.py'),
+]
+
+
+def chain_message(current, version):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.115 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.115 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.115 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this ' + version + ' update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current, source.name or '7.0.116'))
+    new_version = (source / 'VERSION').read_text(encoding='utf-8').strip()
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the ' + new_version +
+                         ' folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        allowed = ALLOWED.get(name, [])
+        if destination.exists() and allowed and sha(destination) not in allowed + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+    plan = {'target': str(target), 'installed_version': current, 'new_version': new_version,
+            'apply': args.apply, 'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every ' + new_version + ' code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v' + current + '-to-v' + new_version + '-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to ' + new_version + '. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat).')
+        print('Nothing was re-rendered, no voice was re-recorded and no Flow credit was spent. To put one card on '
+              'screen at a time, render the language again (it reuses the saved narration and the approved '
+              'picture): python3 cli.py v3 language-outputs <job> --files --check-captions then the render command '
+              'it prints.')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
+        raise SystemExit(1)
