+"""v7.0.110: choosing Gemini's shots happens in the app, not only on the command line.
+
+Field request: "I want to pick which shots Gemini generates, and do it in the UI." v7.0.109 added the choice
+(``engine/providers/gemini_video.choose_shots``) but the only way to use it was ``cli.py v3 gemini-shots`` or a
+number typed in Create that silently took the first N eligible shots.
+
+These tests hold the UI to three promises:
+
+* the picker is reachable from the job panel (Queue and Storyboard) and from the Create page's own help text,
+* it lists every shot with a verdict and a reason, so an ineligible shot explains itself,
+* it only saves a choice - it never submits a request, so opening the panel costs nothing.
+"""
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+APP = (ROOT / 'app.py').read_text(encoding='utf-8')
+
+
+def test_the_picker_is_one_function_and_not_pasted_into_each_page():
+    assert APP.count('def gemini_shot_panel(') == 1
+    # Create/Queue panel, Storyboard, and the second job panel share the same expander.
+    assert APP.count('gemini_shot_panel(') >= 4
+    assert APP.count("multiselect('Shots for Gemini") == 1
+
+
+def test_the_job_panel_shows_the_picker_next_to_the_other_job_panels():
+    for neighbour in ('language_edition_panel(st.session_state.job_id)',
+                      'graphics_audit_panel(st.session_state.job_id)'):
+        assert neighbour in APP
+    blocks = [block for block in APP.split('gemini_shot_panel(st.session_state.job_id)')]
+    assert len(blocks) >= 3, 'the picker is only wired into one job panel'
+    # Both job-panel call sites (Queue and the Create-page pipeline view) carry it.
+    for needle in ('monitor_job(st.session_state.job_id)\n        gemini_shot_panel(st.session_state.job_id)',
+                   'pipeline_view(st.session_state.job_id)\n        gemini_shot_panel(st.session_state.job_id)'):
+        assert needle in APP, needle
+
+
+def test_the_storyboard_still_offers_it_per_job():
+    assert 'gemini_shot_panel(m.job_id)' in APP
+
+
+def test_the_create_page_says_where_the_shots_are_chosen():
+    assert 'Gemini Web video shots' in APP
+    assert 'gemini-shots' in APP          # the exact CLI fallback is printed in the same help
+    assert 'not just the first ones' in APP
+
+
+def test_the_panel_lists_every_shot_with_its_reason():
+    for column in ("'shot': row['shot_id']", "'eligible': row['eligible']", "'why': row['reason']"):
+        assert column in APP
+    assert 'No shot is eligible for Gemini in this job' in APP
+
+
+def test_saving_the_choice_submits_nothing():
+    assert 'no request was submitted' in APP
+    assert 'A shot with an accepted take or an existing Flow request is never offered' in APP
+    # The panel is guarded by the production lock and stores through choose_shots only.
+    assert 'choose_shots(job_dir, manifest.shots, picked)' in APP
+    assert 'choose_shots(job_dir, manifest.shots, [])' in APP
+
+
+def test_the_choice_can_be_cleared_again():
+    assert "button('Clear the choice'" in APP
+    assert 'Choice cleared; the first eligible shots are used again.' in APP
+
+
+def test_choosing_is_capped_at_four_and_says_so():
+    assert "multiselect('Shots for Gemini (maximum 4)'" in APP
