+"""v7.0.73 cleanup: English branded master, Hindi/Odia copies and exports are kept; videos can be copied out first."""
+import json
+from pathlib import Path
+
+import pytest
+
+from engine import post_job_cleanup as pjc
+
+
+def _job(root):
+    job = root / 'job-42'
+    (job / 'render').mkdir(parents=True)
+    (job / 'production').mkdir()
+    (job / 'flow' / 'shots' / 'shot_001').mkdir(parents=True)
+    (job / 'downloads').mkdir()
+    (job / 'production_manifest.json').write_text(json.dumps({'status': 'done'}))
+    (job / 'render' / 'job-42-final.mp4').write_bytes(b'final-video')
+    (job / 'render' / 'job-42-en-branded.mp4').write_bytes(b'english-branded')
+    (job / 'render' / 'job-42-hi-edition.mp4').write_bytes(b'hindi-copy')
+    (job / 'render' / 'job-42-or-edition.mp4').write_bytes(b'odia-copy')
+    export_dir = job / 'language_editions' / 'stamp-1' / 'exports'
+    export_dir.mkdir(parents=True)
+    (export_dir / 'hi-stamp-1.mp4').write_bytes(b'hindi-copy')
+    (export_dir / 'or-stamp-1.mp4').write_bytes(b'odia-copy')
+    (job / 'flow' / 'shots' / 'shot_001' / 'take_01.mp4').write_bytes(b'x' * 1000)
+    (job / 'downloads' / 'raw.png').write_bytes(b'x' * 500)
+    return job
+
+
+def _valid(path):
+    return Path(path).read_bytes() in (b'final-video', b'english-branded', b'hindi-copy', b'odia-copy')
+
+
+def test_plan_keeps_every_language_video_and_frees_only_intermediates(tmp_path):
+    job = _job(tmp_path)
+    plan = pjc.plan_job(job, validate_final=_valid)
+    assert plan['allowed'], plan['blocked']
+    assert set(plan['kept_videos']) == {
+        'render/job-42-final.mp4', 'render/job-42-en-branded.mp4', 'render/job-42-hi-edition.mp4',
+        'render/job-42-or-edition.mp4', 'language_editions/stamp-1/exports/hi-stamp-1.mp4',
+        'language_editions/stamp-1/exports/or-stamp-1.mp4'}
+    freed = {f['path'] for f in plan['files']}
+    assert 'flow/shots/shot_001/take_01.mp4' in freed and 'downloads/raw.png' in freed
+    assert not any(p.startswith(('render/job-42', 'language_editions/')) for p in freed)
+
+
+def test_apply_with_keep_dir_copies_every_video_verified_then_cleans(tmp_path):
+    job = _job(tmp_path)
+    plan = pjc.plan_job(job, validate_final=_valid)
+    keep = tmp_path / 'ready'
+    report = pjc.apply_plan(job, plan['digest'], validate_final=_valid, keep_video_dir=str(keep))
+    names = sorted(p.name for p in keep.iterdir())
+    assert names == ['hi-stamp-1.mp4', 'job-42-en-branded.mp4', 'job-42-final.mp4',
+                     'job-42-hi-edition.mp4', 'job-42-or-edition.mp4', 'or-stamp-1.mp4']
+    assert (keep / 'job-42-final.mp4').read_bytes() == b'final-video'
+    assert len(report['exported_videos']) == 6
+    assert not (job / 'flow' / 'shots' / 'shot_001' / 'take_01.mp4').exists()
+    assert (job / 'render' / 'job-42-final.mp4').is_file()  # the in-job videos are kept too
+
+
+def test_keep_dir_inside_job_is_refused_and_nothing_is_deleted(tmp_path):
+    job = _job(tmp_path)
+    plan = pjc.plan_job(job, validate_final=_valid)
+    with pytest.raises(ValueError, match='outside the job'):
+        pjc.apply_plan(job, plan['digest'], validate_final=_valid, keep_video_dir=str(job / 'copies'))
+    assert (job / 'flow' / 'shots' / 'shot_001' / 'take_01.mp4').exists()
