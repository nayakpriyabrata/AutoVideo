+GEMINI_PROFILE_ENV = re.compile(r"^GEMINI_API_KEY_([A-Z0-9_]+)$")
+
+
+def gemini_chunk_chars() -> int:
+    """Narration part size in characters, read from .env at call time (7.0.82)."""
+    try:
+        value = int(str(os.getenv("GEMINI_TTS_CHUNK_CHARS", "")).strip() or GEMINI_TTS_CHUNK_CHARS)
+    except ValueError:
+        value = GEMINI_TTS_CHUNK_CHARS
+    return min(max(value, 500), 6000)
+
+
+def gemini_key_profiles() -> list[str]:
+    """Key profiles configured in .env (7.0.82). Names only; key values are never returned.
+
+    ``GEMINI_API_KEY`` is the profile ``default``. ``GEMINI_API_KEY_<NAME>`` is the profile ``<name>``.
+    Every profile should belong to a Google project you own and pay for. Two free-tier projects do not
+    add quota together; the daily limit is per project and per model.
+    """
+    names = []
+    if str(os.getenv("GEMINI_API_KEY", "")).strip():
+        names.append("default")
+    for variable, value in os.environ.items():
+        match = GEMINI_PROFILE_ENV.match(variable)
+        if match and str(value).strip():
+            names.append(match.group(1).lower())
+    return names
+
+
+def gemini_api_key(profile: str = "default") -> str:
+    profile = str(profile or "default").strip().lower()
+    variable = "GEMINI_API_KEY" if profile == "default" else f"GEMINI_API_KEY_{profile.upper()}"
+    key = str(os.getenv(variable, "")).strip()
+    if not key:
+        raise RuntimeError(
+            f"{variable} is not configured. Add it to .env (key profile '{profile}'), or choose another "
+            "Gemini key profile. Run 'python3 cli.py v3 env-doctor' to check which .env file was loaded.")
+    return key
+
+
+def split_route(provider) -> tuple[str, str]:
+    """'gemini@paid' -> ('gemini', 'paid'); 'gemini' -> ('gemini', ''); None -> ('auto', '')."""
+    text = str(provider or "auto").strip().lower() or "auto"
+    base, _, profile = text.partition("@")
+    return base.strip() or "auto", profile.strip()
+
+
+def provider_for_language(provider, language: str) -> str:
+    """A batch provider is a string, or a dict such as {'default': 'auto', 'or': 'gemini-lite@paid'} (7.0.82)."""
+    if isinstance(provider, dict):
+        from ..languages import language_pack
+        code = language_pack(language).code
+        return str(provider.get(code) or provider.get("default") or "auto")
+    return str(provider or "auto")
+
+
+def split_speech_text(text: str, limit=None) -> list[str]:
     """Split narration into parts of at most ``limit`` characters, on sentence ends where possible.
 
     Sentence ends include the Devanagari/Odia danda (।) and the double danda (॥).
     """
+    limit = int(limit or gemini_chunk_chars())
     sentences = [s.strip() for s in re.split(r"(?<=[.!?।॥])\s+", str(text or "").strip()) if s.strip()]
     parts: list[str] = []
     current = ""
