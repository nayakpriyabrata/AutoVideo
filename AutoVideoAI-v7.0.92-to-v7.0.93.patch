 def generate(provider, shot, compiled, output, vertical, request_hash):
+    """Image generation with fresh requests. Only a saved request with no output is ever replaced, and only up to
+    FRESH_IMAGE_REQUESTS submissions per shot. Two real outputs, and video requests, are never resubmitted here."""
+    from .providers.flow_browser import FlowRequestPending
+    output = Path(output)
+    while True:
+        try:
+            return _generate_once(provider, shot, compiled, output, vertical, request_hash)
+        except FlowRequestPending as error:
+            if not getattr(error, 'fresh_request_allowed', False):
+                raise
+            used = fresh_request_count(output)
+            if used + 1 >= FRESH_IMAGE_REQUESTS:
+                raise FlowRequestPending(str(error) + f' Automatic fresh image requests stopped after {used + 1} '
+                                         'submission(s); review the saved Flow project before any further action.') from error
+            archived = archive_saved_request(output)
+            print(f'[Flow] {output.name}: the saved image request produced no image. Submitting a fresh free image '
+                  f'request ({used + 2} of {FRESH_IMAGE_REQUESTS}); the old request is kept as {archived.name}.')
+
+
