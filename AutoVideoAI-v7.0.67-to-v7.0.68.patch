+def _json_snapshot(path, folder, kind):
+    """Immutable copy of reviewed word timings; verified like every other asset."""
+    path = Path(path).expanduser().resolve(strict=True)
+    if not path.is_file() or path.is_symlink():
+        raise ValueError('Invalid ' + kind + ' file')
+    sha = _hash(path)
+    folder = Path(folder); folder.mkdir(parents=True, exist_ok=True)
+    dest = folder / (kind + '-' + sha[:20] + '.json')
+    if not dest.exists():
+        tmp = dest.with_name('.' + dest.name + '-' + uuid.uuid4().hex)
+        shutil.copyfile(path, tmp)
+        os.replace(tmp, dest)
+    return {'path': str(dest.resolve()), 'sha256': sha, 'duration': 0}
