+#!/usr/bin/env python3
+"""Apply the v7.0.97 update to a v7.0.96 installation.
+
+- Every image recovery wait is 60 s instead of 360 s, saved per job as
+  ``flow_image_wait_seconds`` (``cli.py v3 resume <job> --flow-image-wait-seconds 120``);
+- a completed job can be deleted again: the finished video is found wherever the renderer
+  wrote it (``<job>-final.mp4``, ``<job>-final-broll.mp4`` for video cutaways, a saved
+  ``final_path``), the preview names the file and why others were rejected, and a completed job
+  with no finished video can be removed with an explicit tick. Unfinished jobs and unresolved
+  Flow requests are still refused;
+- Settings gains "Clip Studio content · disk cleanup": per-folder preview and category-by-category
+  removal of ``_clip_work``, ``.clip-render-jobs``, ``clip-history``, the selection reviews and
+  (only with its own tick) the rendered clips. A running clip render is never touched;
+- the Queue "Speech batches" panel shows the batch saved with the Active job, and keeps every other
+  Create step 4 batch in a collapsed folder instead of mixing them together.
+
+Nothing is generated, rendered or charged by this update itself.
+
+Usage (run from the existing installation folder, after extracting the 7.0.97 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.97/tools/update_v796_to_v797.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.97/tools/update_v796_to_v797.py . --apply    # installs the code
+
+Only code and documentation are replaced. Outputs, saved jobs, browser profiles, Clip Studio
+folders, music, characters and channel profiles are never copied, moved or deleted.
+Stop the dashboard before --apply.
+"""
+
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = ['RESUME_WAIT_DELETE_AND_CLEANUP_V7_0_97.md', 'VERSION', 'app.py', 'cli.py',
+           'engine/clip_cleanup.py', 'engine/factory.py', 'engine/flow_image_transaction.py',
+           'engine/flow_resume_recovery.py', 'engine/isolated_frame_regeneration.py',
+           'engine/job_cleanup.py', 'engine/job_delete.py', 'engine/providers/flow_browser.py',
+           'engine/speech_batches.py', 'engine/studio_config.py',
+           'tests/test_v797_cleanup_and_waits.py', 'tools/update_v796_to_v797.py']
+# Files as they exist in 7.0.96: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['859b7073e55acb507aaba170db0606fbd287fed8a3d94d8963ec24e01c53734b'],
+    'app.py': ['e6c9bda58d50e937132aa425db500ababe9ac8b3cbfbedc0761949eed76b5be1'],
+    'cli.py': ['ea28212e631eb37e433e347eecf88a4bd8e1797a4516ea0fcb44e659618d8544'],
+    'engine/factory.py': ['2ad1193e341206c972fcb88d7b2f9ea59ab74edb8687292f2d1dd399519fb671'],
+    'engine/flow_image_transaction.py': ['cb2be5f41239943c324af4e8f5ea0170862738ffcd450e98bd2f411aeb27a173'],
+    'engine/flow_resume_recovery.py': ['693db8bf0f7c4caf9df852a8cedff48651468d92257ff10a775242fc863417af'],
+    'engine/isolated_frame_regeneration.py': ['a717b4fd7ec30958ca072d29824af98a569dd25db7ba108bbd4f265b32b82274'],
+    'engine/job_cleanup.py': ['439559ce84e5a3dd1521da636e52f3d57c177f303885ce143673435b5256f1f8'],
+    'engine/job_delete.py': ['d32bdf14f8b1fcbe1f0898c457432a1ae4e040bd3b6b712e35d9287fee95ccfe'],
+    'engine/providers/flow_browser.py': ['c47af6ebab6a93e449d284132f260e75280b7f20bac5af537c1299d04ec8db71'],
+    'engine/speech_batches.py': ['7e5a1d375ef1a7fd64ace3c0f9444d16ca5fff366991d91cb7406d1309c7a0f2'],
+    'engine/studio_config.py': ['e0c7473f2f1e0e32b012fb1dc3182c8988921b9220dc9bd3459ec556b8ceb064'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.96', '7.0.97')  # 7.0.97 allows a safe re-run after success
+
+# The 7.0.96 to 7.0.97 update ships in the 7.0.97 zip. Apply it first on an older installation.
+EARLIER_STEPS = [
+    ('7.0.95', '7.0.96', 'tools/update_v795_to_v796.py'),
+]
+
+
+def chain_message(current):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.96 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.96 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.96 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this 7.0.97 update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current))
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the 7.0.97 folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        if destination.exists() and sha(destination) not in ALLOWED.get(name, []) + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+    plan = {'target': str(target), 'installed_version': current, 'apply': args.apply,
+            'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every 7.0.97 code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v7.0.96-to-v7.0.97-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to 7.0.97. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat).')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
+        raise SystemExit(1)
