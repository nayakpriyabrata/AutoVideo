+        url="https://www.scottbuckley.com.au/library/echoes/",
+        search="Scott Buckley Echoes", themes=["cinematic", "calm"], tempo="slow",
+        video_types=["documentary", "motivation"],
+        notes="Solo cello and strings; builds after 3 minutes, so use its first half as a bed.",
+    ),
+    _track(
+        id="buckley-midvinter", title="Midvinter", artist="Scott Buckley",
+        platform="scottbuckley.com.au", licence="CC BY 4.0", attribution="required",
+        credit="'Midvinter' by Scott Buckley - released under CC-BY 4.0. www.scottbuckley.com.au",
+        url="https://www.scottbuckley.com.au/library/midvinter/",
+        search="Scott Buckley Midvinter", themes=["calm"], tempo="slow",
+        video_types=["education", "kids"],
+        notes="Simple piano lullaby. The gentlest entry here; use at low volume under meditation content.",
+    ),
+]
+
+# Where to get more, and what the licence really allows. Re-check each page before publishing.
+SAFE_SOURCES = [
+    {"name": "YouTube Audio Library", "url": "https://support.google.com/youtube/answer/3376882?hl=en",
+     "licence": "YouTube Audio Library license, or CC BY 4.0 for tracks marked 'Attribution required'",
+     "attribution": "Depends on the track: filter 'Attribution not required' to skip credits",
+     "content_id": "No Content ID claims for tracks downloaded from the Audio Library",
+     "notes": "Safest option for a YouTube-first channel: lives in YouTube Studio, downloadable as MP3, "
+              "filterable by mood and by attribution. The copyright-safe promise is YouTube-only."},
+    {"name": "Pixabay Music", "url": "https://pixabay.com/music/",
+     "licence": "Pixabay Content License (content from before 2019 is CC0)",
+     "attribution": "Not required", "content_id": "Some tracks are Content ID registered (shield icon)",
+     "notes": "Largest free library with no credit line needed. Download the MP3 and keep the track page; "
+              "avoid tracks with the Content ID shield for monetised videos. Do not resell tracks as files."},
+    {"name": "Scott Buckley (CC BY 4.0)", "url": "https://www.scottbuckley.com.au/library/",
+     "licence": "CC BY 4.0", "attribution": "Required in the video description, in the exact published form",
+     "content_id": "Registered with a claim-release process tied to the credit line",
+     "notes": "Cinematic and neoclassical tracks that sound expensive. Paste the credit text verbatim or you "
+              "will get a claim. See https://www.scottbuckley.com.au/library/using-this-music/."},
+    {"name": "Free Music Archive", "url": "https://freemusicarchive.org/",
+     "licence": "Per track: CC0, CC BY, CC BY-SA (never use NC/ND for monetised work)",
+     "attribution": "Depends on the track; filter to CC0 for no-credit use",
+     "content_id": "Varies by artist", "notes": "Where Monplaisir's CC0 catalogue lives."},
+    {"name": "Incompetech / Kevin MacLeod", "url": "https://incompetech.com/music/royalty-free/music.html",
+     "licence": "CC BY 4.0 (older tracks CC BY 3.0)",
+     "attribution": "Required", "content_id": "Some tracks are claimed; the site publishes the credit format",
+     "notes": "Huge, well-known catalogue at every mood; the credit format on each track page must be copied."},
+]
+
+
+def recommend(content_type="", themes=None, limit=8):
+    """Tracks suited to a video type and/or theme tags, best first."""
+    kind = str(content_type or "").strip().lower()
+    wanted = {str(theme).strip().lower() for theme in (themes or []) if str(theme).strip()}
+    scored = []
+    for index, track in enumerate(CATALOGUE):
+        score = 0
+        if kind and kind in track["video_types"]:
+            score += 3
+        score += 2 * len(wanted & set(track["themes"]))
+        if track["attribution"] == "none":
+            score += 1  # fewer obligations is a feature for a channel that reuses tracks
+        if score:
+            scored.append((score, index, track))
+    scored.sort(key=lambda row: (-row[0], row[1]))
+    return [track for _, _, track in scored[:max(1, int(limit))]]
+
+
+def credit_block(tracks):
+    """The description block for every track that needs one; empty when none do."""
+    lines = [track["credit"] for track in tracks or [] if track.get("attribution") == "required" and track.get("credit")]
+    if not lines:
+        return ""
+    return "Music:\n" + "\n".join(lines)
+
+
+def theme_tags(content_type="", tracks=None, limit=3):
+    """The library tags to attach when importing a track for this kind of video.
+
+    Only the themes of the recommended tracks, most common first, so the advice is
+    "tag it calm or motivation" rather than the whole vocabulary.
+    """
+    rows = tracks if tracks is not None else recommend(content_type, limit=6)
+    counts = {}
+    for track in rows:
+        for theme in track["themes"]:
+            counts[theme] = counts.get(theme, 0) + 1
+    ranked = sorted(counts, key=lambda theme: (-counts[theme], theme))
+    return ranked[:max(1, int(limit))] or ["calm"]
