+def test_an_unfinished_job_is_never_deletable_even_with_the_override(outputs, no_ffprobe):
+    job = outputs / 'job-paused'
+    job.mkdir()
+    (job / 'production_manifest.json').write_text(json.dumps({'status': 'paused'}))
+    preview = completed_job_delete(outputs, outputs.parent / 'jobs.db', job.name, allow_missing_final=True)
+    assert preview['eligible'] is False
+    assert preview['reason_code'] == 'unfinished'
