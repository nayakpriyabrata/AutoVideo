+    kept = resolve(cards, report=report)
+    assert [card['title'] for card in kept] == ['first', 'third']
+    assert report['considered'] == 3 and report['dropped_count'] == 1
+    assert report['dropped'][0]['text'] == 'second'
+    assert report['dropped'][0]['kept'] == 'first'
+    assert report['dropped'][0]['would_share_seconds'] == 1.4
