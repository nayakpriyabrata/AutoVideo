+def test_an_educational_series_and_a_single_card_cannot_share_the_screen():
+    from engine import finishing_studio as finish
+    overlays = [{'kind': 'points', 'start': 2.0, 'end': 9.0, 'title': 'series', 'path': 'a.png'},
+                {'kind': 'takeaway', 'start': 3.5, 'end': 6.0, 'title': 'single', 'path': 'b.png'},
+                {'kind': 'hook', 'start': 3.0, 'end': 4.0, 'title': 'hook', 'path': 'c.png'}]
+    report = {}
+    legacy, kept = finish._one_card_at_a_time([], overlays, report=report)
+    kinds = [event['kind'] for event in kept]
+    assert kinds.count('points') == 1 and 'hook' in kinds          # the hook is untouched
+    assert 'takeaway' not in kinds                                  # the single card gave way
