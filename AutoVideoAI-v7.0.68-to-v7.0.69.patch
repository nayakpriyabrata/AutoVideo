+"""v7.0.69 Create form: channel name and logo come from profiles when they exist."""
+from engine.channel_branding import branding_plan, save_missing_profiles
+
+
+def test_complete_when_every_selected_edition_has_a_profile():
+    plan = branding_plan(['en', 'hi', 'or'], {'en': 'a', 'hi': 'b', 'or': 'c'}, 'en')
+    assert plan == {'complete': True, 'primary_missing': False, 'inline': []}
+
+
+def test_missing_extra_edition_is_asked_inline_and_primary_is_untouched():
+    plan = branding_plan(['en', 'hi', 'or'], {'en': 'a'}, 'en')
+    assert plan['complete'] is False
+    assert plan['primary_missing'] is False
+    assert plan['inline'] == ['hi', 'or']
+
+
+def test_missing_primary_keeps_the_single_channel_fields():
+    plan = branding_plan(['en', 'hi'], {'hi': 'b'}, 'en')
+    assert plan['primary_missing'] is True
+    assert plan['inline'] == []
+
+
+def test_single_language_without_profile_asks_the_primary_fields():
+    plan = branding_plan([], {}, 'hi')
+    assert plan == {'complete': False, 'primary_missing': True, 'inline': []}
+
+
+def test_save_missing_profiles_skips_blank_names_and_passes_logo():
+    saved_calls = []
+    uploads = []
+
+    def fake_save(name, *, names, logo):
+        saved_calls.append((name, names, logo))
+        return f'/profiles/{name}/profile.json'
+
+    def fake_upload(uploaded, kind):
+        uploads.append((uploaded, kind))
+        return f'/logos/{uploaded}' if uploaded else ''
+
+    result = save_missing_profiles({'hi': ('  Hunar Setu  ', 'logo-hi.png'), 'or': ('', 'logo-or.png'),
+                                    'de': ('Kanal', None)}, fake_save, fake_upload)
+    assert result == {'hi': '/profiles/Hunar Setu/profile.json', 'de': '/profiles/Kanal/profile.json'}
+    assert saved_calls[0] == ('Hunar Setu', {'hi': 'Hunar Setu'}, '/logos/logo-hi.png')
+    assert saved_calls[1] == ('Kanal', {'de': 'Kanal'}, '')
+    assert ('logo-or.png', 'logo') not in uploads  # blank name: nothing is uploaded or saved
+
+
+def test_inline_profile_is_a_real_profile_read_back_for_its_edition(tmp_path):
+    from engine.finishing_studio import save_profile
+    path = save_missing_profiles({'or': ('Gyana Patha', None)},
+                                 lambda name, **kw: save_profile(name, root=tmp_path, **kw),
+                                 lambda uploaded, kind: '')['or']
+    import json
+    data = json.loads(open(path, encoding='utf-8').read())
+    assert data['names']['or'] == 'Gyana Patha'
+    assert data['name'] == 'Gyana Patha'
+
+
+def _create_page(tmp_path, monkeypatch):
+    from pathlib import Path
+    from streamlit.testing.v1 import AppTest
+    import engine.factory as module
+    import engine.finishing_studio as fs
+    import engine.project.database as database
+    from engine.factory import Factory
+    shared = tmp_path / 'shared'
+    monkeypatch.setattr(fs, 'shared_root', lambda: shared)
+    f = Factory(str(tmp_path / 'outputs'), str(tmp_path / 'db.sqlite'))
+    monkeypatch.setattr(module, 'Factory', lambda *a, **k: f)
+    monkeypatch.setattr(database, 'JobDB', lambda *a, **k: f.db)
+    profiles = {
+        'en': fs.save_profile('Hunar Setu', names={'en': 'Hunar Setu'}, root=shared / 'channel_profiles'),
+        'hi': fs.save_profile('Hunar Setu HI', names={'hi': 'हुनर सेतु'}, root=shared / 'channel_profiles'),
+    }
+    app = AppTest.from_file(str(Path(__file__).resolve().parents[1] / 'app.py'), default_timeout=60).run()
+    next(w for w in app.sidebar.selectbox if w.label == 'Workspace').set_value('Create').run()
+    next(r for r in app.sidebar.radio if r.label == 'Page').set_value('STUDIO').run()
+    assert not app.exception, [e.message for e in app.exception]
+    return app, profiles
+
+
+def _labels(app):
+    return [t.label for t in app.text_input]
+
+
+def test_create_page_asks_for_channel_only_where_no_profile_exists(tmp_path, monkeypatch):
+    app, profiles = _create_page(tmp_path, monkeypatch)
+    next(m for m in app.multiselect if m.label.startswith('Additional')).set_value(['hi']).run()
+    assert 'Channel name in Hindi' in _labels(app)          # no Hindi profile: ask here
+    assert 'Channel name' in _labels(app)                  # primary (English) has none either
+
+    next(s for s in app.selectbox if s.key == 'studio-edition-profile-en').set_value(str(profiles['en'])).run()
+    next(s for s in app.selectbox if s.key == 'studio-edition-profile-hi').set_value(str(profiles['hi'])).run()
+    assert not any(l in ('Channel name', 'Channel name in Hindi') for l in _labels(app))
+    assert any('come from the language profiles' in c.value for c in app.caption)
+
+    next(m for m in app.multiselect if m.label.startswith('Additional')).set_value(['hi', 'or']).run()
+    labels = _labels(app)
+    assert 'Channel name in Odia' in labels                # new edition without a profile
+    assert 'Channel name' not in labels and 'Channel name in Hindi' not in labels
