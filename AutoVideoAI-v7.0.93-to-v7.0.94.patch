+def approval_context(bridge, output, request):
+    """v7.0.94: image requests use the same credit approval guard as video.
+
+    The Flow approval probe refuses any card unless the bridge has a journal AND an outstanding request id.
+    Image submissions set the journal but never the request id, so every wait on that bridge ended at once,
+    silently (job 20261022-143856-7, 19:19-19:23 IST). The id here lets a card be checked against this journal;
+    max_generation_credits stays 0, so a paid card is refused and logged, and an unpriced card is never clicked.
+    """
+    bridge._approval_journal = str(journal_path(output))
+    bridge._approval_card_limit = 1
+    bridge._awaiting_request_id = 'image:' + str(request.get('request_hash') or journal_path(output).name)
+
+
+def sync_approval_reservations(output, request):
+    """Keep credit reservations written by the approval probe. Journal writes use the in-memory request, so
+    without this a later write would drop a reservation made during the wait and allow a second click."""
+    try:
+        disk = json.loads(journal_path(output).read_text(encoding='utf-8'))
+    except (OSError, ValueError):
+        return
+    if 'approval_reservations' in disk:
+        request['approval_reservations'] = disk['approval_reservations']
+        request['approval_credit_total_reserved'] = disk.get('approval_credit_total_reserved', 0)
+
