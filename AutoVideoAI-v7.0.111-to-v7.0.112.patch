diff --git a/tests/test_v7112_card_band_and_picture_check.py b/tests/test_v7112_card_band_and_picture_check.py
new file mode 100644
index 0000000..f2f7398
--- /dev/null
+++ b/tests/test_v7112_card_band_and_picture_check.py
@@ -0,0 +1,247 @@
+"""v7.0.112: one card band and one card style for every language, and a picture check on the render.
+
+Field report, with a screenshot: the English card covered the presenter's face while the Hindi and Odia cards did
+not, and the English card looked better than theirs.
+
+Both came from two different code paths:
+
+* the English master drew its keypoint card at 12 % of the height - a top card, over the face;
+* the language editions drew a hand-rolled navy panel at 72 % - a different look entirely.
+
+The promises these tests hold, in order:
+
+1. a card never starts in the face zone (the top half of the frame) and never reaches the burned captions;
+2. the same card lands in the same place, with the same style, in English, Hindi and Odia;
+3. the render itself is checked against the picture, not only against the plan.
+"""
+import json
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+needs_ffmpeg = pytest.mark.skipif(not (shutil.which('ffmpeg') and shutil.which('ffprobe')),
+                                  reason='FFmpeg required')
+os.environ.setdefault('HOME', '/tmp')
+TEXT = 'Keep shoulders back and spine straight to signal confidence'
+
+
+# --------------------------------------------------------------------------- where a card may sit
+
+
+@pytest.mark.parametrize('width,height', [(1920, 1080), (1080, 1920), (1280, 720), (720, 1280)])
+def test_a_card_never_starts_on_the_face(width, height):
+    from engine.render.card_band import FACE_ZONE, band
+    top, _bottom = band(width, height)
+    face = FACE_ZONE['portrait' if height > width else 'landscape']
+    assert top >= height * face - 1, 'the card band must start below the face zone'
+
+
+@pytest.mark.parametrize('width,height', [(1920, 1080), (1080, 1920)])
+def test_a_card_never_reaches_the_burned_captions(width, height):
+    from engine.render.card_band import band
+    from engine.render.captions_ass import caption_block_top
+    aspect = '9:16' if height > width else '16:9'
+    top, bottom = band(width, height, captions=True)
+    assert bottom <= caption_block_top(width, height, aspect=aspect,
+                                       template='OPUS' if height > width else 'HORMOZI')
+
+
+def test_the_card_band_is_centred_and_not_a_strip_at_the_top():
+    from engine.render.card_band import band, safe_top
+    width, height = 1920, 1080
+    top, bottom = band(width, height)
+    panel = 200
+    placed = safe_top(width, height, panel)
+    assert top <= placed <= bottom - panel + 1
+    # centred inside the band, within a pixel
+    assert abs((placed - top) - ((bottom - panel) - placed)) <= 1
+    assert placed > height * 0.39
+
+
+def test_a_short_frame_still_gets_a_usable_band():
+    from engine.render.card_band import band
+    top, bottom = band(640, 360)
+    assert 0 < top < bottom <= 360 and bottom - top >= 360 * 0.10
+
+
+def test_the_band_is_described_for_a_log():
+    from engine.render.card_band import describe
+    sentence = describe(1920, 1080, 300)
+    assert 'landscape' in sentence and 'px' in sentence and 'cards sit between' in sentence
+
+
+# --------------------------------------------------------------------------- one card, every language
+
+
+@pytest.mark.parametrize('width,height', [(1920, 1080), (1080, 1920)])
+@pytest.mark.parametrize('style', ['playful', 'bold'])
+def test_the_english_card_and_an_edition_card_are_the_same_card(tmp_path, width, height, style):
+    """Same renderer, same style, same position - the field report's "make Odia look like English"."""
+    from PIL import Image
+    from engine.render.graphics import OverlayEvent, render_overlay_png
+    from engine.finishing_studio import _card_image
+    english = tmp_path / 'english.png'
+    render_overlay_png(OverlayEvent('keypoint', 0, 1, TEXT, anchor='top-left', layout={'captions': True}),
+                       str(english), width, height, style=style)
+    edition = tmp_path / 'edition.png'
+    _card_image(TEXT, width, height, edition, 'or', style=style, captions=True)
+    from engine.render.captions_ass import caption_block_top
+    from engine.render.card_band import FACE_ZONE
+    box_en, box_or = Image.open(english).getbbox(), Image.open(edition).getbbox()
+    assert box_en == box_or
+    face = FACE_ZONE['portrait' if height > width else 'landscape']
+    assert box_en[1] >= height * face - 6, 'the card must not start on the face'
+    captions = caption_block_top(width, height, aspect='9:16' if height > width else '16:9',
+                                 template='OPUS' if height > width else 'HORMOZI')
+    assert box_en[3] <= captions, 'the card must stay above the captions'
+
+
+def test_the_edition_uses_the_job_card_style_not_a_hard_coded_one(tmp_path):
+    from engine import finishing_studio as finish
+    (tmp_path / 'production').mkdir(parents=True)
+    (tmp_path / 'production' / 'publish_readiness.json').write_text(json.dumps({'text_card_style': 'clean'}),
+                                                                  encoding='utf-8')
+    assert finish._job_card_style(tmp_path) == 'clean'
+    # a saved language state wins over the readiness file, and an unknown value is ignored
+    assert finish._job_card_style(tmp_path, {'card_style': 'playful'}) == 'playful'
+    (tmp_path / 'production' / 'publish_readiness.json').write_text(json.dumps({'text_card_style': 'neon'}),
+                                                                  encoding='utf-8')
+    assert finish._job_card_style(tmp_path) == ''
+    assert finish._edition_card_style({'card_style': None, 'educational': True}) == 'playful'
+    assert finish._edition_card_style({'card_style': 'bold'}) == 'bold'
+
+
+def test_the_edition_card_is_drawn_by_the_shared_renderer(tmp_path):
+    """No hand-rolled panel: the edition uses the same card drawing code as the English master."""
+    from PIL import Image
+    from engine.finishing_studio import _card_image
+    path = tmp_path / 'card.png'
+    event = _card_image(TEXT, 1920, 1080, path, 'hi', style='playful', captions=True)
+    assert event.kind == 'keypoint' and event.layout['captions'] is True
+    image = Image.open(path)
+    assert image.size == (1920, 1080)
+    pixel = image.convert('RGB').getpixel((200, 620))       # inside the panel
+    assert pixel != (0, 0, 0), 'the panel is drawn, not an empty frame'
+
+
+def test_a_card_too_long_for_the_frame_names_the_card(tmp_path):
+    from engine.finishing_studio import _card_image
+    with pytest.raises(ValueError) as error:
+        _card_image(' '.join(['word'] * 120), 640, 360, tmp_path / 'x.png', 'or')
+    assert 'Card is too long for the frame' in str(error.value) and 'word word' in str(error.value)
+
+
+# --------------------------------------------------------------------------- the picture check
+
+
+def _video(tmp_path, with_text):
+    """A 4 s video; with_text burns white caption-like text into the caption band.
+
+    The text is drawn with Pillow (some FFmpeg builds here have no drawtext filter) and encoded with the same
+    encoder the renderer uses.
+    """
+    from PIL import Image, ImageDraw, ImageFont
+    frame = tmp_path / ('with.png' if with_text else 'plain.png')
+    image = Image.new('RGB', (640, 360), (32, 48, 64))
+    if with_text:
+        draw = ImageDraw.Draw(image)
+        try:
+            face = ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf', 40)
+        except OSError:
+            face = ImageFont.load_default()
+        draw.text((90, 300), 'captions burned here', font=face, fill=(255, 255, 255))
+    image.save(frame)
+    target = tmp_path / ('with.mp4' if with_text else 'without.mp4')
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-loop', '1', '-i', str(frame), '-t', '4',
+                    '-r', '24', '-c:v', 'libx264', '-pix_fmt', 'yuv420p', str(target)], check=True)
+    return target
+
+
+@needs_ffmpeg
+def test_the_picture_check_sees_a_burned_transcript(tmp_path):
+    from engine.render.caption_check import probe
+    drawn = probe(_video(tmp_path, True))
+    plain = probe(_video(tmp_path, False))
+    assert drawn['checked'] and plain['checked']
+    assert drawn['looks_like_text'] is True, drawn
+    assert plain['looks_like_text'] is False, plain
+    assert drawn['ratio'] > plain['ratio']
+    assert '%' in drawn['detail']
+
+
+@needs_ffmpeg
+def test_the_picture_check_can_disagree_with_the_job_and_says_so(tmp_path):
+    from engine.render.caption_check import explain, probe
+    result = probe(_video(tmp_path, True))
+    sentence = explain(result, expected=False)
+    assert 'although the job asks for no transcript' in sentence
+    assert explain(result, expected=True) == ''
+    plain = probe(_video(tmp_path, False))
+    # The other direction is deliberately silent: a caption is not on screen every second, so a handful of
+    # samples that find nothing cannot prove the transcript is missing.
+    assert explain(plain, expected=True) == ''
+    assert explain(plain, expected=False) == ''
+
+
+def test_an_unreadable_file_is_reported_not_guessed(tmp_path):
+    from engine.render.caption_check import probe
+    missing = probe(tmp_path / 'nope.mp4')
+    assert missing['checked'] is False and missing['looks_like_text'] is None
+    assert 'No file to check' in missing['detail']
+
+
+@needs_ffmpeg
+def test_a_render_records_what_the_picture_shows(tmp_path):
+    """The edition record now carries the picture check, so the panel can show it without re-reading the file."""
+    from engine import edition_files
+    from engine.language_editions import render_job_editions, set_transcript
+    job = _job(tmp_path)
+    first = render_job_editions(job)
+    assert first['status'] == 'exported', first
+    entry = json.loads((job / 'production' / 'language_editions_render.json').read_text())['editions']['or']
+    assert entry['captions_detected']['checked'] is True
+    assert entry['captions_detected']['looks_like_text'] is False
+    assert entry['captions_detected']['detail']
+
+    set_transcript(job, languages={'or': True})
+    render_job_editions(job)
+    entry = json.loads((job / 'production' / 'language_editions_render.json').read_text())['editions']['or']
+    assert entry['captions_detected']['looks_like_text'] is True
+    assert 'caption band' not in (entry.get('warning') or '')     # asked for, and it is there: no warning
+    listing = edition_files.report(job)
+    assert listing['editions']['or']['current']['captions_detected']['looks_like_text'] is True
+    assert 'picture check:' in '\n'.join(edition_files.format_report(listing))
+
+
+# --------------------------------------------------------------------------- supporting fixtures
+
+
+def _job(tmp_path):
+    from engine.production import digest
+    job = tmp_path / 'job'
+    (job / 'render').mkdir(parents=True)
+    (job / 'production').mkdir()
+    picture = job / 'render' / 'visual-master.mp4'
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i',
+                    'color=c=0x203040:size=640x360:rate=24:duration=6', '-c:v', 'libx264', '-pix_fmt', 'yuv420p',
+                    str(picture)], check=True)
+    (job / 'production' / 'visual_master.json').write_text(json.dumps(
+        {'path': str(picture), 'sha256': digest(picture), 'duration': 6.0}), encoding='utf-8')
+    folder = job / 'speech-editions' / 'or' / 'key'
+    folder.mkdir(parents=True)
+    voice = folder / 'voice.wav'
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i',
+                    'sine=frequency=700:sample_rate=44100', '-t', '6', '-c:a', 'pcm_s16le', str(voice)], check=True)
+    words = [{'word': 'ଶବ୍ଦ' + str(i), 'start': 0.3 + i * 0.6, 'end': 0.3 + i * 0.6 + 0.5} for i in range(9)]
+    (folder / 'words.json').write_text(json.dumps(words, ensure_ascii=False), encoding='utf-8')
+    bundle = {'audio': str(voice), 'audio_sha256': digest(voice), 'duration': 6.0,
+              'words': str(folder / 'words.json'), 'script': ' '.join(word['word'] for word in words),
+              'language': 'or', 'timing_source': 'test', 'cards': [], 'text_cards': False}
+    (job / 'production' / 'language_editions.json').write_text(json.dumps(
+        {'source_language': 'en', 'editions': ['en', 'or'], 'profiles': {'or': None},
+         'bundles': {'or': bundle}, 'transcript': {'default': False, 'languages': {}}}), encoding='utf-8')
+    return job
