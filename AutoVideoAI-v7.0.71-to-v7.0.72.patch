+"""v7.0.72 post-job cleanup: keep finished video and records, free regenerable media."""
+import json
+from pathlib import Path
+
+import pytest
+
+from engine import post_job_cleanup as pjc
+
+FINAL = 'job-final.mp4'
+
+
+def _job(root, status='done', pending=None, auto_state=None):
+    job = root / 'job-1'
+    (job / 'render').mkdir(parents=True)
+    (job / 'flow' / 'shots' / 'shot_001').mkdir(parents=True)
+    (job / 'downloads').mkdir()
+    (job / 'storyboard').mkdir()
+    (job / 'narration').mkdir()
+    (job / 'logs').mkdir()
+    (job / 'production_manifest.json').write_text(json.dumps({'status': status}))
+    (job / 'render' / FINAL).write_bytes(b'final-video')
+    (job / 'render' / 'render_stage_timings.json').write_text('{}')
+    (job / 'flow' / 'shots' / 'shot_001' / 'take_01.mp4').write_bytes(b'x' * 1000)
+    (job / 'flow' / 'shots' / 'shot_001' / 'take_01.mp4.flow-request.json').write_text(
+        json.dumps({'status': pending or 'downloaded'}))
+    (job / 'downloads' / 'raw.png').write_bytes(b'x' * 500)
+    (job / 'storyboard' / 'shot_001.jpg').write_bytes(b'x' * 200)
+    (job / 'narration' / 'voice.mp3').write_bytes(b'x' * 300)
+    (job / 'logs' / 'run.log').write_text('kept log')
+    if auto_state:
+        (job / 'auto_resume.json').write_text(json.dumps({'state': auto_state}))
+    bounded = job / 'render' / '.bounded-abc'
+    bounded.mkdir()
+    (bounded / 'cut_0000.mp4').write_bytes(b'x' * 50)
+    return job
+
+
+def _valid(path):
+    return Path(path).read_bytes() == b'final-video'
+
+
+def test_plan_keeps_final_and_records_and_frees_media(tmp_path):
+    job = _job(tmp_path)
+    plan = pjc.plan_job(job, validate_final=_valid)
+    assert plan['allowed'], plan['blocked']
+    assert plan['kept_videos'] == ['render/' + FINAL]
+    paths = {f['path'] for f in plan['files']}
+    assert 'flow/shots/shot_001/take_01.mp4' in paths
+    assert 'downloads/raw.png' in paths
+    assert 'storyboard/shot_001.jpg' in paths
+    assert 'narration/voice.mp3' in paths
+    assert 'render/.bounded-abc/cut_0000.mp4' in paths
+    assert not any(p.endswith(('.json', '.log')) for p in paths)
+    assert 'render/' + FINAL not in paths
+
+
+def test_apply_deletes_only_reviewed_media_and_writes_report(tmp_path):
+    job = _job(tmp_path)
+    plan = pjc.plan_job(job, validate_final=_valid)
+    result = pjc.apply_plan(job, plan['digest'], validate_final=_valid)
+    assert result['errors'] == []
+    assert result['freed_bytes'] == plan['reclaimable_bytes']
+    assert (job / 'render' / FINAL).read_bytes() == b'final-video'
+    assert (job / 'logs' / 'run.log').exists()
+    assert (job / 'flow' / 'shots' / 'shot_001' / 'take_01.mp4.flow-request.json').exists()
+    assert not (job / 'flow' / 'shots' / 'shot_001' / 'take_01.mp4').exists()
+    assert not (job / 'render' / '.bounded-abc').exists()
+    assert list((job / 'logs').glob('post_job_cleanup_*.json'))
+
+
+def test_stale_review_is_refused(tmp_path):
+    job = _job(tmp_path)
+    plan = pjc.plan_job(job, validate_final=_valid)
+    (job / 'downloads' / 'new.png').write_bytes(b'new')
+    with pytest.raises(ValueError, match='changed since the review'):
+        pjc.apply_plan(job, plan['digest'], validate_final=_valid)
+    assert (job / 'flow' / 'shots' / 'shot_001' / 'take_01.mp4').exists()
+
+
+def test_unfinished_job_is_blocked(tmp_path):
+    job = _job(tmp_path, status='running')
+    plan = pjc.plan_job(job, validate_final=_valid)
+    assert not plan['allowed']
+    with pytest.raises(ValueError, match='blocked'):
+        pjc.apply_plan(job, plan['digest'], validate_final=_valid)
+    assert (job / 'flow' / 'shots' / 'shot_001' / 'take_01.mp4').exists()
+
+
+def test_pending_flow_request_blocks_cleanup(tmp_path):
+    job = _job(tmp_path, pending='pending')
+    plan = pjc.plan_job(job, validate_final=_valid)
+    assert not plan['allowed']
+    assert any('Pending Flow request' in reason for reason in plan['blocked'])
+
+
+def test_active_auto_resume_blocks_cleanup(tmp_path):
+    job = _job(tmp_path, auto_state='waiting')
+    plan = pjc.plan_job(job, validate_final=_valid)
+    assert not plan['allowed']
+    assert any('automatic resume' in reason for reason in plan['blocked'])
+
+
+def test_missing_validated_final_blocks_cleanup(tmp_path):
+    job = _job(tmp_path)
+    plan = pjc.plan_job(job, validate_final=lambda _p: False)
+    assert not plan['allowed']
+    assert any('No validated final video' in reason for reason in plan['blocked'])
+
+
+def test_symlinks_are_never_followed_or_removed(tmp_path):
+    outside = tmp_path / 'approved_stock.mp4'
+    outside.write_bytes(b'stock-asset')
+    job = _job(tmp_path)
+    (job / 'stock').mkdir()
+    (job / 'stock' / 'link.mp4').symlink_to(outside)
+    plan = pjc.plan_job(job, validate_final=_valid)
+    assert 'stock/link.mp4' not in {f['path'] for f in plan['files']}
+    pjc.apply_plan(job, plan['digest'], validate_final=_valid)
+    assert outside.read_bytes() == b'stock-asset'
+
+
+def test_clip_folder_frees_source_work_and_keeps_outputs(tmp_path):
+    folder = tmp_path / 'clips'
+    work = folder / '_clip_work' / 'src1'
+    work.mkdir(parents=True)
+    (folder / 'highlights.json').write_text('{}')
+    (folder / 'headline_01.mp4').write_bytes(b'clip-output')
+    (folder / 'captions.srt').write_text('1')
+    (work / 'source.mp4').write_bytes(b'x' * 900)
+    (work / 'speech_001.mp3').write_bytes(b'x' * 100)
+    plan = pjc.plan_clip_folder(folder)
+    assert plan['allowed'], plan['blocked']
+    assert plan['kept_videos'] == ['headline_01.mp4']
+    result = pjc.apply_plan(folder, plan['digest'], kind='clip')
+    assert result['errors'] == []
+    assert (folder / 'headline_01.mp4').exists()
+    assert (folder / 'captions.srt').exists()
+    assert not (folder / '_clip_work').exists()
+
+
+def test_incomplete_clip_run_is_blocked(tmp_path):
+    folder = tmp_path / 'clips'
+    (folder / '_clip_work' / 'src1').mkdir(parents=True)
+    (folder / '_clip_work' / 'src1' / 'source.mp4').write_bytes(b'x')
+    plan = pjc.plan_clip_folder(folder)
+    assert not plan['allowed']
+    with pytest.raises(ValueError, match='blocked'):
+        pjc.apply_plan(folder, plan['digest'], kind='clip')
+    assert (folder / '_clip_work' / 'src1' / 'source.mp4').exists()
