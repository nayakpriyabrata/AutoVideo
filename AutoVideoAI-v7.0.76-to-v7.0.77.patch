+# ---------- unit: hook pill placement clears the channel badge ----------
+
+@pytest.mark.parametrize('width,height', [(1920, 1080), (1080, 1920)])
+def test_hook_pill_sits_below_the_channel_badge(tmp_path, width, height):
+    out = render_hook_png({'text': 'Why does your mind race?', 'start': 0, 'end': 3}, tmp_path / 'h.png', width, height)
+    scale = min(width, height) / 1080
+    badge_bottom = height * .035 + 80 * scale
+    assert out['box'][1] >= badge_bottom
