+#!/usr/bin/env python3
+"""Apply the v7.0.111 update to a v7.0.110 installation.
+
+One field report, and the answer to it:
+
+* **"The transcript is still there after I rendered again."** The render was right: the record and the new export
+  both said *no captions*. But every render deliberately keeps the earlier video, so the job held two Odia videos
+  with equally plausible names and nothing said which one was current - the old one, with the captions you had
+  switched off, still played as if it were the latest render.
+
+v7.0.111 makes the current file impossible to miss, in three places:
+
+1. ``python3 cli.py v3 language-outputs <job> --files`` lists, per language, the file to watch, the time it was
+   rendered, and **what that exact file burned** (read from the export's own provenance), plus every earlier file
+   marked *not current*, with its own caption state.
+2. The job panel plays the current export, labels it ("This is the current Odia video · without a burned
+   transcript · rendered ..."), warns when the copy in ``render/`` is not it, and lists the older videos it keeps.
+3. A plan built while captions were on can never re-burn them after the job switched them off: the job's setting
+   now wins over the plan, and the provenance records that the burn was suppressed and why.
+
+Every earlier video is still kept - that is deliberate, and never deleted. Nothing is generated, re-recorded or
+charged by this update.
+
+Usage (run from the existing installation folder, after extracting the 7.0.111 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.111/tools/update_v7110_to_v7111.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.111/tools/update_v7110_to_v7111.py . --apply    # installs the code
+
+Only code, documentation and tests are replaced. Outputs, saved jobs, Flow journals, browser profiles and
+``music_library/`` are never copied, moved or deleted. Stop the dashboard before --apply.
+"""
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = [
+    'VERSION', 'app.py', 'cli.py',
+    'engine/edition_files.py', 'engine/language_editions.py', 'engine/finishing_studio.py',
+    'tests/test_v7111_which_edition_file.py',
+    'WHICH_EDITION_FILE_V7_0_111.md', 'tools/update_v7110_to_v7111.py',
+]
+# Files as they exist in 7.0.110: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['6afcf447ffd309cd5ab86aa3dbcdc14f767e046e25ea354f5a8d49517c3b29db'],
+    'app.py': ['42ede10f240449fd1a9bde96cc4411a5cfa0b6169806429f2cfa0f438f1b8b94'],
+    'cli.py': ['dfabf2a5c37494bfe6f481b81ef782d3856a8959011869221a7aec7ee50ac97c'],
+    'engine/language_editions.py': ['6cacf22775c1cfd6972655aaad8c1f20fc67a2f3399941e5854a934a4ec31beb'],
+    'engine/finishing_studio.py': ['ac0fff94dfdca5191e2994af4f2a18365a145e158146421a495a247fef3a3879'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.110', '7.0.111')  # 7.0.111 allows a safe re-run after success
+
+# The 7.0.111 zip carries the 7.0.110 update; apply that first on an older installation.
+EARLIER_STEPS = [
+    ('7.0.109', '7.0.110', 'tools/update_v7109_to_v7110.py'),
+]
+
+
+def chain_message(current, version):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.110 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.110 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.110 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this ' + version + ' update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current, source.name or '7.0.111'))
+    new_version = (source / 'VERSION').read_text(encoding='utf-8').strip()
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the ' + new_version +
+                         ' folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        allowed = ALLOWED.get(name, [])
+        if destination.exists() and allowed and sha(destination) not in allowed + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+    plan = {'target': str(target), 'installed_version': current, 'new_version': new_version,
+            'apply': args.apply, 'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every ' + new_version + ' code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v' + current + '-to-v' + new_version + '-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to ' + new_version + '. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat).')
+        print('Nothing was re-rendered, no voice was re-recorded and no Flow credit was spent. To see which '
+              'language video is the current one: python3 cli.py v3 language-outputs <job> --files')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
+        raise SystemExit(1)
