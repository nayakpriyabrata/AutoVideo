+def cast_panel(job_id):
+    """Which saved character this video shows - and the one repair allowed before planning (v7.0.122).
+
+    A job made from a prepared narration batch held no cast at all, so its storyboard invented a new person
+    while the saved character sat unused in Character Library, and nothing on the page said so. This panel names
+    the cast in plain words and, while the job has no storyboard yet, lets the user set it: exactly the snapshots
+    Create writes, so the next Resume plans that character. Nothing is generated, recorded or spent here.
+    """
+    from engine.cast import job_cast, set_job_cast
+    from engine.content_library import CharacterLibrary
+    job_dir = F.pm.job_dir(job_id)
+    st.subheader('Cast · who appears in the video')
+    notice = st.session_state.pop('cast-notice', '')
+    if notice:
+        st.success(notice)
+    current = job_cast(job_dir)
+    if current:
+        photos = sum(len(row.get('references') or []) for row in current)
+        st.caption('This video shows ' + ', '.join(str(row.get('name') or row['id']) for row in current)
+                   + ' from Character Library, with ' + str(photos) + ' saved photo(s) copied into the job. '
+                   'Every generated shot is prompted with that identity.')
+    else:
+        st.warning('No saved character is set for this job, so its storyboard will invent a new person. If the '
+                   'video should show your character, set it here before you resume.')
+    try:
+        manifest = F.pm.load_manifest(job_id)
+    except Exception:
+        return
+    shots = list(getattr(manifest, 'shots', []) or [])
+    if shots:
+        if not current:
+            st.caption('This job already has its storyboard (' + str(len(shots)) + ' scene(s)), so its cast is '
+                       'fixed - the scenes were planned without one. Choose the character next time in '
+                       '“Run your prepared voices”, or in Create before you press GENERATE.')
+        return
+    saved = CharacterLibrary().list()
+    if not saved:
+        st.caption('Character Library is empty. Save a character identity there (photos + description) and it can '
+                   'be used by any video.')
+        return
+    from engine.job_monitor import is_running
+    known = {character['id']: character for character in saved}
+    remembered = [row['id'] for row in current if row['id'] in known]
+    chosen = st.multiselect('Character for this video · optional (up to three)', list(known), default=remembered,
+                            max_selections=3, key='job-cast-' + job_id,
+                            format_func=lambda identifier: known[identifier]['name'] + ' · ' + identifier,
+                            help='Saved in this job only. The next Resume plans the storyboard with this character '
+                                 'and every frame uses their saved photos. Creating the video still spends credits.')
+    running = is_running(job_dir)
+    if running:
+        st.caption('This job is running now. Stop it, save the cast, then resume so the storyboard is planned with it.')
+    if st.button('Save the cast for this job', key='job-cast-save-' + job_id, disabled=running):
+        try:
+            result = set_job_cast(job_dir, chosen)
+            st.session_state['cast-notice'] = (
+                'Saved. This job will plan its storyboard with ' + ', '.join(result['names'])
+                + '. Nothing was generated; press “Resume / continue job”.' if result['names'] else
+                'Cleared. This job will plan a new generic cast. Nothing was generated.')
+            st.rerun()
+        except Exception as error:
+            st.error(str(error))
+
