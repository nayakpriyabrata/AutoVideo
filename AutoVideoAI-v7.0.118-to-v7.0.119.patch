+def job_audio_shas(job_dir) -> set:
+    """Voice fingerprints a job already holds, read from its own saved snapshots (no hashing)."""
+    root = Path(job_dir)
+    shas = set()
+    for name, key in (('production/prepared_speech.json', None),
+                      ('production/language_editions.json', 'bundles')):
+        path = root / name
+        try:
+            data = json.loads(path.read_text(encoding='utf-8'))
+        except (OSError, ValueError):
+            continue
+        records = [data] if key is None else list((data.get(key) or {}).values())
+        for record in records:
+            if isinstance(record, dict) and record.get('audio_sha256'):
+                shas.add(str(record['audio_sha256']))
+    return shas
+
+
+def with_attachments(rows, job_dirs=()) -> list[dict]:
+    """Say which job (if any) already contains each batch's voices (v7.0.119).
+
+    A batch prepared in Create step 4 is *not* a job: until it is attached, there is nothing to Resume, and
+    its voices live only in the shared folder. The list used to leave that out entirely, so prepared narration
+    looked like a job that had lost its audio.
+    """
+    owners = {}
+    for job in job_dirs:
+        folder = Path(job)
+        if not folder.is_dir():
+            continue
+        for sha in job_audio_shas(folder):
+            owners.setdefault(sha, set()).add(folder.name)
+    rows = list(rows or [])
+    for row in rows:
+        attached = set()
+        for sha in row.get('audio_sha256') or set():
+            attached |= owners.get(sha, set())
+        row['attached_to'] = sorted(attached)
+        row['attached'] = bool(attached)
+    return rows
+
+
+def display_label(row, *, newest=False) -> str:
+    """One identifying line for a batch: time, topic, languages, state, and whether a job holds it."""
+    parts = [row.get('origin') or 'Create step 4', row.get('created') or 'time not recorded']
+    if row.get('topic'):
+        parts.append('"' + row['topic'][:60] + '"')
+    parts.append(', '.join(language_label(code) for code in row.get('editions') or []))
+    state = 'ready' if row.get('ready') else ('stopped' if row.get('error') else (row.get('phase') or 'pending'))
+    parts.append(state + ' · voices ' + str(len(row.get('done') or [])) + '/' + str(len(row.get('editions') or [])))
+    owner = row.get('origin') or ''
+    if row.get('attached'):
+        parts.append('voices in job ' + ', '.join(row['attached_to']))
+    elif owner.startswith('Job '):
+        # This batch lives inside that job already; only the copied voices are missing.
+        parts.append('saved in ' + owner[4:] + ' · voices not copied into the job yet')
+    else:
+        parts.append('not part of any job yet')
+    if newest:
+        parts.append('newest')
+    return ' · '.join(parts)
+
