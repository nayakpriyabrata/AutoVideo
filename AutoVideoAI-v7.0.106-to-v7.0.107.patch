--- a/engine/narration_fit.py
+++ b/engine/narration_fit.py
@@ -0,0 +1,140 @@
+"""v7.0.107: fit a longer reviewed narration onto the approved picture, and say exactly why if it cannot.
+
+Field case (job ``20261022-143856-7-small-daily-habits-tha-9729``, 2026-10-27): Hindi exported, Odia failed with
+
+    Odia narration is more than 25% longer than the approved picture. Shorten that language script,
+    review it, and prepare it again.
+
+That told nobody the actual numbers, and the only lever was "slow the picture by up to 25%" - so a perfectly
+good Odia narration that was 30% longer produced no video at all.
+
+Three bounded levers are available now, in this order:
+
+1. **picture**: slow the approved picture (`setpts`), up to ``max_picture_stretch`` (default 1.25x);
+2. **narration**: speed the reviewed narration with pitch-preserving ``atempo``, up to ``max_tempo``
+   (default 1.12x); card/caption word timings are divided by the same factor so they stay in sync;
+3. **hold** (opt-in): clone the last frame for the remaining seconds (``allow_hold``, capped by ``hold_cap``).
+
+Combined, 1.25 x 1.12 absorbs a narration up to 1.40x the picture. Beyond that the render is refused with the
+measurements, how much text to cut, and the exact flags that would accept it. This module is pure: no ffmpeg,
+no files, no browser - so the arithmetic is testable.
+"""
+from __future__ import annotations
+
+DEFAULT_MAX_PICTURE_STRETCH = 1.25
+DEFAULT_MAX_TEMPO = 1.12
+DEFAULT_HOLD_CAP = 20.0
+# Rough speaking rate used only to express an overflow as "about N words to cut".
+WORDS_PER_SECOND = 2.4
+
+
+def _positive(value, default):
+    try:
+        number = float(value)
+    except (TypeError, ValueError):
+        return float(default)
+    return number if number > 0 else float(default)
+
+
+def _policy(kwargs):
+    kwargs = kwargs or {}
+    return {
+        'max_picture_stretch': _positive(kwargs.get('max_picture_stretch'), DEFAULT_MAX_PICTURE_STRETCH),
+        'max_tempo': _positive(kwargs.get('max_tempo'), DEFAULT_MAX_TEMPO),
+        'allow_hold': bool(kwargs.get('allow_hold', False)),
+        'hold_cap': _positive(kwargs.get('hold_cap'), DEFAULT_HOLD_CAP),
+    }
+
+
+def plan(narration_seconds, picture_seconds, *, label='Narration', max_picture_stretch=None,
+         max_tempo=None, allow_hold=False, hold_cap=None) -> dict:
+    """Decide how a narration of ``narration_seconds`` fits a picture of ``picture_seconds``.
+
+    ``mode`` is ``none`` (no fit needed), ``fit`` (picture and/or narration are retimed), ``hold``
+    (retimed plus a cloned last frame) or ``refuse`` (nothing can be exported safely).
+
+    ``picture_scale`` multiplies the picture length, ``tempo`` multiplies the narration speed
+    (``atempo``), and ``hold_seconds`` is cloned onto the end of the picture.
+    """
+    policy = _policy({'max_picture_stretch': max_picture_stretch, 'max_tempo': max_tempo,
+                      'allow_hold': allow_hold, 'hold_cap': hold_cap})
+    max_stretch = policy['max_picture_stretch']
+    max_tempo = policy['max_tempo']
+    hold_cap = policy['hold_cap']
+    narration = float(narration_seconds or 0.0)
+    picture = float(picture_seconds or 0.0)
+    base = {'narration_seconds': round(narration, 3), 'picture_seconds': round(picture, 3),
+            'max_picture_stretch': max_stretch, 'max_tempo': max_tempo, 'allow_hold': policy['allow_hold'],
+            'hold_cap': hold_cap, 'picture_scale': 1.0, 'tempo': 1.0, 'hold_seconds': 0.0,
+            'ratio': round(narration / picture, 4) if picture > 0 else None,
+            'absorbable_ratio': round(max_stretch * max_tempo, 4), 'overflow_seconds': 0.0,
+            'words_to_cut': 0, 'fit_seconds': round(narration, 3), 'label': str(label or 'Narration')}
+    if picture <= 0 or narration <= picture + 0.25:
+        base.update(mode='none', message='')
+        return base
+
+    ratio = narration / picture
+    stretch = min(ratio, max_stretch)
+    tempo = ratio / stretch if stretch else ratio
+    if tempo <= max_tempo + 1e-9:
+        base.update(mode='fit', picture_scale=round(stretch, 6), tempo=round(min(tempo, max_tempo), 6),
+                    tempo_used=bool(tempo > 1.0001))
+        return base
+
+    absorbed = picture * max_stretch * max_tempo
+    overflow = max(0.0, narration - absorbed)
+    words = int(round(overflow * WORDS_PER_SECOND))
+    base.update(mode='refuse', picture_scale=max_stretch, tempo=max_tempo, hold_seconds=0.0,
+                overflow_seconds=round(overflow, 3), words_to_cut=words)
+    if policy['allow_hold'] and overflow <= hold_cap:
+        base.update(mode='hold', hold_seconds=round(overflow, 3), words_to_cut=0,
+                    message=(f"{base['label']} narration is {narration:.1f}s but the approved picture is "
+                             f"{picture:.1f}s ({ratio:.2f}x). The picture is slowed {max_stretch:.2f}x, the "
+                             f"narration sped {max_tempo:.2f}x, and the last frame is held for "
+                             f"{overflow:.1f}s at the end so the whole narration is heard."))
+        return base
+
+    needed_tempo = max_tempo + (overflow / (picture * max_stretch))
+    base['needed_tempo'] = round(needed_tempo, 3)
+    hold_hint = (f' or hold the last frame for {overflow:.0f}s with `--fit-hold {overflow:.0f}`'
+                 if not policy['allow_hold'] else f' (that is beyond the {hold_cap:g}s hold limit)')
+    base['message'] = (
+        f"{base['label']} narration is {narration:.1f}s but the approved picture is {picture:.1f}s "
+        f"({ratio:.2f}x) - more than 25% longer than the approved picture, so a video rendered from it would "
+        f"either cut the narration or freeze the picture. Slowing the picture {max_stretch:.2f}x and speeding "
+        f"the narration {max_tempo:.2f}x absorbs {base['absorbable_ratio']:.2f}x, which still leaves "
+        f"{overflow:.1f}s (about {words} spoken words) over. Nothing was exported. Fix one of these: shorten "
+        f"that language script by about {words} words and re-approve it; re-run with `--fit-max-tempo "
+        f"{needed_tempo:.2f}` to accept a faster narration;{hold_hint}; or trim the picture.")
+    return base
+
+
+def scale_words(words, tempo):
+    """Divide word timings by ``tempo`` so cards and captions follow the sped-up narration."""
+    tempo = float(tempo or 1.0)
+    if abs(tempo - 1.0) < 1e-6:
+        return [dict(word) for word in (words or [])]
+    scaled = []
+    for word in words or []:
+        row = dict(word)
+        for key in ('start', 'end'):
+            if isinstance(row.get(key), (int, float)):
+                row[key] = round(float(row[key]) / tempo, 3)
+        scaled.append(row)
+    return scaled
+
+
+def describe(report) -> str:
+    """One line for the log: what the fit did, with numbers."""
+    report = report or {}
+    mode = report.get('mode')
+    if mode == 'none':
+        return (f"No narration fit needed ({report.get('narration_seconds')}s narration, "
+                f"{report.get('picture_seconds')}s picture).")
+    if mode == 'fit':
+        return (f"Narration fit: picture x{report.get('picture_scale')} · narration x{report.get('tempo')} "
+                f"({report.get('narration_seconds')}s narration on {report.get('picture_seconds')}s picture).")
+    if mode == 'hold':
+        return (f"Narration fit: picture x{report.get('picture_scale')} · narration x{report.get('tempo')} · "
+                f"last frame held {report.get('hold_seconds')}s.")
+    return 'Narration fit refused: ' + str(report.get('message') or '')
--- a/engine/graphics_audit.py
+++ b/engine/graphics_audit.py
@@ -0,0 +1,216 @@
+"""Say plainly why on-screen cards or hooks did - or did not - appear (v7.0.107).
+
+Field report: cards were called "not good" and the pop-up card feature "not visible" in the finished
+video, and hooks were "missing", while the job log listed graphics. From the outside there was no way to
+tell whether cards were switched off, drafted but unused, dropped for overlapping, or lost in the render.
+
+Every render now writes ``production/graphics_audit.json``: what was asked for, what existed on disk, what
+was actually placed on the timeline, and - when the master exists - whether each card can be *seen* in the
+finished file (frame comparison, see ``engine/render/graphic_visibility.py``). The same report is printed by
+``python3 cli.py v3 graphics-audit <job>`` and summarised in the job warnings.
+
+This module is pure bookkeeping: it never renders and never fails a job.
+"""
+from __future__ import annotations
+
+import json
+import time
+from pathlib import Path
+
+SCHEMA = "graphics-audit-v1"
+
+
+def _read(path, default=None):
+    try:
+        path = Path(path)
+        if not path.is_file():
+            return default
+        return json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return default
+
+
+def plan_path(job_root):
+    """Where this job's overlay plan lives (job root, as the renderer writes it, or production/)."""
+    root = Path(job_root)
+    for candidate in (root / "graphics_plan.json", root / "production" / "graphics_plan.json"):
+        if candidate.is_file():
+            return candidate
+    return root / "graphics_plan.json"
+
+
+def _count(kind_map, key):
+    return int(kind_map.get(key, 0) or 0)
+
+
+def _prepared(job_root):
+    """What card/hook work already exists on disk before the render places anything."""
+    root = Path(job_root)
+    speech = _read(root / "production" / "speech_cards.json", {}) or {}
+    hooks = _read(root / "production" / "hooks.json", {}) or {}
+    return {
+        "speech_cards_file": (root / "production" / "speech_cards.json").is_file(),
+        "speech_cards_drafted": len(speech.get("cards") or []),
+        "speech_series_points": len(((speech.get("series") or {}).get("points")) or []),
+        "speech_cards_drafted_at": speech.get("created_at") or speech.get("drafted_at"),
+        "hooks_file": (root / "production" / "hooks.json").is_file(),
+        "hooks_drafted": len(hooks.get("hooks") or []),
+        "hooks_drafted_at": hooks.get("created_at") or hooks.get("drafted_at"),
+    }
+
+
+def _kinds(overlays):
+    counts: dict[str, int] = {}
+    for event in overlays or []:
+        kind = str((event or {}).get("kind") or "unknown")
+        counts[kind] = counts.get(kind, 0) + 1
+    return dict(sorted(counts.items()))
+
+
+def build_report(job_root, *, settings=None, overlays=None, errors=None, dropped_hooks=0,
+                 prepared=None, verified=None):
+    """Every fact needed to explain the on-screen graphics of one job."""
+    settings = settings or {}
+    overlays = list(overlays or [])
+    prepared = dict(prepared if prepared is not None else _prepared(job_root))
+    kinds = _kinds(overlays)
+    cards_on_timeline = sum(count for kind, count in kinds.items() if kind not in ("watermark", "hook"))
+    hooks_on_timeline = _count(kinds, "hook")
+    text_cards = bool(settings.get("text_cards_enabled", settings.get("text_cards", False)))
+    speech_cards = bool(settings.get("speech_cards_enabled", False))
+    hooks_enabled = bool(settings.get("hooks_enabled", False))
+    problems, notes = [], []
+
+    def problem(code, message, fix):
+        problems.append({"code": code, "message": message, "fix": fix})
+
+    def note(code, message, fix=""):
+        notes.append({"code": code, "message": message, "fix": fix})
+
+    if not text_cards:
+        problem("text_cards_off",
+                "Text cards were switched off for this job, so the video only carries the channel watermark.",
+                "Turn on 'Text cards / speech-timed cards' in Create (Finishing options) and render again.")
+    elif cards_on_timeline == 0:
+        problem("no_cards_placed",
+                "Text cards were requested but not one card reached the timeline.",
+                "Open production/graphics_audit.json for the drafting error, then Resume the job to rebuild cards.")
+    if not speech_cards and prepared.get("speech_cards_drafted"):
+        note("speech_cards_unused",
+             f"{prepared.get('speech_cards_drafted', 0)} reviewed speech cards were already prepared, but "
+             "'Use speech-timed Gemini cards' is off, so the automatic keypoint cards were used instead.",
+             "Tick 'Use speech-timed Gemini cards' to use the prepared cards, or delete "
+             "production/speech_cards.json to silence this note.")
+    if speech_cards and not prepared.get("speech_cards_drafted"):
+        problem("speech_cards_missing",
+                "Speech cards are enabled but production/speech_cards.json does not exist or has no cards.",
+                "Resume the job: the prepare stage drafts the cards before the render.")
+    if not hooks_enabled:
+        note("hooks_off",
+             "Hook pills were not requested for this job (the option is off by default).",
+             "Tick 'Add Gemini Web hooks' when creating the job, or set hooks_enabled and Resume.")
+    elif hooks_on_timeline == 0:
+        reason = "; ".join(f"{item.get('stage')}: {item.get('error')}" for item in (errors or [])
+                           if item.get("stage", "").startswith("hook"))
+        problem("hooks_not_placed",
+                "Hooks were requested but none reached the timeline."
+                + (f" Reason: {reason}" if reason else
+                   (f" {dropped_hooks} hook(s) were dropped for overlapping another card." if dropped_hooks
+                    else f" production/hooks.json holds {prepared.get('hooks_drafted', 0)} drafted hook(s).")),
+                "Resume the job to refresh hooks against the current narration, then render again.")
+    elif dropped_hooks:
+        note("hooks_dropped",
+             f"{dropped_hooks} hook(s) were dropped because they would have covered a card.",
+             "Re-draft hooks after the cards settle, or accept the remaining hooks.")
+    for item in errors or []:
+        problem(item.get("stage", "graphics_error"), str(item.get("error") or "")[:400],
+                "Fix that cause and Resume; the render continued without it.")
+    report = {
+        "schema": SCHEMA,
+        "checked_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "requested": {"text_cards": text_cards, "speech_cards": speech_cards, "hooks": hooks_enabled},
+        "prepared": prepared,
+        "on_timeline": {"total": len(overlays), "by_kind": kinds, "cards": cards_on_timeline,
+                        "hooks": hooks_on_timeline},
+        "problems": problems,
+        "notes": notes,
+        "verified_in_video": verified or {"checked": 0, "reason": "not_run"},
+    }
+    report["verdict"] = ("no_cards" if text_cards and cards_on_timeline == 0
+                         else "cards_placed" if cards_on_timeline
+                         else "off")
+    return report
+
+
+def write(job_root, report):
+    """Save the audit next to the plan; never raise into a render."""
+    path = Path(job_root) / "production" / "graphics_audit.json"
+    try:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(json.dumps(report, indent=2, ensure_ascii=False), encoding="utf-8")
+        return path
+    except OSError:
+        return None
+
+
+def warnings(report):
+    """Short lines for the job warnings list; problems first."""
+    lines = []
+    for item in report.get("problems") or []:
+        lines.append(f"On-screen graphics: {item['message']} Fix: {item['fix']}")
+    for item in report.get("notes") or []:
+        if item.get("code") in ("hooks_off", "speech_cards_unused"):
+            lines.append(f"On-screen graphics: {item['message']} {item.get('fix') or ''}".strip())
+    seen = report.get("verified_in_video") or {}
+    if seen.get("checked"):
+        missing = seen.get("missing") or []
+        if missing:
+            lines.append(
+                "On-screen graphics: " + str(len(missing)) + " card(s) could not be found in the finished "
+                f"video ({', '.join(missing[:4])}). See production/graphics_audit.json.")
+        else:
+            lines.append(f"On-screen graphics: all {seen['checked']} sampled card(s) are visible in the "
+                         "finished video.")
+    return lines
+
+
+def explain(job_root):
+    """The stored audit as readable text, rebuilt from the plan when the audit is missing."""
+    root = Path(job_root)
+    report = _read(root / "production" / "graphics_audit.json")
+    if not report:
+        overlays = _read(plan_path(root), []) or []
+        report = build_report(root, overlays=overlays)
+        report["source"] = "rebuilt from " + str(plan_path(root).relative_to(root)) + " (no audit was written)"
+    lines = []
+    requested = report.get("requested") or {}
+    timeline = report.get("on_timeline") or {}
+    prepared = report.get("prepared") or {}
+    lines.append("Graphics audit · job " + root.name)
+    if report.get("source"):
+        lines.append("  source: " + str(report["source"]))
+    lines.append("  requested: text cards " + ("on" if requested.get("text_cards") else "off")
+                 + " · speech cards " + ("on" if requested.get("speech_cards") else "off")
+                 + " · hooks " + ("on" if requested.get("hooks") else "off"))
+    lines.append(f"  prepared: {prepared.get('speech_cards_drafted', 0)} speech card(s), "
+                 f"{prepared.get('speech_series_points', 0)} series point(s), "
+                 f"{prepared.get('hooks_drafted', 0)} hook(s)")
+    kinds = ", ".join(f"{kind} x{count}" for kind, count in (timeline.get("by_kind") or {}).items()) or "none"
+    lines.append(f"  on the timeline: {timeline.get('total', 0)} overlay(s) · {kinds}")
+    for item in report.get("problems") or []:
+        lines.append(f"  PROBLEM [{item['code']}] {item['message']}")
+        if item.get("fix"):
+            lines.append(f"          fix: {item['fix']}")
+    for item in report.get("notes") or []:
+        lines.append(f"  note    [{item['code']}] {item['message']}")
+        if item.get("fix"):
+            lines.append(f"          fix: {item['fix']}")
+    seen = report.get("verified_in_video") or {}
+    if seen.get("checked"):
+        lines.append(f"  seen in the video: {seen['checked'] - len(seen.get('missing') or [])}"
+                     f"/{seen['checked']} sampled card(s)")
+        for name in seen.get("missing") or []:
+            lines.append(f"          missing at {name}")
+    elif seen.get("reason"):
+        lines.append("  seen in the video: not checked (" + str(seen["reason"]) + ")")
+    return "\n".join(lines)
--- a/engine/render/graphic_visibility.py
+++ b/engine/render/graphic_visibility.py
@@ -0,0 +1,121 @@
+"""Prove that a card really reached the finished video (v7.0.107).
+
+The plan says a card sits at 03:12 for four seconds; that does not prove a viewer sees it. Transport
+problems (a dropped overlay label, an edition render that ignores the overlay list, a card drawn in the
+wrong region) all look identical in the JSON and only differ in the file.
+
+This module samples the finished master: for each placed card it grabs the frame in the middle of the card
+and a control frame shortly before/after it, then compares the pixels of the card's own region. A card that
+is on screen changes those pixels measurably; a card that never rendered leaves them identical.
+
+Bounded by design: at most ``limit`` cards, two half-scale frames each, no audio, no re-encode.
+"""
+from __future__ import annotations
+
+import shutil
+import subprocess
+import tempfile
+from pathlib import Path
+
+VISIBLE_MEAN_DELTA = 3.0  # mean absolute difference (0-255) over the card region
+SKIP_KINDS = {"watermark"}
+
+
+def _tool(name):
+    from ..finishing_studio import _tool as resolve
+    return resolve(name)
+
+
+def _grab(video, when, target, width, height):
+    cmd = [_tool("ffmpeg"), "-y", "-hide_banner", "-loglevel", "error",
+           "-ss", f"{max(0.0, float(when)):.3f}", "-i", str(video), "-frames:v", "1", "-an",
+           "-vf", f"scale={width}:{height}", str(target)]
+    result = subprocess.run(cmd, capture_output=True, text=True)
+    return Path(target).is_file() and target.stat().st_size > 0 and result.returncode == 0
+
+
+def _region(box, width, height, full_w, full_h):
+    if not box or len(box) != 4:
+        return (0, 0, width, height)
+    scale_x, scale_y = width / float(full_w or width), height / float(full_h or height)
+    x, y, w, h = (float(v) for v in box)
+    left = max(0, min(width - 1, int(x * scale_x)))
+    top = max(0, min(height - 1, int(y * scale_y)))
+    right = max(left + 1, min(width, int((x + w) * scale_x)))
+    bottom = max(top + 1, min(height, int((y + h) * scale_y)))
+    return (left, top, right, bottom)
+
+
+def verify(video, overlays, *, limit=8, duration=None) -> dict:
+    """Return ``{'checked': n, 'missing': [...], 'per_overlay': [...], 'reason': ...}``."""
+    try:
+        from PIL import Image, ImageChops, ImageStat
+    except Exception as error:  # pragma: no cover - Pillow ships with the app
+        return {"checked": 0, "missing": [], "per_overlay": [], "reason": f"Pillow unavailable: {error}"}
+    video = Path(video)
+    if not video.is_file():
+        return {"checked": 0, "missing": [], "per_overlay": [], "reason": "no finished video to check"}
+    candidates = [e for e in (overlays or [])
+                  if str(e.get("kind")) not in SKIP_KINDS
+                  and isinstance(e.get("start"), (int, float)) and isinstance(e.get("end"), (int, float))
+                  and float(e["end"]) - float(e["start"]) >= 0.6]
+    if not candidates:
+        return {"checked": 0, "missing": [], "per_overlay": [], "reason": "nothing to check"}
+    candidates = candidates[:max(1, int(limit))]
+    try:
+        from ..finishing_studio import _probe
+        info, total = _probe(video)
+        stream = next((s for s in info["streams"] if s.get("codec_type") == "video"), {})
+        full_w, full_h = int(stream.get("width") or 0), int(stream.get("height") or 0)
+        total = float(duration or total)
+    except Exception:
+        full_w = full_h = 0
+        total = float(duration or 0)
+    if not full_w or not full_h:
+        return {"checked": 0, "missing": [], "per_overlay": [], "reason": "could not read the video size"}
+    width, height = max(160, full_w // 2), max(160, full_h // 2)
+    per_overlay, missing = [], []
+    folder = Path(tempfile.mkdtemp(prefix=".graphics-check-"))
+    try:
+        for index, event in enumerate(candidates):
+            start, end = float(event["start"]), float(event["end"])
+            if total and start >= total:
+                per_overlay.append({"kind": event.get("kind"), "start": round(start, 2),
+                                    "visible": False, "reason": "card starts after the end of the video"})
+                missing.append(f"{event.get('kind')} at {start:.1f}s (past the end)")
+                continue
+            mid = start + max(0.2, (end - start) / 2)
+            control = start - 0.6 if start > 0.8 else min(end + 0.6, (total or end + 0.6) - 0.05)
+            on_frame, off_frame = folder / f"{index}-on.png", folder / f"{index}-off.png"
+            if not (_grab(video, min(mid, max(0.0, (total or mid) - 0.05)), on_frame, width, height)
+                    and _grab(video, max(0.0, control), off_frame, width, height)):
+                per_overlay.append({"kind": event.get("kind"), "start": round(start, 2),
+                                    "visible": False, "reason": "frames could not be read"})
+                missing.append(f"{event.get('kind')} at {start:.1f}s (frames unreadable)")
+                continue
+            try:
+                with Image.open(on_frame) as first, Image.open(off_frame) as second:
+                    first = first.convert("RGB")
+                    second = second.convert("RGB")
+                    first = first.resize((width, height))
+                    second = second.resize((width, height))
+                    region = _region(event.get("box"), width, height, full_w, full_h)
+                    delta = ImageStat.Stat(ImageChops.difference(first.crop(region), second.crop(region))).mean
+                    score = sum(delta) / max(1, len(delta))
+            except Exception as error:
+                per_overlay.append({"kind": event.get("kind"), "start": round(start, 2),
+                                    "visible": False, "reason": f"frame compare failed: {error}"})
+                missing.append(f"{event.get('kind')} at {start:.1f}s (compare failed)")
+                continue
+            visible = score >= VISIBLE_MEAN_DELTA
+            per_overlay.append({"kind": event.get("kind"), "start": round(start, 2),
+                                "seconds": round(end - start, 2), "visible": visible,
+                                "mean_pixel_delta": round(score, 2),
+                                "region": list(region)})
+            if not visible:
+                missing.append(f"{event.get('kind')} at {start:.1f}s")
+    finally:
+        shutil.rmtree(folder, ignore_errors=True)
+    return {"checked": len(per_overlay), "missing": missing, "per_overlay": per_overlay,
+            "threshold_mean_delta": VISIBLE_MEAN_DELTA,
+            "reason": "" if per_overlay else "nothing to check"}
