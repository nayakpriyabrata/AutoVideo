+# --------------------------------------------------------------------------- #
+# Production prepares the extra narrations by itself
+# --------------------------------------------------------------------------- #
+def test_selected_languages_are_prepared_without_the_automatic_checkbox(tmp_path, monkeypatch):
+    from engine import speech_cards as SC
+    job = tmp_path / 'job'
+    (job / 'production').mkdir(parents=True)
+    (job / 'production' / 'language_editions.json').write_text(json.dumps(
+        {'source_language': 'en', 'editions': ['en', 'hi'], 'profiles': {}, 'prepare_audio': False,
+         'bundles': {}, 'text_cards': False}), encoding='utf-8')
