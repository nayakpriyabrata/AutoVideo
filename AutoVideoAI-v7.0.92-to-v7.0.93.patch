+def fresh_request_count(output):
+    """Number of archived (old, unresolved) submissions for this shot image."""
+    output = Path(output)
+    return len(list(output.parent.glob(output.name + '.flow-request.archived-*.json')))
+
+
+def archive_saved_request(output):
+    """Rename an unresolved image journal so a fresh request can be submitted. Nothing is deleted.
+
+    Image requests cost no Flow credits, so no credit flag is needed. Refuses if a valid non-reference image
+    is saved. It takes no lock: the caller already holds the production slot.
+    """
+    output = Path(output)
+    path = journal_path(output)
+    request = json.loads(path.read_text(encoding='utf-8'))
+    if request.get('scope') != SCOPE or request.get('kind') != 'image':
+        raise RuntimeError('Only a saved image request can be archived for a fresh request')
+    for entry in (request.get('capture_probes') or {}).values():
+        if entry.get('reference'):
+            continue
+        if entry.get('file') and image_valid(output.parent / str(entry['file'])):
+            raise RuntimeError(f"{entry['file']} is a valid image that is not a classified uploaded reference; "
+                               'recover it instead of resubmitting')
+    stamp = time.strftime('%Y%m%dT%H%M%SZ', time.gmtime()) + '-' + uuid.uuid4().hex[:6]
+    archived = output.with_name(output.name + '.flow-request.archived-' + stamp + '.json')
+    path.rename(archived)
+    return archived
+
