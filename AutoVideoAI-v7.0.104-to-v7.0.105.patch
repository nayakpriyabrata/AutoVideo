@@ -0,0 +1,249 @@
+"""v7.0.105: a paid Flow request is not abandoned because Flow asked a second time.
+
+Field log, job ``20261022-143856-7-small-daily-habits-tha-9729``, 2026-10-27:
+
+    11:21:03  shot_020: Could not attach Agent reference media … no verified composer attachment appeared within 45s
+    11:22:53  [Flow] Credit confirmation: clicked 'Approve' (6 credits)
+    11:22:54  Flow accepted the request but it is still scheduled in the high-demand queue … remaining=899s
+    11:23:27  Approval stopped: Additional approval card exceeds the saved request approval-card limit
+    11:23:28  FlowRequestPending … (last observed interval 29s) → 20-retry recovery, every attempt scanning
+              "6 gallery assets, 0 fresh candidates" → PAUSED flow_recovery_exhausted at 11:33
+
+Three defects in that sequence:
+
+1. the second approval card ended the wait at 29 s while the *already approved* request still had ~870 s of
+   queue left, so the app walked away from a paid request;
+2. a request Flow is still queueing counted as "no progress", so recovery gave up after five scans (~10 min);
+3. the 45 s composer check declared a reference unattached although the upload had landed (the next attempt
+   found it with "Reused existing project media") - which cost a whole extra submission cycle.
+
+No browser is opened and no credit is spent here.
+"""
+import inspect
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from engine import flow_approval as fa
+from engine.automatic_recovery import still_queued
+from engine.providers.flow_browser import (
+    REFERENCE_ATTACH_TIMEOUT_MS, FlowBrowser, FlowRequestPending, FlowUIChanged)
+
+QUEUE_ERROR = FlowRequestPending(
+    "Submitted Flow request has no validated local video asset; Flow adapter reported: Flow accepted the video "
+    "request and showed a high-demand queue card during the bounded wait (last observed interval 29s), but no "
+    "completed playable/downloadable video became available. No download was attempted and no replacement "
+    "generation was submitted; the exact request remains saved.")
+QUESTION = ("I'm going to generate 1 video clip interpolating between your start and end frames using Omni 1.1 "
+            "Flash in 16:9 at 360p for 6 seconds. Would you like me to kick off this 1 video generation, "
+            "costing 6 credits? ")
