+def test_a_foreign_folder_is_refused(tmp_path):
+    plain = tmp_path / 'not-clip-studio'
+    plain.mkdir()
+    (plain / 'notes.txt').write_text('x')
+    with pytest.raises(ValueError, match='does not look like Clip Studio'):
+        clip_cleanup.cleanup(plain, ('work',), apply=True)
+
+
+# ---------------------------------------------------------------- 4 · speech batches belong to a job
+
+def _batch(folder, phase='ready_for_review', editions=('en', 'hi'), done=('en', 'hi'), script='master'):
+    folder.mkdir(parents=True, exist_ok=True)
+    bundles = {}
+    for code in done:
+        audio = folder / f'voice-{code}.mp3'
+        audio.write_bytes(b'audio')
+        bundles[code] = {'audio': str(audio), 'duration': 1.0}
+    (folder / 'batch.json').write_text(json.dumps({
+        'source_language': 'en', 'source_script': script, 'editions': list(editions),
+        'phase': phase, 'bundles': bundles, 'scripts': {code: script for code in editions}}))
+    return folder
+
+
+def test_a_finished_job_batch_is_listed_only_when_asked_for(tmp_path, monkeypatch):
+    shared = tmp_path / 'shared' / 'speech_preparation'
+    _batch(shared / 'batch-create-1')
+    monkeypatch.setattr(speech_batches, 'batches_root', lambda: shared)
+    job = tmp_path / 'job-1'
+    _batch(job)
+    plain = speech_batches.list_speech_batches([job])
+    assert [Path(row['path']).name for row in plain] == ['batch-create-1']
+    asked = speech_batches.list_speech_batches([job], include_finished=[job])
+    assert {Path(row['path']).name for row in asked} == {'batch-create-1', 'job-1'}
+
+
+def test_batches_are_partitioned_by_the_active_job(tmp_path):
+    job = tmp_path / 'job-1'
+    _batch(job, phase='scripts_corrected', done=())
+    mine = {'path': str(job), 'ready': False}
+    other = {'path': str(tmp_path / 'shared' / 'speech_preparation' / 'batch-create-1'), 'ready': False}
+    own, others = speech_batches.partition_for_job([mine, other], job)
+    assert own == [mine] and others == [other]
+    assert speech_batches.partition_for_job([mine, other], None) == ([mine, other], [])
