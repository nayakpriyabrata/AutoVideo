+"""v7.0.109: transcript on/off per language, script-accurate caption text, a channel badge that never blinks
+out, a logo that stays, and a real choice of which shots Gemini generates.
+
+Field reports behind these tests:
+
+* the burned Odia transcript showed the right words with the wrong spellings;
+* the English master carried a nice channel badge (logo + name), the Odia edition only plain white text, and
+  the logo vanished whenever the badge closed;
+* after the first render there was no way to re-render a language without its transcript - or to put it back;
+* the four Gemini video shots were picked automatically with no way to say which shots should be theirs.
+"""
+import array
+import json
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+needs_ffmpeg = pytest.mark.skipif(not (shutil.which('ffmpeg') and shutil.which('ffprobe')),
+                                  reason='FFmpeg required')
+
+
+# ---------------------------------------------------------------- caption text
+
+
+def test_caption_text_follows_the_reviewed_script_and_keeps_timing():
+    from engine.captions import script_accurate_words
+    script = 'ନିଜର ସ୍ୱାସ୍ଥ୍ୟ ପ୍ରତି ଧ୍ୟାନ ଦିଅ'
+    recognised = [
+        {'word': 'ନିଜର', 'start': 0.1, 'end': 0.5},
+        {'word': 'ସ୍ୱାସ୍ଥ୍ଯ', 'start': 0.5, 'end': 1.0},   # recognizer spelling of the same word
+        {'word': 'ପ୍ରତି', 'start': 1.0, 'end': 1.3},
+        {'word': 'ଧ୍ୟାନ୍', 'start': 1.3, 'end': 1.7},      # recognizer spelling again
+        {'word': 'ଦିଅ', 'start': 1.7, 'end': 2.0},
+    ]
+    words, report = script_accurate_words(script, recognised, 2.0)
+    assert [w['word'] for w in words] == script.split()
+    assert report['corrected'] == 2 and 'reviewed script' in report['note']
+    # Timing is never invented: the anchors that matched keep their measured times.
+    assert words[0]['start'] == pytest.approx(0.1) and words[-1]['end'] == pytest.approx(2.0)
+    assert all(a['end'] <= b['start'] + 1e-6 for a, b in zip(words, words[1:]))
+
+
+def test_a_correct_transcript_is_left_untouched():
+    from engine.captions import script_accurate_words
+    words = [{'word': 'A', 'start': 0.0, 'end': 0.4}, {'word': 'clean', 'start': 0.4, 'end': 0.9},
+             {'word': 'take.', 'start': 0.9, 'end': 1.4}]
+    same, report = script_accurate_words('A clean take.', words, 1.4)
+    assert same == words and report['corrected'] == 0 and report['note'] == ''
+
