+    data = json.loads(Path(profile).read_text(encoding='utf-8'))
+    assert set(key for key in data['assets'] if key.startswith('logo')) == {'logo-en', 'logo-hi', 'logo-or'}
+    rows = {row['language']: row for row in language_rows(['en', 'hi', 'or'],
+                                                          {code: str(profile) for code in ('en', 'hi', 'or')},
+                                                          read_profile=lambda value: json.loads(Path(value).read_text(encoding='utf-8')))}
+    assert rows['hi']['channel_name'] == 'हुनर सेतु'
+    assert Path(rows['hi']['logo_path']).name.endswith('logo-hi-' + _sha(data['assets']['logo-hi']['path'])[:20] + '.png')
