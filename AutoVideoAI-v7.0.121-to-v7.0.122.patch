+++ b/tests/test_v7122_cast_and_every_batch.py
@@ -0,0 +1,372 @@
+"""v7.0.122: the video keeps the character you chose, and every prepared narration is offered.
+
+Two field reports, right after v7.0.121 was installed:
+
+* "its only showing for the video which is have an active job already" - the *Run your prepared voices* picker
+  was built from `usable_now`, which hides a batch the moment a job holds its voices, and the batch list itself
+  only read finished batches inside the Active job. So a second prepared narration was invisible and the picker
+  looked as if only the newest Create step 4 session existed.
+* "its not picking the selected character for the video generation" - the cast was chosen in Create inside a
+  collapsed "Characters and recovery preferences · optional" expander, was never recorded with the narration
+  batch, and `create_job_from_batch` passed no `character_ids` at all. A job made from prepared voices
+  therefore planned a brand-new person, whatever was selected.
+
+So: the cast is a visible step of Create, it travels with the batch, the picker asks for it and writes it into
+the job, a job without a storyboard can still be given one, and the picker lists every finished narration.
+"""
+import hashlib
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from engine.cast import job_cast, set_job_cast
+from engine.content_library import CharacterLibrary
+from engine.speech_batches import list_speech_batches, pickable, with_attachments
+
+ROOT = Path(__file__).resolve().parent.parent
+APP = (ROOT / 'app.py').read_text(encoding='utf-8')
+CLI = (ROOT / 'cli.py').read_text(encoding='utf-8')
+WORDS = [{'word': word, 'start': index * 1.0, 'end': index * 1.0 + 0.9}
+         for index, word in enumerate('small daily habits beat big plans'.split())]
+
+
+def _voices(folder: Path, languages, duration=61.5) -> dict:
+    bundles = {}
+    for code in languages:
+        lang = folder / code / 'k1'
+        lang.mkdir(parents=True, exist_ok=True)
+        audio = lang / 'voice.mp3'
+        audio.write_bytes(b'ID3' + folder.name.encode() + b'\0' * 6000)
+        (lang / 'words.json').write_text(json.dumps(WORDS))
+        bundles[code] = {'language': code, 'audio': str(audio), 'words': str(lang / 'words.json'),
+                         'audio_sha256': hashlib.sha256(audio.read_bytes()).hexdigest(),
+                         'duration': duration, 'timing_source': 'measured'}
+    return bundles
+
+
+def make_batch(folder: Path, script: str, *, topic='Small habits', languages=('en', 'hi', 'or'),
+               character_ids=None, origin='Create step 4'):
+    folder.mkdir(parents=True, exist_ok=True)
+    (folder / 'batch.json').write_text(json.dumps({
+        'source_language': 'en', 'source_script': script, 'editions': list(languages),
+        'scripts': {code: script for code in languages},
+        'request': {'provider': 'gemini', 'topic': topic, 'character_ids': list(character_ids or [])},
+        'error': '', 'bundles': _voices(folder, languages), 'phase': 'ready_for_review'}))
+    from engine.speech_batches import _row
+    return _row(folder, origin)
+
+
+def make_job(root: Path, job_id: str, *, shots=0, status='created', script=''):
+    job = root / 'outputs' / job_id
+    for name in ('production', 'narration', 'logs'):
+        (job / name).mkdir(parents=True, exist_ok=True)
