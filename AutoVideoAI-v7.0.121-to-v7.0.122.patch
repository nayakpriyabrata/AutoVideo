+                         'fixed. Nothing was changed. Choose the character when you create the next video; '
+                         'this job keeps the identity its scenes were planned with.')
+    wanted = list(dict.fromkeys(str(identifier) for identifier in (ids or [])))
+    cast = snapshot_cast(wanted) if wanted else []
+    if cast:
+        save(root / 'character_snapshot.json', cast[0])
+        save(root / 'cast_snapshot.json', {'characters': cast})
