+def test_a_completed_job_without_a_video_says_exactly_what_was_checked(outputs, no_ffprobe):
+    job = _completed_job(outputs, 'job-empty', None)
+    (job / 'render' / 'job-empty-final.mp4').write_bytes(b'jpeg-not-a-video')
+    code, reason = job_completion_state(job)
+    assert code == 'no_final_video'
+    assert 'job-empty-final.mp4' in reason                      # names the file it rejected
+    preview = completed_job_delete(outputs, outputs.parent / 'jobs.db', job.name)
+    assert preview['eligible'] is False
+    assert preview['reason_code'] == 'no_final_video'
+    names = [row['name'] for row in preview['candidates']]
+    assert 'job-empty-final.mp4' in names and 'job-empty-final-broll.mp4' in names
+    assert all(row['valid'] is False for row in preview['candidates'])
