+# --------------------------------------------------------------------------- #
+# The transcript switch still changes exactly the languages it should
+# --------------------------------------------------------------------------- #
+@needs_ffmpeg
+def test_switching_a_transcript_off_re_renders_only_that_language(tmp_path):
+    from engine import language_editions as LE
+    job = _job(tmp_path)
+    first = LE.render_job_editions(job)
+    assert first['status'] == 'exported'
+    # Odia is transcript-OFF by default, so switching it ON is the change that must repaint one file.
+    assert LE.transcript_for(json.loads((job / 'production' / 'language_editions.json')
+                                        .read_text(encoding='utf-8')), 'or') is False
+    LE.set_transcript(job, languages={'or': True})
+    second = LE.render_job_editions(job)
+    assert second['status'] == 'exported'
+    assert second['editions']['hi']['path'] == first['editions']['hi']['path']   # untouched
+    assert second['editions']['or']['path'] != first['editions']['or']['path']   # repainted once
+    assert second['editions']['or']['captions'] is True
+    third = LE.render_job_editions(job)
+    assert third['editions']['or']['path'] == second['editions']['or']['path']   # and then it settles
+    assert third['editions']['hi']['path'] == first['editions']['hi']['path']
+
+
+@needs_ffmpeg
+def test_odia_is_still_off_by_default_and_the_previous_file_is_kept(tmp_path):
+    from engine import language_editions as LE
+    job = _job(tmp_path)
+    assert LE.transcript_for(json.loads((job / 'production' / 'language_editions.json')
+                                        .read_text(encoding='utf-8')), 'or') is False
+    first = LE.render_job_editions(job)
+    assert first['editions']['or']['captions'] is False          # Odia defaults to no transcript
+    kept = Path(first['editions']['or']['path'])
+    LE.set_transcript(job, languages={'or': True})
+    second = LE.render_job_editions(job)
+    assert Path(second['editions']['or']['path']).is_file()
+    assert kept.is_file() and second['editions']['or']['path'] != str(kept)
