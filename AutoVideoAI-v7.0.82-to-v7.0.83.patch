+"""v7.0.83: Create step 4 batches are visible and resumable from Jobs & Recovery; approved narration is used by jobs.
+
+No network and no TTS: prepare_edition and the card step are replaced by small fakes.
+"""
+import json
+from pathlib import Path
+
+import pytest
+
+import engine.speech_cards as SC
+import engine.speech_batches as SB
+
+EN = 'Start with one small habit today. Repeat it for one week.'
+HI = 'आज एक छोटी आदत से शुरुआत करें। एक हफ्ते तक इसे दोहराएँ।'
+OR_GOOD = 'ଆଜି ଏକ ଛୋଟ ଅଭ୍ୟାସରୁ ଆରମ୍ଭ କରନ୍ତୁ। ଏକ ସପ୍ତାହ ଧରି ଏହାକୁ ଦୋହରାନ୍ତୁ।'
+OR_BAD = 'ଆଜି ଏକ βαğβαğ ଅଭ୍ୟାସରୁ ଆରମ୍ଭ କରନ୍ତୁ। ଏକ ସପ୍ତାହ ଧରି ଏହାକୁ ଦୋହରାନ୍ତୁ।'
+LANGS = ['en', 'hi', 'or']
+
+
+@pytest.fixture
+def shared(tmp_path, monkeypatch):
+    monkeypatch.setenv('AUTOVIDEO_SHARED_ROOT', str(tmp_path / 'shared'))
+    calls = []
+    fail_on = {'code': None}
+
+    def fake_prepare_edition(root, script, language, **kwargs):
+        calls.append({'language': language, 'script': script, 'provider': kwargs.get('provider')})
+        if language == fail_on['code']:
+            raise RuntimeError('Gemini TTS daily request limit reached (test)')
+        audio = Path(root) / 'speech-editions' / language / 'voice.mp3'
+        audio.parent.mkdir(parents=True, exist_ok=True)
+        audio.write_bytes(b'x' * 2048)
+        return {'audio': str(audio), 'audio_sha256': 'x', 'duration': 3.0, 'script': script, 'language': language,
+                'words': str(audio) + '.words.json', 'cards': []}
+
+    monkeypatch.setattr(SC, 'prepare_edition', fake_prepare_edition)
+    monkeypatch.setattr(SC, 'complete_edition_cards', lambda bundle, cleanup: bundle)
+    monkeypatch.setattr(SC, 'prepare_localized_scripts',
+                        lambda *a, **k: (_ for _ in ()).throw(AssertionError('must not regenerate narration')))
+    return {'calls': calls, 'fail_on': fail_on, 'root': tmp_path}
+
+
+def _scripts(**override):
+    scripts = {'en': EN, 'hi': HI, 'or': OR_GOOD}
+    scripts.update(override)
+    return scripts
+
+
+def test_wrong_script_is_saved_and_listed_with_its_error(shared):
+    folder = SB.batches_root() / 'batch'
+    with pytest.raises(ValueError, match='outside its script'):
+        SC.prepare_batch(folder, EN, 'en', LANGS, provider='gemini', localized_scripts=_scripts(**{'or': OR_BAD}))
+    assert shared['calls'] == []  # no TTS was started
+    rows = SB.list_speech_batches()
+    assert len(rows) == 1
+    row = rows[0]
+    assert row['ready'] is False
+    assert 'Jobs & Recovery' in row['error'] and 'no TTS was started' in row['error']
+    assert row['scripts']['or'] == OR_BAD
+    assert row['request']['provider'] == 'gemini'
+
+
+def test_correction_is_checked_saved_and_used_by_the_job(shared):
+    folder = SB.batches_root() / 'batch'
+    with pytest.raises(ValueError):
+        SC.prepare_batch(folder, EN, 'en', LANGS, provider='gemini', localized_scripts=_scripts(**{'or': OR_BAD}))
+    approvals = {'hi': True, 'or': True}
+    with pytest.raises(ValueError, match='outside its script'):
+        SB.correct_speech_scripts(folder, {'hi': HI, 'or': OR_BAD}, approvals)
+    with pytest.raises(ValueError, match='Review and approve'):
+        SB.correct_speech_scripts(folder, {'hi': HI, 'or': OR_GOOD}, {'hi': True})
+    saved = SB.correct_speech_scripts(folder, {'hi': HI, 'or': OR_GOOD}, approvals)
+    assert saved == {'en': EN, 'hi': HI, 'or': OR_GOOD}
+    state = json.loads((folder / 'batch.json').read_text(encoding='utf-8'))
+    assert state['phase'] == 'scripts_corrected' and state['error'] == '' and state['bundles'] == {}
+
+    # A job later runs the same master and languages. It must use the approved snapshot, not regenerate.
+    assert SC.reviewed_scripts_for(EN, 'en', LANGS) == {'en': EN, 'hi': HI, 'or': OR_GOOD}
+    job = shared['root'] / 'job'
+    SC.prepare_batch(job, EN, 'en', LANGS, provider='auto')
+    assert {c['language']: c['script'] for c in shared['calls']} == {'en': EN, 'hi': HI, 'or': OR_GOOD}
+
+
+def test_resume_reuses_stored_settings_and_only_unfinished_languages(shared):
+    folder = SB.batches_root() / 'batch'
+    shared['fail_on']['code'] = 'hi'
+    with pytest.raises(RuntimeError, match='daily request limit'):
+        SC.prepare_batch(folder, EN, 'en', LANGS, provider='gemini-lite@paid', text_cards=False,
+                         localized_scripts=_scripts())
+    row = SB.list_speech_batches()[0]
+    assert row['done'] == ['en'] and 'daily request limit' in row['error']
+    assert row['request']['provider'] == 'gemini-lite@paid' and row['request']['text_cards'] is False
+
+    shared['fail_on']['code'] = None
+    shared['calls'].clear()
+    SB.resume_speech_batch(folder)
+    languages = [c['language'] for c in shared['calls']]
+    assert languages == ['en', 'hi', 'or']  # the script is re-checked; the cached voice file is reused by prepare_edition
+    assert {c['provider'] for c in shared['calls']} == {'gemini-lite@paid'}
+    row = SB.list_speech_batches()[0]
+    assert row['ready'] is True and row['error'] == ''
+
+
+def test_a_batch_without_saved_scripts_reads_the_approved_snapshot(shared):
+    from engine.speech_cards import localization_key
+    folder = SB.batches_root() / 'legacy'
+    folder.mkdir(parents=True)
+    key = localization_key(EN, 'en', LANGS)
+    snapshot = shared['root'] / 'shared' / 'speech_preparation' / 'scripts' / key
+    snapshot.mkdir(parents=True)
+    (snapshot / 'localized_scripts.json').write_text(json.dumps({
+        'phase': 'scripts_approved', 'fingerprint': key, 'source_language': 'en', 'source_script': EN,
+        'editions': LANGS, 'scripts': _scripts(), 'reviewed': {x: True for x in LANGS}}), encoding='utf-8')
+    (folder / 'batch.json').write_text(json.dumps({
+        'source_language': 'en', 'source_script': EN, 'editions': LANGS, 'phase': 'tts',
+        'bundles': {}, 'error': 'stopped during TTS'}), encoding='utf-8')
+    row = SB.list_speech_batches()[0]
+    assert row['scripts'] == _scripts()
+    assert row['request'] == {}
+
+
+def test_master_script_change_is_refused_by_the_resume_path(shared):
+    folder = SB.batches_root() / 'batch'
+    SC.prepare_batch(folder, EN, 'en', LANGS, provider='auto', localized_scripts=_scripts())
+    state = json.loads((folder / 'batch.json').read_text(encoding='utf-8'))
+    state['source_script'] = EN + ' Changed.'
+    (folder / 'batch.json').write_text(json.dumps(state), encoding='utf-8')
+    with pytest.raises(ValueError, match='Reviewed master script changed'):
+        SB.resume_speech_batch(folder)
+
+
+def test_unfinished_job_batches_are_listed_and_finished_ones_are_not(shared):
+    job = shared['root'] / 'jobs' / '20261022-job'
+    with pytest.raises(ValueError):
+        SC.prepare_batch(job, EN, 'en', LANGS, provider='auto', localized_scripts=_scripts(**{'hi': 'Latin only text here.', 'or': OR_BAD}))
+    rows = SB.list_speech_batches([job])
+    assert len(rows) == 1 and rows[0]['origin'] == 'Job 20261022-job'
+    assert rows[0]['error']
+
+    done_job = shared['root'] / 'jobs' / '20261023-done'
+    SC.prepare_batch(done_job, EN, 'en', LANGS, provider='auto', localized_scripts=_scripts())
+    assert all(row['key'] != '20261023-done' for row in SB.list_speech_batches([done_job]))
