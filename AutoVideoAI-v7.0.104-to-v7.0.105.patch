+def test_a_queued_request_is_waited_out_instead_of_being_abandoned(tmp_path, monkeypatch):
+    monkeypatch.setenv('HOME', str(tmp_path / 'home'))
+    from engine.automatic_recovery import run_with_recovery
+    from engine.factory import Factory, RecoverableInterruption
+
+    factory = Factory(str(tmp_path / 'outputs'), str(tmp_path / 'data/jobs.db'))
+    job = factory.create_job('Queued request wait', dry_run=True)
+    calls = []
+
+    def run(*args):
