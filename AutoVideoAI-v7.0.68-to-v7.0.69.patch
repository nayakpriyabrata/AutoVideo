+"""v7.0.69 script drafting: ChatGPT/OpenAI and other API providers beside Gemini Web."""
+import json
+
+import pytest
+
+from engine import studio_review as sr
+
+
+def test_provider_list_shows_gemini_web_and_marks_api_keys(monkeypatch):
+    monkeypatch.delenv('OPENAI_API_KEY', raising=False)
+    options = {key: (ok, note) for key, _label, ok, note in sr.draft_provider_options()}
+    assert set(options) == {'gemini-web', 'openai', 'gemini', 'groq', 'grok', 'ollama'}
+    assert options['gemini-web'][0] is True and 'no API key' in options['gemini-web'][1]
+    assert options['openai'][0] is False and 'OPENAI_API_KEY' in options['openai'][1]
+    assert options['ollama'][0] is True  # local; availability is not probed on each render
+
+
+def test_openai_is_available_when_its_key_is_set(monkeypatch):
+    monkeypatch.setenv('OPENAI_API_KEY', 'test-key')
+    options = {key: ok for key, _label, ok, _note in sr.draft_provider_options()}
+    assert options['openai'] is True
+
+
+def _plan_json():
+    return json.dumps({'narration': 'Hello there. This is a short test script.', 'scenes': [{'text': 'Hello there.'}],
+                       'character_suggestions': []})
+
+
+def _patch_validation(monkeypatch):
+    monkeypatch.setattr(sr, 'validate_plan', lambda value: {**value, 'rights': {}})
+
+
+def test_chatgpt_api_draft_uses_chosen_provider_and_never_touches_gemini_web(monkeypatch):
+    monkeypatch.setenv('OPENAI_API_KEY', 'test-key')
+    _patch_validation(monkeypatch)
+    calls = []
+    import engine.planning.script_engine as engine_script
+    monkeypatch.setattr(engine_script, '_call_provider', lambda provider, model, system, user: calls.append((provider, model)) or _plan_json())
+    import engine.providers.gemini_web as gw
+    monkeypatch.setattr(gw, 'gemini_web_generate', lambda *a, **k: (_ for _ in ()).throw(AssertionError('Gemini Web must not run')))
+
+    review = sr.draft_script_cast('Save money', 30, 'en', [], 'education', audio_mode='voiceover', provider='openai')
+    assert calls and calls[0][0] == 'openai'
+    assert review['plan']['drafted_by'] == 'openai'
+    assert review['plan']['approved'] is False
+
+
+def test_gemini_web_remains_the_default(monkeypatch):
+    _patch_validation(monkeypatch)
+    import engine.providers.gemini_web as gw
+    seen = []
+    monkeypatch.setattr(gw, 'gemini_web_generate', lambda system, user, cleanup='delete-after-read', **k: seen.append(cleanup) or _plan_json())
+    review = sr.draft_script_cast('Save money', 30, 'en', [], 'education', audio_mode='voiceover')
+    assert seen == ['delete-after-read']
+    assert review['plan']['drafted_by'] == 'gemini-web'
+
+
+def test_unknown_provider_is_rejected_before_any_request(monkeypatch):
+    with pytest.raises(ValueError, match='Unsupported drafting provider'):
+        sr.draft_script_cast('Save money', 30, 'en', [], 'education', provider='planner')
+
+
+def test_unconfigured_api_provider_fails_clearly_without_a_request(monkeypatch):
+    monkeypatch.delenv('GROQ_API_KEY', raising=False)
+    with pytest.raises(ValueError, match='not configured'):
+        sr._draft_generate('groq', 'system', 'user')
+
+
+def test_ollama_is_not_blocked_by_a_live_probe(monkeypatch):
+    import engine.planning.script_engine as engine_script
+    monkeypatch.setattr(engine_script, '_provider_available', lambda provider: False)
+    monkeypatch.setattr(engine_script, '_call_provider', lambda provider, model, system, user: 'ok')
+    assert sr._draft_generate('ollama', 'system', 'user') == 'ok'
