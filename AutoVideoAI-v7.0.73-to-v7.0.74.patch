+"""7.0.74 educational cards: single-point kinds, five-point box, pop animation."""
+import json
+import shutil
+import subprocess
+from pathlib import Path
+
+import numpy as np
+import pytest
+from PIL import Image
+
+from engine.render.educational_cards import is_educational, render_card_png
+from engine.render.ffmpeg_renderer import build_ffmpeg_cmd, ffmpeg_exe
+from engine.speech_cards import anchor_cards, prepare, render
+from engine.render.structured_graphics import build_structured_overlays
+
+POINTS = ['Breathe slowly before reacting', 'Write one worry on paper', 'Name the feeling out loud',
+          'Pick one small next step', 'Review the day tonight']
+
+
+def words(n=60):
+    return [{'word': f'w{i}', 'start': i * .5, 'end': i * .5 + .4} for i in range(n)]
+
+
+def points_card(**extra):
+    return {'kind': 'points', 'text': 'Five habits that calm a racing mind', 'points': POINTS,
+            'start_word': 0, 'end_word': 14, **extra}
+
+
+def test_only_education_gets_educational_card_kinds():
+    assert is_educational('education')
+    assert is_educational(' Education ')
+    assert not is_educational('kids_story')
+    assert not is_educational('')
+
+
+def test_educational_kinds_validate_and_keep_timings():
+    rows = {'cards': [points_card(), {'kind': 'tip', 'text': 'Drink water before coffee', 'start_word': 20, 'end_word': 23}]}
+    cards = anchor_cards(rows, words(), 40, educational=True)
+    assert [c['kind'] for c in cards] == ['points', 'tip']
+    assert len(cards[0]['points']) == 5
+    assert 6 <= cards[0]['end'] - cards[0]['start'] <= 14
+
+
+@pytest.mark.parametrize('points', [
+    POINTS[:2],                      # too few
+    POINTS + ['Sixth point'],        # too many
+    ['x' * 61, 'b', 'c'],            # over 60 characters
+    ['', 'b', 'c'],                  # empty
+    [1, 'b', 'c'],                   # not a string
+])
+def test_points_cards_reject_bad_lists(points):
+    with pytest.raises(ValueError):
+        anchor_cards({'cards': [points_card(points=points)]}, words(), 40, educational=True)
+
+
+def test_points_card_must_last_six_to_fourteen_seconds():
+    with pytest.raises(ValueError):
+        anchor_cards({'cards': [points_card(end_word=40)]}, words(), 40, educational=True)
+
+
+def test_unknown_educational_kind_is_rejected():
+    with pytest.raises(ValueError):
+        anchor_cards({'cards': [{'kind': 'bullet', 'text': 'Nope', 'start_word': 0, 'end_word': 4}]},
+                     words(), 40, educational=True)
+
+
+def test_other_video_types_stay_plain_keypoints():
+    rows = {'cards': [{'kind': 'points', 'text': 'Plain line', 'points': POINTS, 'start_word': 10, 'end_word': 12}]}
+    cards = anchor_cards(rows, words(), 40)
+    assert cards[0]['kind'] == 'keypoint' and 'points' not in cards[0]
+
+
+@pytest.mark.parametrize('dimensions', [(1080, 1920), (1920, 1080)])
+@pytest.mark.parametrize('kind', ['takeaway', 'tip', 'warning', 'points'])
+def test_every_kind_draws_inside_canvas_with_transparent_panel(tmp_path, kind, dimensions):
+    w, h = dimensions
+    card = points_card() if kind == 'points' else {'kind': kind, 'text': 'Put the phone away before bed',
+                                                   'start': 2.0, 'end': 5.0}
+    card.setdefault('start', 2.0)
+    card.setdefault('end', 9.0)
+    info = render_card_png(card, tmp_path / f'{kind}.png', w, h, 'playful')
+    x, y, bw, bh = info['box']
+    assert 0 <= x and 0 <= y and x + bw <= w and y + bh <= h
+    assert info['anim'] == 'pop' and info['kind'] == kind
+    for x0, y0, x1, y1 in info['layout']['text_boxes']:
+        assert 0 <= x0 < x1 <= w and 0 <= y0 < y1 <= h
+    with Image.open(tmp_path / f'{kind}.png') as image:
+        alpha = np.asarray(image.getchannel('A'))
+    assert alpha[0, 0] == 0
+    # The panel is translucent: inside the padding it is neither opaque nor invisible.
+    assert 120 <= alpha[y + bh // 2, x + bw - 8] <= 200
+
+
+def _cards_fixture(root, audio, script='Script'):
+    audio.write_bytes(b'voice-bytes')
+    return words(), script
+
+
+def test_educational_prepare_uses_points_prompt_and_render_animates(tmp_path, monkeypatch):
+    import engine.providers.gemini_web as gemini
+    audio = tmp_path / 'voice.mp3'
+    word_rows, script = _cards_fixture(tmp_path, audio)
+    seen = {}
+
+    def fake(system, user, cleanup='keep'):
+        seen['system'] = system
+        return json.dumps({'cards': [points_card(), {'kind': 'warning', 'text': 'Do not scroll in bed',
+                                                    'start_word': 20, 'end_word': 23}]})
+    monkeypatch.setattr(gemini, 'gemini_web_generate', fake)
+    result = prepare(tmp_path, audio, word_rows, script, 40, 'en', educational=True)
+    assert '"points"' in seen['system'] and 'warning' in seen['system']
+    assert result['schema_version'] == 2 and result['educational'] is True
+    overlays = render(tmp_path, audio, word_rows, script, 40, 1080, 1920, 'playful', educational=True)
+    assert [o['kind'] for o in overlays] == ['points', 'warning']
+    assert all(o['anim'] == 'pop' and len(o['box']) == 4 for o in overlays)
+    # The educational draft is a different fingerprint: a plain render must refuse it.
+    with pytest.raises(ValueError):
+        render(tmp_path, audio, word_rows, script, 40, 1080, 1920, 'playful', educational=False)
+
+
+def test_non_educational_prepare_keeps_original_prompt_and_plain_cards(tmp_path, monkeypatch):
+    import engine.providers.gemini_web as gemini
+    audio = tmp_path / 'voice.mp3'
+    word_rows, script = _cards_fixture(tmp_path, audio)
+    seen = {}
+
+    def fake(system, user, cleanup='keep'):
+        seen['system'] = system
+        return json.dumps({'cards': [{'text': 'Pause before speaking', 'start_word': 10, 'end_word': 12}]})
+    monkeypatch.setattr(gemini, 'gemini_web_generate', fake)
+    prepare(tmp_path, audio, word_rows, script, 40, 'en')
+    assert '"points"' not in seen['system']
+    overlays = render(tmp_path, audio, word_rows, script, 40, 1080, 1920, 'bold')
+    assert overlays and 'anim' not in overlays[0] and overlays[0]['kind'] == 'keypoint'
+
+
+def test_structured_list_gets_pop_only_for_education(tmp_path):
+    graphics = tmp_path / 'production' / 'graphics.json'
+    graphics.parent.mkdir(parents=True)
+    graphics.write_text(json.dumps({'events': [{
+        'kind': 'list', 'start': 1, 'end': 9, 'title': 'Five habits',
+        'rows': [{'label': p} for p in POINTS]}]}), encoding='utf-8')
+    plain = build_structured_overlays(tmp_path, 40, 1080, 1920, style='playful')
+    taught = build_structured_overlays(tmp_path, 40, 1080, 1920, style='playful', educational=True)
+    assert 'anim' not in plain[0] and plain[0]['box']
+    assert taught[0]['anim'] == 'pop' and taught[0]['box'] == plain[0]['box']
+
+
+def _measure_card_area(png, background=(32, 48, 64)):
+    arr = np.asarray(Image.open(png).convert('RGB')).astype(int)
+    diff = np.abs(arr - np.array(background)).max(axis=2)
+    return int((diff > 40).sum())
+
+
+@pytest.mark.skipif(not (shutil.which('ffmpeg') or Path(ffmpeg_exe()).exists()), reason='ffmpeg unavailable')
+def test_pop_animation_opens_holds_and_closes_in_ffmpeg(tmp_path):
+    binary = ffmpeg_exe()
+    W, H = 720, 1280
+    src = tmp_path / 'src.mp4'
+    subprocess.run([binary, '-v', 'error', '-y', '-f', 'lavfi', '-i', f'color=c=0x203040:s={W}x{H}:d=5:r=25',
+                    '-pix_fmt', 'yuv420p', str(src)], check=True, timeout=60)
+    card = points_card(start=1.0, end=4.0)
+    info = render_card_png(card, tmp_path / 'points.png', W, H, 'playful')
+    out = tmp_path / 'out.mp4'
+    cmd, meta = build_ffmpeg_cmd([{'src': str(src), 'in': 0, 'dur': 5, 'freeze': 0, 'hard_cut': True}], None,
+                                 str(out), W=W, H=H, fps=25, encoder='libx264', quality='preview',
+                                 safe_concat=True, overlays=[info])
+    assert 'eval=frame' in ' '.join(cmd)
+    result = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
+    assert result.returncode == 0, result.stderr[-2000:]
+    areas = {}
+    for t in (0.5, 1.12, 2.5, 3.9, 4.6):
+        frame = tmp_path / f'frame_{t}.png'
+        subprocess.run([binary, '-v', 'error', '-y', '-ss', str(t), '-i', str(out), '-frames:v', '1', str(frame)],
+                       check=True, timeout=60)
+        areas[t] = _measure_card_area(frame)
+    assert areas[0.5] < 50 and areas[4.6] < 50          # not visible before or after
+    assert areas[1.12] < areas[2.5]                      # still opening
+    assert areas[3.9] < areas[2.5]                       # closing
+    assert areas[2.5] > 5000                             # full panel on screen while held
