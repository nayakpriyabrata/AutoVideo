diff -ruN a/tests/test_v768_delivery_duplicates.py b/tests/test_v768_delivery_duplicates.py
--- a/tests/test_v768_delivery_duplicates.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_v768_delivery_duplicates.py	2026-10-20 05:29:08.498194474 +0000
@@ -0,0 +1,190 @@
+"""v7.0.68 cross-channel duplicate guard, exercised with generated synthetic videos.
+
+Identical bytes approved or scheduled for another account are blocked. Re-encoded
+near-duplicates need explicit acknowledgment. Scheduling re-checks both.
+"""
+import shutil
+import subprocess
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+import pytest
+
+pytestmark = pytest.mark.skipif(shutil.which('ffprobe') is None, reason='ffprobe unavailable')
+
+
+def _gen(path, source, *extra):
+    from engine.render.ffmpeg_renderer import ffmpeg_exe
+    subprocess.run([ffmpeg_exe(), '-y', '-v', 'error', '-f', 'lavfi', '-i', source, '-t', '4', '-an',
+                    *extra, '-pix_fmt', 'yuv420p', '-c:v', 'libx264', '-preset', 'veryfast', str(path)],
+                   check=True, timeout=300)
+    return path
+
+
+@pytest.fixture
+def world(tmp_path, monkeypatch):
+    """Run inside a temp repo so 'outputs/' is isolated; provide three sources."""
+    monkeypatch.chdir(tmp_path)
+    src = {
+        'base': _gen(tmp_path / 'base.mp4', 'testsrc=size=540x960:rate=30'),
+        'reencoded': _gen(tmp_path / 'reencoded.mp4', 'testsrc=size=540x960:rate=30', '-crf', '40'),
+        'other': _gen(tmp_path / 'other.mp4', 'mandelbrot=size=540x960:rate=30'),
+    }
+    return src
+
+
+def _export(source, folder, title='Launch'):
+    from engine.publishing import export_delivery
+    return export_delivery(source, folder, 'youtube_short', language='en', title=title,
+                           caption='Caption', description='Description')
+
+
+def _approve(record_path, account, **kw):
+    from engine.publishing import approve_release
+    return approve_release(record_path, account_id=account, rights_confirmed=True, facts_reviewed=True,
+                           language_reviewed=True, made_for_kids=False, ai_disclosure_required=False, **kw)
+
+
+def _twin(record, folder, identifier):
+    """Identical bytes, separate release record: the same file uploaded from a second folder."""
+    from engine.production import save
+    from engine.publishing import _write_upload_packet
+    folder = Path(folder)
+    folder.mkdir(parents=True, exist_ok=True)
+    video = folder / (identifier + '.mp4')
+    shutil.copy(record['video'], video)
+    twin = dict(record, id=identifier, video=str(video), state='REVIEW_REQUIRED', account_id='')
+    for key in ('approval_sha256', 'duplicate_review', 'editorial_evidence', 'publish_at'):
+        twin.pop(key, None)
+    release = folder / (identifier + '.release.json')
+    save(release, twin)
+    _write_upload_packet(twin, release)
+    return release
+
+
+def _record_path(record):
+    return Path(record['video']).with_suffix('.release.json')
+
+
+def test_identical_bytes_for_another_account_are_blocked(world):
+    from engine.production import read
+    first = _export(world['base'], 'outputs/deliveries/a')
+    _approve(_record_path(first), 'channel-one')
+    twin = _twin(first, 'outputs/deliveries/b', 'twin')
+    with pytest.raises(ValueError, match='Identical video is already approved or scheduled for another account'):
+        _approve(twin, 'channel-two')
+    assert read(twin)['state'] == 'REVIEW_REQUIRED'
+
+
+def test_identical_bytes_for_the_same_account_are_allowed(world):
+    first = _export(world['base'], 'outputs/deliveries/a')
+    _approve(_record_path(first), 'channel-one')
+    twin = _twin(first, 'outputs/deliveries/b', 'twin')
+    assert _approve(twin, 'channel-one')['state'] == 'APPROVED_FOR_MANUAL_UPLOAD'
+
+
+def test_near_duplicate_needs_acknowledgment_then_is_recorded(world):
+    from engine.production import read
+    first = _export(world['base'], 'outputs/deliveries/a')
+    _approve(_record_path(first), 'channel-one')
+    variant = _export(world['reencoded'], 'outputs/deliveries/b', title='Launch variant')
+    with pytest.raises(ValueError, match='Near-duplicate of approved or scheduled delivery'):
+        _approve(_record_path(variant), 'channel-two')
+    assert read(_record_path(variant))['state'] == 'REVIEW_REQUIRED'
+    approved = _approve(_record_path(variant), 'channel-two', acknowledge_duplicate_warning=True)
+    review = approved['duplicate_review']
+    assert review['acknowledged'] is True
+    assert [row['id'] for row in review['matches']] == [first['id']]
+    assert review['matches'][0]['mean_hamming'] <= 10
+    assert read(_record_path(variant))['duplicate_review']['acknowledged'] is True
+
+
+def test_unrelated_content_raises_no_warning(world):
+    first = _export(world['base'], 'outputs/deliveries/a')
+    _approve(_record_path(first), 'channel-one')
+    other = _export(world['other'], 'outputs/deliveries/b', title='Different')
+    approved = _approve(_record_path(other), 'channel-two')
+    assert 'duplicate_review' not in approved
+
+
+def test_approval_without_matches_keeps_fingerprint_contract(world):
+    from engine.publishing import _approval_fingerprint, schedule_release
+    record = _approve(_record_path(_export(world['base'], 'outputs/deliveries/a')), 'channel-one')
+    assert _approval_fingerprint(record) == record['approval_sha256']
+    when = (datetime.now(timezone.utc) + timedelta(days=2)).isoformat()
+    assert schedule_release(_record_path(record), when)['state'] == 'SCHEDULED_MANUAL_REMINDER'
+
+
+def test_schedule_blocks_identical_bytes_that_appeared_after_approval(world):
+    from engine.production import read, save
+    from engine.publishing import schedule_release
+    first = _export(world['base'], 'outputs/deliveries/a')
+    approved = _approve(_record_path(first), 'channel-one')
+    twin = _twin(first, 'outputs/deliveries/b', 'twin')
+    record = read(twin)
+    record.update(state='SCHEDULED_MANUAL_REMINDER', account_id='channel-two')
+    save(twin, record)  # a record written outside this approval path
+    when = (datetime.now(timezone.utc) + timedelta(days=2)).isoformat()
+    with pytest.raises(ValueError, match='Identical video is now approved or scheduled'):
+        schedule_release(_record_path(approved), when)
+
+
+def test_schedule_requires_review_for_a_new_near_duplicate(world):
+    from engine.production import read, save
+    from engine.publishing import schedule_release
+    first = _export(world['base'], 'outputs/deliveries/a')
+    approved = _approve(_record_path(first), 'channel-one')
+    variant = _export(world['reencoded'], 'outputs/deliveries/b', title='Variant')
+    record = read(_record_path(variant))
+    record.update(state='APPROVED_FOR_MANUAL_UPLOAD', account_id='channel-two')
+    save(_record_path(variant), record)  # appeared after the first approval
+    when = (datetime.now(timezone.utc) + timedelta(days=2)).isoformat()
+    with pytest.raises(ValueError, match='new near-duplicate delivery appeared'):
+        schedule_release(_record_path(approved), when)
+
+
+def test_candidate_outside_active_states_does_not_block(world):
+    from engine.production import read, save
+    first = _export(world['base'], 'outputs/deliveries/a')
+    twin = _twin(first, 'outputs/deliveries/b', 'twin')
+    record = read(twin)
+    record['account_id'] = 'channel-two'  # still REVIEW_REQUIRED: not approved, not scheduled
+    save(twin, record)
+    assert _approve(_record_path(first), 'channel-one')['state'] == 'APPROVED_FOR_MANUAL_UPLOAD'
+
+
+def test_missing_candidate_video_is_reported_and_does_not_block(world):
+    first = _export(world['base'], 'outputs/deliveries/a')
+    _approve(_record_path(first), 'channel-one')
+    Path(first['video']).unlink()
+    variant = _export(world['reencoded'], 'outputs/deliveries/b', title='Variant')
+    approved = _approve(_record_path(variant), 'channel-two')
+    assert approved['duplicate_review']['skipped'][0]['reason'] == 'video file missing'
+
+
+def test_fingerprint_cache_avoids_recomputing_frames(world, monkeypatch):
+    from engine import delivery_duplicates as dd
+    video = _export(world['base'], 'outputs/deliveries/a')['video']
+    first = dd.fingerprint(video)
+    def boom(*a, **kw):
+        raise AssertionError('frames recomputed despite a valid cache')
+    monkeypatch.setattr(dd, '_frame_hash', boom)
+    again = dd.fingerprint(video)
+    assert again['frames'] == first['frames'] and again['sha256'] == first['sha256']
+
+
+def test_changed_video_invalidates_the_cache(world):
+    from engine import delivery_duplicates as dd
+    video = Path(_export(world['base'], 'outputs/deliveries/a')['video'])
+    before = dd.fingerprint(video)
+    replacement = _gen(video.with_suffix('.replacement.mp4'), 'mandelbrot=size=540x960:rate=30')
+    shutil.copy(replacement, video)
+    after = dd.fingerprint(video)
+    assert after['sha256'] != before['sha256']
+    assert dd.mean_hamming(before['frames'], after['frames']) > 10
+
+
+def test_mean_hamming_rejects_mismatched_frame_counts():
+    from engine.delivery_duplicates import mean_hamming
+    with pytest.raises(ValueError):
+        mean_hamming([0, 0], [0, 0])
diff -ruN a/tests/test_v768_flow_image_cleanup.py b/tests/test_v768_flow_image_cleanup.py
--- a/tests/test_v768_flow_image_cleanup.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_v768_flow_image_cleanup.py	2026-10-20 05:29:08.498194474 +0000
@@ -0,0 +1,198 @@
+"""v7.0.68: image-only Flow projects may be deleted once their local image and
+request record are verified; video projects and changed or pending captures stay."""
+import json
+from pathlib import Path
+from types import SimpleNamespace as NS
+
+import pytest
+
+URL = 'https://flow.google.com/project/aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa'
+
+
+def _png(path, colour):
+    from PIL import Image
+    path.parent.mkdir(parents=True, exist_ok=True)
+    Image.new("RGB", (96, 96), colour).save(path, format='PNG')
+    return path
+
+
+def _record(root, name, *, kind='image', scope='isolated_image_v1', status='downloaded',
+            colour=(10, 20, 30), capture_inventory=None, project_url=URL):
+    from engine.isolated_frame_regeneration import sha
+    out = _png(Path(root) / 'images' / name, colour)
+    row = {'kind': kind, 'scope': scope, 'status': status, 'project_url': project_url,
+           'media_sha256': sha(out), 'reference_hashes': {}}
+    if capture_inventory is not None:
+        row['capture_inventory'] = capture_inventory
+    (Path(str(out) + '.flow-request.json')).write_text(json.dumps(row))
+    return out
+
+
+def _project(tmp_path, **kw):
+    root = tmp_path / 'job'
+    root.mkdir()
+    _record(root, 'frame-1.png', **kw)
+    return root
+
+
+def _rows(root):
+    from engine.flow_project_cleanup import inventory
+    return {r['project_url']: r for r in inventory(root)}
+
+
+# ---- eligibility -----------------------------------------------------------
+
+def test_image_project_without_captured_inventory_is_eligible(tmp_path):
+    row = _rows(_project(tmp_path))[URL]
+    assert row['eligible'] and row['max_images'] == 1 and not row['exact']
+
+
+def test_two_image_records_bound_is_their_sum(tmp_path):
+    root = _project(tmp_path)
+    _record(root, 'frame-2.png', colour=(90, 90, 90))
+    row = _rows(root)[URL]
+    assert row['eligible'] and row['max_images'] == 2
+
+
+def test_captured_inventory_is_used_for_exact_match_when_complete(tmp_path):
+    root = _project(tmp_path, capture_inventory=['sig-a'])
+    row = _rows(root)[URL]
+    assert row['eligible'] and row['exact'] and row['signatures'] == ['sig-a']
+
+
+def test_video_project_stays_protected(tmp_path):
+    row = _rows(_project(tmp_path, kind='video'))[URL]
+    assert not row['eligible'] and 'Video/recovery project retained' in row['blocked']
+
+
+def test_pending_image_stays_protected(tmp_path):
+    row = _rows(_project(tmp_path, status='pending'))[URL]
+    assert not row['eligible'] and any('pending' in b for b in row['blocked'])
+
+
+def test_changed_local_image_stays_protected(tmp_path):
+    root = _project(tmp_path)
+    _png(root / 'images' / 'frame-1.png', (1, 1, 1))  # bytes no longer match the journal
+    row = _rows(root)[URL]
+    assert not row['eligible']
+
+
+def test_one_video_record_blocks_the_whole_project(tmp_path):
+    root = _project(tmp_path)
+    _record(root, 'clip.png', kind='video', colour=(5, 5, 5))
+    assert not _rows(root)[URL]['eligible']
+
+
+# ---- live check at deletion ------------------------------------------------
+
+class Loc:
+    def __init__(self, text, actions, state):
+        self.text, self.actions, self.state = text, actions, state
+        self.first = self
+
+    def count(self):
+        return 0 if hasattr(self.text, 'pattern') and 'confirm' not in self.actions else 1
+
+    def is_visible(self, **kw):
+        return bool(self.count())
+
+    def click(self, **kw):
+        self.actions.append(self.text)
+
+    def inner_text(self, **kw):
+        return 'Delete this project?'
+
+    def get_by_role(self, *a, **kw):
+        return Loc('confirm', self.actions, self.state)
+
+    def wait_for(self, **kw):
+        if not self.state['toast']:
+            raise RuntimeError('No explicit success confirmation')
+
+
+def _bridge(assets, toast=True):
+    actions, state = [], {'toast': toast}
+    page = NS(url=URL, get_by_text=lambda *a, **kw: Loc(a[0], actions, state),
+              get_by_role=lambda *a, **kw: Loc('dialog', actions, state))
+    bridge = NS(_page=page, ensure_project=lambda *a, **kw: None,
+                media_assets=lambda: assets,
+                _try_resolve=lambda *a, **kw: Loc('project-menu', actions, state))
+    return bridge, actions
+
+
+def test_delete_without_inventory_accepts_images_within_bound():
+    from engine.flow_project_delete import delete
+    bridge, actions = _bridge([{'kind': 'image', 'sig': 'x'}])
+    assert delete(bridge, URL, None, max_images=1)['status'] == 'deleted'
+    assert actions == ['project-menu', 'Delete', 'confirm']
+
+
+def test_delete_without_inventory_refuses_a_video_asset_before_any_click():
+    from engine.flow_project_delete import delete
+    from engine.providers.flow_browser import FlowUIChanged
+    bridge, actions = _bridge([{'kind': 'image', 'sig': 'x'}, {'kind': 'video', 'sig': 'v'}])
+    with pytest.raises(FlowUIChanged, match='non-image'):
+        delete(bridge, URL, None, max_images=5)
+    assert not actions
+
+
+def test_delete_without_inventory_refuses_more_images_than_verified_requests():
+    from engine.flow_project_delete import delete
+    from engine.providers.flow_browser import FlowUIChanged
+    bridge, actions = _bridge([{'kind': 'image', 'sig': str(n)} for n in range(3)])
+    with pytest.raises(FlowUIChanged, match='more images'):
+        delete(bridge, URL, None, max_images=2)
+    assert not actions
+
+
+def test_delete_without_any_evidence_refuses_before_any_click():
+    from engine.flow_project_delete import delete
+    from engine.providers.flow_browser import FlowUIChanged
+    bridge, actions = _bridge([{'kind': 'image', 'sig': 'x'}])
+    with pytest.raises(FlowUIChanged, match='nothing deleted'):
+        delete(bridge, URL, None)
+    assert not actions
+
+
+def test_delete_with_inventory_still_requires_exact_match():
+    from engine.flow_project_delete import delete
+    from engine.providers.flow_browser import FlowUIChanged
+    bridge, actions = _bridge([{'kind': 'image', 'sig': 'extra'}])
+    with pytest.raises(FlowUIChanged, match='captured inventory'):
+        delete(bridge, URL, ['exact'], max_images=5)
+    assert not actions
+
+
+def test_delete_without_success_toast_is_not_reported_as_deleted():
+    from engine.flow_project_delete import delete
+    bridge, _ = _bridge([{'kind': 'image', 'sig': 'x'}], toast=False)
+    with pytest.raises(RuntimeError, match='success'):
+        delete(bridge, URL, None, max_images=1)
+
+
+# ---- cleanup dispatch ------------------------------------------------------
+
+def test_delete_selected_passes_bound_only_when_no_inventory(tmp_path):
+    from engine.flow_project_cleanup import delete_selected
+    calls = []
+
+    class Bridge:
+        def delete_exact_project(self, url, expected_signatures=None, max_images=None):
+            calls.append((expected_signatures, max_images))
+            return {'status': 'deleted'}
+
+    class Provider:
+        def _ensure(self):
+            return Bridge()
+
+    root = _project(tmp_path)
+    delete_selected(root, [_rows(root)[URL]], provider_factory=Provider, lock_held=True)
+    assert calls == [(None, 1)]
+
+
+def test_video_project_is_never_selectable_for_delete(tmp_path):
+    from engine.flow_project_cleanup import delete_selected
+    root = _project(tmp_path, kind='video')
+    with pytest.raises(ValueError):
+        delete_selected(root, [_rows(root)[URL]], provider_factory=lambda: pytest.fail('no browser'),
+                        lock_held=True)
diff -ruN a/tests/test_v768_gemini_video_settle.py b/tests/test_v768_gemini_video_settle.py
--- a/tests/test_v768_gemini_video_settle.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_v768_gemini_video_settle.py	2026-10-20 05:29:08.498194474 +0000
@@ -0,0 +1,53 @@
+"""v7.0.68: Gemini-web video downloads wait for a loaded, stable video tile."""
+from engine.providers.gemini_video import GEMINI_VIDEO_READY_JS, VideoTileSettle
+
+
+class Clock:
+    def __init__(self):
+        self.now = 0.0
+
+    def __call__(self):
+        return self.now
+
+
+def test_chat_text_without_a_loaded_video_never_settles():
+    clock = Clock()
+    settle = VideoTileSettle(clock=clock)
+    for _ in range(20):
+        assert settle.observe({'ready': False, 'src': ''}) is False
+        clock.now += 1.5
+
+
+def test_loaded_video_must_stay_unchanged_for_two_seconds():
+    clock = Clock()
+    settle = VideoTileSettle(clock=clock)
+    assert settle.observe({'ready': True, 'src': 'blob:a'}) is False
+    clock.now += 1.5
+    assert settle.observe({'ready': True, 'src': 'blob:a'}) is False
+    clock.now += 0.5
+    assert settle.observe({'ready': True, 'src': 'blob:a'}) is True
+
+
+def test_source_change_restarts_the_window():
+    clock = Clock()
+    settle = VideoTileSettle(clock=clock)
+    settle.observe({'ready': True, 'src': 'poster-thumb'})
+    clock.now += 1.9
+    assert settle.observe({'ready': True, 'src': 'blob:final'}) is False
+    clock.now += 2.0
+    assert settle.observe({'ready': True, 'src': 'blob:final'}) is True
+
+
+def test_not_ready_resets_the_window():
+    clock = Clock()
+    settle = VideoTileSettle(clock=clock)
+    settle.observe({'ready': True, 'src': 'blob:a'})
+    clock.now += 1.9
+    settle.observe({'ready': False, 'src': 'blob:a'})
+    clock.now += 0.2
+    assert settle.observe({'ready': True, 'src': 'blob:a'}) is False
+
+
+def test_readiness_script_requires_decoded_video_not_metadata_only():
+    assert 'readyState >= 3' in GEMINI_VIDEO_READY_JS
+    assert 'readyState >= 1' not in GEMINI_VIDEO_READY_JS
diff -ruN a/tests/test_v768_language_editions_render.py b/tests/test_v768_language_editions_render.py
--- a/tests/test_v768_language_editions_render.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_v768_language_editions_render.py	2026-10-20 05:29:08.498194474 +0000
@@ -0,0 +1,215 @@
+"""v7.0.68: every selected language edition is rendered from its own reviewed narration.
+
+Real FFmpeg media, no Gemini/TTS/Flow calls. Narration tones are used as voice
+fingerprints: 660 Hz for Hindi and 880 Hz for Odia. An English 440 Hz voice must
+never appear in a non-English edition.
+"""
+import array
+import hashlib
+import importlib.util
+import json
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location('finish_v768', ROOT / 'engine' / 'finishing_studio.py')
+finish = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(finish)
+
+needs_ffmpeg = pytest.mark.skipif(not (shutil.which('ffmpeg') and shutil.which('ffprobe')), reason='FFmpeg required')
+
+
+def _tone(path, frequency, seconds):
+    cmd = ['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i', f'sine=frequency={frequency}:sample_rate=44100',
+           '-t', str(seconds), '-c:a', 'libmp3lame', '-b:a', '128k', str(path)]
+    subprocess.run(cmd, check=True)
+    return path
+
+
+def _picture(path, seconds):
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i', 'testsrc2=size=640x360:rate=24',
+                    '-t', str(seconds), '-an', '-c:v', 'libx264', '-pix_fmt', 'yuv420p', str(path)], check=True)
+    return path
+
+
+def _sha(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def _zero_crossings_per_second(path, seconds=1.0, start=0.0):
+    raw = subprocess.run(['ffmpeg', '-loglevel', 'error', '-ss', str(start), '-i', str(path), '-vn', '-ac', '1', '-ar', '8000',
+                          '-f', 's16le', '-t', str(seconds), '-'], capture_output=True, check=True).stdout
+    samples = array.array('h', raw)
+    crossings = sum(1 for a, b in zip(samples, samples[1:]) if (a < 0) != (b < 0))
+    return crossings / seconds
+
+
+def _duration(path):
+    out = subprocess.run(['ffprobe', '-v', 'error', '-show_entries', 'format=duration', '-of', 'csv=p=0', str(path)],
+                         capture_output=True, text=True, check=True).stdout
+    return float(out.strip())
+
+
+def _job(tmp_path, *, picture_seconds=3.0, hindi_seconds=3.0, odia_seconds=3.0, odia_profile=None):
+    """A finished production: clean visual master plus reviewed Hindi/Odia bundles."""
+    job = tmp_path / 'job'
+    (job / 'render').mkdir(parents=True)
+    (job / 'production').mkdir()
+    (job / 'audio').mkdir()
+    visual = _picture(job / 'render' / 'visual-master.mp4', picture_seconds)
+    finish._atomic_json(job / 'production' / 'visual_master.json',
+                        {'path': str(visual.resolve()), 'sha256': _sha(visual), 'duration': picture_seconds,
+                         'contains': 'picture and approved B-roll only; no speech, captions, music or branding'})
+    bundles = {}
+    for code, freq, seconds in (('hi', 660, hindi_seconds), ('or', 880, odia_seconds)):
+        folder = job / 'speech-editions' / code / ('key-' + code)
+        folder.mkdir(parents=True)
+        audio = _tone(folder / 'voice.mp3', freq, seconds)
+        words = [{'word': 'शब्द', 'start': 0.1, 'end': 0.9}, {'word': 'दो', 'start': 1.0, 'end': 1.8},
+                 {'word': 'तीन', 'start': 2.0, 'end': 2.8}]
+        words_path = folder / 'words.json'
+        words_path.write_text(json.dumps(words, ensure_ascii=False), encoding='utf-8')
+        bundles[code] = {'audio': str(audio), 'audio_sha256': _sha(audio), 'duration': seconds,
+                         'words': str(words_path), 'script': 'स्वीकृत वर्णन', 'language': code,
+                         'timing_source': 'test-measured',
+                         'cards': [{'text': 'नमस्ते', 'start': 0.5, 'end': 2.5, 'start_word': 0, 'end_word': 1,
+                                    'spoken_anchor': 'शब्द दो'}]}
+    profiles = {'hi': None, 'or': odia_profile}
+    finish._atomic_json(job / 'production' / 'language_editions.json',
+                        {'source_language': 'en', 'editions': ['en', 'hi', 'or'], 'profiles': profiles,
+                         'prepare_audio': True, 'bundles': bundles, 'status': 'prepared batch attached'})
+    return job
+
+
+@needs_ffmpeg
+def test_each_selected_language_is_rendered_with_its_own_narration(tmp_path):
+    from engine.language_editions import render_job_editions
+    profile_root = tmp_path / 'profiles'
+    logo = tmp_path / 'odia-logo.png'
+    from PIL import Image
+    Image.new('RGB', (120, 120), 'orange').save(logo)
+    odia_profile = finish.save_profile('Odia Pragati', names={'or': 'ଓଡ଼ିଆ ପ୍ରଗତି'}, logo=logo, root=profile_root)
+    job = _job(tmp_path, odia_profile=str(odia_profile))
+
+    report = render_job_editions(job)
+
+    assert report['status'] == 'exported', report
+    hindi = Path(report['editions']['hi']['path'])
+    odia = Path(report['editions']['or']['path'])
+    assert hindi.is_file() and odia.is_file()
+    assert hindi.name.startswith('hi-') and odia.name.startswith('or-')
+    # Each edition speaks its own reviewed narration, never the primary/English voice.
+    assert 1250 < _zero_crossings_per_second(hindi) < 1400          # 660 Hz Hindi voice
+    assert 1700 < _zero_crossings_per_second(odia) < 1850           # 880 Hz Odia voice
+    assert abs(_duration(hindi) - 3.0) < 0.3 and abs(_duration(odia) - 3.0) < 0.3
+    hindi_provenance = json.loads(hindi.with_suffix('.provenance.json').read_text(encoding='utf-8'))
+    assert hindi_provenance['captions_burned'] is True and hindi_provenance['narration_fitted_picture'] is False
+    assert json.loads(odia.with_suffix('.provenance.json').read_text(encoding='utf-8'))['channel']['name'] == 'Odia Pragati'
+    record = json.loads((job / 'production' / 'language_editions_render.json').read_text(encoding='utf-8'))
+    assert record['status'] == 'exported' and set(record['editions']) == {'hi', 'or'}
+
+    # Re-running reuses the verified exports; nothing is re-rendered or overwritten.
+    again = render_job_editions(job)
+    assert again['status'] == 'exported'
+    assert again['editions']['hi']['path'] == report['editions']['hi']['path']
+
+
+@needs_ffmpeg
+def test_longer_localized_narration_stretches_the_picture_within_the_limit(tmp_path):
+    from engine.language_editions import render_job_editions
+    job = _job(tmp_path, picture_seconds=3.0, hindi_seconds=3.3, odia_seconds=3.0)
+    report = render_job_editions(job)
+    assert report['status'] == 'exported', report
+    export = Path(report['editions']['hi']['path'])
+    assert abs(_duration(export) - 3.3) < 0.2          # the whole Hindi narration is kept
+    assert 1250 < _zero_crossings_per_second(export, seconds=1.0, start=0.5) < 1400   # Hindi voice intact
+    provenance = json.loads(export.with_suffix('.provenance.json').read_text(encoding='utf-8'))
+    assert provenance['narration_fitted_picture'] is True
+
+
+@needs_ffmpeg
