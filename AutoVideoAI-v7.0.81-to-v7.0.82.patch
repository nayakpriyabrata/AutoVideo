+SECRET_PAID = "paid-secret-value"
+DAILY_BODY = ('{"error":{"message":"Rate limit exceeded for model gemini-3.8-flash-tts (limit: 10 requests per day '
+              'on Free Tier).","status":"RESOURCE_EXHAUSTED"}}')
+
+
+class FakeResponse:
+    def __init__(self, status=200, body=None, text=""):
+        self.status_code = status
+        self._body = body
+        self.text = text
+
+    def json(self):
+        return self._body
+
+
+@pytest.fixture
+def clean_env(monkeypatch):
+    import os
+    for name in list(os.environ):
+        if name == "GEMINI_API_KEY" or name.startswith("GEMINI_API_KEY_") or name == "GEMINI_TTS_CHUNK_CHARS":
+            monkeypatch.delenv(name, raising=False)
+    return monkeypatch
+
+
+@pytest.fixture
+def fake_audio(monkeypatch):
+    """Skip ffmpeg: every part becomes a small placeholder file."""
+    monkeypatch.setattr(TTS.GeminiTTSProvider, "_part_to_mp3",
+                        staticmethod(lambda raw, part: open(part, "wb").write(b"x" * 2048)))
+
+    def concat(parts, out):
+        with open(out, "wb") as handle:
+            for part in parts:
+                handle.write(open(part, "rb").read())
+
+    monkeypatch.setattr(TTS, "_concat_mp3", concat)
+    monkeypatch.setattr(TTS, "_mp3_len", lambda path: 3.0)
+    monkeypatch.setattr(TTS.time, "sleep", lambda seconds: None)
+
+
+@pytest.fixture
+def capture_posts(monkeypatch):
+    calls = []
+
+    def fake_post(url, headers=None, json=None, timeout=None):
+        calls.append({"key": (headers or {}).get("x-goog-api-key"), "model": json["model"]})
+        return FakeResponse(200, {"audio": base64.b64encode(b"\x00\x20" * 6000).decode()})
+
+    monkeypatch.setattr(requests, "post", fake_post)
+    return calls
+
+
+def test_default_part_size_is_2400_and_env_can_tune_it(clean_env):
+    assert TTS.gemini_chunk_chars() == 2400
+    clean_env.setenv("GEMINI_TTS_CHUNK_CHARS", "3000")
+    assert TTS.gemini_chunk_chars() == 3000
+    clean_env.setenv("GEMINI_TTS_CHUNK_CHARS", "100")
+    assert TTS.gemini_chunk_chars() == 500
+    clean_env.setenv("GEMINI_TTS_CHUNK_CHARS", "huge")
+    assert TTS.gemini_chunk_chars() == 2400
+
+
+def test_a_five_thousand_character_narration_is_three_parts_not_five(clean_env):
+    text = " ".join(f"This is sentence number {i} about the daily habit." for i in range(110))
+    assert 4900 <= len(text) <= 5600
+    parts = TTS.split_speech_text(text)
+    assert all(len(part) <= 2400 for part in parts)
+    assert 2 <= len(parts) <= 3
+    assert " ".join(parts) == text
+
+
+def test_profiles_list_names_without_leaking_key_values(clean_env):
+    clean_env.setenv("GEMINI_API_KEY", SECRET_DEFAULT)
+    clean_env.setenv("GEMINI_API_KEY_PAID", SECRET_PAID)
+    clean_env.setenv("GEMINI_API_KEY_EMPTY", "  ")
+    profiles = TTS.gemini_key_profiles()
+    assert profiles == ["default", "paid"]
+    assert SECRET_DEFAULT not in repr(profiles) and SECRET_PAID not in repr(profiles)
+
+
+def test_missing_profile_error_names_the_variable_not_a_value(clean_env):
+    clean_env.setenv("GEMINI_API_KEY", SECRET_DEFAULT)
+    with pytest.raises(RuntimeError, match="GEMINI_API_KEY_OTHER is not configured"):
+        TTS.gemini_api_key("other")
+    assert TTS.gemini_api_key("default") == SECRET_DEFAULT
+
+
+def test_route_parsing_and_per_language_dict(clean_env):
+    assert TTS.split_route("gemini-lite@Paid") == ("gemini-lite", "paid")
+    assert TTS.split_route("gemini") == ("gemini", "")
+    assert TTS.split_route(None) == ("auto", "")
+    routes = {"default": "auto", "or": "gemini-lite@paid"}
+    assert TTS.provider_for_language(routes, "or") == "gemini-lite@paid"
+    assert TTS.provider_for_language(routes, "en") == "auto"
+    assert TTS.provider_for_language("gemini", "hi") == "gemini"
+
+
+def test_check_tts_language_accepts_gemini_profiles_for_odia(clean_env):
+    check_tts_language("gemini-lite@paid", "or")
+    check_tts_language({"default": "auto", "or": "gemini@paid"}, "or")
+    with pytest.raises(ValueError, match="Odia requires"):
+        check_tts_language("edge@paid", "or")
+    with pytest.raises(ValueError, match="Odia requires"):
+        check_tts_language({"default": "auto", "or": "groq"}, "or")
+
+
+def test_each_route_sends_its_own_key_and_model(clean_env, fake_audio, capture_posts, tmp_path):
+    clean_env.setenv("GEMINI_API_KEY", SECRET_DEFAULT)
+    clean_env.setenv("GEMINI_API_KEY_PAID", SECRET_PAID)
+    TTS.synthesize_narration("Short English narration.", "x", str(tmp_path / "en.mp3"), provider="gemini", language="en")
+    TTS.synthesize_narration("ଓଡ଼ିଆ ବାକ୍ୟ ଏଠାରେ ଅଛି।", "gemini-native-odia", str(tmp_path / "or.mp3"),
+                             provider="gemini-lite@paid", language="or")
+    assert capture_posts[0] == {"key": SECRET_DEFAULT, "model": "gemini-3.8-flash-tts"}
+    assert capture_posts[1] == {"key": SECRET_PAID, "model": "gemini-3.8-flash-lite-tts"}
+
+
+def test_dict_routes_send_each_language_to_its_own_route(clean_env, fake_audio, capture_posts, tmp_path):
+    clean_env.setenv("GEMINI_API_KEY", SECRET_DEFAULT)
+    clean_env.setenv("GEMINI_API_KEY_PAID", SECRET_PAID)
+    routes = {"default": "gemini", "or": "gemini-lite@paid"}
+    TTS.synthesize_narration("Hello there.", "x", str(tmp_path / "en.mp3"), provider=routes, language="en")
+    TTS.synthesize_narration("ଓଡ଼ିଆ ବାକ୍ୟ।", "gemini-native-odia", str(tmp_path / "or.mp3"), provider=routes, language="or")
+    assert [call["key"] for call in capture_posts] == [SECRET_DEFAULT, SECRET_PAID]
+    assert [call["model"] for call in capture_posts] == ["gemini-3.8-flash-tts", "gemini-3.8-flash-lite-tts"]
+
+
+def test_profile_on_a_non_gemini_route_is_refused(clean_env, tmp_path):
+    with pytest.raises(RuntimeError, match="applies only to Gemini"):
+        TTS.synthesize_narration("Hello.", "x", str(tmp_path / "a.mp3"), provider="edge@paid", language="en")
+
+
+def test_missing_profile_fails_before_any_request(clean_env, capture_posts, tmp_path):
+    clean_env.setenv("GEMINI_API_KEY", SECRET_DEFAULT)
+    with pytest.raises(RuntimeError, match="GEMINI_API_KEY_PAID is not configured"):
+        TTS.synthesize_narration("Hello.", "x", str(tmp_path / "a.mp3"), provider="gemini@paid", language="en")
+    assert capture_posts == []
+
+
+def test_daily_limit_message_names_the_key_profile(clean_env, monkeypatch, tmp_path):
+    clean_env.setenv("GEMINI_API_KEY_PAID", SECRET_PAID)
+    monkeypatch.setattr(requests, "post", lambda *a, **k: FakeResponse(429, {"error": {}}, DAILY_BODY))
+    with pytest.raises(TTS.GeminiQuotaExceeded, match="Key profile 'paid'"):
+        TTS.synthesize_narration("Hello.", "x", str(tmp_path / "a.mp3"), provider="gemini-lite@paid", language="en")
