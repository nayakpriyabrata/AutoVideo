+"""v7.0.91: uploaded references are identified by their stable Flow tile label, not by asset URL.
+
+Field case (shot_020, 2026-10-25): every project load gave the same two uploaded references new
+/asb/ URLs, so URL-based exclusion never held, the probes were downloaded again on every run, and
+the generation wait saw the references as fresh output. v7.0.91 records each classified reference's
+AV_<hash>_<filename> label, excludes those labels from the wait, and reuses the saved reference bytes
+instead of downloading them again. It also adds an archive step that moves an unresolved journal aside
+only with an explicit credit-spend flag. No test here submits a prompt or spends credits.
+"""
+import fcntl
+import importlib.util
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+from PIL import Image
+
+from engine import flow_image_transaction as tx
+from engine.providers import flow_browser
+from engine.providers.flow_browser import FlowBrowser, FlowRequestPending
+
+PROJECT = 'https://flow.google.com/project/cccccccc-cccc-cccc-cccc-cccccccccccc'
+LOCATION_LABEL = 'AV_197ff6e22dbe_location_master.jpg'
+CHARACTER_LABEL = 'AV_5a1ca5dde04e_character-aradhya-aaa37613-0.jpg'
+TOOL = Path(__file__).resolve().parents[1] / 'tools' / 'archive_uncertain_flow_image.py'
+
+
+def picture(path, color):
+    Image.new('RGB', (128, 96), color).save(path)
+    return str(path)
+
+
+def tile(sig, label=''):
+    hint = ('Tile displaying a user\'s image ' + label) if label else 'Tile displaying a generated image'
+    return {'kind': 'image', 'sig': sig, 'tile_hint': hint, 'hint': hint}
+
+
+class Bridge:
+    normalize_project_url = staticmethod(FlowBrowser.normalize_project_url)
+
+    def __init__(self, tiles, served):
+        self.tiles = list(tiles)     # tile dicts currently visible in the project
+        self.served = served         # signature -> file bytes source
+        self.project = PROJECT
+        self.downloads = []
+
+    def current_project_url(self): return self.project
+    def media_assets(self): return [dict(t) for t in self.tiles]
+
+    def download_latest_asset(self, path, preferred_signature, **kw):
+        self.downloads.append(preferred_signature)
+        Path(path).write_bytes(Path(self.served[preferred_signature]).read_bytes())
+
+
+class Provider:
+    def __init__(self, bridge): self.bridge = bridge
+
+
+@pytest.fixture
+def refs(tmp_path):
+    location = picture(tmp_path / 'location_master.jpg', 'red')
+    character = picture(tmp_path / 'character.png', 'blue')
+    generated = picture(tmp_path / 'scene.jpg', 'green')
+    request = {'schema_version': 1, 'scope': tx.SCOPE, 'kind': 'image', 'status': 'pending',
+               'phase': 'submission_uncertain', 'project_url': PROJECT, 'project_name': 'AutoVideo-Image-test',
+               'reference_hashes': {location: tx.sha(location), character: tx.sha(character)},
+               'baseline': [], 'signature': '', 'submitted_prompt': 'x'}
+    return tmp_path, [location, character], generated, request
+
+
+def test_reference_label_is_read_from_the_tile_hint_and_nothing_else():
+    assert tx.reference_label(tile('x', LOCATION_LABEL)) == LOCATION_LABEL
+    assert tx.reference_label({'tile_hint': 'Tile displaying a generated image'}) == ''
+    assert tx.reference_label({'hint': 'AV_5a1ca5dde04e_character-aradhya-aaa37613-0.png  extra'}) == \
+        'AV_5a1ca5dde04e_character-aradhya-aaa37613-0.png'
+
+
+def test_exclusion_drops_only_the_classified_reference_labels():
+    tiles = [tile('/asb/new-location', LOCATION_LABEL), tile('/asb/new-character', CHARACTER_LABEL),
+             tile('/asb/new-output')]
+    kept = tx.exclude_reference_labels(tiles, [LOCATION_LABEL, CHARACTER_LABEL])
+    assert [t['sig'] for t in kept] == ['/asb/new-output']
+    assert [t['sig'] for t in tx.exclude_reference_labels(tiles, [])] == [t['sig'] for t in tiles]
+
+
+def test_reloaded_references_with_new_urls_are_reused_and_not_downloaded_again(refs):
+    tmp_path, (location, character), generated, request = refs
+    output = tmp_path / 'shot_020_open.jpg'
+    # First load: the two references are classified and their bytes saved. No output yet.
+    first = Bridge([tile('/asb/old-location', LOCATION_LABEL), tile('/asb/old-character', CHARACTER_LABEL)],
+                   {'/asb/old-location': location, '/asb/old-character': character})
+    with pytest.raises(RuntimeError, match='No unique non-reference image'):
+        tx.capture(Provider(first), first, request, output, [location, character])
+    assert sorted(first.downloads) == ['/asb/old-character', '/asb/old-location']
+    refs_recorded = [e for e in request['capture_probes'].values() if e.get('reference')]
+    assert len(refs_recorded) == 2
+    assert sorted(e['reference_label'] for e in refs_recorded) == sorted([LOCATION_LABEL, CHARACTER_LABEL])
+
+    # Second load: Flow gives both references new URLs and the real output is now visible.
+    second = Bridge([tile('/asb/new-location', LOCATION_LABEL), tile('/asb/new-character', CHARACTER_LABEL),
+                     tile('/asb/new-output')],
+                    {'/asb/new-output': generated, '/asb/new-location': location,
+                     '/asb/new-character': character})
+    tx.capture(Provider(second), second, request, output, [location, character])
+
+    assert second.downloads == ['/asb/new-output']          # references were not downloaded again
+    assert tx.completed(output, request)
+    assert output.read_bytes() == Path(generated).read_bytes()
+    probe_files = [p for p in output.parent.glob('shot_020_open.jpg.probe-*')]
+    assert len(probe_files) == 3                              # 2 references + 1 output, no duplicates
+
+
+def test_generation_wait_excludes_labelled_references_even_after_their_urls_change(monkeypatch):
+    now = {'t': 10_000.0}
+    monkeypatch.setattr(flow_browser.time, 'time', lambda: now['t'])
+    tiles = [tile('/asb/new-location', LOCATION_LABEL), tile('/asb/new-character', CHARACTER_LABEL)]
+    b = FlowBrowser.__new__(FlowBrowser)
+    b.ui = {'actions': {}, 'timeouts': {'generation': 300, 'poll_interval': 8}}
+    b._page = SimpleNamespace(inner_text=lambda selector: 'Done',
+                              wait_for_timeout=lambda ms: now.__setitem__('t', now['t'] + ms / 1000.0))
+    b.detect_failure = lambda: None
+    b.detect_service_busy = lambda: None
+    b.state_cb = None
+    b.media_assets = lambda: [dict(t) for t in tiles]
+
+    found = b.wait_for_agent_generation(before_assets=set(), timeout_s=60, required_kind='image',
+                                        transactional_images=True,
+                                        exclude_labels=[LOCATION_LABEL, CHARACTER_LABEL])
+    assert found is False                                     # only references are visible: nothing to hand over
+    assert b.last_generated_asset_signature is None
+
+    tiles.append(tile('/asb/new-output'))
+    now['t'] = 10_000.0
+    found = b.wait_for_agent_generation(before_assets=set(), timeout_s=60, required_kind='image',
+                                        transactional_images=True,
+                                        exclude_labels=[LOCATION_LABEL, CHARACTER_LABEL])
+    assert found is True
+    assert b.last_generated_asset_signature == '/asb/new-output'
+
+
+def run_tool(*args):
+    spec = importlib.util.spec_from_file_location('archive_uncertain_flow_image', TOOL)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.main(list(args))
+
+
+def journal(output, **extra):
+    data = {'schema_version': 1, 'scope': tx.SCOPE, 'kind': 'image', 'status': 'pending',
+            'phase': 'submission_uncertain', 'submission_acknowledged': False,
+            'project_url': PROJECT, 'capture_probes': {}}
+    data.update(extra)
+    tx.journal_path(output).write_text(json.dumps(data), encoding='utf-8')
+    return data
+
+
+def test_archive_without_the_confirm_flag_changes_nothing(tmp_path, capsys):
+    output = tmp_path / 'shot_020_open.jpg'
+    journal(output)
+    assert run_tool(str(output)) == 0
+    assert tx.journal_path(output).is_file()
+    assert 'Nothing was changed' in capsys.readouterr().out
+
+
+def test_archive_with_the_flag_moves_the_journal_aside_byte_for_byte(tmp_path):
+    output = tmp_path / 'shot_020_open.jpg'
+    journal(output, phase='submitted', submission_acknowledged=True)
+    original = tx.journal_path(output).read_bytes()
+    assert run_tool(str(output), '--confirm-new-credit-spend') == 0
+    assert not tx.journal_path(output).exists()
+    archived = list(tmp_path.glob('shot_020_open.jpg.flow-request.archived-*.json'))
+    assert len(archived) == 1 and archived[0].read_bytes() == original
+
+
+@pytest.mark.parametrize('phase', ['preparing', 'downloaded_pending', 'pending'])
+def test_archive_refuses_any_other_phase(tmp_path, phase):
+    output = tmp_path / 'shot_020_open.jpg'
+    journal(output, phase=phase)
+    assert run_tool(str(output), '--confirm-new-credit-spend') == 2
+    assert tx.journal_path(output).is_file()
+
+
+def test_archive_refuses_when_a_valid_non_reference_image_is_saved(tmp_path):
+    output = tmp_path / 'shot_020_open.jpg'
+    probe = picture(tmp_path / 'shot_020_open.jpg.probe-aaaa.jpg', 'green')
+    journal(output, capture_probes={'k': {'file': Path(probe).name, 'reference': False}})
+    assert run_tool(str(output), '--confirm-new-credit-spend') == 2
+    assert tx.journal_path(output).is_file()
+
+
+def test_archive_allows_a_journal_whose_probes_are_real_reference_paths(tmp_path):
+    # Field shape (shot_020 journal): "reference" holds the matched reference path, not True.
+    output = tmp_path / 'shot_020_open.jpg'
+    probe = picture(tmp_path / 'shot_020_open.jpg.probe-5347.jpg', 'red')
+    journal(output, capture_probes={'k': {'file': Path(probe).name, 'state': 'downloaded',
+                                          'reference': '/mnt/outputs/references/location_master.jpg'}})
+    assert run_tool(str(output), '--confirm-new-credit-spend') == 0
+    assert not tx.journal_path(output).exists()
+
+
+def test_archive_refuses_while_the_job_is_running(tmp_path):
+    output = tmp_path / 'shot_020_open.jpg'
+    journal(output)
+    with (tmp_path / '.production.lock').open('a+b') as held:
+        fcntl.flock(held, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        assert run_tool(str(output), '--confirm-new-credit-spend') == 2
+    assert tx.journal_path(output).is_file()
+
+
+def test_archive_with_no_journal_is_a_clean_no_op(tmp_path):
+    assert run_tool(str(tmp_path / 'shot_020_open.jpg'), '--confirm-new-credit-spend') == 0
