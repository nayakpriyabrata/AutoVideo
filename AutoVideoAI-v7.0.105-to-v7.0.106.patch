+#!/usr/bin/env python3
+"""Apply the v7.0.106 update to a v7.0.105 installation.
+
+Two field requests:
+
+1. **Approve every Flow video request once, not just the first.** A job needing eight Flow videos needed seven
+   manual clicks, and after a pause a manual ``approve-request`` before Resume could do anything - because a
+   submitted request whose card was never clicked has no video to download, so every scan "honestly" found
+   nothing. Now each saved request is approved exactly once (visible card, readable cost, within the per-take
+   cap), never twice, never with "Always approve", and never when ``flow_approval = manual``.
+2. **Keep the rendered video when a job is cleaned up.** Permanent deletion used to remove the folder that held
+   the finished video. It is now moved to ``<outputs>/_render-backups/<job>/`` first, and Clip Studio cleanup
+   moves its clips to ``_render-backups/clips`` - with a verification step that refuses the deletion if the
+   backup cannot be made.
+
+Nothing is generated, rendered or charged by this update itself.
+
+Usage (run from the existing installation folder, after extracting the 7.0.106 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.106/tools/update_v7105_to_v7106.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.106/tools/update_v7105_to_v7106.py . --apply    # installs the code
+
+Only code and documentation are replaced. Outputs, saved jobs, Flow journals, browser profiles and
+Clip Studio folders are never copied, moved or deleted. Stop the dashboard before --apply.
+"""
+
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = ['APPROVE_ONCE_AND_RENDER_BACKUPS_V7_0_106.md', 'VERSION', 'app.py', 'cli.py',
+           'engine/automatic_recovery.py', 'engine/clip_cleanup.py', 'engine/factory.py',
+           'engine/flow_approval_once.py', 'engine/flow_resume_recovery.py', 'engine/job_delete.py',
+           'engine/providers/flow_browser.py', 'engine/render_backup.py', 'engine/studio_config.py',
+           'tests/test_v7106_approval_and_backups.py', 'tools/update_v7105_to_v7106.py']
+# Files as they exist in 7.0.105: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['e419a0b909b90b8f47baa4f77239b41800bdf4e5ad16462e8cd8b700156e1fed'],
+    'app.py': ['db9144975ecfad553cf7e4cb398a6b34412a426a3394f8953e0058ef4c1ba13e'],
+    'cli.py': ['12d3f84e7f6ad2c6ccbc4c9c2382afcd0a3a4d81c5693b9393f7b06c86a8b597'],
+    'engine/automatic_recovery.py': ['cef8a0ca826eee4bd61331a61919b6901bb495a7ba3a15f950572c2c129b222b'],
+    'engine/clip_cleanup.py': ['2bcc4727301a5ff430dd3532f7786ad4b12a7d268904bd9e83a5cdbe6c47ed01'],
+    'engine/factory.py': ['273fd0904fb660f6b91c9e6ede5165c18754386ba5db3caa8eb72bb547ab93e9'],
+    'engine/flow_resume_recovery.py': ['f566687aa97cac15b7195d014dfa4758991796c8aeaa8b8be18d9d98323ff847'],
+    'engine/job_delete.py': ['66925467fa070bde4fdf45f2766829b855a3b29fb295e6b7b592785e1aad5cc6'],
+    'engine/providers/flow_browser.py': ['c1c5a014394c24df7125b1b22acf83573390c3bb9b90c590a590543c2214a1ee'],
+    'engine/studio_config.py': ['136f71af15372264c2f0a9fd2a77e41536dace8a19663dafa1a1efb04e984894'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.105', '7.0.106')  # 7.0.106 allows a safe re-run after success
+
+# The 7.0.105 zip carries the 7.0.104 to 7.0.105 update; apply that first on an older installation.
+EARLIER_STEPS = [
+    ('7.0.104', '7.0.105', 'tools/update_v7104_to_v7105.py'),
+]
+
+
+def chain_message(current):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.105 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.105 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.105 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this 7.0.106 update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current))
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the 7.0.106 folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        if destination.exists() and sha(destination) not in ALLOWED.get(name, []) + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+    plan = {'target': str(target), 'installed_version': current, 'apply': args.apply,
+            'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every 7.0.106 code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v7.0.105-to-v7.0.106-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to 7.0.106. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat).')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
+        raise SystemExit(1)
