+    output = job / 'storyboard' / 'shot_023_open.jpg'
+    location = picture(job / 'storyboard' / 'location_master.jpg', 'red')
+    character = picture(job / 'storyboard' / 'character.png', 'blue')
+    request = {'schema_version': 1, 'scope': tx.SCOPE, 'kind': 'image', 'status': 'pending',
+               'phase': 'submitted', 'submission_acknowledged': True, 'project_url': SAVED,
+               'project_name': 'AutoVideo-Image-19-22', 'request_hash': 'h1', 'shot_id': 'shot_023',
+               'vertical': False, 'submitted_prompt': 'x', 'source_prompt': 'x',
+               'baseline': [], 'signature': '',
+               'reference_hashes': {location: tx.sha(location), character: tx.sha(character)},
+               'capture_probes': {}}
+    tx.write_json(tx.journal_path(output), request)
+    return job, output, request, [location, character]
