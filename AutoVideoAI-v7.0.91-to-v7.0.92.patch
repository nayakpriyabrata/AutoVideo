+    job = tmp_path / '20261022-143856-7-small-daily-habits-tha-9729'
+    storyboard = job / 'storyboard'
+    storyboard.mkdir(parents=True)
+    output = storyboard / 'shot_020_open.jpg'
+    location = picture(tmp_path / 'location_master.jpg', 'red')
+    character = picture(tmp_path / 'character.png', 'blue')
+    generated = picture(tmp_path / 'scene.jpg', 'green')
+    request = {'schema_version': 1, 'scope': tx.SCOPE, 'kind': 'image', 'status': 'pending',
+               'phase': 'submission_uncertain', 'submission_acknowledged': False,
+               'project_url': PROJECT, 'project_name': 'AutoVideo-Image-test',
+               'reference_hashes': {location: tx.sha(location), character: tx.sha(character)},
+               'baseline': [], 'signature': '', 'submitted_prompt': 'x',
+               'capture_probes': {
+                   'k1': {'project_url': PROJECT, 'signature': '/asb/old-location', 'state': 'downloaded',
+                          'file': 'shot_020_open.jpg.probe-5347.jpg', 'reference': location},
+                   'k2': {'project_url': PROJECT, 'signature': '/asb/old-character', 'state': 'downloaded',
+                          'file': 'shot_020_open.jpg.probe-e62b.jpg', 'reference': character}}}
+    tx.write_json(tx.journal_path(output), request)
+    return output, [location, character], generated, request
+
+
+def test_labelled_references_are_never_downloaded_even_for_an_old_journal(stalled_shot):
+    output, (location, character), generated, request = stalled_shot
+    bridge = Bridge([tile('/asb/new-location', LOCATION_LABEL), tile('/asb/new-character', CHARACTER_LABEL)],
+                    {'/asb/new-location': location, '/asb/new-character': character})
+    with pytest.raises(FlowRequestPending):
+        tx.recover(Provider(bridge), request, output, compiled={})
+    assert bridge.downloads == []
+    assert not output.exists()
+
+
+def test_a_run_with_no_generated_tile_waits_once_and_stops_with_the_archive_command(stalled_shot):
+    output, (location, character), generated, request = stalled_shot
+    bridge = Bridge([tile('/asb/new-location', LOCATION_LABEL), tile('/asb/new-character', CHARACTER_LABEL)],
+                    {}, output_appears=None)
+    with pytest.raises(FlowRequestPending) as info:
