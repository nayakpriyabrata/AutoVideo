+#!/usr/bin/env python3
+"""Apply the v7.0.123 update to a v7.0.122 installation.
+
+Three reports after v7.0.122:
+
+1. "I don't see the earlier selected channel profile is attached to either of the language" - Create step 3 chose
+   a channel profile per language, the narration batch never recorded it, and a job created from prepared voices
+   wrote no ``production/language_editions.json``: no channel name, no logo, no intro, no outro. The batch now
+   records ``channel_profiles`` per language, the job is given them, and Queue & Resume can attach a profile to a
+   job that already exists.
+
+2. "keep the resume of the failed or scripted or planned jobs in this ... we can keep the tts in a separate
+   section" - prepared narration moved to its own page, **Jobs & Recovery -> Prepared Voices**, with the batch
+   picker, the character, the channel profile per language, and the stopped-TTS section. Queue & Resume now only
+   resumes a saved job, and creating a job lands there.
+
+3. "one of the old failed job, i want you to fix it" - a frame that stopped because two real images were saved
+   can now be decided: Queue & Resume lists the saved images of every waiting frame and keeps the one you choose,
+   locally (no browser, no Flow request, no credit, nothing deleted), and ``v3 keep-frame`` does the same.
+
+Usage (run from the existing installation folder, after extracting the 7.0.123 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.123-Branding-Pages-And-Choice/tools/update_v7122_to_v7123.py .         # dry run
+    python3 ../AutoVideoAI-v7.0.123-Branding-Pages-And-Choice/tools/update_v7122_to_v7123.py . --apply # install
+
+Only code, documentation and tests are replaced. Outputs, saved jobs, speech batches, Flow journals and request
+files, character photos, channel profiles, browser profiles and ``music_library/`` are never copied, moved or
+deleted. Stop the dashboard before --apply.
+"""
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = [
+    'VERSION', 'app.py', 'cli.py',
+    'engine/channel_profiles.py', 'engine/flow_choice.py',
+    'engine/batch_actions.py', 'engine/speech_batches.py', 'engine/speech_cards.py',
+    'tests/test_v7120_use_prepared_voices.py', 'tests/test_v7121_run_prepared_voices.py',
+    'tests/test_v7119_queue_narration_and_steps.py', 'tests/test_v7122_cast_and_every_batch.py',
+    'tests/test_v7123_branding_pages_and_choice.py',
+    'BRANDING_PAGES_AND_CHOICE_V7_0_123.md', 'tools/update_v7122_to_v7123.py',
+]
+# Files as they exist in 7.0.122: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['d23aa1959198e16b50aba707f58ca64ff041aa93dae581d02b91e774eb21b4c2'],
+    'app.py': ['88b59855b94a3766076b63c0ca6ff58c01840bcd5987ef1c440c6879508b1b7e'],
+    'cli.py': ['0ddbeb11895d9229be33fa22c052e40b42cf4d244cbeb3eed7ac91748d088c93'],
+    'engine/batch_actions.py': ['60a13f336458bcdeb4233407b4ce32b738c96afc51b83708c2200d7e7c54e3d7'],
+    'engine/speech_batches.py': ['52be37af9cb2bdebd859e28a5f02fd4dffca2238cd6bd9e1f51f65b9925da898'],
+    'engine/speech_cards.py': ['8d9561ac7eca8fe6c4cd04e536c617aae58c0a2cee7cba3b7489cdc8090de0c6'],
+    'tests/test_v7121_run_prepared_voices.py': ['42910c97fe76a5bb06aea7b78680b2296033ebb1a886b3beef594ec28ec99ab2'],
+    'tests/test_v7122_cast_and_every_batch.py': ['c42c020427b87355523a3eaaf3142d0403ada0ac71441188212126193e8a68f8'],
+    'tests/test_v7120_use_prepared_voices.py': [
+        '519d5f4472435ce6fdaf2ffa852a2a7307aebc304ebce572a54e9fbedad9fb9d'],
+    'tests/test_v7119_queue_narration_and_steps.py': [
+        'd03c0182a69e1be9dce769c4daff70a4af3ef233fc4513de9ca6b287e211ce98'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.122', '7.0.123')  # 7.0.123 allows a safe re-run after success
+
+# An older installation must walk the zips one at a time; this one knows the step before it.
+EARLIER_STEPS = [
+    ('7.0.121', '7.0.122', 'tools/update_v7121_to_v7122.py'),
+]
+
+
+def chain_message(current, version):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.122 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.122 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.122 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this ' + version + ' update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current, source.name or '7.0.123'))
+    new_version = (source / 'VERSION').read_text(encoding='utf-8').strip()
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the ' + new_version +
+                         ' folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        allowed = ALLOWED.get(name, [])
+        if destination.exists() and allowed and sha(destination) not in allowed + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+        if destination.exists() and not allowed and sha(destination) != expected[name]:
+            # A file this release introduces must not overwrite a different file that already sits at that path.
+            raise ValueError('A different file already exists where this update installs ' + name +
+                             '; preserved it and changed nothing. Move it aside and run the update again.')
+    plan = {'target': str(target), 'installed_version': current, 'new_version': new_version,
+            'apply': args.apply, 'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every ' + new_version + ' code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v' + current + '-to-v' + new_version + '-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to ' + new_version + '. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat), then check the install with:')
+        print('    python3 cli.py v3 self-check')
+        print('Then: Jobs & Recovery > Prepared Voices creates a job from your TTS (character + channel profile '
+              'per language, then "Create the job from these voices"). Queue & Resume resumes a saved job, can '
+              'attach its channel profile in "Channel profile", and can decide a frame that stopped with more '
+              'than one saved image in "Saved images waiting for your choice" - locally, with no Flow request and '
+              'no credit. From a terminal: python3 cli.py v3 use-voices --list / --create-job --rights '
+              'own_content [--cast <id>] [--channel en=<profile>,...], python3 cli.py v3 channel <job> '
+              '[--set en=<profile>], python3 cli.py v3 keep-frame <job> [--image <file> --keep <n>].')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
+        raise SystemExit(1)
