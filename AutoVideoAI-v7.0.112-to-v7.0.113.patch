@@ -0,0 +1,228 @@
+"""v7.0.113: the Odia transcript that came back when the narration had to be fitted.
+
+Field report, after v7.0.112 made the renderer look at the picture: the current Odia export is recorded as
+`captions: false` for the job, its provenance says `captions_burned: true ... from the reviewed script`, and the
+picture check agrees - bright text with sharp edges in the caption band. So the render really did burn a transcript
+the job had switched off.
+
+Cause, reproduced on the 7.0.112 tree before changing it: when a narration is longer than the picture, the render
+fits it (slows the picture, speeds the voice, optionally holds the last frame) and then **handed the retimed word
+file to the caption stage unconditionally**. ``words_path`` was ``None`` because the plan asked for no captions;
+fifteen lines later it was a file, and captions were burned. Every language whose narration needed fitting was
+affected, from 7.0.107 (when fitting landed) to 7.0.112.
+
+These tests hold the fix to four promises:
+
+* fitting never re-enables captions the job switched off - and never suppresses captions it asked for;
+* a plain render repairs a job that is already in the field state (export with captions, job wanting none),
+  keeping the earlier file;
+* a file that disagrees even after being rendered again is not re-rendered for ever: it is kept and explained;
+* the messages name the cause instead of asking the user to do what they already did.
+"""
+import json
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+needs_ffmpeg = pytest.mark.skipif(not (shutil.which('ffmpeg') and shutil.which('ffprobe')),
+                                  reason='FFmpeg required')
+os.environ.setdefault('HOME', '/tmp')
+
+WORDS = [{'word': 'ଶବ୍ଦ' + str(i), 'start': 0.3 + i * 0.75, 'end': 0.3 + i * 0.75 + 0.6} for i in range(10)]
+FIT = {'allow_hold': 8.0, 'hold_cap': 8.0}
+
+
+def _job(tmp_path, *, narration_seconds=7.8, picture_seconds=6.0, transcript=None):
+    """A job whose Odia narration is longer than the picture, so every render has to fit it."""
+    from engine.production import digest
+    job = tmp_path / 'job'
+    (job / 'render').mkdir(parents=True)
+    (job / 'production').mkdir()
+    picture = job / 'render' / 'visual-master.mp4'
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i',
+                    f'testsrc2=size=640x360:rate=24', '-t', str(picture_seconds), '-an',
+                    '-c:v', 'libx264', '-pix_fmt', 'yuv420p', str(picture)], check=True)
+    (job / 'production' / 'visual_master.json').write_text(json.dumps(
+        {'path': str(picture), 'sha256': digest(picture), 'duration': picture_seconds}), encoding='utf-8')
+    folder = job / 'speech-editions' / 'or' / 'key'
+    folder.mkdir(parents=True)
+    voice = folder / 'voice.wav'
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i',
+                    'sine=frequency=700:sample_rate=44100', '-t', str(narration_seconds),
+                    '-c:a', 'pcm_s16le', str(voice)], check=True)
+    (folder / 'words.json').write_text(json.dumps(WORDS, ensure_ascii=False), encoding='utf-8')
+    bundle = {'audio': str(voice), 'audio_sha256': digest(voice), 'duration': narration_seconds,
+              'words': str(folder / 'words.json'), 'script': ' '.join(word['word'] for word in WORDS),
+              'language': 'or', 'timing_source': 'test', 'cards': [], 'text_cards': False}
+    state = {'source_language': 'en', 'editions': ['en', 'or'], 'profiles': {'or': None},
+             'bundles': {'or': bundle}}
+    if transcript is not None:
+        state['transcript'] = {'default': transcript, 'languages': {}}
+    (job / 'production' / 'language_editions.json').write_text(json.dumps(state, ensure_ascii=False),
+                                                               encoding='utf-8')
+    return job
+
+
+def _entry(job, code='or'):
+    from engine.language_editions import _record_path
+    return json.loads(_record_path(job).read_text(encoding='utf-8'))['editions'][code]
+
+
+def _provenance(entry):
+    return json.loads(Path(entry['path']).with_suffix('.provenance.json').read_text(encoding='utf-8'))
+
+
+# --------------------------------------------------------------------------- the bug itself
+
+
+@needs_ffmpeg
+def test_a_fitted_edition_with_its_transcript_off_burns_no_captions(tmp_path):
+    """The field bug: the job asks for no transcript, the narration is 30% too long, and captions came back."""
+    from engine.language_editions import render_job_editions
+    from engine.render.caption_check import probe
+    job = _job(tmp_path)
+    report = render_job_editions(job, fit_policy=FIT)
+    assert report['status'] == 'exported', report
+    entry = _entry(job)
+    assert entry['captions'] is False                     # the job's wish
+    assert _provenance(entry)['captions_burned'] is False  # and the file
+    assert entry['caption_words_sha256'] == ''
+    picture = probe(entry['path'])
+    assert picture['checked'] and picture['looks_like_text'] is False, picture['detail']
+    assert entry['captions_detected']['looks_like_text'] is False
+    # the fitting itself still happened: the picture was stretched/held to the narration
+    assert _provenance(entry)['narration_fitted_picture'] is True
+
