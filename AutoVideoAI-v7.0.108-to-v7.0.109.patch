+def test_diagnosis_says_which_languages_have_a_transcript(tmp_path):
+    from engine.language_editions import edition_diagnosis
+    job = _state_job(tmp_path)
+    _finished(job, 'hi', True)
+    (job / 'render' / (job.name + '-hi-edition.mp4')).write_bytes(b'video')
+    diagnosis = edition_diagnosis(job, verify=False)
+    assert diagnosis['transcript']['editions'] == {'hi': True, 'or': False}
+    # Hindi was burned with a transcript and still wants one; Odia has not rendered yet and wants none.
+    assert diagnosis['editions']['hi'].get('transcript') is True
+    assert diagnosis['editions']['or'].get('transcript') is False
+    assert 'transcript is switched off' in diagnosis['editions']['or']['message']
