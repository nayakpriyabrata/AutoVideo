+"""v7.0.92: a saved shot request that can never finish must stop cleanly, not loop.
+
+Field case (shot_020, 2026-10-25, runs 15:59 to 16:52 IST): the saved Flow project held only the two
+uploaded references. Each run re-downloaded both references (their URLs had rotated), waited six minutes
+silently, retried twice, and ended at "Recovery needs attention". No Resume could finish.
+
+v7.0.92 fixes this in three ways, tested here with fakes only (no browser, no submission, no credits):
+1. Uploaded references are recognised by their live AV_<hash>_<file> label and are never downloaded,
+   including for journals written before the label existed.
+2. When the wait finds no generated tile, recovery stops after that single wait with an explicit reason.
+3. The blocked-Resume message names the exact archive command, which needs --confirm-new-credit-spend.
+"""
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+from PIL import Image
+
+from engine import flow_image_transaction as tx
+from engine.flow_resume_safety import FlowResumeBlocked, check_job
+from engine.providers.flow_browser import FlowBrowser, FlowRequestPending
+
+ROOT = Path(__file__).resolve().parents[1]
+PROJECT = 'https://flow.google.com/project/b25567e3-ae85-4c25-b409-bbfa7d9c0488'
+LOCATION_LABEL = 'AV_197ff6e22dbe_location_master.jpg'
+CHARACTER_LABEL = 'AV_5a1ca5dde04e_character-aradhya-aaa37613-0.jpg'
+
+
+def picture(path, color):
+    Image.new('RGB', (128, 96), color).save(path)
+    return str(path)
+
+
+def tile(sig, label=''):
+    hint = "Tile displaying a user's image " + label if label else 'Tile displaying a generated image'
+    return {'kind': 'image', 'sig': sig, 'tile_hint': hint, 'hint': hint}
+
+
+class Bridge:
+    normalize_project_url = staticmethod(FlowBrowser.normalize_project_url)
+
+    def __init__(self, tiles, served, output_appears=None):
+        self.tiles = list(tiles)
+        self.served = served
+        self.output_appears = output_appears  # tile added when the wait runs, or None
+        self.project = PROJECT
+        self.downloads = []
+        self.wait_calls = 0
+
+    def current_project_url(self): return self.project
+    def ensure_project(self, *a, **k): self.project = k.get('project_url') or PROJECT
+    def media_assets(self): return [dict(t) for t in self.tiles]
+
+    def download_latest_asset(self, path, preferred_signature, **kw):
+        self.downloads.append(preferred_signature)
+        Path(path).write_bytes(Path(self.served[preferred_signature]).read_bytes())
+
+    def wait_for_agent_generation(self, **kw):
+        self.wait_calls += 1
+        if self.output_appears:
+            self.tiles.append(self.output_appears)
+            return True
+        return False  # six minutes passed; nothing new
+
+
+class Provider:
+    def __init__(self, bridge): self.bridge = bridge
+    def _ensure(self): return self.bridge
+    def close(self): pass
+
+
