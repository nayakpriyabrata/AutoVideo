@@ -0,0 +1,172 @@
+"""v7.0.69 automatic resume: which failures continue unattended, and the backoff budget."""
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from engine import auto_resume as ar
+from engine.automatic_recovery import run_with_recovery
+from engine.factory import RecoverableInterruption
+from engine.providers.flow_browser import (FlowBrowserClosedError, FlowReferenceUnavailable,
+                                           FlowRequestPending, FlowServiceBusy)
+
+
+class FakePM:
+    def __init__(self, root):
+        self.root = str(root)
+        self.logged = []
+
+    def job_dir(self, job_id):
+        return f'{self.root}/{job_id}'
+
+    def log(self, job_id, event, data=None):
+        self.logged.append((job_id, event))
+
+
+def make_factory(root, settings=None):
+    pm = FakePM(root)
+    fac = SimpleNamespace(pm=pm, settings=settings or {'flow_auto_recovery': True})
+    fac._settings = lambda job_id: fac.settings
+    fac.db = SimpleNamespace(upsert=lambda *a, **k: None)
+    fac._write_pause_state = lambda *a, **k: None
+    fac._is_valid_image_file = lambda path: True
+    fac.pm.load_manifest = lambda job_id: SimpleNamespace(shots=[], status='running')
+    fac.pm.save_manifest = lambda manifest: None
+    fac._active_job_providers = []
+    return fac
+
+
+def make_job(root, job_id='job-a'):
+    (root / job_id).mkdir(parents=True, exist_ok=True)
+    return job_id
+
+
+def test_strict_action_retries_only_recoverable_browser_network_and_busy(tmp_path):
+    settings = {'flow_auto_recovery': True}
+    assert ar.strict_failure_action(settings, FlowBrowserClosedError('Image download target closed'), False) == 'retry'
+    assert ar.strict_failure_action(settings, FlowServiceBusy('high demand'), False) == 'retry'
+
+
+def test_strict_action_keeps_manual_paths_for_auth_pending_and_opt_outs():
+    on = {'flow_auto_recovery': True}
+    assert ar.strict_failure_action(on, FlowBrowserClosedError('x'), True) == 'pause'
+    assert ar.strict_failure_action({'flow_auto_recovery': False}, FlowBrowserClosedError('x'), False) == 'fail'
+    assert ar.strict_failure_action(on, None, False) == 'fail'
+    # A submitted request may already have consumed credits: never retried automatically.
+    assert ar.strict_failure_action(on, FlowRequestPending('submitted, download unknown'), False) == 'fail'
+    # Sign-in or quota text is excluded even when the type is recoverable.
+    assert ar.strict_failure_action(on, FlowReferenceUnavailable('sign in required'), False) == 'fail'
+
+
+def test_recoverable_stop_schedules_backoff_then_resets_on_progress(tmp_path):
+    fac = make_factory(tmp_path)
+    make_job(tmp_path)
+    ar.note_recoverable_failure(tmp_path / 'job-a', 'browser closed', progress=[3, 1], now=1000)
+    first = ar.after_run(fac, 'job-a', {'status': 'paused'}, None, now=1000)
+    assert first['state'] == 'waiting' and first['attempts'] == 1
+    assert first['next_at'] == 1000 + 2 * 60
+
+    # Same progress again: the budget keeps counting and the delay grows.
+    ar.note_recoverable_failure(tmp_path / 'job-a', 'browser closed', progress=[3, 1], now=2000)
+    second = ar.after_run(fac, 'job-a', {'status': 'failed'}, None, now=2000)
+    assert second['attempts'] == 2 and second['next_at'] - 2000 == 5 * 60
+
+    # More saved media since last time: a new interruption, so the budget restarts.
+    ar.note_recoverable_failure(tmp_path / 'job-a', 'browser closed', progress=[5, 2], now=3000)
+    third = ar.after_run(fac, 'job-a', {'status': 'paused'}, None, now=3000)
+    assert third['attempts'] == 1 and third['next_at'] - 3000 == 2 * 60
+
+
+def test_budget_exhaustion_and_success_reset(tmp_path):
+    fac = make_factory(tmp_path)
+    make_job(tmp_path)
+    for step in range(ar.MAX_AUTOMATIC_RESUMES):
+        ar.note_recoverable_failure(tmp_path / 'job-a', 'browser closed', progress=[0, 0], now=step)
+        state = ar.after_run(fac, 'job-a', {'status': 'paused'}, None, now=step)
+    assert state['state'] == 'waiting' and state['attempts'] == ar.MAX_AUTOMATIC_RESUMES
+    ar.note_recoverable_failure(tmp_path / 'job-a', 'browser closed', progress=[0, 0], now=99)
+    assert ar.after_run(fac, 'job-a', {'status': 'paused'}, None, now=99)['state'] == 'exhausted'
+    done = ar.after_run(fac, 'job-a', {'status': 'done'}, None, now=100)
+    assert done == {'state': 'idle', 'attempts': 0, 'updated_at': 100}
+
+
+def test_non_recoverable_stop_never_schedules(tmp_path):
+    fac = make_factory(tmp_path)
+    make_job(tmp_path)
+    state = ar.after_run(fac, 'job-a', {'status': 'failed', 'message': 'quota exceeded'}, None, now=5)
+    assert state['state'] == 'stopped'
+    assert 'quota exceeded' in state['reason']
+    assert ar.scan_once(fac, now=10**12, start=lambda f, j: True) == []
+
+
+def test_scan_starts_only_due_jobs_and_restores_state_when_start_refuses(tmp_path):
+    fac = make_factory(tmp_path)
+    make_job(tmp_path, 'due')
+    make_job(tmp_path, 'later')
+    make_job(tmp_path, 'refused')
+    ar.save(tmp_path / 'due' / ar.STATE_FILE, {'state': 'waiting', 'next_at': 100, 'attempts': 1})
+    ar.save(tmp_path / 'later' / ar.STATE_FILE, {'state': 'waiting', 'next_at': 10**9, 'attempts': 1})
+    original = {'state': 'waiting', 'next_at': 100, 'attempts': 2}
+    ar.save(tmp_path / 'refused' / ar.STATE_FILE, original)
+    calls = []
+
+    def start(factory, job_id):
+        calls.append(job_id)
+        return job_id != 'refused'
+
+    started = ar.scan_once(fac, now=500, start=start)
+    assert started == ['due']
+    assert sorted(calls) == ['due', 'refused']
+    assert ar.load(tmp_path / 'due')['state'] == 'running'
+    assert ar.load(tmp_path / 'refused') == original
+    assert ar.load(tmp_path / 'later')['state'] == 'waiting'
+
+
+def test_describe_user_messages(tmp_path):
+    now = time.time()
+    text = ar.describe({'state': 'waiting', 'next_at': now + 11 * 60, 'attempts': 2}, now=now)
+    assert 'about 11 min' in text and 'attempt 2 of 8' in text and 'awake' in text
+    assert 'stopped after 8 attempts' in ar.describe({'state': 'exhausted'}, now=now)
+    assert ar.describe({'state': 'idle'}, now=now) == ''
+
+
+def test_run_with_recovery_records_recoverable_exhaustion(tmp_path):
+    """A repeatedly failing browser-closed job leaves a recoverable note for the supervisor."""
+    fac = make_factory(tmp_path)
+    make_job(tmp_path)
+    error = RecoverableInterruption('job-a', 'shot_001', FlowBrowserClosedError('Image download target closed'), '')
+
+    def failing_run(job_id, progress_cb, auto_render):
+        raise error
+
+    fac._run_job = failing_run
+    with pytest.raises(RecoverableInterruption):
+        run_with_recovery(fac, 'job-a', None, True, sleep=lambda seconds: None)
+    note = ar.load(tmp_path / 'job-a')['pending_failure']
+    assert note['recoverable'] is True and note['progress'] == [0, 0]
+    assert 'Image download target closed' in note['reason']
+
+
+def test_run_with_recovery_does_not_note_auth_failures(tmp_path):
+    fac = make_factory(tmp_path)
+    make_job(tmp_path)
+    error = RecoverableInterruption('job-a', 'shot_001', FlowReferenceUnavailable('sign in required'), '')
+    fac._run_job = lambda job_id, progress_cb, auto_render: (_ for _ in ()).throw(error)
+    with pytest.raises(RecoverableInterruption):
+        run_with_recovery(fac, 'job-a', None, True, sleep=lambda seconds: None)
+    assert 'pending_failure' not in ar.load(tmp_path / 'job-a')
+
+
+def test_job_thread_records_state_when_the_run_ends(tmp_path, monkeypatch):
+    """job_monitor.start runs the job on a thread and records automatic-resume state at the end."""
+    from engine import job_monitor
+    fac = make_factory(tmp_path)
+    make_job(tmp_path, 'job-t')
+    fac.run_job = lambda job_id, progress_cb=None: {'job_id': job_id, 'status': 'done'}
+    ar.save(tmp_path / 'job-t' / ar.STATE_FILE, {'state': 'waiting', 'next_at': 0, 'attempts': 3})
+    assert job_monitor.start(fac, 'job-t') is True
+    task = job_monitor._tasks[str(Path(tmp_path / 'job-t').resolve())]
+    task['thread'].join(timeout=10)
+    assert ar.load(tmp_path / 'job-t') == {'state': 'idle', 'attempts': 0, 'updated_at': ar.load(tmp_path / 'job-t')['updated_at']}
+
