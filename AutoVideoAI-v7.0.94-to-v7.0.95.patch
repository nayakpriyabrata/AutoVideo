diff -ruN -x RELEASE_MANIFEST.json -x '*.pyc' -x __pycache__ -x code-update-backups -x .pytest_cache a/tests/test_v795_three_language_render.py b/tests/test_v795_three_language_render.py
--- a/tests/test_v795_three_language_render.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_v795_three_language_render.py	2026-10-25 14:40:46.000000000 +0000
@@ -0,0 +1,356 @@
+"""v7.0.95: a three-language production really produces three videos.
+
+These tests pin the behaviour that used to leave an English master alone:
+
+* one language can no longer block the others;
+* a prepared-batch review mismatch is a warning on that edition, not a refusal;
+* the extra narrations are prepared during production even when the
+  "prepare automatically" box was never ticked, and a failure there does not
+  stop the primary master;
+* every selected language is explained by name, with the next action;
+* a picture-only master can be recovered (opt-in) when the render never wrote one;
+* one channel profile carries a logo per language, and the edition uses it.
+
+Real FFmpeg media is used; no Gemini, TTS or Flow call is made.
+"""
+import json
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+
+needs_ffmpeg = pytest.mark.skipif(not (shutil.which('ffmpeg') and shutil.which('ffprobe')),
+                                  reason='FFmpeg required')
+
+
+def _tone(path, seconds=3.0, frequency=660):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi',
+                    '-i', f'sine=frequency={frequency}:sample_rate=44100', '-t', str(seconds),
+                    '-c:a', 'libmp3lame', '-b:a', '128k', str(path)], check=True)
+    return path
+
+
+def _picture(path, seconds=3.0):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi',
+                    '-i', 'testsrc2=size=640x360:rate=24', '-t', str(seconds), '-an',
+                    '-c:v', 'libx264', '-pix_fmt', 'yuv420p', str(path)], check=True)
+    return path
+
+
+def _sha(path):
+    import hashlib
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def _bundle(job, code, *, text_cards=True, cards=None, seconds=3.0, frequency=None, educational=False):
+    from engine.production import digest
+    folder = job / 'speech-editions' / code / 'k'
+    audio = _tone(folder / 'voice.mp3', seconds=seconds,
+                  frequency=frequency or {'hi': 660, 'or': 880}.get(code, 440))
+    words = folder / 'words.json'
+    words.write_text(json.dumps([{'word': 'a', 'start': 0.1, 'end': 0.4},
+                                {'word': 'b', 'start': 0.5, 'end': 0.9}]), encoding='utf-8')
+    (folder / 'production').mkdir(parents=True, exist_ok=True)
+    if educational:
+        (folder / 'production' / 'speech_cards.json').write_text(json.dumps({'cards': []}), encoding='utf-8')
+    return {'audio': str(audio), 'words': str(words), 'duration': seconds, 'audio_sha256': digest(audio),
+            'script': 'नमस्ते दुनिया' if code == 'hi' else 'ନମସ୍କାର ଦୁନିଆ', 'language': code,
+            'cards': list(cards or []), 'timing_source': 'native-tts', 'text_cards': bool(text_cards),
+            'educational': bool(educational), 'topic': 't', 'card_provider': 'gemini-web', 'hooks': False,
+            'cards_ready': True, 'hooks_ready': False, 'hooks_error': '', 'review_required': True}
+
+
+def _job(tmp_path, *, narrated=(), with_picture=True, state=None):
+    """A production with a clean picture and one narration bundle per named language."""
+    from engine.language_editions import STATE_NAME
+    from engine.production import save
+    job = tmp_path / 'job'
+    (job / 'render').mkdir(parents=True, exist_ok=True)
+    (job / 'production').mkdir(exist_ok=True)
+    if with_picture:
+        visual = _picture(job / 'render' / 'visual-master.mp4')
+        save(job / 'production' / 'visual_master.json',
+             {'path': str(visual), 'sha256': _sha(visual), 'duration': 3.0, 'contains': 'picture only'})
+    bundles = {code: _bundle(job, code, **({'text_cards': False} if code in () else {})) for code in narrated}
+    save(job / 'production' / STATE_NAME,
+         {'source_language': 'en', 'editions': ['en', 'hi', 'or'], 'profiles': {},
+          'prepare_audio': True, 'bundles': bundles, 'text_cards': True,
+          'hooks_enabled': False, 'educational': False, 'topic': 't', **(state or {})})
+    return job
+
+
+# --------------------------------------------------------------------------- #
+# One language no longer blocks the others
+# --------------------------------------------------------------------------- #
+@needs_ffmpeg
+def test_a_missing_narration_does_not_stop_the_other_languages(tmp_path):
+    from engine.language_editions import render_job_editions
+    # Only Hindi is narrated; Odia has no bundle at all.
+    job = _job(tmp_path, narrated=('hi',))
+    report = render_job_editions(job)
+    assert report['editions']['hi']['status'] == 'exported'
+    assert report['editions']['or']['status'] == 'needs_narration'
+    assert report['status'] == 'partial'
+    assert 'Odia' in report['error'] and 'Hindi' not in report['error']
+    exported = Path(report['editions']['hi']['path'])
+    assert exported.is_file()
+    copy = job / 'render' / (job.name + '-hi-edition.mp4')
+    assert copy.is_file() and _sha(copy) == report['editions']['hi']['sha256']
+
+
+@needs_ffmpeg
+def test_a_rejected_plan_for_one_language_does_not_stop_the_next(tmp_path, monkeypatch):
+    from engine import language_editions as LE
+    job = _job(tmp_path, narrated=('hi', 'or'))
+    real_create_plan = LE.finish.create_plan
+
+    def flaky(source, profile_path, *, languages=('en',), **kwargs):
+        if list(languages) == ['or']:
+            raise ValueError('plan refused for a test reason')
+        return real_create_plan(source, profile_path, languages=languages, **kwargs)
+
+    monkeypatch.setattr(LE.finish, 'create_plan', flaky)
+    report = LE.render_job_editions(job)
+    assert report['editions']['hi']['status'] == 'exported'
+    assert report['editions']['or']['status'] == 'failed'
+    assert 'plan refused for a test reason' in report['editions']['or']['error']
+    assert report['status'] == 'partial'
+
+
+@needs_ffmpeg
+def test_batch_prepared_without_cards_renders_with_a_warning(tmp_path):
+    from engine.language_editions import edition_diagnosis, render_job_editions
+    job = _job(tmp_path, narrated=('hi',))
+    state_path = job / 'production' / 'language_editions.json'
+    state = json.loads(state_path.read_text(encoding='utf-8'))
+    state['bundles']['hi']['text_cards'] = False  # prepared before the cards were switched on
+    state_path.write_text(json.dumps(state, ensure_ascii=False), encoding='utf-8')
+    report = render_job_editions(job)
+    entry = report['editions']['hi']
+    assert entry['status'] == 'exported'
+    assert 'prepared without text cards' in entry['warning']
+    assert edition_diagnosis(job)['editions']['hi']['status'] == 'exported'
+
+
+@needs_ffmpeg
+def test_missing_points_file_keeps_the_plain_cards(tmp_path):
+    from engine import finishing_studio as finish
+    job = _job(tmp_path, narrated=('hi',))
+    state_path = job / 'production' / 'language_editions.json'
+    state = json.loads(state_path.read_text(encoding='utf-8'))
+    state['educational'] = True
+    state['bundles']['hi']['educational'] = True
+    state['bundles']['hi']['cards'] = [{'text': 'x', 'start': 0.2, 'end': 1.0}]
+    state_path.write_text(json.dumps(state, ensure_ascii=False), encoding='utf-8')
+    plan_path = finish.create_plan(job / 'render' / 'visual-master.mp4', {'hi': ''}, languages=['hi'],
+                                   output_root=job / 'plans', source_language='en',
+                                   require_profiles=False, fit_narration=True, captions=True)
+    edition = json.loads(plan_path.read_text(encoding='utf-8'))['editions']['hi']
+    assert edition['educational'] is False
+    assert edition['cards'] and 'points were not saved' in edition['cards_warning']
+
+
+# --------------------------------------------------------------------------- #
+# A missing picture master
+# --------------------------------------------------------------------------- #
+@needs_ffmpeg
+def test_missing_visual_master_is_explained_and_can_be_recovered(tmp_path):
+    from engine.language_editions import (edition_diagnosis, ensure_visual_master,
+                                          render_job_editions)
+    job = _job(tmp_path, narrated=('hi',), with_picture=False)
+    (job / 'render' / 'job-final.mp4').unlink(missing_ok=True)
+    # The primary master has to exist for a recovery; make one from the same picture.
+    _picture(job / 'render' / (job.name + '-final.mp4'))
+    report = render_job_editions(job)
+    assert report['editions']['hi']['status'] == 'needs_picture'
+    assert 'visual_master.json' in report['editions']['hi']['error']
+
+    refused = ensure_visual_master(job, allow_recovered_picture=False)
+    assert refused['status'] == 'refused' and refused['reason']
+    assert edition_diagnosis(job)['visual_master']['ready'] is False
+
+    recovered = ensure_visual_master(job, allow_recovered_picture=True)
+    assert recovered['status'] == 'recovered'
+    assert Path(recovered['path']).is_file()
+    record = json.loads((job / 'production' / 'visual_master.json').read_text(encoding='utf-8'))
+    assert record['recovered'] is True and 'burned captions' in record['contains']
+    report = render_job_editions(job)
+    assert report['editions']['hi']['status'] == 'exported'
+
+
+# --------------------------------------------------------------------------- #
+# Diagnosis
+# --------------------------------------------------------------------------- #
+def test_single_language_job_says_one_video_is_expected(tmp_path):
+    from engine.language_editions import edition_diagnosis
+    job = tmp_path / 'one'
+    (job / 'production').mkdir(parents=True)
+    (job / 'production' / 'language_editions.json').write_text(
+        json.dumps({'source_language': 'en', 'editions': ['en']}), encoding='utf-8')
+    diagnosis = edition_diagnosis(job)
+    assert diagnosis['status'] == 'single_language'
+    assert 'only one video is expected' in diagnosis['message']
