+CARD_STYLES = ('bold', 'playful', 'clean')
+
+
+def _job_card_style(job_root, state=None):
+    """The card style this job's English master used, so an edition can match it (v7.0.112).
+
+    Read from the saved language state first (when the app wrote it), then from the production's own
+    ``publish_readiness.json`` (``text_card_style`` is the resolved style the primary render actually drew).
+    Returns ``''`` when neither is known, and the caller falls back to its own default.
+    """
+    candidates = []
+    if isinstance(state, dict):
+        candidates.append(state.get('card_style'))
+    try:
+        readiness = json.loads((Path(job_root) / 'production' / 'publish_readiness.json').read_text(encoding='utf8'))
+        candidates.append(readiness.get('text_card_style'))
+    except (OSError, ValueError):
+        pass
+    for value in candidates:
+        value = str(value or '').strip().lower()
+        if value in CARD_STYLES:
+            return value
+    return ''
+
+
+def _edition_card_style(edition):
+    """The style one edition draws its cards with: explicit, else the job's, else playful for education."""
+    value = str(edition.get('card_style') or '').strip().lower()
+    if value in CARD_STYLES:
+        return value
+    if bool(edition.get('educational')):
+        return 'playful'
+    return 'bold'
+
+
