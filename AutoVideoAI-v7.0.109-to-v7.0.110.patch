@@ -0,0 +1,282 @@
+"""v7.0.110: the user can read the transcript, fix a spelling, and render that.
+
+Field request: the Odia transcript's words were right and the spellings were not. Rather than only switching the
+transcript off, the user wants to see the exact words and correct them.
+
+The rules these tests hold the feature to:
+
+* the correction changes **screen text only** - the narration file and its timings are never touched, and
+  nothing is generated, recorded or charged;
+* fixing a spelling keeps every measured word time exactly;
+* a correction is per language, triggers a re-render of that language only, and every earlier export survives;
+* a correction that is wrong (empty, out of order, negative) is refused with a message that says what to fix;
+* "use the reviewed script" removes the correction and returns to the v7.0.109 behaviour.
+"""
+import json
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+needs_ffmpeg = pytest.mark.skipif(not (shutil.which('ffmpeg') and shutil.which('ffprobe')),
+                                  reason='FFmpeg required')
+
+WORDS = [
+    {'word': 'ନିଜର', 'start': 0.20, 'end': 0.60},
+    {'word': 'ସ୍ୱାସ୍ଥ୍ୟ', 'start': 0.60, 'end': 1.10},
+    {'word': 'ପ୍ରତି', 'start': 1.10, 'end': 1.40},
+    {'word': 'ଧ୍ୟାନ', 'start': 1.40, 'end': 1.85},
+    {'word': 'ଦିଅ', 'start': 1.85, 'end': 2.20},
+    {'word': 'ପ୍ରତିଦିନ', 'start': 2.20, 'end': 2.80},
+]
+
+
+def _job(tmp_path, code='or'):
+    from engine.production import digest
+    job = tmp_path / 'job'
+    (job / 'production').mkdir(parents=True)
+    (job / 'render').mkdir()
+    folder = job / 'speech-editions' / code / 'key'
+    folder.mkdir(parents=True)
+    audio = folder / 'voice.wav'
+    try:                                       # FFmpeg is only needed by the two render tests
+        subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i',
+                        'sine=frequency=880:sample_rate=44100', '-t', '3', '-c:a', 'pcm_s16le', str(audio)],
+                       check=True)
+    except (OSError, subprocess.CalledProcessError):
+        audio.write_bytes(b'\x00' * 64)
+    words = folder / 'words.json'
+    words.write_text(json.dumps(WORDS, ensure_ascii=False), encoding='utf-8')
+    bundle = {'audio': str(audio), 'audio_sha256': digest(audio), 'duration': 3.0, 'words': str(words),
+              'script': 'ନିଜର ସ୍ୱାସ୍ଥ୍ୟ ପ୍ରତି ଧ୍ୟାନ ଦିଅ ପ୍ରତିଦିନ', 'language': code,
+              'timing_source': 'test', 'cards': [], 'text_cards': False}
+    (job / 'production' / 'language_editions.json').write_text(json.dumps(
+        {'source_language': 'en', 'editions': ['en', code], 'profiles': {code: None}, 'bundles': {code: bundle}}),
+        encoding='utf-8')
+    return job
+
+
+def test_the_editor_shows_the_exact_words_that_would_be_burned(tmp_path):
+    from engine import transcript_edit
+    job = _job(tmp_path)
+    row = transcript_edit.state(job, 'or')
+    assert row['word_count'] == len(WORDS)
+    assert [w['word'] for w in row['words']] == [w['word'] for w in WORDS]
+    assert row['edited'] is False and row['timing'] == 'measured'
+
+
+def test_fixing_a_spelling_keeps_every_measured_time(tmp_path):
+    from engine import transcript_edit
+    job = _job(tmp_path)
+    words = [dict(word) for word in transcript_edit.state(job, 'or')['words']]
+    words[1]['word'] = 'ସ୍ୱାସ୍ଥ୍ୟ।'          # the user's correction
+    saved = transcript_edit.save_words(job, 'or', words, note='test')
+    assert saved['edited'] is True and saved['timing'] == 'unchanged'
+    assert saved['words'][1]['word'] == 'ସ୍ୱାସ୍ଥ୍ୟ।'
+    assert [(w['start'], w['end']) for w in saved['words']] == [(w['start'], w['end']) for w in WORDS]
+    stored = json.loads((job / 'production' / 'transcripts' / 'or.json').read_text(encoding='utf-8'))
+    assert stored['schema'] == 'transcript-edit-v1' and stored['words'][1]['word'] == 'ସ୍ୱାସ୍ଥ୍ୟ।'
+
+
+def test_a_corrected_line_keeps_the_word_count_and_the_timing(tmp_path):
+    from engine import transcript_edit
+    job = _job(tmp_path)
+    translated = 'ନିଜର ସ୍ୱାସ୍ଥ୍ୟ ପ୍ରତି ଧ୍ୟାନ ଦିଅ ପ୍ରତିଦିନ'      # nothing changed
+    saved = transcript_edit.save_text(job, 'or', translated)
+    assert saved['timing'] == 'unchanged'
+    corrected = 'ନିଜର ସ୍ୱାସ୍ଥ୍ୟ ପ୍ରତି ଧ୍ୟାନ ଦିଅ ପ୍ରତିଦିନଁ'      # last word fixed
+    saved = transcript_edit.save_text(job, 'or', corrected)
+    assert saved['words'][-1]['word'] == 'ପ୍ରତିଦିନଁ'
+    assert saved['words'][-1]['start'] == pytest.approx(WORDS[-1]['start'])
+
+
+def test_a_different_word_count_is_accepted_but_reported_as_estimated(tmp_path):
+    from engine import transcript_edit
+    job = _job(tmp_path)
+    saved = transcript_edit.save_text(job, 'or', 'ନିଜର ସ୍ୱାସ୍ଥ୍ୟ ପ୍ରତି ଧ୍ୟାନ ଦିଅ')   # one word fewer
+    assert saved['timing'] == 'estimated'
+    assert saved['word_count'] == 5
+    assert all(word['start'] <= word['end'] for word in saved['words'])
+
+
+@pytest.mark.parametrize('words,expected', [
+    ([], 'empty'),
+    ([{'word': 'a', 'start': 1.0, 'end': 0.5}], 'ends before it starts'),
+    ([{'word': 'a', 'start': 0.0, 'end': 1.0}, {'word': 'b', 'start': 0.5, 'end': 1.2}], 'starts before'),
+])
+def test_a_correction_that_breaks_the_timeline_is_refused_and_nothing_is_saved(tmp_path, words, expected):
+    from engine import transcript_edit
+    job = _job(tmp_path)
+    with pytest.raises(ValueError) as error:
+        transcript_edit.save_words(job, 'or', words)
+    assert expected in str(error.value) and 'nothing was changed' in str(error.value)
+    assert not transcript_edit.edit_path(job, 'or').exists()
+
+
+def test_an_empty_correction_is_refused(tmp_path):
+    from engine import transcript_edit
+    job = _job(tmp_path)
+    with pytest.raises(ValueError) as error:
+        transcript_edit.save_text(job, 'or', '   ')
+    assert '--clear' in str(error.value)
+
+
+def test_removing_the_correction_returns_to_the_measured_words(tmp_path):
+    from engine import transcript_edit
+    job = _job(tmp_path)
+    transcript_edit.save_text(job, 'or', 'ନିଜର ସ୍ୱାସ୍ଥ୍ୟ ପ୍ରତି ଧ୍ୟାନ ଦିଅ ପ୍ରତିଦିନଁ')
+    assert transcript_edit.state(job, 'or')['edited'] is True
+    row = transcript_edit.clear(job, 'or')
+    assert row['edited'] is False
+    assert [w['word'] for w in row['words']] == [w['word'] for w in WORDS]
+
+
+def test_caption_lines_group_words_the_way_the_screen_shows_them(tmp_path):
+    from engine import transcript_edit
+    words = [{'word': f'w{i}', 'start': i * 0.3, 'end': i * 0.3 + 0.3} for i in range(14)]
+    lines = transcript_edit.caption_lines(words, max_words=6)
+    assert [len(line) for line in lines] == [6, 6, 2]
+    assert [word['index'] for line in lines for word in line] == list(range(14))
+
+
+def test_saving_a_correction_only_writes_the_transcript_file(tmp_path):
+    from engine import transcript_edit
+    job = _job(tmp_path)
+    before = {p: p.stat().st_size for p in job.rglob('*') if p.is_file()}
+    transcript_edit.save_words(job, 'or', transcript_edit.state(job, 'or')['words'])
+    after = {p: p.stat().st_size for p in job.rglob('*') if p.is_file()}
+    assert set(after) - set(before) == {job / 'production' / 'transcripts' / 'or.json'}
+    assert all(after[path] == size for path, size in before.items())
+
+
+def test_the_edition_is_out_of_date_until_it_is_rendered_again(tmp_path):
+    from engine.language_editions import _bundle_is_current, caption_signature
+    job = _job(tmp_path)
+    bundle = json.loads((job / 'production' / 'language_editions.json').read_text())['bundles']['or']
+    video = job / 'video.mp4'
+    video.write_bytes(b'v')
+    entry = {'status': 'exported', 'audio_sha256': bundle['audio_sha256'], 'path': str(video),
+             'captions': True, 'caption_words_sha256': ''}
+    assert caption_signature(job, 'or')[1] == 'measured'
+    assert _bundle_is_current(job, 'or', bundle, entry, verify=False, captions_sha='') is True
+    from engine import transcript_edit
+    transcript_edit.save_words(job, 'or', transcript_edit.state(job, 'or')['words'])
+    sha, source = caption_signature(job, 'or')
+    assert source == 'edited' and sha
+    assert _bundle_is_current(job, 'or', bundle, entry, verify=False, captions_sha=sha) is False
+    entry['caption_words_sha256'] = sha
+    assert _bundle_is_current(job, 'or', bundle, entry, verify=False, captions_sha=sha) is True
+
+
+def test_the_render_uses_the_correction_from_an_immutable_snapshot(tmp_path):
+    from engine import transcript_edit
+    job = _job(tmp_path)
+    transcript_edit.save_text(job, 'or', 'ନିଜର ସ୍ୱାସ୍ଥ୍ୟ ପ୍ରତି ଧ୍ୟାନ ଦିଅ ପ୍ରତିଦିନଁ')
+    target = tmp_path / 'plan' / 'assets' / 'captions-or.json'
+    snapshot, report = transcript_edit.snapshot_for_plan(job, 'or', target)
+    assert report['source'] == 'edited' and report['words'] == 6
+    saved = json.loads(snapshot.read_text(encoding='utf-8'))
+    assert saved[-1]['word'] == 'ପ୍ରତିଦିନଁ'
+    # A later edit cannot change the snapshot an in-flight render is using.
+    transcript_edit.clear(job, 'or')
+    assert json.loads(snapshot.read_text(encoding='utf-8'))[-1]['word'] == 'ପ୍ରତିଦିନଁ'
+
+
+def test_without_a_correction_the_snapshot_holds_the_measured_words(tmp_path):
+    from engine import transcript_edit
+    job = _job(tmp_path)
+    snapshot, report = transcript_edit.snapshot_for_plan(job, 'or', tmp_path / 'captions.json')
+    assert report['source'] == 'measured'
+    assert [w['word'] for w in json.loads(snapshot.read_text(encoding='utf-8'))] == [w['word'] for w in WORDS]
+
+
+def test_a_language_without_words_says_which_languages_have_them(tmp_path):
+    from engine import transcript_edit
+    job = _job(tmp_path)
+    with pytest.raises(ValueError) as error:
+        transcript_edit.state(job, 'hi')
+    assert 'hi' in str(error.value) and 'or' in str(error.value)
+
+
+# ---------------------------------------------------------------- real render
+
+
+def _renderable_job(tmp_path):
+    from engine import finishing_studio as finish
+    from engine.production import digest
+    job = tmp_path / 'job'
+    (job / 'render').mkdir(parents=True)
+    (job / 'production').mkdir()
+    picture = job / 'render' / 'visual-master.mp4'
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i',
+                    'testsrc2=size=640x360:rate=24', '-t', '3', '-an', '-c:v', 'libx264',
+                    '-pix_fmt', 'yuv420p', str(picture)], check=True)
+    (job / 'production' / 'visual_master.json').write_text(json.dumps(
+        {'path': str(picture), 'sha256': finish._hash(picture), 'duration': 3.0, 'contains': 'picture only'}),
+        encoding='utf-8')
+    folder = job / 'speech-editions' / 'or' / 'key'
+    folder.mkdir(parents=True)
+    audio = folder / 'voice.wav'
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i',
+                    'sine=frequency=880:sample_rate=44100', '-t', '3', '-c:a', 'pcm_s16le', str(audio)], check=True)
+    words = folder / 'words.json'
+    words.write_text(json.dumps(WORDS, ensure_ascii=False), encoding='utf-8')
+    bundle = {'audio': str(audio), 'audio_sha256': digest(audio), 'duration': 3.0, 'words': str(words),
+              'script': 'ନିଜର ସ୍ୱାସ୍ଥ୍ୟ ପ୍ରତି ଧ୍ୟାନ ଦିଅ ପ୍ରତିଦିନ', 'language': 'or', 'timing_source': 'test',
+              'cards': [], 'text_cards': False}
+    (job / 'production' / 'language_editions.json').write_text(json.dumps(
+        {'source_language': 'en', 'editions': ['en', 'or'], 'profiles': {'or': None}, 'bundles': {'or': bundle},
+         'transcript': {'default': True, 'languages': {}}}), encoding='utf-8')
+    return job
+
+
+@needs_ffmpeg
+def test_a_corrected_transcript_is_what_the_export_burns(tmp_path):
+    from engine import transcript_edit
+    from engine.language_editions import render_job_editions
+    job = _renderable_job(tmp_path)
+    transcript_edit.save_text(job, 'or', 'ନିଜର ସ୍ୱାସ୍ଥ୍ୟ ପ୍ରତି ଧ୍ୟାନ ଦିଅ ପ୍ରତିଦିନଁ')
+    report = render_job_editions(job)
+    assert report['status'] == 'exported', report
+    export = Path(report['editions']['or']['path'])
+    provenance = json.loads(export.with_suffix('.provenance.json').read_text(encoding='utf-8'))
+    assert provenance['captions_burned'] is True
+    assert provenance['captions_from_correction'] is True
+    assert provenance['captions_from_reviewed_script'] is False
+    assert 'correction' in provenance['captions_note']
+    # The plan snapshot FFmpeg burned from holds the user's word, not the recognizer's.
+    plan = json.loads(Path(provenance['plan']).read_text(encoding='utf-8'))
+    burned = Path(plan['editions']['or']['caption_words']['path'])
+    assert burned.is_file() and burned.parent.name == 'assets'
+    assert json.loads(burned.read_text(encoding='utf-8'))[-1]['word'] == 'ପ୍ରତିଦିନଁ'
+
+    # Rendering again with nothing changed produces no new file.
+    again = render_job_editions(job)
+    assert again['status'] == 'exported'
+    assert len(sorted((job / 'language_editions').glob('*/exports/*.mp4'))) == 1
+
+    # A new correction re-renders that language, and the earlier export stays on disk.
+    earlier = Path(report['editions']['or']['path'])
+    transcript_edit.save_text(job, 'or', 'ନିଜର ସ୍ୱାସ୍ଥ୍ୟ ପ୍ରତି ଧ୍ୟାନ ଦିଅ ପ୍ରତିଦିନ।')
+    third = render_job_editions(job)
+    assert third['status'] == 'exported'
+    newest = Path(third['editions']['or']['path'])
+    exports = set((job / 'language_editions').glob('*/exports/*.mp4'))
+    assert len(exports) == 2 and newest in exports and earlier in exports and newest != earlier
+
+
+@needs_ffmpeg
+def test_the_corrected_words_reach_the_burned_captions_file(tmp_path):
+    """The ASS the renderer builds must contain the corrected spelling, not the measured one."""
+    from engine import transcript_edit
+    from engine.render.captions_ass import build_captions
+    job = _renderable_job(tmp_path)
+    transcript_edit.save_text(job, 'or', 'ନିଜର ସ୍ୱାସ୍ଥ୍ୟ ପ୍ରତି ଧ୍ୟାନ ଦିଅ ପ୍ରତିଦିନଁ')
+    words, report = transcript_edit.words_for_render(job, 'or')
+    assert report['source'] == 'edited'
+    captions = build_captions(words, str(tmp_path / 'captions'), template='HORMOZI', aspect='16:9',
+                              W=640, H=360, duration=3.0)
+    text = Path(captions['ass']).read_text(encoding='utf-8')
+    assert 'ପ୍ରତିଦିନଁ' in text.replace('\u200d', '\u200d')
