+def graphics_audit_panel(job_id):
+    """Why on-screen cards and hooks did or did not appear (v7.0.107).
+
+    The job used to look broken from the outside: the plan listed graphics, the video seemed to have none. The
+    audit says what was requested, what was prepared, what reached the timeline, and - on demand - whether each
+    card can be seen in the finished file.
+    """
+    from engine.graphics_audit import (build_report, explain, plan_path, _read,
+                                       write as write_graphics_audit)
+    job_dir = Path(F.pm.job_dir(job_id))
+    audit_file = job_dir / 'production' / 'graphics_audit.json'
+    if not audit_file.is_file() and not plan_path(job_dir).is_file():
+        return
+    label = 'Text cards and hooks · what appeared, and why'
+    with st.expander(label, expanded=False):
+        st.code(explain(job_dir), language='text')
+        masters = sorted((job_dir / 'render').glob('*-final*.mp4'),
+                         key=lambda path: path.stat().st_mtime, reverse=True)
+        if not masters:
+            st.caption('No finished video yet. Render the job, then check the cards here.')
+            return
+        st.caption('The check samples the finished video where each card should be and compares it with a '
+                   'frame of the same region a moment earlier. A card that never rendered cannot pass.')
+        if st.button('Check these cards in the finished video', key=f'check-graphics-{job_id}'):
+            try:
+                overlays = _read(plan_path(job_dir), []) or []
+                from engine.render.graphic_visibility import verify
+                verified = verify(masters[0], overlays)
+                stored = _read(audit_file) or build_report(job_dir, overlays=overlays)
+                stored['verified_in_video'] = verified
+                write_graphics_audit(job_dir, stored)
+                if verified.get('missing'):
+                    st.warning('Not found in the video: ' + ', '.join(verified['missing'][:6]))
+                else:
+                    st.success(f"All {verified.get('checked', 0)} sampled cards are visible in the video.")
+                st.rerun()
+            except Exception as error:
+                st.error('The graphics check failed: ' + str(error))
+
