+#!/usr/bin/env python3
+"""Apply the v7.0.114 update to a v7.0.113 installation.
+
+One field report on 7.0.113, when the repair it introduced was run for the first time:
+
+    [ 50%] Rendering Odia edition
+    "error": "FFmpeg failed: av_interleaved_write_frame(): Input/output error
+              Error writing trailer of .../.render-j06ayvm3/picture-fit.mp4: Input/output error"
+    Odia: no current video yet
+
+Three things were wrong, and the repair itself was not one of them:
+
+1. **The message named a temp file that was already deleted** and nothing about the volume. "Input/output error"
+   while writing a trailer is what a full, over-quota or read-only volume looks like to FFmpeg. The failure now
+   reports the file, the free space on that volume in GB, and what to do - and a listing that finds a job in this
+   state measures the volume again when you run it.
+2. **The working picture was written twice.** It carried ``+faststart``, which rewrites the whole file at trailer
+   time - the exact moment this render died - for a file that is decoded again immediately and never played. It is
+   now written once, without it.
+3. **A failed render hid the file you still had.** The record was replaced by the failure, so the previous Odia
+   export - complete, on disk, with its captions - became "no current video yet". The previous export is now kept
+   in the record as ``kept_export`` and named everywhere: the listing, the panel diagnosis and the job summary. It
+   is described as what it is, unchanged but not repaired.
+
+The language stays pending, so after the cause is fixed the same command finishes the job. Nothing is re-recorded
+and no Flow credit is spent by it.
+
+Usage (run from the existing installation folder, after extracting the 7.0.114 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.114/tools/update_v7113_to_v7114.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.114/tools/update_v7113_to_v7114.py . --apply    # installs the code
+
+Only code, documentation and tests are replaced. Outputs, saved jobs, Flow journals, browser profiles and
+``music_library/`` are never copied, moved or deleted. Stop the dashboard before --apply.
+"""
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = [
+    'VERSION',
+    'engine/finishing_studio.py', 'engine/language_editions.py', 'engine/edition_files.py',
+    'tests/test_v7114_failed_repair_keeps_file.py',
+    'REPAIR_THAT_FAILED_V7_0_114.md', 'tools/update_v7113_to_v7114.py',
+]
+# Files as they exist in 7.0.110: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['3e317c697be4d298a7ddbfb5b3a08a18346e927b7e30c17eae6bf2d9174c6c47'],
+    'engine/finishing_studio.py': ['d17f6362fcc7eaf6d2c20c1b1a34804b7c04b0a77abfb6097e60f46bca88115d'],
+    'engine/language_editions.py': ['dcfee2a4a6c14dc4b29568e79842c7b1d08bbca5a2df8815480dd3dc49f665f6'],
+    'engine/edition_files.py': ['ab45d38a177244f3ee0088522d9df533adc06d7df4ebc4cb3f14cf944522f7fb'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.113', '7.0.114')  # 7.0.114 allows a safe re-run after success
+
+# The 7.0.114 zip carries the 7.0.113 update; apply that first on an older installation.
+EARLIER_STEPS = [
+    ('7.0.112', '7.0.113', 'tools/update_v7112_to_v7113.py'),
+]
+
+
+def chain_message(current, version):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.113 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.113 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.113 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this ' + version + ' update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current, source.name or '7.0.114'))
+    new_version = (source / 'VERSION').read_text(encoding='utf-8').strip()
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the ' + new_version +
+                         ' folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        allowed = ALLOWED.get(name, [])
+        if destination.exists() and allowed and sha(destination) not in allowed + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+    plan = {'target': str(target), 'installed_version': current, 'new_version': new_version,
+            'apply': args.apply, 'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every ' + new_version + ' code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v' + current + '-to-v' + new_version + '-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to ' + new_version + '. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat).')
+        print('Nothing was re-rendered, no voice was re-recorded and no Flow credit was spent. If a repair '
+              'render stopped with an Input/output error, run the same render again after the listing says the '
+              'volume has room: python3 cli.py v3 language-outputs <job> --files --check-captions  - the file you '
+              'already have is kept and named while that language is not current.')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
+        raise SystemExit(1)
