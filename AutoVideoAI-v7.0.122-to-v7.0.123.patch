+def test_the_page_creates_a_job_with_the_chosen_character(install):
+    """The real page: the panel shows a channel box per language and keeps the character that was chosen.
+
+    The channel path itself is proved by the CLI and engine tests above (AppTest cannot drive a selectbox whose
+    ``format_func`` maps profile paths to labels), so this test proves what only the page can: the three channel
+    boxes are offered, and the created job carries the cast from the panel.
+    """
+    profile = make_profile()
+    character = add_character()
+    make_batch(install / 'speech_preparation' / 'panel', 'small daily habits beat big plans.', topic='Panel')
+    from streamlit.testing.v1 import AppTest
+    at = AppTest.from_file(str(ROOT / 'app.py'), default_timeout=300)
+    at.session_state['autovideo_workspace'] = 'Jobs & Recovery'
+    at.session_state['autovideo_current_page'] = 'PREPARED VOICES'
+    at.session_state['autovideo_page_jobs-and-recovery'] = 'PREPARED VOICES'
+    at.run()
+    assert not at.exception, [str(item.value) for item in at.exception]
+    assert 'Run your prepared voices' in [item.value for item in at.subheader]
+    assert len([item for item in at.selectbox if item.label.endswith(' channel')]) == 3
+    assert any(item.label.startswith('Character in this video') for item in at.multiselect)
