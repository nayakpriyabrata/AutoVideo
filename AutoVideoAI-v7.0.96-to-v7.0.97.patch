+"""v7.0.97: shorter image waits, a deletable completed job, Clip Studio cleanup, job-scoped speech batches.
+
+Four field reports, all reproduced here with fakes (no browser, no Flow request, no credits):
+
+1. Every image request waited 360 s even though a saved project either holds the image or does not.
+2. A completed 2.4 GB job could not be deleted because the finished video was named
+   ``<job>-final-broll.mp4`` (the video-cutaway renderer) and the guard only looked for
+   ``<job>-final.mp4``.
+3. Clip Studio kept the downloaded source, speech chunks, caption scratch files, selection history
+   and render state beside the clips with no way to clean them.
+4. The Queue "Speech batches" panel listed every Create step 4 batch of the installation instead of
+   the batch of the Active job.
+"""
+import json
+from pathlib import Path
+
+import pytest
+from PIL import Image
+
+from engine import clip_cleanup
+from engine import flow_image_transaction as tx
+from engine import speech_batches
+from engine.job_delete import completed_job_delete
+from engine.job_cleanup import final_video_candidates, find_final_video, job_completion_state
+from engine.providers.flow_browser import FlowBrowser, FlowBrowserProvider, FlowRequestPending
+
+PROJECT = 'https://flow.google.com/project/ca1709fe-6a77-41a3-95be-4fafe7192ae2'
+
+
+# ---------------------------------------------------------------- 1 · image wait
+
+def test_one_image_waits_sixty_seconds_not_six_minutes():
+    assert tx.DEFAULT_IMAGE_WAIT_SECONDS == 60
+    assert tx.image_wait_seconds() == 60
+    assert tx.image_wait_seconds({}) == 60
+    assert tx.image_wait_seconds({'flow_image_wait_seconds': 120}) == 120
+    assert tx.image_wait_seconds(None, 45) == 45
+    assert tx.image_wait_seconds(None, 10) == 10
+    assert tx.image_wait_seconds({'flow_image_wait_seconds': 'not a number'}) == 60
+    assert tx.image_wait_seconds({'flow_image_wait_seconds': 0}) == 5          # never a zero wait
+    assert tx.image_wait_seconds({'flow_image_wait_seconds': 99999}) == tx.MAX_IMAGE_WAIT_SECONDS
+
+
+class WaitingBridge:
+    normalize_project_url = staticmethod(FlowBrowser.normalize_project_url)
+
+    def __init__(self):
+        self.project = PROJECT
+        self.timeouts = []
+
+    def current_project_url(self): return self.project
+    def ensure_project(self, *a, **k): self.project = k.get('project_url') or PROJECT
+    def media_assets(self): return []
+
+    def wait_for_agent_generation(self, **kw):
+        self.timeouts.append(kw.get('timeout_s'))
+        return False
+
+
+class WaitingProvider:
+    def __init__(self, bridge): self.bridge = bridge
+    def _ensure(self): return self.bridge
+    def close(self): pass
+
+
+def _journal(output, **extra):
+    data = {'schema_version': 1, 'scope': tx.SCOPE, 'kind': 'image', 'status': 'pending',
+            'phase': 'submitted', 'submission_acknowledged': True, 'project_url': PROJECT,
+            'project_name': 'AutoVideo-Image-1', 'request_hash': 'h1', 'shot_id': 'shot_023',
+            'vertical': False, 'submitted_prompt': 'x', 'source_prompt': 'x', 'baseline': [],
+            'signature': '', 'capture_probes': {}, 'reference_hashes': {}}
+    data.update(extra)
+    tx.write_json(tx.journal_path(output), data)
+    return data
+
+
+@pytest.fixture
+def image_shot(tmp_path):
+    job = tmp_path / 'job-v797'
+    (job / 'storyboard').mkdir(parents=True)
+    job.mkdir(exist_ok=True)
+    output = job / 'storyboard' / 'shot_023_open.jpg'
+    return job, output
+
+
+def test_recovery_waits_the_short_default(image_shot):
+    job, output = image_shot
+    request = _journal(output)
+    bridge = WaitingBridge()
+    with pytest.raises(FlowRequestPending):
+        tx.recover(WaitingProvider(bridge), request, output, compiled={})
+    assert bridge.timeouts == [60]
+    assert json.loads(tx.journal_path(output).read_text())['image_wait_seconds'] == 60
+
+
+def test_a_jobs_saved_wait_replaces_the_default(image_shot):
+    job, output = image_shot
+    request = _journal(output)
+    bridge = WaitingBridge()
+    with pytest.raises(FlowRequestPending):
+        tx.recover(WaitingProvider(bridge), request, output, compiled={'flow_image_wait_seconds': 150})
+    assert bridge.timeouts == [150]
+
+
+def test_the_new_setting_is_a_real_job_setting():
+    from engine import studio_config
+    assert studio_config.DEFAULTS['flow_image_wait_seconds'] == 60
+    merged = dict(studio_config.DEFAULTS)
+    from engine.studio_config import _validate_settings
+    _validate_settings(merged)                     # a whole number >= 0
+    merged['flow_image_wait_seconds'] = -5
+    with pytest.raises(ValueError):
+        _validate_settings(merged)
+
+
+# ---------------------------------------------------------------- 2 · deleting a completed job
+
+def _valid_video(path, size=4096):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(b'\x00\x00\x00\x20ftypisom' + b'0' * max(0, size - 12))
+    return path
+
+
+@pytest.fixture
+def no_ffprobe(monkeypatch):
+    """Decide validity from the file itself so the test does not depend on a local encoder."""
+    monkeypatch.setattr(FlowBrowserProvider, '_is_valid_video_file',
+                        staticmethod(lambda path: Path(path).is_file() and Path(path).stat().st_size > 1024))
+
+
+@pytest.fixture
+def outputs(tmp_path):
+    root = tmp_path / 'outputs'
+    root.mkdir()
+    return root
+
+
+def _completed_job(outputs, job_id, final_name):
+    job = outputs / job_id
+    (job / 'render').mkdir(parents=True)
+    (job / 'production_manifest.json').write_text(json.dumps({'status': 'done', 'job_id': job_id}))
+    if final_name:
+        _valid_video(job / 'render' / final_name)
+    return job
+
+
+def test_a_broll_final_video_makes_the_job_eligible(outputs, no_ffprobe):
+    """Field case: the finished video is <job>-final-broll.mp4 because the render used video cutaways."""
+    job = _completed_job(outputs, '20261018-132625-speak-with-confidence--5-0686',
+                         '20261018-132625-speak-with-confidence--5-0686-final-broll.mp4')
+    found, rows = find_final_video(job)
+    assert found and found.name.endswith('-final-broll.mp4')
+    preview = completed_job_delete(outputs, outputs.parent / 'jobs.db', job.name)
+    assert preview['eligible'] is True
+    assert preview['reason_code'] == ''
+    assert preview['final_video'].endswith('-final-broll.mp4')
+    assert preview['final_bytes'] > 0
