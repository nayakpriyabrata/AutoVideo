+#!/usr/bin/env python3
+"""Apply the v7.0.77 update (language editions follow the job's text-card, hook and educational choices) to a v7.0.76 installation.
+
+Usage (run from the existing installation folder, after extracting the 7.0.77 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.77/tools/update_v776_to_v777.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.77/tools/update_v776_to_v777.py . --apply    # installs the code
+
+Only code and documentation are replaced. Outputs, saved jobs, browser profiles,
+music, characters and channel profiles are never copied, moved or deleted.
+A file you changed locally is preserved and the update stops before touching anything.
+Stop the dashboard before --apply.
+"""
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = [
+    'EDITION_CARDS_HOOKS_V7_0_77.md',
+    'VERSION',
+    'app.py',
+    'engine/factory.py',
+    'engine/finishing_studio.py',
+    'engine/language_editions.py',
+    'engine/render/hook_cards.py',
+    'engine/speech_cards.py',
+    'tests/test_v777_edition_cards_hooks.py',
+    'tools/update_v776_to_v777.py',
+]
+# Files as they exist in 7.0.76: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['61a4b881caa988583017f1f49ea24f973699fd16da4d3d817db18ca27512ef0f'],
+    'app.py': ['92056026c9c84acaae5dd3a166fa63742ec802ec48b5aec0646626c4b624937e'],
+    'engine/factory.py': ['68bc023b211a7932b3fb33e5693308444519e53208f46004f58a87a72d258c8a'],
+    'engine/finishing_studio.py': ['46210950ba6a49ce6f4ea9d60228f7ecf71152dd50ce9fa3e002da43acc7f648'],
+    'engine/language_editions.py': ['31c503e2c23569e32a6ac26a07bd935a59c38159d7506609a620b1a98cf968df'],
+    'engine/speech_cards.py': ['4b827c7d2faf06ae337096c570dcea465f80e02c5c9d4314b60aa9e913b01ce7'],
+    'engine/render/hook_cards.py': ['eaab91da7b814174bb083ded3ba06edbfb4e29def24a6e5f051fc699395b26c8'],
+}
+ACCEPTED_INSTALLS = ('7.0.76', '7.0.77')  # 7.0.77 allows a safe re-run after success
+
+# Earlier updates, each shipped in its own release zip. Install them in this order, one step at a time,
+# each run from the installation folder with the matching release folder extracted beside it.
+EARLIER_STEPS = [
+    ('7.0.67', '7.0.68', 'tools/update_v767_to_v768.py'),
+    ('7.0.68', '7.0.69', 'tools/update_v768_to_v769.py'),
+    ('7.0.69', '7.0.70', 'tools/update_v769_to_v770.py'),
+    ('7.0.70', '7.0.71', 'tools/update_v770_to_v771.py'),
+    ('7.0.71', '7.0.72', 'tools/update_v771_to_v772.py'),
+    ('7.0.72', '7.0.73', 'tools/update_v772_to_v773.py'),
+    ('7.0.73', '7.0.74', 'tools/update_v773_to_v774.py'),
+    ('7.0.74', '7.0.75', 'tools/update_v774_to_v775.py'),
+    ('7.0.75', '7.0.76', 'tools/update_v775_to_v776.py'),
+]
+
+
+def chain_message(current):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.76 (found ' + current + '). '
+                'The earlier releases are not recognised by this updater.')
+    lines = []
+    version = current
+    for start, end, path in EARLIER_STEPS:
+        if start != version:
+            continue
+        lines.append('    python3 ../AutoVideoAI-v' + end + '/' + path + ' .' + ' --apply')
+        version = end
+        if version == '7.0.76':
+            break
+    return ('This update requires an installed 7.0.76 (found ' + current + '). Apply the earlier updates in order, '
+            'each from the release zip folder for its version (extract that zip beside this installation first):\n'
+            + '\n'.join(lines) + '\nThen run this 7.0.77 update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current))
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the 7.0.77 folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        if destination.exists() and sha(destination) not in ALLOWED.get(name, []) + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+    plan = {'target': str(target), 'installed_version': current, 'apply': args.apply,
+            'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every 7.0.77 code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v7.0.76-to-v7.0.77-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to 7.0.77. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat).')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
+        raise SystemExit(1)
