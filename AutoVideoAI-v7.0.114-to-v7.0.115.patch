+#!/usr/bin/env python3
+"""Apply the v7.0.115 update to a v7.0.114 installation.
+
+One field report on 7.0.114, from the repair render itself:
+
+    [ 73%] Rendering Odia edition Odia
+    [100%] Language editions finished
+    "error": "Export QC failed: duration or audio"
+
+Fifty-nine minutes of rendering, and that was everything it said. The check behind it was one line that compared the
+finished file's duration with the timeline and threw ``Export QC failed: duration or audio`` - inside the ``try``
+whose ``finally`` deletes the temporary folder, so the finished video was deleted with it. No numbers, no file, no
+cause, nothing to play.
+
+v7.0.115:
+
+1. **The check measures the two tracks separately** and reports both, in seconds. "The picture stops early" and
+   "the narration stops early" are different defects with different repairs, and an mp4 whose *header* merely
+   disagrees with both is neither - that one is now accepted with a note instead of costing another hour.
+2. **A failed export keeps the video it made.** It is copied beside the plan as ``result-<lang>.qc-failed.mp4``,
+   with ``qc-<lang>.json`` holding the numbers, and the job says so: the file exists, play it, here is why it is
+   not marked current.
+3. **The picture is extended to the timeline before the expensive pass.** When the concatenated picture is even
+   slightly shorter than the container says, the last frame is cloned to cover the gap - free - instead of the
+   export landing short and failing after the encode.
+4. **A language with no current export names the videos it still has.** Three field reports in a row said "no
+   current video yet" while finished videos sat in the folder; the newest one on disk is now named, with its date
+   and whether it has captions.
+
+Nothing is generated, re-recorded or charged by this update, and the repair render re-records nothing either: it
+reuses the saved narration and the approved picture.
+
+Usage (run from the existing installation folder, after extracting the 7.0.115 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.115/tools/update_v7114_to_v7115.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.115/tools/update_v7114_to_v7115.py . --apply    # installs the code
+
+Only code, documentation and tests are replaced. Outputs, saved jobs, Flow journals, browser profiles and
+``music_library/`` are never copied, moved or deleted. Stop the dashboard before --apply.
+"""
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = [
+    'VERSION',
+    'engine/finishing_studio.py', 'engine/language_editions.py', 'engine/edition_files.py',
+    'tests/test_v7115_qc_keeps_the_file.py',
+    'EXPORT_CHECK_V7_0_115.md', 'tools/update_v7114_to_v7115.py',
+]
+# Files as they exist in 7.0.110: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['e6aa888014bcdd0da7a253ae5b7806352faf58fd857c4955885872c08807d893'],
+    'engine/finishing_studio.py': ['ac092dc57f2470c3453e734d9aebd52b3c2f8bc31826206c011c68628f4b98e6'],
+    'engine/language_editions.py': ['52289d6b0eb4db5e9d073fc5d86c2d36eabec2b73803d5571865dbbb4f2555b4'],
+    'engine/edition_files.py': ['b8d775a812497453ae30bebaa8d1ee9626c97fa095ad9968886be3b849ba03bc'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.114', '7.0.115')  # 7.0.115 allows a safe re-run after success
+
+# The 7.0.115 zip carries the 7.0.114 update; apply that first on an older installation.
+EARLIER_STEPS = [
+    ('7.0.113', '7.0.114', 'tools/update_v7113_to_v7114.py'),
+]
+
+
+def chain_message(current, version):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.114 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.114 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.114 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this ' + version + ' update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current, source.name or '7.0.115'))
+    new_version = (source / 'VERSION').read_text(encoding='utf-8').strip()
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the ' + new_version +
+                         ' folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        allowed = ALLOWED.get(name, [])
+        if destination.exists() and allowed and sha(destination) not in allowed + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+    plan = {'target': str(target), 'installed_version': current, 'new_version': new_version,
+            'apply': args.apply, 'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every ' + new_version + ' code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v' + current + '-to-v' + new_version + '-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to ' + new_version + '. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat).')
+        print('Nothing was re-rendered, no voice was re-recorded and no Flow credit was spent. To see which '
+              'language video is current, what each one really shows, and where a failed export kept its file: '
+              'python3 cli.py v3 language-outputs <job> --files --check-captions')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
+        raise SystemExit(1)
