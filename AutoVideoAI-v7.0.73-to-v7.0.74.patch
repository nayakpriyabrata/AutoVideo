@@ -122,6 +122,37 @@
     return v
 
 
+def _pop_chain(e: dict, st: float, en: float, W: int, H: int, idx: int, fade_in: float, fade_out: float):
+    """Pop-open / pop-closed animation for one card PNG.
+
+    The card is cropped to its panel box, scaled per frame (eased open, shrink
+    on close) and centred on the box, with alpha fades. Returns the filter
+    chain and the overlay x/y expressions, or None when no valid box is given.
+    """
+    box = e.get("box")
+    if not box or len(box) != 4:
+        return None
+    bx, by, bw, bh = (int(round(float(v))) for v in box)
+    bw -= bw % 2
+    bh -= bh % 2
+    if bw < 2 or bh < 2 or bx < 0 or by < 0 or bx + bw > W or by + bh > H:
+        raise ValueError(f"Card animation box is outside the frame: {box!r}")
+    span = en - st
+    open_d = min(0.45, span * 0.35)
+    close_d = min(0.35, span * 0.25)
+    grow = f"min(1,max(0,(t-{st:.3f})/{open_d:.3f}))"
+    shrink = f"min(1,max(0,(t-{en - close_d:.3f})/{close_d:.3f}))"
+    scale = f"(0.70+0.30*(1-pow(1-{grow},3)))*(1-0.20*{shrink})"
+    chain = (f"[{idx}:v]scale={W}:{H},format=rgba,crop={bw}:{bh}:{bx}:{by},"
+             f"scale=w='trunc({bw}*{scale}/2)*2':h='trunc({bh}*{scale}/2)*2':eval=frame")
+    if fade_in:
+        chain += f",fade=t=in:st={st:.3f}:d={fade_in:.3f}:alpha=1"
+    if fade_out:
+        chain += f",fade=t=out:st={en - fade_out:.3f}:d={fade_out:.3f}:alpha=1"
+    place = f"x='{bx}+({bw}-overlay_w)/2':y='{by}+({bh}-overlay_h)/2'"
+    return chain, place
+
