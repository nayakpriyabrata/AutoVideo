@@ -0,0 +1,228 @@
+"""v7.0.120: "my three languages are narrated - how do I run them?"
+
+v7.0.119 made a finished Create step 4 batch readable and playable, and then stopped: the panel could describe
+the voices and play them, but offered no way to a running job. This release adds the two honest paths and the
+checks around them:
+
+* a production created from the batch's own words (the plan repeats the approved narration exactly, so the saved
+  voices are the script of the job), with the voices attached and nothing generated until an explicit Resume;
+* attaching the voices to a saved job whose approved script is the same narration - the only case where the
+  engine will reuse `production/prepared_speech.json` at all.
+
+It also fixes a crash found while wiring this up: the transcript editor handed Streamlit a LanguagePack object
+instead of a label, so opening any job that had a narratable edition raised
+`TypeError: bad argument type for built-in operation`.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+
+import pytest
+
+from engine.batch_actions import (attach, create_job_from_batch, job_script, jobs_using_script,
+                                  measured_seconds, norm, plan_for_batch)
+from engine.factory import Factory
+
+ROOT = Path(__file__).resolve().parent.parent
+APP = (ROOT / 'app.py').read_text(encoding='utf-8')
+WORDS = [{'word': word, 'start': index * 1.0, 'end': index * 1.0 + 0.9}
+         for index, word in enumerate('small daily habits beat big plans'.split())]
+
+
+def make_batch(shared: Path, key: str, script: str, *, topic='Small habits', languages=('en', 'hi', 'or'),
+               phase='ready_for_review', duration=6.5):
+    """A batch in the real on-disk layout: <batch>/<language>/<key>/voice.mp3 + words.json."""
+    folder = shared / key
+    folder.mkdir(parents=True, exist_ok=True)
+    bundles = {}
+    for code in languages:
+        lang = folder / code / 'k1'
+        lang.mkdir(parents=True, exist_ok=True)
+        audio = lang / 'voice.mp3'
+        audio.write_bytes(b'ID3' + b'\0' * 6000)
+        (lang / 'words.json').write_text(json.dumps(WORDS))
+        bundles[code] = {'language': code, 'audio': str(audio), 'words': str(lang / 'words.json'),
+                         'audio_sha256': hashlib.sha256(audio.read_bytes()).hexdigest(),
+                         'duration': duration, 'timing_source': 'measured', 'script': script}
+    state = {'source_language': 'en', 'source_script': script, 'editions': list(languages),
+             'scripts': {code: script for code in languages},
+             'request': {'provider': 'gemini', 'topic': topic, 'text_cards': True},
+             'error': '', 'bundles': bundles, 'phase': phase}
+    (folder / 'batch.json').write_text(json.dumps(state))
+    from engine.speech_batches import _row
+    return _row(folder, 'Create step 4')
+
+
+@pytest.fixture()
+def install(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv('AUTOVIDEO_SHARED_ROOT', str(tmp_path))
+    (tmp_path / 'speech_preparation').mkdir()
+    (tmp_path / 'outputs').mkdir()
+    return {'root': tmp_path, 'shared': tmp_path / 'speech_preparation', 'factory': Factory()}
+
+
+def test_measured_seconds_comes_from_the_saved_voice(install):
+    batch = make_batch(install['shared'], 'b1', 'Small daily habits beat big plans.', duration=101.4)
+    assert measured_seconds(batch) == 101
+
+
+def test_the_plan_repeats_the_approved_narration_word_for_word(install):
+    script = 'Small  daily habits\nbeat big plans.'
+    batch = make_batch(install['shared'], 'b2', script)
+    path = plan_for_batch(batch, declaration='own_content')
+    plan = json.loads(Path(path).read_text(encoding='utf-8'))
+    assert plan['narration'] == norm(script) == 'Small daily habits beat big plans.'
+    assert plan['language'] == 'en'
+    assert plan['rights'] == {'declaration': 'own_content', 'adaptation_confirmed': True}
+    assert plan['approved'] is True
+    assert 'Create step 4' in plan['provenance']['source']
+    assert Path(path).parent == Path(batch['path'])
+
+
+def test_the_plan_is_refused_without_the_users_own_rights_statement(install):
+    batch = make_batch(install['shared'], 'b3', 'Small daily habits beat big plans.')
+    with pytest.raises(ValueError) as error:
+        plan_for_batch(batch, declaration='')
+    assert 'how you may use this narration' in str(error.value)
+    with pytest.raises(ValueError):
+        plan_for_batch(batch, declaration='vibes')
+
+
+def test_unfinished_voices_cannot_be_turned_into_a_job_or_attached(install):
+    batch = make_batch(install['shared'], 'b4', 'Small daily habits beat big plans.', phase='tts')
+    object.__setattr__(batch, 'ready', None) if False else None
+    batch['ready'] = False
+    with pytest.raises(ValueError) as error:
+        plan_for_batch(batch, declaration='own_content')
+    assert 'not finished yet' in str(error.value)
+    job = install['factory'].create_job('anything', profile='FLOW_ECONOMY', target_seconds=30, dry_run=True)
+    (Path(install['factory'].pm.job_dir(job)) / 'script.json').write_text(json.dumps(
+        {'narration': 'Small daily habits beat big plans.'}))
+    with pytest.raises(ValueError) as error:
+        attach(batch, install['factory'].pm.job_dir(job))
+    assert 'not finished yet' in str(error.value)
+
+
+def test_a_production_created_from_voices_uses_exactly_those_words_and_waits_for_resume(install):
+    batch = make_batch(install['shared'], 'b5', 'Small daily habits beat big plans.', duration=72.4)
+    created = create_job_from_batch(install['factory'], batch, declaration='own_content', max_credits=0)
+    job = created['job_id']
+    folder = Path(install['factory'].pm.job_dir(job))
+    assert created['seconds'] == 72
+    assert job_script(folder) == 'Small daily habits beat big plans.'
+    assert json.loads((folder / 'production' / 'prepared_speech.json').read_text())['language'] == 'en'
+    editions = json.loads((folder / 'production' / 'language_editions.json').read_text())
+    assert editions['editions'] == ['en', 'hi', 'or']
+    assert sorted(editions['bundles']) == ['en', 'hi', 'or']
+    marker = json.loads((folder / 'production' / 'speech_attachment.json').read_text())
+    assert marker['batch'] == batch['path']
+    assert marker['languages'] == ['en', 'hi', 'or']
+    from engine import narration_assets
+    assert narration_assets.labels(folder) == ['English', 'Hindi', 'Odia']
+    # nothing was generated: no shots, no Flow submission, the job is only scripted
+    manifest = install['factory'].pm.load_manifest(job)
+    assert manifest.shots == []
+    assert manifest.status == 'scripted'
+    assert not list((folder / 'flow' / 'shots').glob('**/*.flow-request.json'))
+    assert install['factory'].pm.load_manifest(job).target_seconds == 72
+
+
+def test_attaching_refuses_a_job_whose_script_is_not_these_words(install):
+    batch = make_batch(install['shared'], 'b6', 'Small daily habits beat big plans.')
+    factory = install['factory']
+    other = factory.create_job('a different topic', profile='FLOW_ECONOMY', target_seconds=30, dry_run=True)
+    folder = Path(factory.pm.job_dir(other))
+    (folder / 'script.json').write_text(json.dumps({'narration': 'Something else entirely.'}))
+    with pytest.raises(ValueError) as error:
+        attach(batch, folder)
+    assert 'not the narration these voices speak' in str(error.value)
+    assert not (folder / 'production' / 'prepared_speech.json').exists()
+
+
+def test_attaching_refuses_a_job_without_a_script(install):
+    batch = make_batch(install['shared'], 'b7', 'Small daily habits beat big plans.')
+    factory = install['factory']
+    job = factory.create_job('no script yet', profile='FLOW_ECONOMY', target_seconds=30, dry_run=True)
+    with pytest.raises(ValueError) as error:
+        attach(batch, factory.pm.job_dir(job))
+    assert 'no approved script yet' in str(error.value)
+    assert 'Create a production from these voices' in str(error.value)
+
+
+def test_the_same_voices_can_be_attached_to_a_job_that_already_has_that_script(install):
+    batch = make_batch(install['shared'], 'b8', 'Small daily habits beat big plans.')
+    factory = install['factory']
+    job = factory.create_job('small habits', profile='FLOW_ECONOMY', target_seconds=30, dry_run=True)
+    folder = Path(factory.pm.job_dir(job))
+    (folder / 'script.json').write_text(json.dumps({'narration': 'Small daily habits  beat big plans.'}))
+    matches = jobs_using_script(batch, [factory.pm.job_dir(job)])
+    assert [row['job_id'] for row in matches] == [job]          # whitespace is normalised
+    attached = attach(batch, folder, factory=factory)
+    assert attached['languages'] == ['en', 'hi', 'or']
+    from engine import narration_assets
+    assert narration_assets.labels(folder) == ['English', 'Hindi', 'Odia']
+    assert json.loads((folder / 'production' / 'language_editions.json').read_text())['editions'] == ['en', 'hi', 'or']
+
+
+def test_jobs_with_a_different_script_are_not_offered(install):
+    batch = make_batch(install['shared'], 'b9', 'Small daily habits beat big plans.')
+    factory = install['factory']
+    job = factory.create_job('other', profile='FLOW_ECONOMY', target_seconds=30, dry_run=True)
+    (Path(factory.pm.job_dir(job)) / 'script.json').write_text(json.dumps({'narration': 'Nope.'}))
+    assert jobs_using_script(batch, [factory.pm.job_dir(job)]) == []
+    assert jobs_using_script({'source_script': ''}, [factory.pm.job_dir(job)]) == []
+
+
+def test_the_queue_offers_both_ways_forward_and_promises_no_generation():
+    start = APP.index('def use_voices_controls(row):')
+    block = APP[start:APP.index('def speech_batch_controls(row):')]
+    assert 'Create a production from these voices' in block
+    assert 'Attach these voices to this job' in block
+    assert 'generates a video, records a voice or spends a Flow credit' in block
+    assert 'waits for an explicit Resume' in block
+    assert 'RIGHTS_DECLARATIONS' in block and 'never assumes it' in block
+    # wired into a finished batch, after its audio and text, before that branch returns
+    start = APP.index('def speech_batch_controls(row):')
+    body = APP[start:APP.index('    title = ', start)]
+    assert 'use_voices_controls(row)' in body
+    assert body.index('st.audio(audio)') < body.index('use_voices_controls(row)')
+    assert body.index('Narration text of this batch') < body.index('use_voices_controls(row)')
+    assert body.index('use_voices_controls(row)') < body.index('return', body.index('use_voices_controls(row)'))
+    assert APP.count('use_voices_controls(row)') == 2          # the definition's caller + the invocation
+
+
+def test_the_transcript_editor_no_longer_hands_streamlit_a_language_object():
+    assert 'LANGUAGE_PACKS.get(code, code)' not in APP
+    assert "LANGUAGE_PACKS[code].label" in APP
+
+
+def test_the_queue_page_creates_and_opens_the_production(install):
+    """The real page: click the button on a finished batch and land on the new job."""
+    from streamlit.testing.v1 import AppTest
+    make_batch(install['shared'], 'b10', 'Small daily habits beat big plans.', topic='Small habits')
+    (install['root'] / 'config').symlink_to(ROOT / 'config')
+    (install['root'] / 'assets').symlink_to(ROOT / 'assets')
+    at = AppTest.from_file(str(ROOT / 'app.py'), default_timeout=300)
+    at.session_state['autovideo_workspace'] = 'Jobs & Recovery'
+    at.session_state['autovideo_current_page'] = 'QUEUE'
+    at.session_state['autovideo_page_jobs-and-recovery'] = 'QUEUE'
+    at.run()
+    assert not at.exception, [str(item.value) for item in at.exception]
+    button = next(item for item in at.button if item.label == 'Create a production from these voices')
+    button.click()
+    at.run()
+    assert not at.exception, [str(item.value) for item in at.exception]
+    job_id = at.session_state['job_id']
+    assert job_id
+    folder = Path(install['factory'].pm.job_dir(job_id))
+    assert job_script(folder) == 'Small daily habits beat big plans.'
+    assert (folder / 'production' / 'prepared_speech.json').is_file()
+    assert [m.label for m in at.metric][:2] == ['SCRIPT', 'VOICE']
+    assert [m.value for m in at.metric][:2] == ['✓', '✓']
+    # the confirmation survives the rerun that opens the new job
+    assert any(item.value.startswith('Created job') for item in at.success), [s.value for s in at.success]
+    notice = next(item.value for item in at.success if item.value.startswith('Created job'))
+    assert 'Nothing has been generated' in notice and 'Resume' in notice
+    assert 'Narration' in [item.value for item in at.subheader]
