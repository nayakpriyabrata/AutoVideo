+"""v7.0.119: Queue & Resume shows the narration and the completed steps of the job it opens.
+
+The field report, after installing 7.0.118: "I tried to recover it with Queue and Resume, I don't see the audio
+and completed steps, instead it is showing the last successful job details."  Three separate things produced
+that page:
+
+* every Create step 4 batch of the installation was rendered fully expanded whenever no Active job was
+  selected, and each line read exactly "Create step 4 · English, Hindi, Odia · ready" - no time, no topic,
+  no way to tell one session from another, and no statement that a batch is not a job;
+* a ready batch showed only "tick reuse this exact batch" - never the audio it holds;
+* Queue never showed the job's completed steps, and its VOICE step counted a voice only at
+  ``narration/voice.mp3``, so narration that came from a prepared batch showed a dash.
+"""
+import json
+import os
+import sys
+import time
+from pathlib import Path
+
+import pytest
+
+from engine import narration_assets
+from engine.speech_batches import (display_label, job_audio_shas, list_speech_batches,
+                                  with_attachments)
+
+ROOT = Path(__file__).resolve().parent.parent
+APP = (ROOT / 'app.py').read_text(encoding='utf-8')
+
+
+def _voice(path: Path, payload: bytes = b'ID3' + b'\0' * 6000) -> str:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(payload)
+    return str(path)
+
+
+def _batch(shared: Path, key, topic, editions, phase, done, age, created=None):
+    folder = shared / key
+    folder.mkdir(parents=True, exist_ok=True)
+    bundles = {}
+    for code in editions[:done]:
+        audio = _voice(folder / f'{code}-voice.mp3')
+        (folder / f'{code}-words.json').write_text(json.dumps(
+            {'duration': 61.5, 'words': [{'text': 'word', 'start': 0, 'end': 61.5}]}))
+        bundles[code] = {'language': code, 'audio': audio, 'audio_sha256': 'sha-' + key + '-' + code,
+                         'duration': 61.5, 'words': str(folder / f'{code}-words.json')}
+    state = {'source_language': 'en', 'source_script': 'The master script', 'editions': editions,
+             'scripts': {code: 'narration in ' + code for code in editions}, 'scripts_sha256': 'x',
+             'request': {'provider': 'gemini', 'topic': topic, 'text_cards': True},
+             'error': '', 'bundles': bundles, 'phase': phase}
+    if created:
+        state['created_at'] = created
+    (folder / 'batch.json').write_text(json.dumps(state))
+    os.utime(folder / 'batch.json', (age, age))
+    return folder
+
+
+@pytest.fixture()
+def install(tmp_path, monkeypatch):
+    """A miniature installation: three Create step 4 batches and one job holding an old stopped batch."""
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv('AUTOVIDEO_SHARED_ROOT', str(tmp_path))
+    # app.py reads config/presets at import time; the rest of the installation is what this fixture builds.
+    (tmp_path / 'config').symlink_to(ROOT / 'config')
+    (tmp_path / 'assets').symlink_to(ROOT / 'assets')
+    now = time.time()
+    shared = tmp_path / 'speech_preparation'
+    newest = _batch(shared, 'newest1', 'The Growth Mindset of small daily habits',
+                    ['en', 'hi', 'or'], 'ready_for_review', 3, now - 60, created='2026-10-28T09:15:00')
+    older = _batch(shared, 'older22', 'Morning routine that sticks', ['en', 'hi', 'or'],
+                   'ready_for_review', 3, now - 90000, created='2026-10-26T18:40:00')
+    aside = _batch(shared, 'aside33', 'Three ways to learn faster', ['en', 'hi'],
+                   'voices_ready', 2, now - 500000, created='2026-10-20T11:05:00')
+    job_id = '20261022-143856-7-small-daily-habits-tha-9729'
+    job = tmp_path / 'outputs' / job_id
+    for name in ('production', 'logs', 'narration'):
+        (job / name).mkdir(parents=True, exist_ok=True)
+    (job / 'narration' / 'voice.mp3').write_bytes(b'ID3' + b'\0' * 6000)
+    (job / 'batch.json').write_text(json.dumps(
+        {'source_language': 'en', 'source_script': 'old master', 'editions': ['en', 'hi', 'or'],
+         'scripts': {'en': 'old master', 'hi': 'purana', 'or': 'purana'},
+         'request': {'provider': 'gemini', 'topic': 'old habits'}, 'error': '', 'bundles': {}, 'phase': 'tts'}))
+    (job / 'production_manifest.json').write_text(json.dumps(
+        {'job_id': job_id, 'topic': 'old habits', 'shots': [], 'status': 'created'}))
+    return {'root': tmp_path, 'job_id': job_id, 'newest': newest, 'older': older, 'aside': aside,
+            'shared': shared}
+
+
+def _rows(install):
