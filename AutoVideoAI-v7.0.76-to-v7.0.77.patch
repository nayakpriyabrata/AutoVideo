+def _edition_overlays(edition, language, voice, words_path, width, height, tmp_dir, legacy_cards):
+    """Points series, single cards and hook pills for one edition, drawn from its saved reviewed data (7.0.77).
+
+    Uses the same renderers as the main video, into a scratch root inside the export's temporary folder.
+    Narration timings are returned; _add_overlays shifts them past any intro.
+    """
+    if not (edition.get('speech_cards') or edition.get('hooks')):
+        return []
+    if voice is None or words_path is None:
+        raise ValueError(LANGUAGES[language] + ' cards and hooks need its reviewed narration and word timings.')
+    from engine.speech_cards import render as render_cards
+    from engine.video_hooks import build_hook_overlays
+    root = Path(tmp_dir) / 'overlay-root'
+    (root / 'production').mkdir(parents=True, exist_ok=True)
+    words = json.loads(Path(words_path).read_text(encoding='utf8'))
+    audio = _verified(voice)
+    duration = float(voice['duration'])
+    educational = bool(edition.get('educational'))
+    style = 'playful' if educational else 'bold'
+    overlays = []
+    if edition.get('speech_cards'):
+        shutil.copyfile(_verified(edition['speech_cards']), root / 'production' / 'speech_cards.json')
+        overlays = render_cards(root, audio, words, edition['script'], duration, width, height, style,
+                                educational=True, topic=edition.get('topic', '')) or []
+    if edition.get('hooks'):
+        shutil.copyfile(_verified(edition['hooks']), root / 'production' / 'hooks.json')
+        existing = overlays + [{'kind': 'keypoint', 'start': c['start'], 'end': c['end']} for c in legacy_cards]
+        hook_overlays, _dropped = build_hook_overlays(root, audio, words, edition['script'], duration, width, height,
+                                                      style, existing, topic=edition.get('topic', ''), language=language)
+        overlays = overlays + hook_overlays
+    return overlays
+
+
+def _add_overlays(cmd, filters, current, inp, overlays, width, height, offset):
+    """Add picture-timed PNG overlays with the main renderer's pop/open/close animation and fades."""
+    from engine.render.ffmpeg_renderer import _pop_chain
+    for index, e in enumerate(overlays):
+        cmd += ['-loop', '1', '-framerate', '30', '-i', str(e['path'])]
+        st = offset + float(e['start']); en = offset + float(e['end'])
+        span = en - st
+        fade_in = min(span / 2, float(e.get('fade_in', 0) or 0))
+        fade_out = min(span / 2, float(e.get('fade_out', 0) or 0))
+        window = f"enable='between(t,{st:.3f},{en:.3f})':shortest=1"
+        if e.get('anim') in ('pop', 'open', 'close') and e.get('box'):
+            chain, place = _pop_chain(e, st, en, width, height, inp, fade_in, fade_out)
+            filters.append(chain + f'[ed{index}]')
+            filters.append(f"[{current}][ed{index}]overlay={place}:{window}[v{inp}]")
+        else:
+            chain = f'[{inp}:v]scale={width}:{height},format=rgba'
+            if fade_in:
+                chain += f',fade=t=in:st={st:.3f}:d={fade_in:.3f}:alpha=1'
+            if fade_out:
+                chain += f',fade=t=out:st={en - fade_out:.3f}:d={fade_out:.3f}:alpha=1'
+            filters.append(chain + f'[ed{index}]')
+            filters.append(f"[{current}][ed{index}]overlay=0:0:{window}[v{inp}]")
+        current = f'v{inp}'; inp += 1
+    return cmd, filters, current, inp
+
