+def test_the_command_line_lists_and_keeps_a_frame(install):
+    job = make_job(install, '20261031-121949-growth', shots=57)
+    make_frame(job)
+    listed = run_cli(install, 'keep-frame', job.name)
+    assert listed.returncode == 0, listed.stdout + listed.stderr
+    assert 'shot_051_open.jpg' in listed.stdout and 'BLOCKED' in listed.stdout
+    assert '1. shot_051_open.jpg.probe-00.jpg' in listed.stdout
+    kept = run_cli(install, 'keep-frame', job.name, '--image', 'shot_051_open.jpg', '--keep', '1')
+    assert kept.returncode == 0, kept.stdout + kept.stderr
+    assert 'Kept shot_051_open.jpg.probe-00.jpg' in kept.stdout
+    assert 'python3 cli.py v3 resume ' + job.name in kept.stdout
+    again = run_cli(install, 'keep-frame', job.name, '--image', 'shot_051_open.jpg', '--keep', '1')
+    assert again.returncode != 0
+    assert 'already saved as the frame' in (again.stdout + again.stderr)
