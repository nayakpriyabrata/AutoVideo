+@pytest.mark.parametrize('confirmation, expected', [
+    ({}, 'continue'),
+    ({'blocked': False, 'clicked': 'Approve'}, 'continue'),
+    ({'blocked': True, 'card_limit_reached': True, 'approved_cards': 1}, 'keep_waiting'),
+    ({'blocked': True, 'card_limit_reached': True, 'approved_cards': 2}, 'keep_waiting'),
+    ({'blocked': True, 'card_limit_reached': True, 'approved_cards': 0}, 'stop'),
+    ({'blocked': True, 'reason': 'credit guard: 9 > 6'}, 'stop'),
+    ({'blocked': True, 'reason': 'manual approval requested'}, 'stop'),
+])
+def test_a_second_card_leaves_an_approved_request_waiting(confirmation, expected):
+    assert fa.wait_decision(confirmation) == expected
+
