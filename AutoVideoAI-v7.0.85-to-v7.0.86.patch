+"""v7.0.86: voices first; text cards are optional and drafted only on request, or by the job for its own settings.
+
+No network: TTS, Gemini Web and cards are faked. Card drafts never call TTS.
+"""
+import json
+from pathlib import Path
+
+import pytest
+
+import engine.speech_cards as SC
+import engine.speech_batches as SB
+from engine.production import save, digest
+
+EN = 'Start with one small habit today. Repeat it for one week.'
+HI = 'आज एक छोटी आदत से शुरुआत करें। एक हफ्ते तक इसे दोहराएँ।'
+OR_GOOD = 'ଆଜି ଏକ ଛୋଟ ଅଭ୍ୟାସରୁ ଆରମ୍ଭ କରନ୍ତୁ। ଏକ ସପ୍ତାହ ଧରି ଏହାକୁ ଦୋହରାନ୍ତୁ।'
+LANGS = ['en', 'hi', 'or']
+
+
+@pytest.fixture
+def world(tmp_path, monkeypatch):
+    monkeypatch.setenv('AUTOVIDEO_SHARED_ROOT', str(tmp_path / 'shared'))
+    rec = {'tts': [], 'cards': []}
+
+    def fake_edition(root, script, language, **kw):
+        rec['tts'].append(language)
+        audio = Path(root) / 'speech-editions' / language / 'fp' / 'voice.mp3'
+        audio.parent.mkdir(parents=True, exist_ok=True)
+        audio.write_bytes(b'x' * 4096)
+        words = audio.parent / 'words.json'
+        words.write_text(json.dumps([{'word': 'a', 'start': 0.0, 'end': 1.0}]))
+        (audio.parent / 'production').mkdir(exist_ok=True)
+        (audio.parent / 'production' / 'speech_cards.json').write_text(json.dumps({'fingerprint': 'f', 'cards': []}))
+        return {'audio': str(audio), 'audio_sha256': digest(audio), 'duration': 3.0, 'script': script,
+                'language': language, 'words': str(words), 'cards': [], 'timing_source': 'test',
+                'text_cards': kw.get('text_cards', True), 'educational': kw.get('educational', False),
+                'hooks': kw.get('hooks', False), 'topic': kw.get('topic', ''),
+                'card_provider': kw.get('card_provider', 'gemini-web')}
+
+    def fake_cards(bundle, cleanup):
+        rec['cards'].append(bundle['language'])
+        return dict(bundle, cards=[], hooks_ready=bool(bundle.get('hooks')), cards_ready=True)
+
+    monkeypatch.setattr(SC, 'prepare_edition', fake_edition)
+    monkeypatch.setattr(SC, 'complete_edition_cards', fake_cards)
+    monkeypatch.setattr(SC, 'validate_words', lambda *a, **k: None)
+    monkeypatch.setattr(SC, 'prepare_localized_scripts',
+                        lambda *a, **k: (_ for _ in ()).throw(AssertionError('no localization expected')))
+    from engine.finishing_studio import shared_root
+    return {'rec': rec, 'shared': shared_root(), 'root': tmp_path}
+
+
+def _voices_only(world, **kw):
+    folder = world['shared'] / 'speech_preparation' / 'batch'
+    scripts = {'en': EN, 'hi': HI, 'or': OR_GOOD}
+    batch = SC.prepare_batch(folder, EN, 'en', LANGS, provider='auto', localized_scripts=scripts,
+                             draft_cards=False, **kw)
+    return folder, batch
+
+
+def test_voices_come_first_and_no_card_request_is_sent(world):
+    folder, batch = _voices_only(world, text_cards=True)
+    assert batch['phase'] == 'voices_ready'
+    assert world['rec']['tts'] == LANGS
+    assert world['rec']['cards'] == []
+    assert all(bundle['cards_ready'] is False for bundle in batch['bundles'].values())
+    rows = SB.list_speech_batches()
+    assert rows[0]['ready'] is True and rows[0]['phase'] == 'voices_ready'
+
+
+def test_cards_drafted_later_on_request_without_any_new_tts(world):
+    folder, _ = _voices_only(world, text_cards=True)
+    world['rec']['tts'].clear()
+    state = SC.draft_batch_cards(folder)
+    assert state['phase'] == 'ready_for_review'
+    assert world['rec']['tts'] == []
+    assert world['rec']['cards'] == LANGS
+    assert all(bundle['cards_ready'] is True for bundle in state['bundles'].values())
+
+
+def test_job_attaches_voices_only_batch_and_drafts_cards_for_its_settings(world, tmp_path):
+    folder, batch = _voices_only(world, text_cards=True)
+    world['rec']['tts'].clear()
+    job = tmp_path / 'job'
+    (job / 'production').mkdir(parents=True)
+    (job / 'narration').mkdir()
+    bundles = SC.attach_prepared_batch(job, batch)
+    save(job / 'production' / 'language_editions.json', {
+        'source_language': 'en', 'editions': LANGS, 'profiles': {}, 'prepare_audio': True, 'bundles': bundles,
+        'status': 'prepared batch attached', 'text_cards': True, 'hooks_enabled': False, 'educational': False, 'topic': 't'})
+    SC.prepare_selected_editions(job, EN, 'en', {'tts_provider': 'auto', 'gemini_chat_cleanup': 'keep'}, None,
+                                 text_cards=True, hooks=False, educational=False, topic='t')
+    assert world['rec']['tts'] == []
+    assert world['rec']['cards'] == LANGS
+
+
+def test_text_cards_off_means_no_card_request_at_all(world, tmp_path):
+    folder, batch = _voices_only(world, text_cards=False)
+    world['rec']['tts'].clear()
+    job = tmp_path / 'job-off'
+    (job / 'production').mkdir(parents=True)
+    (job / 'narration').mkdir()
+    bundles = SC.attach_prepared_batch(job, batch)
+    save(job / 'production' / 'language_editions.json', {
+        'source_language': 'en', 'editions': LANGS, 'profiles': {}, 'prepare_audio': True, 'bundles': bundles,
+        'status': 'prepared batch attached', 'text_cards': False, 'hooks_enabled': False, 'educational': False, 'topic': 't'})
+    SC.prepare_selected_editions(job, EN, 'en', {'tts_provider': 'auto', 'gemini_chat_cleanup': 'keep'}, None,
+                                 text_cards=False, hooks=False, educational=False, topic='t')
+    assert world['rec']['tts'] == []
+    assert world['rec']['cards'] == []
+
+
+def test_resume_keeps_the_voices_only_choice(world):
+    folder, _ = _voices_only(world, text_cards=True)
+    world['rec']['cards'].clear()
+    SB.resume_speech_batch(folder)
+    assert world['rec']['cards'] == []
+    assert json.loads((folder / 'batch.json').read_text())['phase'] == 'voices_ready'
+
+
+def test_cards_cannot_be_drafted_before_voices(world):
+    folder = world['shared'] / 'speech_preparation' / 'unfinished'
+    folder.mkdir(parents=True)
+    save(folder / 'batch.json', {'phase': 'tts', 'editions': LANGS, 'bundles': {}, 'request': {}})
+    with pytest.raises(ValueError, match='Generate the voices first'):
+        SC.draft_batch_cards(folder)
+
+
+def test_clip_review_button_does_not_read_later_broll_checkbox():
+    source = Path('app.py').read_text(encoding='utf-8')
+    review = source.index("'Review video + propose recreation scenes'")
+    assert source.index("reuse_broll = st.checkbox('Reuse approved B-roll") > review  # defined after the button
+    button_line = source[source.rindex('\n', 0, review) + 1:source.index('\n', review)]
+    assert 'reuse_broll' not in button_line
