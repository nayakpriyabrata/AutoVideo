+def test_an_existing_job_can_be_given_its_channel_profile(install):
+    profile = make_profile()
+    job = make_job(install, '20261031-121949-the-growth-mindset')
+    assert channel_profiles.missing(job) == ['en', 'hi', 'or']
+    result = channel_profiles.attach_profiles(job, {'en': profile, 'hi': profile, 'or': profile},
+                                              editions=['en', 'hi', 'or'])
