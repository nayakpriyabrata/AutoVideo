+#!/usr/bin/env python3
+"""Archive one unresolved Flow image journal so the next Resume makes ONE new submission.
+
+Use only when the user has approved spending credits on a new submission for that shot.
+The old journal is renamed, never deleted, so the old Flow request stays on record.
+
+    python3 tools/archive_uncertain_flow_image.py outputs/<job>/storyboard/shot_020_open.jpg
+    python3 tools/archive_uncertain_flow_image.py outputs/<job>/storyboard/shot_020_open.jpg --confirm-new-credit-spend
+
+Without --confirm-new-credit-spend the tool only prints what it would do and changes nothing.
+It refuses when the shot already has a downloaded image, when the job is running, when the
+journal is in any phase other than submission_uncertain or submitted, and when any probe that
+is not a classified uploaded reference is still a valid image (that image must be recovered,
+not resubmitted).
+"""
+import argparse
+import fcntl
+import json
+import sys
+import time
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+from engine.flow_image_transaction import completed, journal_path  # noqa: E402
+from engine.isolated_frame_regeneration import image_valid  # noqa: E402
+
+ALLOWED_PHASES = {'submission_uncertain', 'submitted'}
+
+
+def refusal(message):
+    print('REFUSED: ' + message)
+    return 2
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('output', type=Path, help='the shot image path, e.g. outputs/<job>/storyboard/shot_020_open.jpg')
+    parser.add_argument('--confirm-new-credit-spend', action='store_true',
+                        help='required: approve that the next Resume spends credits on one new submission')
+    args = parser.parse_args(argv)
+
+    output = args.output.resolve()
+    path = journal_path(output)
+    if not path.is_file():
+        print(f'No open Flow image journal at {path}; nothing to archive.')
+        return 0
+    request = json.loads(path.read_text(encoding='utf-8'))
+    phase = str(request.get('phase') or '')
+    if phase not in ALLOWED_PHASES:
+        return refusal(f'journal phase is {phase!r}; only {sorted(ALLOWED_PHASES)} can be archived.')
+    if request.get('status') == 'downloaded' or completed(output, request) or image_valid(output):
+        return refusal('this shot already has a downloaded image; nothing to resubmit.')
+
+    for entry in (request.get('capture_probes') or {}).values():
+        probe = output.parent / str(entry.get('file') or '')
+        if entry.get('reference'):  # the matched reference path (truthy) or True: a known uploaded reference
+            continue
+        if entry.get('file') and image_valid(probe):
+            return refusal(f'{probe.name} is a valid image that is not a classified uploaded reference. '
+                           'Recover it instead of resubmitting.')
+
+    lock_path = output.parent / '.production.lock'
+    with lock_path.open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except OSError:
+            return refusal('the job is running (production lock held). Stop it, then retry.')
+
+        stamp = time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())
+        archived = output.with_name(output.name + '.flow-request.archived-' + stamp + '.json')
+        print(f'Journal:  {path.name}')
+        print(f'Phase:    {phase}  acknowledged={request.get("submission_acknowledged")}')
+        print(f'Project:  {request.get("project_url")}')
+        print(f'Probes:   {len(request.get("capture_probes") or {})} (kept beside the output, not deleted)')
+        print(f'Archive:  {archived.name}')
+        if not args.confirm_new_credit_spend:
+            print('Dry run. Re-run with --confirm-new-credit-spend to archive. Nothing was changed.')
+            return 0
+        path.rename(archived)
+        print('Archived. Now press Resume once. That makes ONE new submission in a new Flow project.')
+        print('Do not press Resume again unless the user approves another credit spend.')
+        return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
