+def _retime_overlays(overlays, tempo):
+    """Move cards and hooks with a sped-up narration (v7.0.108).
+
+    Cards are drafted and anchored against the reviewed narration's own word timings. When that narration is
+    sped up to fit the picture, its word times shrink by the same factor - so the placed overlays must shrink
+    too. Retiming here (instead of feeding rescaled words to the card renderer) keeps the drafted fingerprint
+    valid, which is what broke the Odia edition in 7.0.107.
+    """
+    tempo = float(tempo or 1.0)
+    if abs(tempo - 1.0) < 1e-6:
+        return [dict(event) for event in overlays or []]
+    retimed = []
+    for event in overlays or []:
+        row = dict(event)
+        for key in ('start', 'end'):
+            if isinstance(row.get(key), (int, float)):
+                row[key] = round(float(row[key]) / tempo, 3)
+        retimed.append(row)
+    return retimed
+
