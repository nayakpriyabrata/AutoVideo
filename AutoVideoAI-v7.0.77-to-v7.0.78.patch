+def speech_spans(audio_path: str, merge_gap: float = 0.18, min_span: float = 0.08) -> list[tuple[float, float]]:
+    """Return voiced (speech) intervals of a narration file, in seconds.
+
+    Used only when no provider returned word timings (for example Odia, which
+    neither Groq nor local Whisper transcribes).  Silence between sentences is
+    kept out of the word budget, so the estimated words stay in step with the
+    real pauses instead of drifting later with every pause.  Returns [] when the
+    audio cannot be decoded; callers then keep the plain duration spread.
+    """
+    try:
+        import subprocess
+        import numpy as np
+        from .audio.tts import _ffmpeg_bin
+        ff = _ffmpeg_bin()
+        if not ff or not os.path.exists(audio_path):
+            return []
+        raw = subprocess.run([ff, "-v", "error", "-i", audio_path, "-ac", "1", "-ar", "16000",
+                              "-f", "s16le", "-"], capture_output=True, timeout=180).stdout
+        x = np.frombuffer(raw, dtype="<i2").astype(np.float32) / 32768.0
+        frame = 320  # 20 ms at 16 kHz
+        m = x.size // frame
+        if m < 5:
+            return []
+        rms = np.sqrt((x[:m * frame].reshape(m, frame) ** 2).mean(axis=1) + 1e-12)
+        db = 20.0 * np.log10(rms)
+        peak = float(np.percentile(db, 98))
+        voiced = db > max(peak - 30.0, -50.0)
+        spans: list[list[float]] = []
+        i = 0
+        while i < m:
+            if voiced[i]:
+                j = i
+                while j < m and voiced[j]:
+                    j += 1
+                spans.append([i * 0.02, j * 0.02])
+                i = j
+            else:
+                i += 1
+        merged: list[list[float]] = []
+        for s, e in spans:
+            if merged and s - merged[-1][1] < merge_gap:
+                merged[-1][1] = e
+            else:
+                merged.append([s, e])
+        return [(round(s, 3), round(e, 3)) for s, e in merged if e - s >= min_span]
+    except Exception:
+        return []
+
+
+def _spans_schedule(weights: list[float], spans: list[tuple[float, float]]) -> list[tuple[float, float]]:
+    """Place weighted words inside voiced spans; each word starts/ends in speech.
+
+    Word boundaries are first placed by character weight on the voiced timeline
+    (silence removed).  A boundary that falls within half an average word of a
+    detected pause is snapped to that pause, so the first word after a pause
+    starts after it rather than sliding back across it.  No word straddles a pause.
+    """
+    lengths = [e - s for s, e in spans]
+    voiced = sum(lengths)
+    n = len(weights)
+    total_w = float(sum(weights)) or 1.0
+    bounds = [0.0]
+    cum = 0.0
+    for wt in weights[:-1]:
+        cum += wt
+        bounds.append(cum / total_w * voiced)
+    bounds.append(voiced)
+    tol = 0.5 * voiced / max(1, n)
+    acc = 0.0
+    for length in lengths[:-1]:
+        acc += length
+        if n < 2:
+            break
+        k = min(range(1, n), key=lambda i: abs(bounds[i] - acc))
+        if abs(bounds[k] - acc) <= tol:
+            bounds[k] = acc
+    for k in range(1, n + 1):
+        bounds[k] = max(bounds[k], bounds[k - 1])
+
+    def real_at(tv: float, start: bool) -> float:
+        # A voiced-time point on a span boundary is a word start (next span)
+        # or a word end (previous span), so no word straddles a pause.
+        acc_len = 0.0
+        for s, e in spans:
+            length = e - s
+            if (tv < acc_len + length) if start else (tv <= acc_len + length):
+                return s + (tv - acc_len)
+            acc_len += length
+        return spans[-1][1]
+
+    return [(real_at(bounds[k], True), real_at(bounds[k + 1], False)) for k in range(n)]
+
