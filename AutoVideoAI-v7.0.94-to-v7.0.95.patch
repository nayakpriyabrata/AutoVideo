+    (job / 'production' / 'language_editions.json').write_text(json.dumps(
+        {'source_language': 'en', 'editions': ['en'], 'profiles': {}, 'prepare_audio': False,
+         'bundles': {'en': {'audio': str(audio), 'audio_sha256': digest(audio), 'script': 'Master narration.',
+                            'duration': 3.0, 'words': str(folder / 'words.json'), 'text_cards': False,
+                            'educational': False, 'hooks': False, 'cards': []}}}, ensure_ascii=False),
+        encoding='utf-8')
+    called = []
