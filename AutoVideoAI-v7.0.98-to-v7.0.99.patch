+def test_the_cli_exposes_the_approve_command_with_an_optional_cost():
+    import cli
+    parser = cli.build_parser() if hasattr(cli, 'build_parser') else None
+    if parser is None:  # older layout: the sub-parsers live in main()
+        source = open(cli.__file__, encoding='utf-8').read()
+        assert '"approve-request"' in source
+        assert '--confirm-credits' in source
+        return
+    args = parser.parse_args(['v3', 'approve-request', JOB, '--shot-id', 'shot_014'])
+    assert args.cmd == 'approve-request' and args.confirm_credits is None
+
