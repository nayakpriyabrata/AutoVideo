+"""v7.0.77: language editions follow the job's text-card, hook and educational choices.
+
+* Text cards off: no card is drafted and no card appears in any edition, whatever was saved earlier.
+* Educational jobs: each edition gets the same points series and single cards as the main video.
+* Hooks: drafted from each language's own narration after its TTS; a failure never stops the batch.
+* The English master's branding plan never takes edition cards or hooks.
+
+Offline unit tests use fake drafters. The FFmpeg tests render real short editions and compare frames.
+"""
+import hashlib
+import importlib.util
+import json
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location('finish_v777', ROOT / 'engine' / 'finishing_studio.py')
+finish = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(finish)
+
+from engine import speech_cards as SC  # noqa: E402
+from engine.render.hook_cards import render_hook_png  # noqa: E402
+
+needs_ffmpeg = pytest.mark.skipif(not (shutil.which('ffmpeg') and shutil.which('ffprobe')), reason='FFmpeg required')
+
+SECONDS = 16.0
+WORDS = [{'word': f'w{i}', 'start': round(i * .1, 3), 'end': round(i * .1 + .08, 3)} for i in range(160)]
+
+CARDS_DRAFT = json.dumps({
+    'cards': [{'kind': 'takeaway', 'text': 'Breathe slowly', 'start_word': 140, 'end_word': 142}],
+    'series': {'title': 'Calm steps', 'points': [
+        {'text': 'Breathe slowly', 'start_word': 0, 'end_word': 5},
+        {'text': 'Name the feeling', 'start_word': 20, 'end_word': 25},
+        {'text': 'Take one small step', 'start_word': 40, 'end_word': 45},
+        {'text': 'Sleep early tonight', 'start_word': 110, 'end_word': 115}]}})
+HOOKS_DRAFT = json.dumps({'hooks': [{'text': 'Why does your mind race?', 'start_word': 0}]})
+
+
+def _tone(path, frequency, seconds=SECONDS):
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i', f'sine=frequency={frequency}:sample_rate=44100',
+                    '-t', str(seconds), '-c:a', 'libmp3lame', '-b:a', '128k', str(path)], check=True)
+    return path
+
+
+def _picture(path, seconds=SECONDS):
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i', 'testsrc2=size=640x360:rate=24',
+                    '-t', str(seconds), '-an', '-c:v', 'libx264', '-pix_fmt', 'yuv420p', str(path)], check=True)
+    return path
+
+
+def _sha(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def _bundle_folder(job, code, frequency=440):
+    folder = job / 'speech-editions' / code / ('key-' + code)
+    folder.mkdir(parents=True)
+    audio = _tone(folder / 'voice.mp3', frequency)
+    words_path = folder / 'words.json'
+    words_path.write_text(json.dumps(WORDS), encoding='utf-8')
+    return folder, audio, words_path
+
+
+def _raw_bundle(folder, audio, words_path, code, **flags):
+    bundle = {'audio': str(audio), 'audio_sha256': _sha(audio), 'duration': SECONDS, 'words': str(words_path),
+              'script': f'{code} script', 'language': code, 'timing_source': 'test-measured', 'cards': [],
+              'review_required': True}
+    bundle.update(flags)
+    return bundle
+
+
+def _fake_drafters(monkeypatch, *, cards=True, hooks=True, calls=None):
+    calls = calls if calls is not None else []
+
+    def card_draft(provider, system, user, cleanup):
+        calls.append(('cards', provider))
+        return CARDS_DRAFT
+
+    def plain_draft(system, user, cleanup=None, **kwargs):
+        calls.append(('plain-cards', None))
+        return json.dumps({'cards': [{'text': 'Plain card', 'start_word': 2, 'end_word': 4}]})
+
+    def hook_draft(provider, system, user, cleanup='delete-after-read'):
+        calls.append(('hooks', provider))
+        if not hooks:
+            raise RuntimeError('Gemini Web is not signed in')
+        return HOOKS_DRAFT
+
+    import engine.providers.gemini_web as GW
+    import engine.studio_review as SR
+    monkeypatch.setattr(SC, '_draft_text', card_draft)
+    monkeypatch.setattr(GW, 'gemini_web_generate', plain_draft)
+    monkeypatch.setattr(SR, '_draft_generate', hook_draft)
+    return calls
+
+
+# ---------- unit: batch choices reach the bundle and the drafters ----------
+
+@needs_ffmpeg
+def test_text_cards_off_drafts_nothing_and_keeps_no_cards(tmp_path, monkeypatch):
+    calls = _fake_drafters(monkeypatch)
+    folder, audio, words_path = _bundle_folder(tmp_path, 'hi')
+    bundle = _raw_bundle(folder, audio, words_path, 'hi', text_cards=False, educational=True, hooks=False)
+    result = SC.complete_edition_cards(bundle, 'keep')
+    assert calls == []
+    assert result['cards'] == []
+    assert not (folder / 'production' / 'speech_cards.json').exists()
+
+
+@needs_ffmpeg
+def test_text_cards_on_uses_the_job_card_provider_and_educational_flag(tmp_path, monkeypatch):
+    calls = _fake_drafters(monkeypatch)
+    folder, audio, words_path = _bundle_folder(tmp_path, 'hi')
+    bundle = _raw_bundle(folder, audio, words_path, 'hi', text_cards=True, educational=True,
+                         card_provider='chatgpt-web', topic='Sleep')
+    result = SC.complete_edition_cards(bundle, 'keep')
+    assert calls == [('cards', 'chatgpt-web')]
+    saved = json.loads((folder / 'production' / 'speech_cards.json').read_text(encoding='utf-8'))
+    assert saved['educational'] is True and saved['series']['title'] == 'Calm steps'
+    assert result['cards'] and result['cards'][0]['kind'] == 'takeaway'
+
+
+@needs_ffmpeg
+def test_plain_cards_still_use_the_plain_drafter(tmp_path, monkeypatch):
+    calls = _fake_drafters(monkeypatch)
+    folder, audio, words_path = _bundle_folder(tmp_path, 'or')
+    bundle = _raw_bundle(folder, audio, words_path, 'or', text_cards=True, educational=False)
+    result = SC.complete_edition_cards(bundle, 'keep')
+    assert calls == [('plain-cards', None)]
+    assert result['cards'][0]['text'] == 'Plain card'
+
+
+@needs_ffmpeg
+def test_hooks_are_drafted_from_the_language_own_words(tmp_path, monkeypatch):
+    calls = _fake_drafters(monkeypatch)
+    folder, audio, words_path = _bundle_folder(tmp_path, 'hi')
+    bundle = _raw_bundle(folder, audio, words_path, 'hi', text_cards=False, hooks=True, topic='Sleep')
+    result = SC.complete_edition_cards(bundle, 'keep')
+    assert ('hooks', 'gemini-web') in calls
+    assert result['hooks_ready'] is True and result['hooks_error'] == ''
+    saved = json.loads((folder / 'production' / 'hooks.json').read_text(encoding='utf-8'))
+    assert saved['language'] == 'hi' and saved['hooks'][0]['text'] == 'Why does your mind race?'
+
+
+@needs_ffmpeg
+def test_hook_failure_is_recorded_and_the_cards_still_prepare(tmp_path, monkeypatch):
+    _fake_drafters(monkeypatch, hooks=False)
+    folder, audio, words_path = _bundle_folder(tmp_path, 'hi')
+    bundle = _raw_bundle(folder, audio, words_path, 'hi', text_cards=True, hooks=True)
+    result = SC.complete_edition_cards(bundle, 'keep')
+    assert result['hooks_ready'] is False
+    assert 'not signed in' in result['hooks_error']
+    assert result['cards'], 'a hook failure must not drop the language cards'
+
+
+def test_saved_batch_is_reused_only_with_the_same_choices():
+    wanted = {'text_cards': True, 'hooks': False, 'educational': True}
+    assert SC._bundle_matches({'text_cards': True, 'hooks': False, 'educational': True}, wanted)
+    assert not SC._bundle_matches({'text_cards': False, 'hooks': False, 'educational': True}, wanted)
+    assert not SC._bundle_matches({'text_cards': True, 'hooks': False, 'educational': False}, wanted)
+    assert not SC._bundle_matches({'text_cards': True, 'hooks': True, 'educational': True}, wanted)
+    # Legacy bundles carry no flags: cards on, not educational, no hooks.
+    assert SC._bundle_matches({}, {'text_cards': True, 'hooks': False, 'educational': False})
+    # A hook request is not satisfied by a bundle whose hook draft failed.
+    assert not SC._bundle_matches({'text_cards': True, 'hooks': True, 'hooks_ready': False, 'educational': True},
+                                  {'text_cards': True, 'hooks': True, 'educational': True})
+
+
+def test_prepare_batch_keeps_the_tts_loop_free_of_card_calls(tmp_path, monkeypatch):
+    """Cards and hooks are drafted only after every voice is ready (the second loop)."""
+    order = []
+    import engine.speech_cards as module
+
+    def fake_prepare_edition(root, script, language, **kwargs):
+        order.append(('tts', language, kwargs.get('draft_cards'), kwargs.get('text_cards'), kwargs.get('hooks')))
+        return {'audio': str(tmp_path / language / 'v.mp3'), 'audio_sha256': '0', 'duration': 1.0, 'words': '',
+                'script': script, 'language': language, 'cards': [], 'timing_source': 'x',
+                'text_cards': kwargs.get('text_cards'), 'hooks': kwargs.get('hooks')}
+
+    def fake_complete(bundle, cleanup='delete-after-read'):
+        order.append(('cards', bundle['language']))
+        return dict(bundle, cards=[])
+
+    monkeypatch.setattr(module, 'prepare_edition', fake_prepare_edition)
+    monkeypatch.setattr(module, 'complete_edition_cards', fake_complete)
+    module.prepare_batch(tmp_path, 'Master', 'en', ['en', 'hi'], text_cards=True, hooks=True, educational=True,
+                         localized_scripts={'en': 'Master', 'hi': 'Hindi master'})
+    tts = [item for item in order if item[0] == 'tts']
+    assert [item[1] for item in tts] == ['en', 'hi']
+    assert all(item[2] is False and item[3] is True and item[4] is True for item in tts)
+    assert order[len(tts):] == [('cards', 'en'), ('cards', 'hi')]
+
+
+# ---------- unit: the render plan follows the saved choices ----------
+
+def _job_with_bundles(tmp_path, *, state, bundles):
+    job = tmp_path / 'job'
+    (job / 'render').mkdir(parents=True)
+    (job / 'production').mkdir()
+    visual = _picture(job / 'render' / 'visual-master.mp4')
+    finish._atomic_json(job / 'production' / 'language_editions.json', dict(state, bundles=bundles))
+    return job, visual
+
+
+def _plan_for(job, visual, languages):
+    plan_path = finish.create_plan(visual, {lang: None for lang in languages}, languages=languages,
+                                   output_root=job / 'language_editions', source_rights='own_content',
+                                   source_language='en', require_profiles=False, fit_narration=True, captions=True)
+    return json.loads(Path(plan_path).read_text(encoding='utf8'))
+
+
+def _prepared_bundle(tmp_path, code, **flags):
+    folder, audio, words_path = _bundle_folder(tmp_path, code)
+    return folder, _raw_bundle(folder, audio, words_path, code, **flags)
+
+
+@needs_ffmpeg
+def test_plan_drops_cards_when_text_cards_are_off(tmp_path, monkeypatch):
+    _fake_drafters(monkeypatch)
+    folder, bundle = _prepared_bundle(tmp_path, 'hi', text_cards=True, educational=True)
+    bundle = SC.complete_edition_cards(bundle, 'keep')
+    job, visual = _job_with_bundles(tmp_path, state={'text_cards': False, 'hooks_enabled': False}, bundles={'hi': bundle})
+    plan = _plan_for(job, visual, ['hi'])
+    edition = plan['editions']['hi']
+    assert edition['cards'] == [] and edition['speech_cards'] is None and edition['educational'] is False
+
+
+@needs_ffmpeg
+def test_plan_refuses_cards_that_were_never_prepared(tmp_path):
+    folder, bundle = _prepared_bundle(tmp_path, 'hi', text_cards=False)
+    job, visual = _job_with_bundles(tmp_path, state={'text_cards': True}, bundles={'hi': bundle})
+    with pytest.raises(ValueError, match='Prepare the language batch again'):
+        _plan_for(job, visual, ['hi'])
+
+
+@needs_ffmpeg
+def test_plan_snapshots_points_and_hooks_for_educational_editions(tmp_path, monkeypatch):
+    _fake_drafters(monkeypatch)
