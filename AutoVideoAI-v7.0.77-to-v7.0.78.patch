+"""v7.0.78: Odia text cards, Odia caption timing and Odia narration direction.
+
+* Caption timing: when no provider returns word timings (Odia has none), script
+  words are placed inside the measured voiced spans of the narration, so pauses
+  stay at their real positions instead of the words drifting later.  Timings
+  cached by 7.0.77 ("script-estimated") are recomputed once.
+* Text cards: the drafter is told the edition language by name; Odia and Hindi
+  copy that is not in the edition's script is retried once and never shipped.
+* Narration: the Gemini TTS request names Odia or Hindi explicitly.
+
+Offline tests use fake drafters and a fake HTTP response.  The timing test makes
+real WAV audio and decodes it with the bundled FFmpeg when one is available.
+"""
+import array
+import json
+import math
+import sys
+import wave
+from pathlib import Path
+
+import pytest
+
+from engine import captions as C
+from engine import speech_cards as SC
+from engine.audio import tts as TTS
+from engine.audio.tts import _ffmpeg_bin
+
+needs_ffmpeg = pytest.mark.skipif(_ffmpeg_bin() is None, reason='FFmpeg decoder required')
+
+ODIA_CARD = 'ଗଭୀର ଶ୍ୱାସ ନିଅନ୍ତୁ'
+ENGLISH_CARD = 'Breathe slowly'
+WORDS = [{'word': f'w{i}', 'start': round(i * .1, 3), 'end': round(i * .1 + .08, 3)} for i in range(160)]
+
+
+def _cards(text):
+    return json.dumps({'cards': [{'kind': 'takeaway', 'text': text, 'start_word': 140, 'end_word': 142}],
+                       'series': None})
+
+
+def _audio(path: Path, pattern):
+    """Write a mono 16 kHz WAV: pattern is [(seconds, voiced_bool), ...]."""
+    samples = array.array('h')
+    for seconds, voiced in pattern:
+        n = int(round(seconds * 16000))
+        for i in range(n):
+            samples.append(int(0.3 * 32767 * math.sin(2 * math.pi * 220 * i / 16000)) if voiced else 0)
+    with wave.open(str(path), 'wb') as w:
+        w.setnchannels(1)
+        w.setsampwidth(2)
+        w.setframerate(16000)
+        w.writeframes(samples.tobytes())
+    return path
+
+
+def _phrase_audio(path: Path):
+    """Four phrases of five words, 0.06 s apart, with 0.9 s pauses between phrases.
+
+    Word length drives word duration (0.10 s + 0.035 s per character), like real speech.
+    """
+    pattern, truth, t = [], [], 0.0
+    for phrase in range(4):
+        for word in range(5):
+            index = phrase * 5 + word
+            seconds = 0.10 + 0.035 * len(f'word{index}')
+            truth.append(t)
+            pattern.append((seconds, True))
+            t += seconds
+            if word < 4:
+                pattern.append((0.06, False))
+                t += 0.06
+        if phrase < 3:
+            pattern.append((0.9, False))
+            t += 0.9
+    _audio(path, pattern)
+    return truth
+
+
+SCRIPT = ' '.join(f'word{i}' + ('.' if (i + 1) % 5 == 0 else '') for i in range(20))
+
+
+@needs_ffmpeg
+def test_voiced_spans_keep_script_words_in_step_with_pauses(tmp_path):
+    audio = tmp_path / 'narration.wav'
+    truth = _phrase_audio(audio)
+    spans = C.speech_spans(str(audio))
+    assert len(spans) >= 4, spans
+    duration = truth[-1] + 0.30 + 0.0
+    placed = C.align_words_to_script(SCRIPT, [], duration, spans=spans)
+    assert [w['word'] for w in placed] == SCRIPT.split()
+    starts = [w['start'] for w in placed]
+    worst = max(abs(a - b) for a, b in zip(starts, truth))
+    assert worst < 0.2, f'word start drifted {worst:.2f}s'
+    # The 7.0.77 full-length spread drifts well past that on the same audio.
+    spread = [w['start'] for w in C.align_words_to_script(SCRIPT, [], duration)]
+    assert max(abs(a - b) for a, b in zip(spread, truth)) > 0.5
+
+
+def test_spans_schedule_stays_inside_speech():
+    spans = [(0.0, 1.0), (2.0, 3.0)]
+    placed = C._spans_schedule([1, 1, 1, 1], spans)
+    for a, b in placed:
+        inside = any(s - 1e-9 <= a and b <= e + 1e-9 for s, e in spans)
+        assert inside, (a, b)
+    assert placed[0][0] == pytest.approx(0.0)
+    assert placed[-1][1] == pytest.approx(3.0)
+
+
+@needs_ffmpeg
+def test_stale_estimated_cache_is_recomputed_and_provider_cache_is_kept(tmp_path, monkeypatch):
+    monkeypatch.delenv('GROQ_API_KEY', raising=False)
+    audio = tmp_path / 'narration.wav'
+    _phrase_audio(audio)
+    cache = Path(str(audio) + '.words.json')
+    meta = Path(str(audio) + '.words.meta.json')
+    cache.write_text(json.dumps([{'word': 'stale', 'start': 0.0, 'end': 9.0}]), encoding='utf-8')
+    meta.write_text(json.dumps({'engine': 'script-estimated', 'script_aligned': True}), encoding='utf-8')
+
+    def no_local(*a, **k):
+        raise RuntimeError('no local ASR for this language')
+
+    monkeypatch.setattr(C, '_local_word_timestamps', no_local)
+    words = C.get_word_timestamps(str(audio), provider='auto', script_text=SCRIPT, language='or')
+    assert [w['word'] for w in words] == SCRIPT.split()
+    assert json.loads(meta.read_text(encoding='utf-8'))['engine'] == 'script-estimated+voiced-spans'
+
+    # Timings from a real provider are never recomputed.
+    cache.write_text(json.dumps([{'word': 'word0', 'start': 0.1, 'end': 0.4}]), encoding='utf-8')
+    meta.write_text(json.dumps({'engine': 'faster-whisper:small', 'script_aligned': True}), encoding='utf-8')
+    called = []
+    monkeypatch.setattr(C, '_local_word_timestamps', lambda *a, **k: called.append(1) or [])
+    kept = C.get_word_timestamps(str(audio), provider='auto', script_text=SCRIPT, language='or')
+    assert called == []
+    assert kept[0]['start'] == pytest.approx(0.1, abs=0.01)
