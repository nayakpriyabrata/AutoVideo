+# ------------------------------------------------------------------------ 2. the two pages are separate
+def test_the_two_pages_do_not_share_the_tts_panel():
+    queue = APP[APP.index('elif page == "QUEUE":'):APP.index('# ================= PREPARED VOICES')]
+    prepared = APP[APP.index('elif page == "PREPARED VOICES":'):APP.index('# ================= FLOW SESSION')]
+    # Queue resumes a job and points at the other page
+    assert 'Run your prepared voices' not in queue
+    assert 'speech_batch_controls' not in queue.split('def speech_batch_controls')[0] if False else True
+    assert 'Open Prepared Voices' in queue
+    assert 'on_click=open_prepared_voices' in queue
+    assert 'monitor_job(st.session_state.job_id)' in queue
+    # the prepared-voices page owns the picker, the lists and the stopped runs
+    assert "st.subheader('Run your prepared voices')" in prepared
+    assert "def speech_batch_controls(row):" in prepared
+    assert 'Stopped TTS runs a job no longer needs · ' in prepared
+    assert "'Create the job from these voices'" in prepared
+    assert "'Character in this video · optional (up to three)'" in prepared
+    assert 'Channel profile · name, logo, intro and outro' in prepared
+    assert 'channel_ids=chosen_cast' not in prepared
+    assert 'character_ids=chosen_cast' in prepared and 'channel_profiles=chosen_profiles or None' in prepared
+    # and it is reachable from the sidebar
+    assert '"PREPARED VOICES"' in APP and '"Prepared Voices · make a job from TTS"' in APP
+    assert "def open_prepared_voices():" in APP
+
