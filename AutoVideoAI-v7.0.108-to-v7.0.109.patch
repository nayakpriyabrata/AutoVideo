+def _state_job(tmp_path, transcript=None):
+    job = tmp_path / 'job'
+    (job / 'production').mkdir(parents=True)
+    (job / 'render').mkdir()
+    bundle = {'audio': str(job / 'voice.mp3'), 'audio_sha256': 'x', 'script': 'script', 'words': 'w',
+              'duration': 3.0, 'language': 'hi'}
+    (job / 'voice.mp3').write_bytes(b'not-really-audio')
+    visual = job / 'render' / 'visual-master.mp4'
+    visual.write_bytes(b'clean picture')
+    from engine import finishing_studio as finish
+    (job / 'production' / 'visual_master.json').write_text(json.dumps(
+        {'path': str(visual), 'sha256': finish._hash(visual), 'duration': 3.0,
+         'contains': 'picture only'}), encoding='utf-8')
+    state = {'source_language': 'en', 'editions': ['en', 'hi', 'or'], 'bundles': {'hi': bundle, 'or': bundle}}
+    if transcript is not None:
+        state['transcript'] = transcript
+    (job / 'production' / 'language_editions.json').write_text(json.dumps(state), encoding='utf-8')
+    return job
+
+
+def test_odia_has_no_transcript_by_default_and_hindi_does(tmp_path):
+    from engine.language_editions import transcript_plan, transcript_settings
+    job = _state_job(tmp_path)
+    state = json.loads((job / 'production' / 'language_editions.json').read_text())
+    assert transcript_settings(state) == {'default': True, 'languages': {'or': False}}
+    plan = transcript_plan(job)
+    assert plan['editions'] == {'hi': True, 'or': False}
+    assert plan['saved'] is False
+
