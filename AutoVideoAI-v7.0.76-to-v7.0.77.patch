+    edition = _plan_for(job, visual, ['hi'])['editions']['hi']
+    assert edition['educational'] is True and edition['topic'] == 'Sleep'
+    assert Path(edition['speech_cards']['path']).is_file() and Path(edition['hooks']['path']).is_file()
+    assert edition['hook_warning'] == ''
