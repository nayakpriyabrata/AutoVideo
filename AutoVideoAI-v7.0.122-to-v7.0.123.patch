@@ -0,0 +1,417 @@
+"""v7.0.123: branding reaches a job made from prepared voices, the two pages are separated, and a blocked
+image can be chosen instead of regenerated.
+
+Three reports, from the same install:
+
+* "I don't see the earlier selected channel profile is attached to either of the language" - Create step 3 saved
+  a channel profile per language, the narration batch never recorded it, and `create_job_from_batch` wrote no
+  `production/language_editions.json`, so the new job had no name, no logo, no intro and no outro.
+* "the character was missing" - already handled in v7.0.122; a batch made before it carries no cast, so the
+  panel must ask rather than assume.
+* "keep the resume of the failed or scripted or planned jobs in this [Queue], we can keep the tts in a separate
+  section" - the Run your prepared voices panel and the batch lists moved to their own page.
+* "one of the old failed job, i want you to fix it" - it stopped at shot_051 with two saved images and no way to
+  say which one is the frame; the app now lists those saved images and keeps the one you choose, locally.
+"""
+import hashlib
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+from PIL import Image
+
+from engine import channel_profiles, flow_choice
+from engine.cast import job_cast
+from engine.speech_batches import list_speech_batches, pickable, with_attachments
+
+ROOT = Path(__file__).resolve().parent.parent
+APP = (ROOT / 'app.py').read_text(encoding='utf-8')
+CLI = (ROOT / 'cli.py').read_text(encoding='utf-8')
+WORDS = [{'word': word, 'start': index * 1.0, 'end': index * 1.0 + 0.9}
+         for index, word in enumerate('small daily habits beat big plans'.split())]
+
+
+# ------------------------------------------------------------------------------------------------ helpers
+def _voices(folder: Path, languages, duration=61.5) -> dict:
+    bundles = {}
+    for code in languages:
+        lang = folder / code / 'k1'
+        lang.mkdir(parents=True, exist_ok=True)
+        audio = lang / 'voice.mp3'
+        audio.write_bytes(b'ID3' + folder.name.encode() + code.encode() + b'\0' * 6000)
+        (lang / 'words.json').write_text(json.dumps(WORDS))
+        bundles[code] = {'language': code, 'audio': str(audio), 'words': str(lang / 'words.json'),
+                         'audio_sha256': hashlib.sha256(audio.read_bytes()).hexdigest(),
+                         'duration': duration, 'timing_source': 'measured'}
+    return bundles
+
+
+def make_batch(folder: Path, script: str, *, topic='Small habits', languages=('en', 'hi', 'or'),
+               character_ids=None, channel_profiles=None):
+    folder.mkdir(parents=True, exist_ok=True)
+    (folder / 'batch.json').write_text(json.dumps({
+        'source_language': 'en', 'source_script': script, 'editions': list(languages),
+        'scripts': {code: script for code in languages},
+        'request': {'provider': 'gemini', 'topic': topic, 'character_ids': list(character_ids or []),
+                    'channel_profiles': dict(channel_profiles or {})},
+        'error': '', 'bundles': _voices(folder, languages), 'phase': 'ready_for_review'}))
+    from engine.speech_batches import _row
+    return _row(folder, 'Create step 4')
+
+
+def make_profile(name='My Channel', *, logo=True, intro=True, outro=True) -> str:
+    """A channel profile in exactly the shape Channel Desk saves (name, names per language, assets).
+
+    Written directly, not through save_profile: that one snapshots media with ffmpeg, which this suite's
+    sandbox does not need to prove anything about branding reaching a job.
+    """
+    from engine.production import save
+    folder = Path('channel_profiles') / name.lower().replace(' ', '-')
+    folder.mkdir(parents=True, exist_ok=True)
+    assets = {}
+    for kind, wanted in (('logo', logo), ('intro', intro), ('outro', outro)):
+        if not wanted:
+            continue
+        media = folder / 'assets' / (kind + '.png' if kind == 'logo' else kind + '.mp4')
+        media.parent.mkdir(parents=True, exist_ok=True)
+        if kind == 'logo':
+            Image.new('RGB', (120, 120), (30, 30, 60)).save(media)
+        else:
+            media.write_bytes(b'\0\0\0\x18ftypmp42' + b'\0' * 200)
+        assets[kind] = {'path': str(media.resolve()), 'sha256': hashlib.sha256(media.read_bytes()).hexdigest()}
+    save(folder / 'profile.json', {
+        'schema_version': 1, 'id': folder.name, 'name': name,
+        'names': {'en': name + ' English', 'hi': name + ' Hindi', 'or': name},
+        'assets': assets})
+    return str((folder / 'profile.json').resolve())
+
+
+def make_job(root: Path, job_id: str, *, language='en', editions=('en', 'hi', 'or'), status='failed',
+             shots=0):
+    job = root / 'outputs' / job_id
+    for name in ('production', 'narration', 'logs', 'storyboard'):
+        (job / name).mkdir(parents=True, exist_ok=True)
+    (job / 'narration' / 'voice.mp3').write_bytes(b'ID3' + b'\0' * 6000)
+    (job / 'production_manifest.json').write_text(json.dumps(
+        {'job_id': job_id, 'topic': 'a topic', 'language': language, 'status': status,
+         'shots': [{'shot_id': 'shot_%03d' % (index + 1), 'status': 'planned'} for index in range(shots)]}))
+    (job / 'production' / 'language_editions.json').write_text(json.dumps(
+        {'source_language': language, 'editions': list(editions), 'profiles': {}, 'bundles': {},
+         'status': 'awaiting narration preparation'}))
+    from engine.project.database import JobDB
+    JobDB().upsert(job_id, topic='a topic', status=status, video_type='faceless_youtube',
+                   target_seconds=300, aspect='16:9', profile='STORYBOARD_ECONOMY',
+                   preset='cinematic_realism', dry_run=0)
+    return job
+
+
+def make_frame(job: Path, image='shot_051_open.jpg', *, candidates=2):
+    """A frame whose journal holds the images Flow already produced, exactly as a blocked request leaves them."""
+    output = job / 'storyboard' / image
+    probes = {}
+    for index in range(candidates):
+        probe = output.parent / (image + '.probe-%02d.jpg' % index)
+        Image.new('RGB', (160, 90), (40 + index * 60, 60, 90)).save(probe)
+        probes['key%d' % index] = {'project_url': 'https://flow.google.com/project/p1',
+                                   'signature': 'sig%d' % index, 'file': probe.name,
+                                   'state': 'downloaded',
+                                   'sha256': hashlib.sha256(probe.read_bytes()).hexdigest()}
+    (Path(str(output) + '.flow-request.json')).write_text(json.dumps({
+        'scope': 'isolated_image_v1', 'project_url': 'https://flow.google.com/project/p1',
+        'status': 'pending', 'capture_probes': probes, 'capture_inventory': ['sig0', 'sig1'],
+        'prompt': 'wide 16:9 cinematic shot of a learner writing in a notebook', 'reference_hashes': {}}))
+    return output
+
+
+def add_character(name='Mira the presenter'):
+    from engine.content_library import CharacterLibrary
+    photo = Path('character-photo.png').resolve()
+    if not photo.is_file():
+        Image.new('RGB', (48, 48), (200, 120, 90)).save(photo)
+    return CharacterLibrary().create(
+        name, 'Original fictional presenter with a round face, short hair and a navy jacket.',
+        reference_files=[str(photo)], original_confirmed=True)
+
+
+@pytest.fixture()
+def install(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv('AUTOVIDEO_SHARED_ROOT', str(tmp_path))
+    (tmp_path / 'speech_preparation').mkdir()
+    (tmp_path / 'outputs').mkdir()
+    (tmp_path / 'data' / 'content').mkdir(parents=True)
+    (tmp_path / 'config').symlink_to(ROOT / 'config')
+    (tmp_path / 'assets').symlink_to(ROOT / 'assets')
+    return tmp_path
+
+
+def run_cli(install, *arguments):
+    return subprocess.run([sys.executable, str(ROOT / 'cli.py'), 'v3', *arguments], cwd=str(install),
+                          capture_output=True, text=True, timeout=300,
+                          env={**os.environ, 'AUTOVIDEO_SHARED_ROOT': str(install), 'PYTHONPATH': str(ROOT)})
+
+
+# ------------------------------------------------------------------------ 1. branding travels with the voices
+def test_a_prepared_batch_records_the_channel_profile_of_each_language(install):
+    from engine import speech_cards
+    profile = make_profile()
+    character = add_character()
+
+    def fake_prepare_edition(root, script, language, **options):
+        folder = Path(root) / language / 'offline'
+        folder.mkdir(parents=True, exist_ok=True)
+        audio = folder / 'voice.mp3'
+        audio.write_bytes(b'ID3' + language.encode() + b'\0' * 100)
+        (folder / 'words.json').write_text(json.dumps(WORDS))
+        return {'language': language, 'audio': str(audio), 'words': str(folder / 'words.json'),
+                'duration': 12.0, 'timing_source': 'measured',
+                'audio_sha256': hashlib.sha256(audio.read_bytes()).hexdigest()}
+
+    original = speech_cards.prepare_edition
+    speech_cards.prepare_edition = fake_prepare_edition
+    try:
+        speech_cards.prepare_batch(
+            Path('speech_preparation/with-branding'), 'small daily habits beat big plans.', 'en',
+            ['en', 'hi', 'or'], provider='gemini',
+            localized_scripts={code: 'small daily habits beat big plans.' for code in ('en', 'hi', 'or')},
+            text_cards=False, draft_cards=False, character_ids=[character['id']],
+            channel_profiles={'en': profile, 'hi': profile, 'or': profile})
+    finally:
+        speech_cards.prepare_edition = original
+    row = next(row for row in list_speech_batches([]) if row['key'] == 'with-branding')
+    assert row['channel_profiles'] == {'en': profile, 'hi': profile, 'or': profile}
+    from engine.speech_batches import display_label
+    assert 'channel saved for English, Hindi, Odia' in display_label(row)
+
+
+def test_a_job_made_from_prepared_voices_keeps_the_channel_profile(install):
+    profile = make_profile()
+    make_batch(install / 'speech_preparation' / 'branded', 'small daily habits beat big plans.',
+               channel_profiles={'en': profile, 'hi': profile, 'or': profile})
+    created = run_cli(install, 'use-voices', 'branded', '--create-job', '--rights', 'own_content',
+                      '--seconds', '120')
+    assert created.returncode == 0, created.stdout + created.stderr
+    assert 'channel: ' in created.stdout and 'My Channel' in created.stdout
+    job_id = created.stdout.split('Created job ')[1].split(' from')[0]
+    job = install / 'outputs' / job_id
+    record = json.loads((job / 'production' / 'language_editions.json').read_text(encoding='utf-8'))
+    assert record['profiles'] == {'en': profile, 'hi': profile, 'or': profile}
+    assert record['editions'] == ['en', 'hi', 'or']
+    assert record['bundles'], 'the attached voices must stay recorded'
+    settings = json.loads((job / 'settings.json').read_text(encoding='utf-8'))
+    assert settings['channel_name'] == 'My Channel English'
+    assert settings['channel_logo'], 'the primary logo must reach the job settings'
+    assert settings['watermark'] is True
+    assert channel_profiles.job_profiles(job) == {'en': profile, 'hi': profile, 'or': profile}
+
+
+def test_the_channel_profile_can_be_chosen_or_changed_on_the_command_line(install):
+    profile = make_profile('First Channel')
+    second = make_profile('Second Channel', logo=False, intro=False, outro=False)
+    make_batch(install / 'speech_preparation' / 'plain-batch', 'small daily habits beat big plans.')
+    created = run_cli(install, 'use-voices', 'plain-batch', '--create-job', '--rights', 'own_content',
+                      '--seconds', '120', '--channel', 'en=' + profile + ',hi=' + profile)
+    assert created.returncode == 0, created.stdout + created.stderr
+    job_id = created.stdout.split('Created job ')[1].split(' from')[0]
+    job = install / 'outputs' / job_id
+    assert channel_profiles.job_profiles(job) == {'en': profile, 'hi': profile}
+    changed = run_cli(install, 'channel', job_id, '--all', second)
+    assert changed.returncode == 0, changed.stdout + changed.stderr
+    assert 'Second Channel' in changed.stdout
+    assert set(channel_profiles.job_profiles(job).values()) == {second}
+    listed = run_cli(install, 'channel', job_id)
+    assert 'no intro' not in listed.stdout or 'Second Channel' in listed.stdout
+    assert 'Nothing was generated or rendered' in changed.stdout
+
