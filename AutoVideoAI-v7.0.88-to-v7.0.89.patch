@@ -0,0 +1,188 @@
+"""v7.0.89: the exact UI blob is read in the page by a click hook, before the browser download starts.
+
+Unit tests use fakes. The browser tests run real Chromium through Playwright when one can be
+launched; set AUTOVIDEO_TEST_CHROMIUM to a Chromium executable to choose one. They are skipped otherwise.
+"""
+import io
+import os
+import random
+import time
+
+import pytest
+
+from engine import flow_download_diagnostics as diagnostics
+from engine import flow_ui_blob
+
+
+# ---------- unit tests (no browser) ----------
+
+def test_browser_log_tail_is_kept_and_redacted():
+    raw = ("TargetClosedError: Page.evaluate: Target page, context or browser has been closed "
+           "Browser logs: <launching> /home/user/.cache/chrome --flag "
+           "[1:1:ERROR] Received signal 11 SEGV_MAPERR https://flow.google.com/x?token=SECRET "
+           "[1:1:ERROR] GPU process exited unexpectedly")
+    text = diagnostics.describe_exception(RuntimeError(raw))
+    assert text.startswith("RuntimeError: TargetClosedError: Page.evaluate: Target page, context or browser has been closed")
+    assert "browser logs (last lines):" in text
+    assert "Received signal 11" in text and "GPU process exited unexpectedly" in text
+    assert "SECRET" not in text and "token=" not in text
+
+
+def test_exception_without_browser_logs_is_unchanged_in_shape():
+    assert diagnostics.describe_exception(ValueError("plain message")) == "ValueError: plain message"
+
+
+def test_receive_records_intercept_without_writing_bytes(tmp_path):
+    class Page:
+        url = "https://flow.google.com/project/abc"
+
+    capture = flow_ui_blob.Capture(Page(), str(tmp_path / "shot.jpg"), lambda path: True)
+    assert capture.receive({"page": capture.page}, {"intercepted": True}) is True
+    assert capture.intercepted is True and capture.size == 0 and capture.index == 0
+    capture.close()
+
+
+def test_arm_refuses_non_flow_page_and_reports(tmp_path, monkeypatch):
+    lines = []
+    monkeypatch.setattr(diagnostics, "runtime_print", lambda *a, **k: lines.append(" ".join(map(str, a))))
+
+    class Page:
+        url = "https://example.com/"
+
+    assert flow_ui_blob.arm(Page(), str(tmp_path / "shot.jpg"), lambda path: True) is None
+    assert any("exact UI blob capture not armed" in line and "Flow page required" in line for line in lines)
+
+
+def test_script_contains_both_click_paths_and_restore():
+    script = flow_ui_blob.SCRIPT
+    assert "HTMLAnchorElement.prototype.click=hookedClick" in script
+    assert "HTMLAnchorElement.prototype.dispatchEvent=hookedDispatch" in script
+    assert "delete HTMLAnchorElement.prototype.click" in script
+    assert "originalClick.call(a)" in script
+    # the in-page fallback only runs while the capture is still open
+    assert "if(window[key]){try{originalClick.call(a);}" in script
+
+
+# ---------- real browser tests ----------
+
+def _chromium_launch(playwright):
+    exe = os.getenv("AUTOVIDEO_TEST_CHROMIUM", "").strip() or None
+    try:
+        return playwright.chromium.launch(executable_path=exe, headless=True, args=["--no-sandbox"])
+    except Exception as exc:  # no browser on this machine
+        pytest.skip(f"no Chromium available for the browser test: {type(exc).__name__}")
+
+
+@pytest.fixture
+def browser_page(tmp_path):
+    pw_api = pytest.importorskip("playwright.sync_api")
+    pytest.importorskip("PIL")
+    with pw_api.sync_playwright() as playwright:
+        browser = _chromium_launch(playwright)
+        context = browser.new_context(accept_downloads=True)
+        page = context.new_page()
+        page.route("https://flow.google.com/**",
+                   lambda route: route.fulfill(status=200, content_type="text/html",
+                                               body="<!doctype html><body><div id='host'></div></body>"))
+        page.goto("https://flow.google.com/project/test", wait_until="load")
+        downloads = []
+        page.on("download", lambda download: downloads.append(download))
+        try:
+            yield page, downloads, tmp_path
+        finally:
+            context.close()
+            browser.close()
+
+
+def _jpeg_bytes(seed=7):
+    from PIL import Image
+    rnd = random.Random(seed)
+    image = Image.frombytes("RGB", (900, 700), bytes(rnd.getrandbits(8) for _ in range(900 * 700 * 3)))
+    buffer = io.BytesIO()
+    image.save(buffer, format="JPEG", quality=92)
+    return buffer.getvalue()
+
+
+def _validator(path):
+    from engine.providers.flow_browser import FlowBrowserProvider
+    provider = FlowBrowserProvider.__new__(FlowBrowserProvider)
+    return provider._asset_valid(path, "image")
+
+
+def _wait(page, predicate, seconds=20):
+    # Sync Playwright delivers in-page binding calls only while Python is inside a Playwright call,
+    # so wait with page.wait_for_timeout (as the production wait loop does), not time.sleep.
+    deadline = time.monotonic() + seconds
+    while time.monotonic() < deadline:
+        if predicate():
+            return True
+        page.wait_for_timeout(100)
+    return predicate()
+
+
+_BLOB_JS = """(args) => {
+    const bin = Uint8Array.from(atob(args.b64), c => c.charCodeAt(0));
+    const url = URL.createObjectURL(new Blob([bin], { type: 'image/jpeg' }));
+    const a = document.createElement('a');
+    a.href = url; a.download = 'shot.jpg';
+    return { a, url };
+}"""
+
+
+def test_click_hook_saves_exact_blob_without_browser_download(browser_page):
+    import base64
+    page, downloads, tmp_path = browser_page
+    data = _jpeg_bytes()
+    out = tmp_path / "shot_013_open.jpg"
+    capture = flow_ui_blob.arm(page, out, _validator)
+    assert capture is not None and capture.hooked is True
+    page.evaluate("""(args) => { const r = (%s)(args); r.a.click(); URL.revokeObjectURL(r.url); }""" % _BLOB_JS,
+                  {"b64": base64.b64encode(data).decode()})
+    assert _wait(page, lambda: capture.done or not capture.active)
+    capture.close()
+    assert capture.done is True and capture.intercepted is True
+    assert out.read_bytes() == data
+    assert downloads == []  # the browser's download manager never started
+
+
+def test_synthetic_dispatch_click_is_also_intercepted(browser_page):
+    import base64
+    page, downloads, tmp_path = browser_page
+    data = _jpeg_bytes(seed=11)
+    out = tmp_path / "shot_dispatch.jpg"
+    capture = flow_ui_blob.arm(page, out, _validator)
+    page.evaluate("""(args) => { const r = (%s)(args);
+        r.a.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true })); URL.revokeObjectURL(r.url); }""" % _BLOB_JS,
+                  {"b64": base64.b64encode(data).decode()})
+    assert _wait(page, lambda: capture.done or not capture.active)
+    capture.close()
+    assert capture.done is True
+    assert out.read_bytes() == data
+    assert downloads == []
+
+
+def test_original_click_is_restored_after_capture_closes(browser_page):
+    import base64
+    page, downloads, tmp_path = browser_page
+    data = _jpeg_bytes(seed=3)
+    capture = flow_ui_blob.arm(page, tmp_path / "unused.jpg", _validator)
+    capture.close()
+    assert page.evaluate("() => Object.prototype.hasOwnProperty.call(HTMLAnchorElement.prototype, 'click')") is False
+    with page.expect_download(timeout=15000) as info:
+        page.evaluate("""(args) => { const r = (%s)(args); r.a.click(); }""" % _BLOB_JS,
+                      {"b64": base64.b64encode(data).decode()})
+    info.value  # a normal browser download starts again
+    assert len(downloads) == 1
+
+
+def test_revoked_blob_falls_back_to_the_original_click(browser_page):
+    import base64
+    page, downloads, tmp_path = browser_page
+    data = _jpeg_bytes(seed=5)
+    capture = flow_ui_blob.arm(page, tmp_path / "fallback.jpg", _validator)
+    page.evaluate("""(args) => { const r = (%s)(args); URL.revokeObjectURL(r.url); r.a.click(); }""" % _BLOB_JS,
+                  {"b64": base64.b64encode(data).decode()})
+    assert _wait(page, lambda: not capture.active, seconds=15)
+    capture.close()
+    assert capture.done is False
+    assert _wait(page, lambda: len(downloads) >= 1, seconds=15)  # the original download ran as the fallback
