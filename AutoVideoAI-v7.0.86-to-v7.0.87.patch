+CHECKPOINT_PREFIX = 'Image recovery checkpoint retained'
+
+
+def recoverable_download_interruption(error):
+    """True when a saved exact image request was only interrupted during download.
+
+    flow_image_transaction.recover() re-raises the last browser/network/busy error
+    as FlowRequestPending('Image recovery checkpoint retained: ...') from it. The
+    request is already recorded and recovery is download-only (no upload, fill or
+    Send), so it is safe for automatic resume. Plain pending or submitted requests
+    are not covered: they may already have consumed credits.
+    """
+    from .providers.flow_browser import (FlowRequestPending, FlowBrowserClosedError,
+                                         FlowTransientNetworkError, FlowServiceBusy)
+    if not isinstance(error, FlowRequestPending) or not str(error).startswith(CHECKPOINT_PREFIX):
+        return False
+    cause = error.__cause__
+    return isinstance(cause, (FlowBrowserClosedError, FlowTransientNetworkError, FlowServiceBusy)) and can_recover(cause)
+
