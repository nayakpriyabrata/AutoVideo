index 0000000..a9ff639
--- /dev/null
+++ b/tests/test_v7111_which_edition_file.py
@@ -0,0 +1,320 @@
+"""v7.0.111: which language video is the current one, and what did that file burn?
+
+Field report: the Odia transcript was switched off, the editions were rendered again, and the Odia video that was
+played still had the same Odia captions. The render was right - the record and the new export both said "no
+captions" - but the job *keeps every earlier export*, so there were now two Odia videos with equally plausible
+names and nothing said which one the app had just made.
+
+These tests hold the answer to four promises:
+
+* the current file is named, with the time it was rendered and whether its bytes still match the record;
+* what it burned comes from the export's own provenance, not from the plan's intention;
+* every earlier file is listed as **not current**, with its own caption state;
+* a plan built while captions were on can never re-burn them after the job switched them off.
+"""
+import json
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+needs_ffmpeg = pytest.mark.skipif(not (shutil.which('ffmpeg') and shutil.which('ffprobe')),
+                                  reason='FFmpeg required')
+os.environ.setdefault('HOME', '/tmp')
+
+WORDS = [{'word': 'ଶବ୍ଦ' + str(i), 'start': 0.3 + i * 0.55, 'end': 0.3 + i * 0.55 + 0.5} for i in range(8)]
+
+
+def _job(tmp_path, *, transcript=None):
+    """A job with an Odia narration bundle and a picture-only master. No media is generated by Flow."""
+    from engine.production import digest
+    job = tmp_path / 'job'
+    (job / 'render').mkdir(parents=True)
+    (job / 'production').mkdir()
+    picture = job / 'render' / 'visual-master.mp4'
+    try:
+        subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i',
+                        'testsrc2=size=640x360:rate=24', '-t', '6', '-an', '-c:v', 'libx264',
+                        '-pix_fmt', 'yuv420p', str(picture)], check=True)
+    except (OSError, subprocess.CalledProcessError):
+        picture.write_bytes(b'\x00' * 1024)
+    (job / 'production' / 'visual_master.json').write_text(json.dumps(
+        {'path': str(picture), 'sha256': digest(picture), 'duration': 6.0}), encoding='utf-8')
+    folder = job / 'speech-editions' / 'or' / 'key'
+    folder.mkdir(parents=True)
+    voice = folder / 'voice.wav'
+    try:
+        subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i',
+                        'sine=frequency=700:sample_rate=44100', '-t', '6', '-c:a', 'pcm_s16le', str(voice)],
+                       check=True)
+    except (OSError, subprocess.CalledProcessError):
+        voice.write_bytes(b'\x00' * 64)
+    words = folder / 'words.json'
+    words.write_text(json.dumps(WORDS, ensure_ascii=False), encoding='utf-8')
+    bundle = {'audio': str(voice), 'audio_sha256': digest(voice), 'duration': 6.0, 'words': str(words),
+              'script': ' '.join(word['word'] for word in WORDS), 'language': 'or', 'timing_source': 'test',
+              'cards': [], 'text_cards': False}
+    state = {'source_language': 'en', 'editions': ['en', 'or'], 'profiles': {'or': None},
+             'bundles': {'or': bundle}}
+    if transcript is not None:
+        state['transcript'] = {'default': transcript, 'languages': {}}
+    (job / 'production' / 'language_editions.json').write_text(json.dumps(state, ensure_ascii=False),
+                                                               encoding='utf-8')
+    return job
+
+
+def _export(job, code='or'):
+    from engine.language_editions import _record_path
+    return json.loads(_record_path(job).read_text(encoding='utf-8'))['editions'][code]
+
+
+def _forget(job, name):
+    """A fake export with a provenance sidecar, for the read-only tests."""
+    folder = job / 'language_editions' / name / 'exports'
+    folder.mkdir(parents=True)
+    video = folder / ('or-' + name + '.mp4')
+    video.write_bytes(b'video-' + name.encode())
+    (job / 'language_editions' / name / 'plan.json').write_text(json.dumps({'captions': True}), encoding='utf-8')
+    return video
+
+
+# --------------------------------------------------------------------------- reading what is on disk
+
+
+def test_provenance_is_the_proof_of_what_a_file_burned(tmp_path):
+    from engine import edition_files
+    job = _job(tmp_path)
+    video = _forget(job, '20260101-000000-aaaa1111')
+    assert edition_files.captions_state(video)['burned'] is None       # no provenance: cannot be known
+    (video.with_suffix('.provenance.json')).write_text(json.dumps({'captions_burned': False}), encoding='utf-8')
+    state = edition_files.captions_state(video)
+    assert state['burned'] is False and state['source'] == 'provenance' and state['planned'] is True
+
+
+def test_without_provenance_the_plan_is_reported_as_a_plan_not_as_proof(tmp_path):
+    from engine import edition_files
+    job = _job(tmp_path)
+    video = _forget(job, '20260101-000000-bbbb2222')
+    state = edition_files.captions_state(video)
+    assert state['burned'] is None and state['planned'] is True and state['source'] == 'unknown'
+
+
+def test_the_current_file_and_every_earlier_file_are_named(tmp_path):
+    from engine import edition_files
+    from engine.language_editions import _record_path
+    job = _job(tmp_path)
+    old = _forget(job, '20260101-000000-cccc3333')
+    old.with_suffix('.provenance.json').write_text(json.dumps({'captions_burned': True}), encoding='utf-8')
+    new = _forget(job, '20260202-000000-dddd4444')
+    new.with_suffix('.provenance.json').write_text(json.dumps({'captions_burned': False}), encoding='utf-8')
+    copy = job / 'render' / (job.name + '-or-edition.mp4')
+    copy.write_bytes(new.read_bytes())
+    (job / 'production' / 'language_editions_render.json').write_text(json.dumps({'editions': {'or': {
+        'status': 'exported', 'path': str(new), 'render_copy': str(copy),
+        'sha256': edition_files._describe(new, verify=True)['sha256']}}}), encoding='utf-8')
+
+    data = edition_files.report(job, verify=True)
+    row = data['editions']['or']
+    assert row['current']['path'] == str(new)
+    assert row['current']['captions']['burned'] is False
+    assert row['current']['render_copy_matches'] is True
+    assert [Path(item['path']).name for item in row['older']] == [old.name]
+    assert row['older'][0]['captions']['burned'] is True
+    assert row['requested_transcript'] is False
+    # The current file is captions-free, so the stale one is not an error - but the listing says so plainly.
+    lines = '\n'.join(edition_files.format_report(data))
+    assert 'watch: ' + str(copy) in lines
+    assert 'burned captions: no' in lines
+    assert 'earlier file (NOT current)' in lines
+    assert '_record_path' in repr(_record_path) or True
+
+
+def test_a_current_export_that_still_has_the_captions_is_called_out(tmp_path):
+    from engine import edition_files
+    job = _job(tmp_path)
+    video = _forget(job, '20260303-000000-eeee5555')
+    video.with_suffix('.provenance.json').write_text(json.dumps({'captions_burned': True}), encoding='utf-8')
+    (job / 'production' / 'language_editions_render.json').write_text(json.dumps({'editions': {'or': {
+        'status': 'exported', 'path': str(video)}}}), encoding='utf-8')
+    data = edition_files.report(job)
+    problems = data['editions']['or']['problems']
+    assert any('still has burned captions' in problem and 'Render that language again' in problem
+               for problem in problems), problems
+
+
+def test_a_copy_that_is_not_the_current_export_is_called_out(tmp_path):
+    from engine import edition_files
+    job = _job(tmp_path)
+    video = _forget(job, '20260404-000000-ffff6666')
+    video.with_suffix('.provenance.json').write_text(json.dumps({'captions_burned': False}), encoding='utf-8')
+    copy = job / 'render' / (job.name + '-or-edition.mp4')
+    copy.write_bytes(b'an older video')
+    (job / 'production' / 'language_editions_render.json').write_text(json.dumps({'editions': {'or': {
+        'status': 'exported', 'path': str(video), 'render_copy': str(copy)}}}), encoding='utf-8')
+    row = edition_files.report(job)['editions']['or']
+    assert row['current']['render_copy_matches'] is False
+    assert any('is not the current export' in problem for problem in row['problems'])
+    assert '! the copy in render/ is NOT the current export' in '\n'.join(
+        edition_files.format_report(edition_files.report(job)))
+
+
+def test_a_recorded_export_that_vanished_is_reported(tmp_path):
+    from engine import edition_files
+    job = _job(tmp_path)
+    (job / 'production' / 'language_editions_render.json').write_text(json.dumps({'editions': {'or': {
+        'status': 'exported', 'path': str(tmp_path / 'gone.mp4')}}}), encoding='utf-8')
+    data = edition_files.report(job)
+    assert any('recorded as exported, but its file is missing' in problem for problem in data['problems'])
+
+
+# --------------------------------------------------------------------------- real renders
+
+
+@needs_ffmpeg
+def test_a_new_render_marks_every_earlier_file_as_superseded(tmp_path):
+    from engine import edition_files
+    from engine.language_editions import render_job_editions
+    job = _job(tmp_path)
+    first = render_job_editions(job)
+    assert first['status'] == 'exported', first
+    first_path = Path(first['editions']['or']['path'])
+    assert (first_path.parents[1] / 'superseded.json').exists() is False   # the current one is not marked
+
+    # Switch the transcript on: that changes what the job wants, so Odia renders again.
+    from engine.language_editions import set_transcript
+    set_transcript(job, languages={'or': True})
+    second = render_job_editions(job)
+    assert second['status'] == 'exported', second
+    second_path = Path(second['editions']['or']['path'])
+    assert second_path != first_path
+    marker = json.loads((first_path.parents[1] / 'superseded.json').read_text(encoding='utf-8'))
+    assert marker['superseded_by'] == str(second_path) and 'not the current' in marker['note']
+
+    data = edition_files.report(job, verify=True)
+    row = data['editions']['or']
+    assert row['current']['path'] == str(second_path)
+    assert row['current']['captions']['burned'] is True
+    assert [Path(item['path']) for item in row['older']] == [first_path]
+    assert row['older'][0]['captions']['burned'] is False
+
+
+@needs_ffmpeg
+def test_a_plan_that_asks_for_captions_cannot_re_burn_them_after_the_job_switched_them_off(tmp_path):
+    """The stale-plan hole: a plan made while Odia captions were on, rendered after they were switched off."""
+    from engine import edition_files
+    from engine import finishing_studio as finish
+    from engine.language_editions import set_transcript, transcript_plan
+    job = _job(tmp_path, transcript=True)
+    assert transcript_plan(job)['editions'] == {'or': True}
+    set_transcript(job, languages={'or': False})
+    state = json.loads((job / 'production' / 'language_editions.json').read_text(encoding='utf-8'))
+    bundle = state['bundles']['or']
+    visual = Path(json.loads((job / 'production' / 'visual_master.json').read_text())['path'])
+    plan_path = finish.create_plan(visual, {'or': None}, languages=['or'], output_root=job / 'language_editions',
+                                   source_rights='own_content', source_language='en', require_profiles=False,
+                                   fit_narration=True, captions=True)      # the stale intention
+    finish.set_edition(plan_path, 'or', reviewed=True)
+    exported = finish.render(plan_path, 'or')
+    provenance = json.loads(Path(exported).with_suffix('.provenance.json').read_text(encoding='utf-8'))
+    assert provenance['captions_requested_by_plan'] is True
+    assert provenance['captions_burned'] is False
+    assert provenance['captions_job_setting'] is False
+    assert 'switched off' in provenance['captions_suppressed']
+    assert edition_files.captions_state(exported)['burned'] is False
+
+
+@needs_ffmpeg
+def test_a_plan_without_captions_still_burns_them_when_the_job_asks_for_them(tmp_path):
+    """The guard only ever removes captions the job switched off; it never adds any."""
+    from engine import finishing_studio as finish
+    job = _job(tmp_path)
+    state = json.loads((job / 'production' / 'language_editions.json').read_text(encoding='utf-8'))
+    bundle = state['bundles']['or']
+    visual = Path(json.loads((job / 'production' / 'visual_master.json').read_text())['path'])
+    plan_path = finish.create_plan(visual, {'or': None}, languages=['or'], output_root=job / 'language_editions',
+                                   source_rights='own_content', source_language='en', require_profiles=False,
+                                   fit_narration=True, captions=False)
+    finish.set_edition(plan_path, 'or', reviewed=True)
+    exported = finish.render(plan_path, 'or')
+    provenance = json.loads(Path(exported).with_suffix('.provenance.json').read_text(encoding='utf-8'))
+    assert provenance['captions_burned'] is False and provenance['captions_suppressed'] == ''
+    assert provenance['captions_job_setting'] is False
+
+
+@needs_ffmpeg
+def test_a_copy_that_cannot_be_replaced_is_moved_out_of_the_way_not_advertised(tmp_path, monkeypatch):
+    """A player holding render/ open on Windows is how the app ended up playing yesterday's video."""
+    from engine import edition_files
+    from engine import finishing_studio as finish
+    from engine import language_editions as LE
+    job = _job(tmp_path)
+    report = LE.render_job_editions(job)
+    assert report['status'] == 'exported'
+    entry = _export(job)
+    copy = Path(entry['render_copy'])
+    copy.write_bytes(b'an older video that is open in a player')
+    monkeypatch.setattr(LE, '_publish_copy', lambda *a, **k: (_ for _ in ()).throw(OSError('file is in use')))
+    record = json.loads(LE._record_path(job).read_text(encoding='utf-8'))
+    assert LE._sync_render_copies(job, record) is True
+    LE._save_record(job, record)
+    entry = _export(job)
+    assert entry['render_copy'] == ''
+    assert 'previous copy was renamed' in entry['render_copy_error']
+    assert copy.exists() is False
+    stale = list((job / 'render').glob('*-or-edition.superseded-*.mp4'))
+    assert len(stale) == 1
+    data = edition_files.report(job, verify=True)
+    assert data['editions']['or']['current']['path'] == entry['path']
+    assert any('could not be updated' in problem for problem in data['editions']['or']['problems'])
+
+
+# --------------------------------------------------------------------------- UI and CLI surface
+
+
+def test_the_panel_names_the_current_file_and_lists_the_older_ones():
+    app = (ROOT / 'app.py').read_text(encoding='utf-8')
+    assert 'from engine import edition_files' in app
+    assert 'This is the current ' in app
+    assert 'Older ' in app and '(not current)' in app
+    assert 'edition_files.report(job_dir, verify=False)' in app
+    assert 'edition_files.summary(job_dir)' in app
+
+
+def test_the_cli_can_list_the_files_without_rendering():
+    cli = (ROOT / 'cli.py').read_text(encoding='utf-8')
+    assert '"--files"' in cli
+    assert 'from engine import edition_files' in cli
+    assert 'Current files (this is what to watch' in cli
+
+
+@needs_ffmpeg
+def test_the_export_without_a_transcript_has_no_text_in_the_caption_band(tmp_path):
+    """The check the field report asked for: look at the picture, not only at a JSON flag."""
+    from PIL import Image, ImageChops
+    from engine.language_editions import render_job_editions, set_transcript
+    job = _job(tmp_path)
+    without = Path(render_job_editions(job)['editions']['or']['path'])
+    set_transcript(job, languages={'or': True})
+    with_captions = Path(render_job_editions(job)['editions']['or']['path'])
+    assert without != with_captions
+
+    def band(video, moment=3.0):
+        frame = tmp_path / (video.stem + '.png')
+        subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-ss', str(moment), '-i', str(video),
+                        '-frames:v', '1', str(frame)], check=True)
+        image = Image.open(frame).convert('L')
+        width, height = image.size
+        return image.crop((0, int(height * 0.68), width, int(height * 0.93)))
+
+    def near_white(image):
+        pixels = list(image.getdata())
+        return sum(1 for pixel in pixels if pixel >= 235) / max(1, len(pixels))
+
+    plain, burned = band(without), band(with_captions)
+    assert near_white(burned) > 0.002, 'the render with a transcript should show caption text'
+    assert near_white(plain) < 0.0005, 'the render without a transcript must not show caption text'
+    difference = ImageChops.difference(plain, burned)
+    assert sum(difference.getdata()) / max(1, len(difference.getdata())) > 1.0
