+#!/usr/bin/env python3
+"""Apply the v7.0.93 update to a v7.0.92 installation.
+
+An image request whose saved Flow project holds no generated image is recovered once and, if still empty, archived
+(kept, never deleted) and replaced by one fresh image request. A shot gets at most 3 image submissions. Two or more
+real outputs stay blocked and are never resubmitted. Video requests are never resubmitted automatically. The Resume
+gate lets an unacknowledged image submission with no local image run through generate(). Archive names never collide.
+Nothing is submitted, generated or charged by this update itself.
+
+Usage (run from the existing installation folder, after extracting the 7.0.93 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.93/tools/update_v792_to_v793.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.93/tools/update_v792_to_v793.py . --apply    # installs the code
+
+Only code and documentation are replaced. Outputs, saved jobs, browser profiles,
+music, characters and channel profiles are never copied, moved or deleted.
+Stop the dashboard before --apply.
+"""
+
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = [
+    'FLOW_FRESH_IMAGE_REQUESTS_V7_0_93.md',
+    'VERSION',
+    'engine/flow_image_transaction.py',
+    'engine/flow_request_archive.py',
+    'engine/flow_resume_safety.py',
+    'engine/providers/flow_browser.py',
+    'tests/test_v743_image_transactions.py',
+    'tests/test_v791_reference_labels.py',
+    'tests/test_v792_stalled_recovery.py',
+    'tests/test_v793_fresh_image_requests.py',
+    'tools/update_v792_to_v793.py',
+]
+# Files as they exist in 7.0.92: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['1460acf4b3427d07850b5effa4f74e58cd7e8c4c52beb9b7d3f0bd7c8672d780'],
+    'engine/flow_image_transaction.py': ['19e56641ed4216245f97db2ccdbdac680c77ac056b64b9f4292699a883761f7c'],
+    'engine/flow_request_archive.py': ['5ca4c1ffdb32a0dc9e5f6723405efe3559b85ee8d2fedd40f1cbd950cac18b9c'],
+    'engine/flow_resume_safety.py': ['7f80a8d630ef13edd61d0a45e65d6798025ba3692febedb43241551a97f4552b'],
+    'engine/providers/flow_browser.py': ['81ffe26a042f4e9969265ae91893bfc475b4459024144eb63fc6ad9d1ebe5be8'],
+    'tests/test_v743_image_transactions.py': ['b607be5cd54378246cc1fb82fb295396cb5b073797a2558142e7a0619ae58744'],
+    'tests/test_v791_reference_labels.py': ['44df7993ea580ce5193c80f3d8985ad31b98686d499d983d82935fdd1552db27'],
+    'tests/test_v792_stalled_recovery.py': ['5e7672b99a28eb7e4c15393b6c081a10b53262aa071dcf910c9d63d4400c5a03'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.92', '7.0.93')  # 7.0.93 allows a safe re-run after success
+
+# The 7.0.91 to 7.0.92 update ships in the 7.0.92 zip. Apply it first on an older installation.
+EARLIER_STEPS = [
+    ('7.0.91', '7.0.92', 'tools/update_v791_to_v792.py'),
+]
+
+
+def chain_message(current):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.92 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.92 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.92 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this 7.0.93 update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current))
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the 7.0.93 folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        if destination.exists() and sha(destination) not in ALLOWED.get(name, []) + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+    plan = {'target': str(target), 'installed_version': current, 'apply': args.apply,
+            'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every 7.0.93 code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v7.0.92-to-v7.0.93-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to 7.0.93. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat).')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
+        raise SystemExit(1)
