+def fingerprint_parts(audio, words, script, variant=''):
+    """What the draft fingerprint is made of, kept so a mismatch can name the part that changed (7.0.108)."""
+    h = hashlib.sha256()
+    with Path(audio).open('rb') as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
+            h.update(chunk)
+    return {'audio': h.hexdigest(),
+            'words': hashlib.sha256(json.dumps(words, sort_keys=True, ensure_ascii=False).encode()).hexdigest(),
+            'script': hashlib.sha256(str(script).encode()).hexdigest(),
+            'variant': hashlib.sha256(str(variant).encode()).hexdigest(),
+            'word_count': len(words or []), 'script_chars': len(str(script or '').strip())}
+
+
+PARTS_LABELS = {'audio': 'the narration audio', 'words': 'the narration word timings',
+                'script': 'the reviewed script', 'variant': 'the video type or topic'}
+
+
+def job_reference(path):
+    """The job id a card/hook file belongs to, so a repair message can be pasted verbatim (v7.0.108)."""
+    path = Path(path).resolve()
+    for parent in list(path.parents)[:6]:
+        production = parent / 'production'
+        if not production.is_dir():
+            continue
+        # A real output job keeps its renders beside production/, or names its editions there. A bare
+        # ``production/speech_cards.json`` can also be a review bundle, which has no job to re-render.
+        if (parent / 'render').is_dir() or (production / 'language_editions.json').is_file():
+            return parent.name
+    return ''
+
+
+def stale_draft_error(kind, path, data, audio, words, script, variant='', language='', job=''):
+    """A precise, repairable message for a card/hook file drafted from different narration (7.0.108).
+
+    Field rule: never a bare "resume to refresh". Name the file, the part that changed, the numbers, and the
+    one command that fixes it without new TTS or new video generation.
+    """
+    now = fingerprint_parts(audio, words, script, variant)
+    stored = data.get('parts') if isinstance(data, dict) else None
+    changed = [PARTS_LABELS[key] for key in ('audio', 'words', 'script', 'variant')
+               if isinstance(stored, dict) and key in stored and stored.get(key) != now.get(key)]
+    if not stored:
+        detail = 'the saved file predates part-by-part checking, so the change is in the narration audio, its word timings or the script'
+    elif changed:
+        detail = ', '.join(changed) + ' changed since the draft'
+    else:
+        detail = 'the saved fingerprint does not match this narration'
+    where = str(path)
+    job = str(job or '') or job_reference(path)
+    target = job or '<job>'
+    language_flag = (' --language ' + language) if language else ''
+    repair = f"python3 cli.py v3 refresh-cards {target}{language_flag}"
+    rerun = (f"python3 cli.py v3 language-outputs {target} --fit-hold 8" if language
+             else "the same render again (python3 cli.py v3 resume " + target + ")")
+    return (f"{kind} in {where} were drafted from a different narration: {detail}. "
+            f"Saved draft: {stored.get('word_count') if isinstance(stored, dict) else '?'} words, "
+            f"{stored.get('script_chars') if isinstance(stored, dict) else '?'} script characters; "
+            f"this edition: {now['word_count']} words, {now['script_chars']} script characters. "
+            f"Nothing was rendered with stale timings. Repair in one step - no new TTS, no new video, "
+            f"no Flow credits: `{repair}` (one Gemini Web request per language), then run {rerun}.")
+
