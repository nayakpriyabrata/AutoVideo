+def script_accurate_words(script_text: str, words, duration: float | None = None):
+    """Caption text from the reviewed script, timings from the saved words (v7.0.109).
+
+    Field report: a burned Odia transcript showed the right words with the wrong spellings. Speech recognition
+    returns its own guess at how a word is written, and a machine-translated script carries its own spelling, so
+    whichever of the two produced the caption could disagree with the script the user approved. Captions must
+    say exactly what was reviewed.
+
+    Returns ``(words, report)``. ``report`` is ``{'corrected': n, 'before': n, 'after': n, 'note': str}`` and
+    is empty when nothing changed. Timing is never invented here: ``align_words_to_script`` keeps every anchor it
+    can match and interpolates the rest inside the measured audio.
+    """
+    original = [dict(w) for w in (words or [])]
+    report = {'corrected': 0, 'before': len(original), 'after': len(original), 'note': ''}
+    script = str(script_text or '').strip()
+    if not original or not script:
+        return original, report
+    try:
+        duration = float(duration or max([float(w.get('end', 0) or 0) for w in original] + [0.0]))
+    except (TypeError, ValueError):
+        duration = 0.0
+    aligned = align_words_to_script(script, original, max(0.1, duration))
+    report['after'] = len(aligned or [])
+    if not aligned:
+        return original, report
+    corrected = sum(1 for before, after in zip(original, aligned)
+                    if str(before.get('word', '')).strip() != str(after.get('word', '')).strip())
+    report['corrected'] = corrected + abs(len(aligned) - len(original))
+    if not report['corrected']:
+        return original, report
+    report['note'] = (f"Caption text follows the reviewed script: {corrected} of {len(aligned)} caption words "
+                      f"were replaced and {abs(len(aligned) - len(original))} added or removed to match it.")
+    return aligned, report
+
+
