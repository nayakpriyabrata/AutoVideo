+def test_channel_badge_covers_its_whole_window_without_gaps():
+    from engine.render.graphics import watermark_segments
+    events = watermark_segments('The Skill Shift Pro', 5.0, 125.0)
+    assert events, 'a channel mark must be produced'
+    assert events[0].start == pytest.approx(5.0) and events[-1].end == pytest.approx(125.0)
+    for before, after in zip(events, events[1:]):
+        assert after.start == pytest.approx(before.end)      # contiguous: the name never vanishes
+    assert any(e.body == 'closed' for e in events)           # ... but it still opens and closes
