+#!/usr/bin/env python3
+"""Apply the v7.0.111 update to a v7.0.110 installation.
+
+Two field reports:
+
+1. **"The Odia video still has the transcript, in language_editions and in render."** v7.0.111 named the current
+   file and made a stale plan incapable of re-burning captions. v7.0.112 adds the witness that cannot argue with
+   itself: every render now samples the finished picture and records whether text is actually burned into its
+   caption band, ``--files --check-captions`` shows that measurement, and the panel plays the uniquely named
+   export instead of the stable ``render/`` copy a browser can serve from its cache.
+2. **"The English text card covers the presenter's face, and the Hindi/Odia cards look different - make them match
+   the English one, in the middle, off the face."** One card band now applies to every language and every card
+   kind (``engine/render/card_band.py``): below the head, above the burned captions, centred in between. The
+   editions draw their cards with the same renderer and the same style the English master used, instead of their
+   own navy panel at 72 %.
+
+Nothing is generated, re-recorded or charged by this update.
+
+Usage (run from the existing installation folder, after extracting the 7.0.112 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.112/tools/update_v7111_to_v7112.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.112/tools/update_v7111_to_v7112.py . --apply    # installs the code
+
+Only code, documentation and tests are replaced. Outputs, saved jobs, Flow journals, browser profiles and
+``music_library/`` are never copied, moved or deleted. Stop the dashboard before --apply.
+"""
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = [
+    'VERSION', 'app.py', 'cli.py',
+    'engine/edition_files.py', 'engine/language_editions.py', 'engine/finishing_studio.py',
+    'engine/speech_cards.py', 'engine/render/graphics.py', 'engine/render/educational_cards.py',
+    'engine/render/captions_ass.py', 'engine/render/card_band.py', 'engine/render/caption_check.py',
+    'tests/test_v7112_card_band_and_picture_check.py', 'tests/test_v733_publication_review.py',
+    'CARDS_AND_CAPTION_CHECK_V7_0_112.md', 'tools/update_v7111_to_v7112.py',
+]
+# Files as they exist in 7.0.110: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['a9731290a3c8614d00c3f689eab19b31845b55daf219e09ca9cf853604596c2d'],
+    'app.py': ['aa068fae4b61af4728c7229632a5275187f4ba5fc72c27789ae7dcdaaaf890bc'],
+    'cli.py': ['50d1a6ea2cfd66feedca29cb4fcc5a3e082b5a9a88264045e36f389bb845d4bf'],
+    'engine/language_editions.py': ['f30331af16e875c83a0bf4735797b339b3bc7251918740045538fa85507b7601'],
+    'engine/finishing_studio.py': ['383f86b94d139df7ea161fcc66c8be676d6a11ac50fb369b59a8e0339dc23ae6'],
+    'engine/edition_files.py': ['d015806d9f6e0f0a493bc75bcea316780c07527f63aba8c4395ede6c687c4cb5'],
+    'engine/speech_cards.py': ['edabb9db2a725235c51cb5ea4b7da0cfeb10d3e98bdaf8ae980d383dcd536ff4'],
+    'engine/render/graphics.py': ['c70fafef9be8cdaff15cf2546fc2b8ad34b78d5f023ba60704f1fc20ad6a8865'],
+    'engine/render/educational_cards.py': ['1a53320fd9d0c9d947e681bb4b42822953178a6d0f75307e10fc1293197eb455'],
+    'engine/render/captions_ass.py': ['136ca1ec8c85ce6704fdd60e9fab0edac8c30cfbad9d6590d7f8ab6f98480440'],
+    'tests/test_v733_publication_review.py': ['98c559d2b90b962879371bff0f492e8d1e215b02e650fc6eaea1294ff592e14d'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.111', '7.0.112')  # 7.0.112 allows a safe re-run after success
+
+# The 7.0.112 zip carries the 7.0.111 update; apply that first on an older installation.
+EARLIER_STEPS = [
+    ('7.0.110', '7.0.111', 'tools/update_v7110_to_v7111.py'),
+]
+
+
+def chain_message(current, version):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.111 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.111 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.111 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this ' + version + ' update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current, source.name or '7.0.112'))
+    new_version = (source / 'VERSION').read_text(encoding='utf-8').strip()
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the ' + new_version +
+                         ' folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        allowed = ALLOWED.get(name, [])
+        if destination.exists() and allowed and sha(destination) not in allowed + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+    plan = {'target': str(target), 'installed_version': current, 'new_version': new_version,
+            'apply': args.apply, 'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every ' + new_version + ' code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v' + current + '-to-v' + new_version + '-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to ' + new_version + '. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat).')
+        print('Nothing was re-rendered, no voice was re-recorded and no Flow credit was spent. To see which '
+              'language video is the current one, and whether it really shows a transcript: '
+              'python3 cli.py v3 language-outputs <job> --files --check-captions')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
