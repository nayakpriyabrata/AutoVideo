+#!/usr/bin/env python3
+"""Apply the v7.0.96 update to a v7.0.95 installation.
+
+A Resume that could not collect a saved Flow image used to repeat the same six-minute wait
+forever, then stop at "Saved request unresolved; no new generation started":
+
+- when the saved request names a Flow project that cannot be reopened (or Flow is showing a
+  different project), recovery no longer waits in that page and no longer retries three times.
+  Nothing is downloaded from another project, because that image can belong to a different shot.
+  The journal records why, and one fresh FREE image request is submitted in a new project;
+- the three-submission automatic budget is counted per shot for automatic replacements only,
+  so the published archive command can no longer block itself; an explicit archive always
+  allows exactly one more free image request;
+- image requests cost no Flow credits (config/flow_models.yaml: credits_per_image 0), so the
+  archive command no longer needs --confirm-new-credit-spend (the flag is still accepted);
+- the blocked-Resume message, the Queue panel and `tools/flow_resume_preflight.py` now state the
+  last recovery verdict, the saved project, and the one command that moves the job forward;
+- `tools/flow_resume_preflight.py` is read-only and explains every journal.
+
+Nothing is generated, rendered or charged by this update itself.
+
+Usage (run from the existing installation folder, after extracting the 7.0.96 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.96/tools/update_v795_to_v796.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.96/tools/update_v795_to_v796.py . --apply    # installs the code
+
+Only code and documentation are replaced. Outputs, saved jobs, browser profiles,
+music, characters and channel profiles are never copied, moved or deleted.
+Stop the dashboard before --apply.
+"""
+
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = ['RESUME_LOOP_FIX_V7_0_96.md', 'VERSION', 'app.py', 'cli.py',
+           'engine/factory.py', 'engine/flow_image_transaction.py', 'engine/flow_request_archive.py',
+           'engine/flow_resume_recovery.py', 'engine/flow_resume_safety.py', 'tests/test_v791_reference_labels.py',
+           'tests/test_v792_stalled_recovery.py', 'tests/test_v796_resume_loop.py',
+           'tools/archive_uncertain_flow_image.py', 'tools/flow_resume_preflight.py',
+           'tools/update_v795_to_v796.py']
+# Files as they exist in 7.0.95: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['38c62ac999db99b05bbaf34f800f7e8614d9f9d4497ed51148982014e952dd24'],
+    'app.py': ['ba6b11582e96f1b58bc10b491e961912601af4d80bd91ab363df5273af4ad5df'],
+    'cli.py': ['3d4768bfadaa911f3a043a0894f1a4bc06b177db8f2e4afa1d42e3ca7298ff04'],
+    'engine/factory.py': ['4bf2cff95a4af619c8cd6c4d03c5861b02307cf2fab900f4aa921aab96659229'],
+    'engine/flow_image_transaction.py': ['436d34ead58a60139c28b41706aaccf2fb48b5913265ed4aa0351aaa8eb6dd4d'],
+    'engine/flow_request_archive.py': ['f405085fb17411d91fdf2820bd28941c6681c59ab6fc76fc702c8415acc8391b'],
+    'engine/flow_resume_recovery.py': ['c0910077bcf8a7f58e72b3e83a48700489ed1b6a6ec2f91e4ea65d98da871a1b'],
+    'engine/flow_resume_safety.py': ['26d132a73815d1431e8e282fd1722733bb12dab42f668e6fc6c198069dff5299'],
+    'tests/test_v791_reference_labels.py': ['f5dbba0c85bb4b7e1a8dfd2f4b916bea5543d945242b3c9e4020e452362e5df9'],
+    'tests/test_v792_stalled_recovery.py': ['7372e121c46e6126acbb9fcdccef8831089f55feb1549a694f7fccd2776676bb'],
