+def test_deleting_a_job_backs_up_every_language_video_not_only_the_primary(tmp_path, monkeypatch):
+    """The user asked: does deleting a job keep a copy of each language video? It did not - now it does."""
+    monkeypatch.setenv('HOME', str(tmp_path / 'home'))
+    from engine import job_delete
+    outputs = tmp_path / 'outputs'
+    job = outputs / 'job'
+    final = job / 'render' / 'job-final.mp4'
+    final.parent.mkdir(parents=True)
+    final.write_bytes(b'\x00' * 2048)
+    hindi = job / 'render' / 'job-hi-edition.mp4'
+    hindi.write_bytes(b'h' * 1024)
+    branded = job / 'render' / 'job-branded.mp4'
+    branded.write_bytes(b'b' * 512)
+    odia = job / 'language_editions' / '20261027-173643-f046a5a0' / 'exports' / 'or-20261027.mp4'
+    odia.parent.mkdir(parents=True)
+    odia.write_bytes(b'o' * 4096)
+    (job / 'production_manifest.json').write_text(json.dumps({'status': 'done'}))
+    monkeypatch.setattr(job_delete, 'job_completion_state', lambda path: ('', 'completed'))
+    monkeypatch.setattr(job_delete, 'find_final_video', lambda path, *a, **k: (final, [
+        {'path': str(final), 'valid': True, 'bytes': final.stat().st_size, 'reason': ''}]))
+    import sqlite3
+    db = tmp_path / 'jobs.db'
+    with sqlite3.connect(db) as cx:
+        cx.execute('CREATE TABLE jobs (job_id TEXT)')
+        cx.execute('INSERT INTO jobs VALUES (?)', ('job',))
+
+    preview = job_delete.completed_job_delete(outputs, db, 'job')
+    assert len(preview['video_backups']) == 4, preview['video_backups']
+    assert 'every language edition' in preview['keeps']
+
+    result = job_delete.completed_job_delete(outputs, db, 'job', apply=True, confirmation='job')
+    assert result['deleted'] is True and not job.exists()
+    kept = {Path(row['target']).name: Path(row['target']) for row in result['video_backups']}
