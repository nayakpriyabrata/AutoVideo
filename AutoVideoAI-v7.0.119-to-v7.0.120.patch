+#!/usr/bin/env python3
+"""Apply the v7.0.120 update to a v7.0.119 installation.
+
+The field report after v7.0.119: "i can see it, but i don't see how to progress from this or run these jobs to
+continue with these assets."  The batches were readable and playable - and the page offered no way forward.
+
+1. **Use these voices** in a finished Create step 4 batch, with two buttons:
+
+   * *Create a production from these voices* builds an approved plan from the batch's own master narration, word
+     for word, creates a job whose script is that narration, copies the English/Hindi/Odia voices into the job
+     and opens it. The duration comes from the measured English voice. Nothing is generated: the job waits for
+     an explicit Resume, so no Flow credit is spent by choosing this. The duration and the credit cap (100) are
+     stated in the confirmation.
+   * *Attach these voices to a saved job* copies the voices into a job whose approved script is the same
+     narration. Only such jobs are offered, because the engine reuses prepared narration only when the script and
+     language match; anything else would be refused at Resume. `production/speech_attachment.json` records which
+     batch was attached and when.
+
+   Both require the user's own rights statement ("I wrote this narration or own it" / written permission /
+   licensed); the app never assumes it.
+
+2. A crash found while wiring this up: the *"Fix the transcript text"* language picker in the three-language panel
+   handed Streamlit a LanguagePack object instead of its label, so opening any job with a narratable edition
+   raised "TypeError: bad argument type for built-in operation" and the page stopped rendering.
+
+Nothing is rendered, re-recorded, resubmitted or charged by this update, and no saved job or batch is modified
+until you press one of the new buttons.
+
+Usage (run from the existing installation folder, after extracting the 7.0.120 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.120-Use-Prepared-Voices/tools/update_v7119_to_v7120.py .            # dry run
+    python3 ../AutoVideoAI-v7.0.120-Use-Prepared-Voices/tools/update_v7119_to_v7120.py . --apply    # install
+
+Only code, documentation and tests are replaced. Outputs, saved jobs, speech batches, Flow journals, browser
+profiles and ``music_library/`` are never copied, moved or deleted. Stop the dashboard before --apply.
+"""
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = [
+    'VERSION', 'app.py', 'engine/batch_actions.py',
+    'tests/test_v7120_use_prepared_voices.py',
+    'USE_PREPARED_VOICES_V7_0_120.md', 'tools/update_v7119_to_v7120.py',
+]
+# Files as they exist in 7.0.119: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['fc517510036f70b3b560f8b9e820d3918a0de4b3d1125d9463a91c57ee0fc021'],
+    'app.py': ['051b7f683fdf5fdb05127ffc286b900abdb3a4c86a9b400be312e71c59564b12'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.119', '7.0.120')  # 7.0.120 allows a safe re-run after success
+
+# The 7.0.120 zip carries the 7.0.119 update; apply that first on an older installation.
+EARLIER_STEPS = [
+    ('7.0.118', '7.0.119', 'tools/update_v7118_to_v7119.py'),
+]
+
+
+def chain_message(current, version):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.119 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.119 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.119 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this ' + version + ' update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current, source.name or '7.0.120'))
+    new_version = (source / 'VERSION').read_text(encoding='utf-8').strip()
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the ' + new_version +
+                         ' folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        allowed = ALLOWED.get(name, [])
+        if destination.exists() and allowed and sha(destination) not in allowed + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+        if destination.exists() and not allowed and sha(destination) != expected[name]:
+            # A file this release introduces (engine/batch_actions.py) must not overwrite a different file that
+            # already sits at that path - the same promise as for an edited file, applied to a new one.
+            raise ValueError('A different file already exists where this update installs ' + name +
+                             '; preserved it and changed nothing. Move it aside and run the update again.')
+    plan = {'target': str(target), 'installed_version': current, 'new_version': new_version,
+            'apply': args.apply, 'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every ' + new_version + ' code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v' + current + '-to-v' + new_version + '-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to ' + new_version + '. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat), then check the install with:')
+        print('    python3 cli.py v3 self-check')
+        print('Then open Jobs & Recovery > Queue & Resume, expand a finished Create step 4 batch and use '
+              '"Use these voices": it either creates a production whose script is exactly this narration or '
+              'attaches the voices to a saved job that already approved the same script. Nothing is generated by '
+              'either button - the first Flow credit is spent when you press Resume.')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
+        raise SystemExit(1)
