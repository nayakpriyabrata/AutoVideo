+def gemini_shot_plan(root, shots, count):
+    """Every shot with its eligibility, so the app and the CLI can offer a real choice.
+
+    ``chosen`` lists the shots a user picked (saved in ``gemini-videos/selection.json``); when nothing is
+    saved, the first ``count`` eligible shots are used exactly as before.
+    """
+    if type(count) is not int or not 0 <= count <= 4:
+        raise ValueError('Gemini video cap must be zero to four')
