+def job_cast(job_dir):
+    """The saved characters this job's storyboard will use, from its own snapshot (v7.0.122).
+
+    ``character_snapshot.json`` / ``cast_snapshot.json`` are written by Create when the job is made, so a job
+    always says which saved character it carries - including a job made from a prepared narration batch.
+    """
+    root = Path(job_dir)
+    for name, key in (('cast_snapshot.json', 'characters'), ('character_snapshot.json', None)):
+        data = read(root / name)
+        if not isinstance(data, dict):
+            continue
+        rows = (data.get(key) if key else [data]) or []
+        rows = [row for row in rows if isinstance(row, dict) and row.get('id')]
+        if rows:
+            return rows
+    return []
