+def branding_panel(job_id):
+    """The channel profile of a saved job - name, logo, intro, outro - and the one repair allowed (v7.0.123).
+
+    A job made from a prepared narration batch carried no profile at all, so Three-language output could only
+    answer "no intro, no outro" and the video kept whatever name Create had guessed. This panel names what the
+    job holds per language and lets the user attach a profile afterwards. It writes settings only: the intro and
+    outro are added, and every edition is rendered, from the picture the job already has - no shot is generated
+    again and no Flow credit is spent.
+    """
+    from engine import channel_profiles as branding
+    from engine.languages import LANGUAGES as LANGUAGE_PACKS
+    job_dir = F.pm.job_dir(job_id)
+    notice = st.session_state.pop('branding-notice', '')
+    if notice:
+        st.success(notice)
+    st.subheader('Channel profile · name, logo, intro and outro')
+    editions = branding.job_editions(job_dir)
+    current = branding.job_profiles(job_dir)
+    saved = branding.saved_profiles()
+    if current:
+        by_path = {row['path']: row for row in saved}
+        st.caption('Saved for this job: ' + (branding.summary([
+            {'language': code, 'channel_name': by_path.get(path, {}).get('name', '') or path,
+             'logo': by_path.get(path, {}).get('logo', False),
+             'intro': by_path.get(path, {}).get('intro', False),
+             'outro': by_path.get(path, {}).get('outro', False)}
+            for code, path in current.items()]) or ', '.join(current)))
+    else:
+        st.warning('No channel profile is saved for this job, so its editions render without a channel name, '
+                   'logo, intro or outro. Choose one below - it needs no new generation.')
+    if not saved:
+        st.caption('No channel profile exists on this installation yet. Channel Desk creates one (name, logo, '
+                   'intro, outro); it can then be attached here.')
+        return
+    options = {'— none —': ''}
+    for row in saved:
+        line = branding.label(row)
+        while line in options:
+            line += ' · ' + row['path']
+        options[line] = row['path']
+    lines = list(options)
+    chosen = {}
+    columns = st.columns(len(editions))
+    for column, code in zip(columns, editions):
+        remembered = current.get(code) or (options[lines[1]] if len(lines) == 2 else '')
+        default = next((line for line in lines if options[line] == remembered), lines[0])
+        chosen_line = column.selectbox(
+            LANGUAGE_PACKS[code].label + ' channel', lines, index=lines.index(default),
+            key='job-channel-' + job_id + '-' + code)
+        if options[chosen_line]:
+            chosen[code] = options[chosen_line]
+    st.caption('Saving writes the profile into this job only. "Three-language output" below then adds the '
+               'intro/outro and renders each edition from the picture this job already has: no shot is generated '
+               'again, no voice is recorded again, no Flow credit is spent. A job whose picture master is missing '
+               'can build one from its finished video first.')
+    if st.button('Save the channel profile for this job', key='job-channel-save-' + job_id):
+        try:
+            result = branding.attach_profiles(job_dir, chosen, editions=editions)
+            st.session_state['branding-notice'] = (
+                'Saved: ' + (branding.summary(result['rows']) or 'no channel profile')
+                + '. Nothing was generated - press “Resume / continue job” for the pictures, then add the '
+                  'intro/outro from Three-language output.')
+            st.rerun()
+        except Exception as error:
+            st.error(str(error))
+
+
+def flow_choice_panel(job_id):
+    """Pick which of the images Flow already produced is the frame - no browser, no request (v7.0.123)."""
+    from engine import flow_choice
+    job_dir = F.pm.job_dir(job_id)
+    st.subheader('Saved images waiting for your choice')
+    notice = st.session_state.pop('flow-choice-notice', '')
+    if notice:
+        st.success(notice)
+    try:
+        blocked = flow_choice.blocked_frames(job_dir)
+        waiting = flow_choice.all_frames(job_dir)
+    except Exception as error:
+        st.warning('Saved image candidates could not be read: ' + str(error))
+        return
+    if not waiting:
+        st.caption('No saved image is waiting for a choice. Frames Flow finished are already in the job; frames '
+                   'with no saved picture are asked for again when you press Resume.')
+        return
+    if blocked:
+        st.warning('Recovery stopped on ' + str(len(blocked)) + ' frame(s) because more than one real image was '
+                   'saved for the same shot. Nothing was replaced and nothing was resubmitted - choose the image '
+                   'you want below.')
+    st.caption('These pictures are already downloaded and checksummed in this job. Choosing one only copies it '
+               'into the frame; no browser opens, no Flow request is submitted and no credit is spent.')
