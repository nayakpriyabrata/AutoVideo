+def test_the_card_limit_is_its_own_recoverable_verdict():
+    error = fa.ApprovalCardLimitReached(cards=1, limit=1, cost=6)
+    assert isinstance(error, ValueError)          # callers that catch ValueError keep working
+    assert error.cards == 1 and error.limit == 1 and error.cost == 6
+    assert 'approval-card limit' in str(error)
+
+
+def test_reserve_raises_the_typed_limit_after_one_reserved_card(tmp_path):
