index 0000000..869b651
--- /dev/null
+++ b/tests/test_v7117_card_audit.py
@@ -0,0 +1,196 @@
+"""v7.0.117: "would two cards be on screen together?" - answered before an expensive render.
+
+Field sequence: v7.0.116 made an edition draw one card at a time, and the Odia render that came back was made by
+7.0.115 - the record carried no card audit at all. Nothing in the listing said so: a missing field read exactly like
+"checked, fine", and the only way to learn the truth was another hour-long render.
+
+v7.0.117 answers the question from the saved job, in seconds:
+
+* ``engine.card_audit`` lists both card sources for a language, the collisions between them, and what a render will
+  draw - it encodes nothing and writes nothing into the job;
+* the listing says **"cards: not recorded"** for a file rendered before the rule, instead of silence.
+
+These tests hold both, and hold them to being read-only.
+"""
+import json
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+needs_ffmpeg = pytest.mark.skipif(not (shutil.which('ffmpeg') and shutil.which('ffprobe')),
+                                  reason='FFmpeg required')
+os.environ.setdefault('HOME', '/tmp')
+
+SCRIPT = 'ଅଭ୍ୟାସ ଏକ କହିବା ପର୍ବରୁ ସାମାନ୍ୟ ଆଟକନ୍ତୁ ଏବଂ ଧୀରେ ଚାଲନ୍ତୁ ତାପରେ ଅଭ୍ୟାସ ଦୁଇ ଭଲ ଘୁମନ୍ତୁ'
+
+
+def _words():
+    return [{'word': word, 'start': round(0.4 + i * 0.55, 3), 'end': round(0.4 + i * 0.55 + 0.5, 3)}
+            for i, word in enumerate(SCRIPT.split())]
+
+
+def _video(path, seconds, *, audio=False):
+    cmd = ['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i',
+           f'testsrc2=size=640x360:rate=24:duration={seconds}']
+    if audio:
+        cmd += ['-f', 'lavfi', '-i', f'sine=frequency=440:sample_rate=48000:duration={seconds}',
+                '-c:a', 'aac', '-map', '0:v:0', '-map', '1:a:0']
+    else:
+        cmd += ['-an']
+    cmd += ['-c:v', 'libx264', '-pix_fmt', 'yuv420p', str(path)]
+    subprocess.run(cmd, check=True)
+    return path
+
+
+def _job(tmp_path, *, copied_cards=True, drafted=True, card_text='ଅଭ୍ୟାସ ୧: କହିବା'):
+    from engine.production import digest
+    from engine import speech_cards
+    job = tmp_path / 'job'
+    (job / 'render').mkdir(parents=True)
+    (job / 'production').mkdir()
+    picture = _video(job / 'render' / 'visual-master.mp4', 20.0)
+    (job / 'production' / 'visual_master.json').write_text(json.dumps(
+        {'path': str(picture), 'sha256': digest(picture), 'duration': 20.0}), encoding='utf-8')
+    words = _words()
+    folder = job / 'speech-editions' / 'or' / 'key'
+    (folder / 'production').mkdir(parents=True)
+    voice = folder / 'voice.wav'
+    duration = words[-1]['end'] + 0.6
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i',
+                    'sine=frequency=700:sample_rate=44100', '-t', str(duration),
+                    '-c:a', 'pcm_s16le', str(voice)], check=True)
+    (folder / 'words.json').write_text(json.dumps(words, ensure_ascii=False), encoding='utf-8')
+    draft = {'cards': [{'text': card_text, 'start_word': 0, 'end_word': 3}],
+             'word_count': len(words), 'script_chars': len(SCRIPT)}
+    draft['fingerprint'] = speech_cards.fingerprint(voice, words, SCRIPT, '')
+    if drafted:
+        (folder / 'production' / 'speech_cards.json').write_text(json.dumps(draft, ensure_ascii=False),
+                                                                encoding='utf-8')
+    cards = speech_cards.anchor_cards(draft, words, duration, educational=False) if copied_cards else []
+    bundle = {'audio': str(voice), 'audio_sha256': digest(voice), 'duration': duration,
+              'words': str(folder / 'words.json'), 'script': SCRIPT, 'language': 'or',
+              'timing_source': 'test', 'cards': cards, 'text_cards': True, 'educational': False,
+              'cards_ready': True}
+    state = {'source_language': 'en', 'editions': ['en', 'or'], 'profiles': {'or': None},
+             'bundles': {'or': bundle}, 'transcript': {'default': False, 'languages': {}}}
+    (job / 'production' / 'language_editions.json').write_text(json.dumps(state, ensure_ascii=False),
+                                                              encoding='utf-8')
+    return job
+
+
+# ------------------------------------------------------------------ the audit itself
+
+
+@needs_ffmpeg
+def test_the_audit_finds_the_collision_before_any_render(tmp_path):
+    from engine.card_audit import audit_job, format_audit
+    job = _job(tmp_path)
+    data = audit_job(job)
+    row = data['languages']['or']
+    assert row['plan_cards'] == 1 and row['edition_cards'] == 1
+    assert len(row['conflicts']) == 1
+    assert row['drawn'] == 1 and len(row['dropped']) == 1
+    assert row['worst_overlap_seconds'] > 1.0
+    assert row['duplicates'] == 1
+    assert 'the same card is scheduled twice' in row['message']
+    assert 'A render draws it once.' in row['message']
+    assert data['problems'] and 'over' not in data['message']
+    lines = '\n'.join(format_audit(data))
+    assert 'job cards: 1 · edition cards: 1 · drawn by a render: 1' in lines
+    assert 'not drawn twice: "' in lines and 'already drawn once' in lines
+    # nothing was rendered and no export folder was created
+    assert not list((job / 'language_editions').glob('*')) if (job / 'language_editions').exists() else True
+
+
+@needs_ffmpeg
+def test_the_audit_is_read_only(tmp_path):
+    from engine.card_audit import audit_job
+    job = _job(tmp_path)
+    before = sorted((path.relative_to(job).as_posix(), path.stat().st_size)
+                    for path in job.rglob('*') if path.is_file())
+    audit_job(job)
+    after = sorted((path.relative_to(job).as_posix(), path.stat().st_size)
+                   for path in job.rglob('*') if path.is_file())
+    assert before == after
+
+
+@needs_ffmpeg
+def test_a_language_with_only_one_card_source_has_nothing_to_fix(tmp_path):
+    from engine.card_audit import audit_job
+    only_drafted = audit_job(_job(tmp_path / 'a', copied_cards=False))
+    row = only_drafted['languages']['or']
+    assert row['plan_cards'] == 0 and row['edition_cards'] == 1
+    assert row['conflicts'] == [] and row['drawn'] == 1
+    assert 'no two share the screen' in row['message']
+    assert only_drafted['problems'] == []
+    assert 'No two cards share the screen' in only_drafted['message']
+
+    only_copied = audit_job(_job(tmp_path / 'b', drafted=False))
+    row = only_copied['languages']['or']
+    assert row['plan_cards'] == 1 and row['edition_cards'] == 0
+    assert 'no drafted card file of its own' in ' '.join(row['notes'])
+    assert row['drawn'] == 1 and row['conflicts'] == []
+
+
+@needs_ffmpeg
+def test_a_language_with_no_cards_says_so(tmp_path):
+    from engine.card_audit import audit_job
+    data = audit_job(_job(tmp_path, copied_cards=False, drafted=False))
+    row = data['languages']['or']
+    assert row['drawn'] == 0 and row['conflicts'] == []
+    assert 'no text cards saved for this narration' in row['message']
+
+
+@needs_ffmpeg
+def test_the_audit_says_whether_the_current_file_was_rendered_with_the_rule(tmp_path):
+    from engine.card_audit import audit_job, format_audit
+    from engine.language_editions import render_job_editions
+    job = _job(tmp_path)
+    assert audit_job(job)['languages']['or']['rule_recorded'] is False     # nothing rendered yet
+    render_job_editions(job, fit_policy={'allow_hold': 8.0, 'hold_cap': 8.0})
+    row = audit_job(job)['languages']['or']
+    assert row['rule_recorded'] is True
+    assert 'rendered with the one-card rule' in '\n'.join(format_audit(audit_job(job)))
+
+
+# ------------------------------------------------------------------ the listing stops being silent
+
+
+@needs_ffmpeg
+def test_the_listing_says_when_a_file_predates_the_rule(tmp_path):
+    from engine import edition_files
+    from engine.language_editions import render_job_editions, _record_path
+    job = _job(tmp_path)
+    render_job_editions(job, fit_policy={'allow_hold': 8.0, 'hold_cap': 8.0})
+    record = json.loads(_record_path(job).read_text(encoding='utf-8'))
+    # exactly the field state: a file rendered before 7.0.116, with no card audit in the record
+    record['editions']['or'].pop('cards_on_screen_at_once', None)
+    record['editions']['or'].pop('cards_overlap_removed', None)
+    _record_path(job).write_text(json.dumps(record), encoding='utf-8')
+
+    data = edition_files.report(job)
+    row = data['editions']['or']
+    assert row['cards_rule_recorded'] is False
+    listing = '\n'.join(edition_files.format_report(data))
+    assert 'cards: not recorded - this file was rendered before 7.0.116' in listing
+    assert '--card-audit' in listing
+    summary = ' '.join(edition_files.summary(job))
+    assert 'cards: not recorded' in summary
+
+
+@needs_ffmpeg
+def test_the_listing_confirms_the_rule_when_the_file_has_it(tmp_path):
+    from engine import edition_files
+    from engine.language_editions import render_job_editions
+    job = _job(tmp_path)
+    render_job_editions(job, fit_policy={'allow_hold': 8.0, 'hold_cap': 8.0})
+    data = edition_files.report(job)
+    assert data['editions']['or']['cards_rule_recorded'] is True
+    listing = '\n'.join(edition_files.format_report(data))
+    assert 'cards: one at a time' in listing
+    assert 'not recorded' not in listing
+    summary = ' '.join(edition_files.summary(job))
+    assert 'cards: one at a time' in summary
