+#!/usr/bin/env python3
+"""Apply the v7.0.110 update to a v7.0.109 installation.
+
+Two field requests:
+
+1. **"Show me the Odia transcript text, let me fix the spellings, then burn the fixed text."** Each language's
+   transcript can now be read word by word in the job panel (and with ``cli.py v3 transcript <job>``), corrected,
+   and rendered again for that language only. Fixing a spelling keeps every measured word time, so the narration
+   is never re-recorded: no text-to-speech, no video request, no Flow credit. The correction is optional - with
+   no correction the job behaves exactly as in 7.0.109 (measured words, or the reviewed script).
+2. **"I want to choose which shots Gemini generates, in the app."** The picker that existed in Storyboard is now
+   also in the job panel on the Queue and Create pages, with every shot's verdict and reason. 7.0.109 could only
+   do this from the command line, or by typing a number in Create that silently took the first eligible shots.
+
+Nothing is generated, rendered or charged by this update itself. Existing exports stay on disk; they are only
+re-rendered when you ask for it, and a re-render keeps the earlier file.
+
+Usage (run from the existing installation folder, after extracting the 7.0.110 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.110/tools/update_v7109_to_v7110.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.110/tools/update_v7109_to_v7110.py . --apply    # installs the code
+
+Only code, documentation and tests are replaced. Outputs, saved jobs, Flow journals, browser profiles and
+``music_library/`` are never copied, moved or deleted. Stop the dashboard before --apply.
+"""
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = [
+    'VERSION', 'app.py', 'cli.py',
+    'engine/transcript_edit.py', 'engine/finishing_studio.py', 'engine/language_editions.py',
+    'tests/test_v7110_transcript_edit.py', 'tests/test_v7110_gemini_picker_ui.py',
+    'TRANSCRIPT_EDIT_AND_GEMINI_PICKER_V7_0_110.md', 'tools/update_v7109_to_v7110.py',
+]
+# Files as they exist in 7.0.109: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['a397b9e5f4ae9e9add5aa0b486bafe434f7bf658375a8077251603d438556c8f'],
+    'app.py': ['2b7ad9c76884688664f1e4b707cc0ed1663c654400c7ee6407d88339c63c7abd'],
+    'cli.py': ['b3eb5b8c8bc1a1276da4feb7037617d48c86af21170c9dbc79d853ab5805a708'],
+    'engine/finishing_studio.py': ['93f8821dc8c64fa86a14c0a7122f2a4501715bd5acb302c541baa6d0b1c0fa2d'],
+    'engine/language_editions.py': ['7f629ac8bd6e9e7f100dd92273e3bf630efc796e2454acf014c6ca596531f76e'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.109', '7.0.110')  # 7.0.110 allows a safe re-run after success
+
+# The 7.0.110 zip carries the 7.0.109 update; apply that first on an older installation.
+EARLIER_STEPS = [
+    ('7.0.108', '7.0.109', 'tools/update_v7108_to_v7109.py'),
+]
+
+
+def chain_message(current, version):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.109 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.109 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.109 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this ' + version + ' update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current, source.name or '7.0.110'))
+    new_version = (source / 'VERSION').read_text(encoding='utf-8').strip()
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the ' + new_version +
+                         ' folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        allowed = ALLOWED.get(name, [])
+        if destination.exists() and allowed and sha(destination) not in allowed + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+    plan = {'target': str(target), 'installed_version': current, 'new_version': new_version,
+            'apply': args.apply, 'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every ' + new_version + ' code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v' + current + '-to-v' + new_version + '-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to ' + new_version + '. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat).')
+        print('Nothing was re-rendered, no voice was re-recorded and no Flow credit was spent. '
+              'Existing exports stay where they are until you ask for a re-render.')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
+        raise SystemExit(1)
