+"""v7.0.121: the one obvious way to run prepared voices, and stale TTS runs that stop asking.
+
+Two field questions after v7.0.120:
+
+* "still need to know how to resume this so that it will create a job and corresponding video" - the buttons
+  existed but inside a collapsed batch list, so the answer was three levels down.
+* "why is it still showing the tts for the completed jobs?" - a Create step 4 batch that stopped during TTS
+  *inside* a job was listed for ever, even though that job had already narrated and moved on to generating.
+
+So: a **Run your prepared voices** panel at the top of Queue & Resume (pick a batch, state your rights, create the
+job, optionally start it), `v3 use-voices` on the command line, and abandoned TTS runs judged against the job
+they live in and moved out of the to-do list - kept and explained, never deleted.
+"""
+import hashlib
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from engine import narration_assets
+from engine.batch_actions import create_job_from_batch, job_script
+from engine.speech_batches import (actionable, list_speech_batches, stale_reason, usable_now,
+                                   with_attachments)
+
+ROOT = Path(__file__).resolve().parent.parent
+APP = (ROOT / 'app.py').read_text(encoding='utf-8')
+WORDS = [{'word': word, 'start': index * 1.0, 'end': index * 1.0 + 0.9}
+         for index, word in enumerate('small daily habits beat big plans'.split())]
+
+
+def _voices(folder: Path, languages, duration=61.5) -> dict:
+    bundles = {}
+    for code in languages:
+        lang = folder / code / 'k1'
+        lang.mkdir(parents=True, exist_ok=True)
+        audio = lang / 'voice.mp3'
+        # unique bytes per batch: two batches with different narration must not look like the same audio
+        audio.write_bytes(b'ID3' + folder.name.encode() + b'\0' * 6000)
+        (lang / 'words.json').write_text(json.dumps(WORDS))
+        bundles[code] = {'language': code, 'audio': str(audio), 'words': str(lang / 'words.json'),
+                         'audio_sha256': hashlib.sha256(audio.read_bytes()).hexdigest(),
+                         'duration': duration, 'timing_source': 'measured'}
+    return bundles
+
+
+def make_batch(folder: Path, script: str, *, topic='Small habits', done=3, languages=('en', 'hi', 'or'),
+               origin='Create step 4'):
+    folder.mkdir(parents=True, exist_ok=True)
+    bundles = _voices(folder, languages[:done])
+    (folder / 'batch.json').write_text(json.dumps({
+        'source_language': 'en', 'source_script': script, 'editions': list(languages),
+        'scripts': {code: script for code in languages},
+        'request': {'provider': 'gemini', 'topic': topic}, 'error': '', 'bundles': bundles,
+        'phase': 'ready_for_review' if done == len(languages) else 'tts'}))
+    from engine.speech_batches import _row
+    return _row(folder, origin)
+
+
+def make_job(root: Path, job_id: str, *, narration=True, shots=0, status='created', script=''):
+    job = root / 'outputs' / job_id
+    for name in ('production', 'narration', 'logs'):
+        (job / name).mkdir(parents=True, exist_ok=True)
+    if narration:
+        (job / 'narration' / 'voice.mp3').write_bytes(b'ID3' + b'\0' * 6000)
+    if script:
+        (job / 'script.json').write_text(json.dumps({'narration': script}))
+    (job / 'production_manifest.json').write_text(json.dumps(
+        {'job_id': job_id, 'topic': 'a topic', 'language': 'en', 'status': status,
+         'shots': [{'shot_id': 'shot_%03d' % (index + 1), 'status': 'planned'} for index in range(shots)]}))
+    # Queue only scans jobs the database knows about, exactly like the app.
+    from engine.project.database import JobDB
+    JobDB().upsert(job_id, topic='a topic', status=status, video_type='faceless_youtube',
+                   target_seconds=300, aspect='16:9', profile='STORYBOARD_ECONOMY',
+                   preset='cinematic_realism', dry_run=0)
+    return job
+
+
+@pytest.fixture()
+def install(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv('AUTOVIDEO_SHARED_ROOT', str(tmp_path))
+    (tmp_path / 'speech_preparation').mkdir()
+    (tmp_path / 'outputs').mkdir()
+    (tmp_path / 'config').symlink_to(ROOT / 'config')
+    (tmp_path / 'assets').symlink_to(ROOT / 'assets')
+    return tmp_path
+
+
+def test_a_stopped_tts_run_inside_a_finished_job_is_not_a_to_do(install):
+    job = make_job(install, '20261022-143856-7-small-daily-habits', narration=True, shots=2, status='generating')
+    row = make_batch(job, 'old master script', done=2, origin='Job ' + job.name)
+    assert row['origin'].startswith('Job ')
+    reason = stale_reason(row, [job])
+    assert 'already past narration' in reason
+    assert 'status "generating"' in reason and '2 scene(s) planned' in reason
+    assert 'not needed to resume the job' in reason
+    assert 'nothing was deleted' in reason
+    assert 'Resume / continue job' in reason
+
+
+def test_a_stopped_run_in_a_job_that_has_not_narrated_yet_still_asks(install):
+    job = make_job(install, '20261031-120000-fresh-job', narration=False, shots=0, status='created')
+    row = make_batch(job, 'a fresh script', done=2, origin='Job ' + job.name)
+    assert stale_reason(row, [job]) == ''
+    rows = with_attachments([row], [job])
+    assert rows[0]['stale'] is False
+    assert actionable(rows) == rows
+
+
+def test_a_finished_batch_inside_a_job_is_never_called_stale(install):
+    job = make_job(install, '20261031-130000-done-job', narration=True, shots=1, status='narrated')
+    row = make_batch(job, 'a script', done=3, origin='Job ' + job.name)
+    assert row['ready'] is True
+    assert stale_reason(row, [job]) == ''
+    assert actionable([row]) == [row]
+
+
+def test_stale_rows_are_marked_and_leave_the_to_do_list(install):
+    good = make_batch(install / 'speech_preparation' / 'good1', 'small daily habits beat big plans.')
+    job = make_job(install, '20261022-143856-7-old-job', narration=True, shots=3, status='done')
+    bad = make_batch(job, 'old master', done=2, origin='Job ' + job.name)
+    rows = with_attachments([good, bad], [job])
+    flagged = next(row for row in rows if row['key'] == bad['key'])
+    assert flagged['stale'] is True and flagged['stale_reason']
+    assert [row['key'] for row in actionable(rows)] == [good['key']]
+    assert [row['key'] for row in usable_now(rows)] == [good['key']]
+
+
+def test_usable_now_prefers_the_newest_ready_unattached_batch(install):
+    older = make_batch(install / 'speech_preparation' / 'a_older', 'older script')
+    os.utime(older['path'] + '/batch.json', (1_600_000_000, 1_600_000_000))
+    newer = make_batch(install / 'speech_preparation' / 'b_newer', 'newer script')
+    rows = with_attachments(list_speech_batches([], include_finished=()), [])
+    ready = usable_now(rows)
+    assert [row['key'] for row in ready] == ['b_newer', 'a_older']
+    # an attached batch is not offered again
+    job = make_job(install, '20261031-140000-attached', narration=True, script='newer script')
+    from engine.batch_actions import attach
+    attach(next(row for row in rows if row['key'] == 'b_newer'), job)
+    rows = with_attachments(list_speech_batches([job], include_finished=[job]), [job])
+    assert [row['key'] for row in usable_now(rows)] == ['a_older']
+
+
+def test_the_queue_puts_the_answer_at_the_top():
+    queue = APP[APP.index('elif page == "QUEUE":'):APP.index('elif page == "FLOW SESSION":')]
+    assert "st.subheader('Run your prepared voices')" in queue
+    assert "st.selectbox(\n            'Batch to run'" in queue or "'Batch to run'" in queue
+    assert "'Create the job from these voices'" in queue
+    assert 'type=\'primary\'' in queue
+    assert 'Start it as soon as it is created (Flow spends credits as it generates)' in queue
+    assert 'Nothing has been generated yet - press “Resume / continue job” below to make the video.' in queue
+    # the answer sits above the batch list, not inside it
+    assert queue.index("st.subheader('Run your prepared voices')") < queue.index('st.expander(title')
+    # and the abandoned runs are separated, with a label nobody can misread
+    assert 'Stopped TTS runs a job no longer needs · ' in queue
+    assert 'kept, nothing deleted' in queue
+
+
+def test_abandoned_runs_are_excluded_from_the_to_finish_count():
+    start = APP.index('elif page == "QUEUE":')
+    block = APP[start:APP.index('def speech_batch_controls', start)]
+    assert 'own_rows = actionable(own_rows)' in block
+    assert 'other_rows = [row for row in actionable(other_rows)]' in block
+    assert 'stale_rows = [row for row in all_rows if row.get(\'stale\')]' in block
+    assert 'runnable = usable_now(all_rows)' in block
+
+
+def test_the_cli_offers_the_same_path(install):
+    batch = make_batch(install / 'speech_preparation' / 'cli_batch', 'small daily habits beat big plans.')
+    run = subprocess.run([sys.executable, str(ROOT / 'cli.py'), 'v3', 'use-voices', '--list'],
+                         cwd=str(install), capture_output=True, text=True, timeout=180,
+                         env={**os.environ, 'AUTOVIDEO_SHARED_ROOT': str(install), 'PYTHONPATH': str(ROOT)})
+    assert run.returncode == 0, run.stdout + run.stderr
+    assert 'Small habits' in run.stdout
+    assert 'use-voices <batch> --create-job --rights own_content' in run.stdout
+    missing = subprocess.run([sys.executable, str(ROOT / 'cli.py'), 'v3', 'use-voices', 'cli_batch',
+                              '--create-job'], cwd=str(install), capture_output=True, text=True, timeout=180,
+                             env={**os.environ, 'AUTOVIDEO_SHARED_ROOT': str(install), 'PYTHONPATH': str(ROOT)})
+    assert missing.returncode != 0
+    assert 'Choose how you may use this narration' in (missing.stdout + missing.stderr)
+    created = subprocess.run([sys.executable, str(ROOT / 'cli.py'), 'v3', 'use-voices', 'cli_batch',
+                              '--create-job', '--rights', 'own_content', '--seconds', '120'],
+                             cwd=str(install), capture_output=True, text=True, timeout=180,
+                             env={**os.environ, 'AUTOVIDEO_SHARED_ROOT': str(install), 'PYTHONPATH': str(ROOT)})
+    assert created.returncode == 0, created.stdout + created.stderr
+    assert 'Nothing has been generated' in created.stdout
+    assert 'python3 cli.py v3 resume' in created.stdout
+    job_id = created.stdout.split('Created job ')[1].split(' from')[0]
+    folder = install / 'outputs' / job_id
+    assert job_script(folder) == 'small daily habits beat big plans.'
+    assert (folder / 'production' / 'prepared_speech.json').is_file()
+    assert narration_assets.labels(folder) == ['English', 'Hindi', 'Odia']
+
+
+def test_the_page_runs_a_batch_from_the_top_panel(install):
+    """The real page: a job with an abandoned TTS run plus a ready batch; create from the top and check it."""
+    make_batch(install / 'speech_preparation' / 'ready1', 'small daily habits beat big plans.',
+               topic='Small habits', done=3)
+    job = make_job(install, '20261022-143856-7-old-job', narration=True, shots=2, status='generating')
+    make_batch(job, 'old master', done=2, origin='Job ' + job.name)
+    from streamlit.testing.v1 import AppTest
+    at = AppTest.from_file(str(ROOT / 'app.py'), default_timeout=300)
+    at.session_state['autovideo_workspace'] = 'Jobs & Recovery'
+    at.session_state['autovideo_current_page'] = 'QUEUE'
+    at.session_state['autovideo_page_jobs-and-recovery'] = 'QUEUE'
+    at.run()
+    assert not at.exception, [str(item.value) for item in at.exception]
+    assert 'Run your prepared voices' in [item.value for item in at.subheader]
+    labels = [item.label for item in at.get('expander')]
+    assert any('Stopped TTS runs a job no longer needs' in label for label in labels), labels
+    assert 'Create the job from these voices' in [item.label for item in at.button]
+    at.button(key='queue-run-create').click()
+    at.run()
+    assert not at.exception, [str(item.value) for item in at.exception]
+    created = at.session_state['job_id']
+    assert created and created != '20261022-143856-7-old-job'
+    folder = install / 'outputs' / created
+    assert job_script(folder) == 'small daily habits beat big plans.'
+    assert (folder / 'production' / 'prepared_speech.json').is_file()
+    assert [m.value for m in at.metric][:2] == ['✓', '✓']
+    notice = next(item.value for item in at.success if item.value.startswith('Created job'))
+    assert 'Nothing has been generated yet' in notice
+    assert 'Resume / continue job' in notice
