+# --------------------------------------------------------------------------- a real edition render
+
+
+def _video(path, seconds, *, audio=False, size='640x360'):
+    cmd = ['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i',
+           f'testsrc2=size={size}:rate=24:duration={seconds}']
+    if audio:
+        cmd += ['-f', 'lavfi', '-i', f'sine=frequency=440:sample_rate=48000:duration={seconds}',
+                '-c:a', 'aac', '-map', '0:v:0', '-map', '1:a:0']
+    else:
+        cmd += ['-an']
+    cmd += ['-c:v', 'libx264', '-pix_fmt', 'yuv420p', str(path)]
+    subprocess.run(cmd, check=True)
+    return path
+
+
+def _job(tmp_path, *, copied_cards=True, drafted=True):
+    """An Odia edition: a copied job card AND the edition's own drafted card, as the field job had."""
+    from engine.production import digest
+    from engine import speech_cards
+    job = tmp_path / ('job' if copied_cards else 'job-control')
+    (job / 'render').mkdir(parents=True)
+    (job / 'production').mkdir()
+    picture = _video(job / 'render' / 'visual-master.mp4', 20.0)
+    (job / 'production' / 'visual_master.json').write_text(json.dumps(
+        {'path': str(picture), 'sha256': digest(picture), 'duration': 20.0}), encoding='utf-8')
+    words = _words()
+    folder = job / 'speech-editions' / 'or' / 'key'
+    (folder / 'production').mkdir(parents=True)
+    voice = folder / 'voice.wav'
+    duration = words[-1]['end'] + 0.6
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i',
+                    'sine=frequency=700:sample_rate=44100', '-t', str(duration),
+                    '-c:a', 'pcm_s16le', str(voice)], check=True)
+    (folder / 'words.json').write_text(json.dumps(words, ensure_ascii=False), encoding='utf-8')
+    draft = {'cards': [{'text': 'ଅଭ୍ୟାସ ୧: କହିବା', 'start_word': 0, 'end_word': 3}],
+             'word_count': len(words), 'script_chars': len(SCRIPT)}
+    draft['fingerprint'] = speech_cards.fingerprint(voice, words, SCRIPT, '')
+    if drafted:
+        (folder / 'production' / 'speech_cards.json').write_text(json.dumps(draft, ensure_ascii=False),
+                                                                encoding='utf-8')
+    cards = speech_cards.anchor_cards(draft, words, duration, educational=False) if copied_cards else []
+    bundle = {'audio': str(voice), 'audio_sha256': digest(voice), 'duration': duration,
+              'words': str(folder / 'words.json'), 'script': SCRIPT, 'language': 'or',
+              'timing_source': 'test', 'cards': cards, 'text_cards': True, 'educational': False,
+              'cards_ready': True}
+    state = {'source_language': 'en', 'editions': ['en', 'or'], 'profiles': {'or': None},
+             'bundles': {'or': bundle}, 'transcript': {'default': False, 'languages': {}}}
+    (job / 'production' / 'language_editions.json').write_text(json.dumps(state, ensure_ascii=False),
+                                                              encoding='utf-8')
+    return job
+
+
+def _render_with_audit(job, monkeypatch):
+    """Render the Odia edition and report exactly what was drawn: the copied cards and the overlays."""
+    from engine import finishing_studio as finish
+    from engine.production import digest
+    picture = Path(json.loads((job / 'production' / 'visual_master.json').read_text(encoding='utf-8'))['path'])
+    plan_path = finish.create_plan(picture, {'or': None}, languages=['or'], output_root=job / 'language_editions',
+                                  source_rights='own_content', source_language='en', require_profiles=False,
+                                  fit_narration=True, captions=False)
+    finish.set_edition(plan_path, 'or', reviewed=True)
+    drawn_cards, overlays = [], []
+    real_card, real_overlays = finish._card_image, finish._add_overlays
+
+    def card_image(text, *args, **kwargs):
+        drawn_cards.append(text)
+        return real_card(text, *args, **kwargs)
+
+    def add_overlays(cmd, filters, current, inp, specs, *args, **kwargs):
+        overlays.extend(dict(spec) for spec in specs)
+        return real_overlays(cmd, filters, current, inp, specs, *args, **kwargs)
+
+    monkeypatch.setattr(finish, '_card_image', card_image)
+    monkeypatch.setattr(finish, '_add_overlays', add_overlays)
+    exported = finish.render(plan_path, 'or')
+    monkeypatch.undo()
+    base = Path(plan_path).parent
+    return Path(exported), base, {'copied_cards': drawn_cards, 'overlays': overlays}
+
+
+@needs_ffmpeg
+def test_a_real_edition_draws_one_card_and_records_which_gave_way(tmp_path, monkeypatch):
+    from engine.render.card_slots import is_card, max_at_once
+    job = _job(tmp_path)
+    exported, base, audit = _render_with_audit(job, monkeypatch)
+    cards = [event for event in audit['overlays'] if is_card(event.get('kind'))] + [
+        {'start': None} for _ in ()]  # copied cards are audited below through the graphics record
+    assert len(audit['copied_cards']) + len(cards) == 1          # exactly one card was drawn
+    stats = json.loads((base / 'graphics-or.json').read_text(encoding='utf-8'))
+    assert stats['cards_on_screen_at_once'] == 1
+    assert stats['cards'] == 1
+    dropped = stats['cards_overlap_removed']['dropped']
+    assert len(dropped) == 1 and dropped[0]['text'] == 'ଅଭ୍ୟାସ ୧: କହିବା'
+    assert 'scheduled twice' in stats['cards_overlap_removed']['note']
+    provenance = json.loads(exported.with_suffix('.provenance.json').read_text(encoding='utf-8'))
+    assert provenance['cards_on_screen_at_once'] == 1
+    assert provenance['cards_overlap_removed']['dropped'][0]['text'] == 'ଅଭ୍ୟାସ ୧: କହିବା'
+    assert max_at_once([{'start': 0.4, 'end': 2.6}]) == 1
+
+
+@needs_ffmpeg
+def test_the_copied_job_card_no_longer_changes_the_picture(tmp_path, monkeypatch):
+    """The strongest check: render the same edition with and without the copied cards, and look at the frame."""
+    from PIL import Image, ImageChops
+    with_cards = _job(tmp_path, copied_cards=True)
+    without = _job(tmp_path, copied_cards=False)
+    plan_with = json.loads((with_cards / 'production' / 'language_editions.json').read_text())['bundles']['or']
+    plan_without = json.loads((without / 'production' / 'language_editions.json').read_text())['bundles']['or']
+    assert len(plan_with['cards']) == 1 and plan_without['cards'] == []      # the only difference between the two
+    one, one_base, one_audit = _render_with_audit(with_cards, monkeypatch)
+    two, two_base, two_audit = _render_with_audit(without, monkeypatch)
+    # in the fixed render the copied card is never drawn at all - not in either job
+    assert one_audit['copied_cards'] == [] and two_audit['copied_cards'] == []
+    assert len(one_audit['overlays']) == len(two_audit['overlays']) == 1
+
+    frames = []
+    for index, (video, folder) in enumerate(((one, one_base), (two, two_base))):
+        frame = folder / f'frame-{index}.png'
+        subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-ss', '1.2', '-i', str(video),
+                        '-frames:v', '1', str(frame)], check=True)
+        frames.append(Image.open(frame).convert('RGB'))
+    difference = ImageChops.difference(frames[0], frames[1])
+    mean = sum(sum(pixel) for pixel in difference.getdata()) / (frames[0].width * frames[0].height * 3)
+    assert mean < 2.0, f'the copied card is still drawn: mean channel difference {mean:.2f}'
+
+    listing = json.loads((one_base / 'graphics-or.json').read_text(encoding='utf-8'))
+    assert listing['plan_cards_drawn'] == 0          # the copied card was not drawn at all
+
+
+@needs_ffmpeg
+def test_the_job_record_and_listing_note_the_dropped_card(tmp_path, monkeypatch):
+    from engine import edition_files
+    from engine.language_editions import render_job_editions, edition_diagnosis
+    job = _job(tmp_path)
+    report = render_job_editions(job, fit_policy={'allow_hold': 8.0, 'hold_cap': 8.0})
+    assert report['status'] == 'exported', report
+    entry = report['editions']['or']
+    assert entry['cards_overlap_removed']['dropped'][0]['text'] == 'ଅଭ୍ୟାସ ୧: କହିବା'
+    assert 'scheduled twice' in entry['warning']
+    assert entry['cards_on_screen_at_once'] == 1
+    assert 'scheduled twice' in edition_diagnosis(job)['editions']['or']['warning']
+    listing = '\n'.join(edition_files.format_report(edition_files.report(job)))
+    assert 'cards: one at a time · 1 overlapping or duplicate card(s) were not drawn' in listing
+
+
+@needs_ffmpeg
+def test_a_language_without_a_drafted_card_file_still_draws_its_copied_cards(tmp_path, monkeypatch):
+    """The rule must not silently remove the only cards an edition has."""
+    from engine import finishing_studio as finish
+    job = _job(tmp_path, copied_cards=True, drafted=False)
+    picture = Path(json.loads((job / 'production' / 'visual_master.json').read_text(encoding='utf-8'))['path'])
+    plan_path = finish.create_plan(picture, {'or': None}, languages=['or'], output_root=job / 'language_editions',
+                                  source_rights='own_content', source_language='en', require_profiles=False,
+                                  fit_narration=True, captions=False)
+    finish.set_edition(plan_path, 'or', reviewed=True)
+    drawn = []
+    real = finish._card_image
+
+    def card_image(text, *args, **kwargs):
+        drawn.append(text)
+        return real(text, *args, **kwargs)
+    monkeypatch.setattr(finish, '_card_image', card_image)
+    exported = finish.render(plan_path, 'or')
+    monkeypatch.undo()
+    assert drawn == ['ଅଭ୍ୟାସ ୧: କହିବା']
+    provenance = json.loads(Path(exported).with_suffix('.provenance.json').read_text(encoding='utf-8'))
+    assert provenance['cards_drawn'] == {'overlays': 0, 'plan_cards': 1}
+    assert provenance['cards_overlap_removed'] is None
