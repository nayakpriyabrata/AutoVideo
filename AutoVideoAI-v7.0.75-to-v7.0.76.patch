+++ b/engine/video_hooks.py	2026-10-21 16:54:27.469530372 +0000
@@ -0,0 +1,139 @@
+"""Hooks drafted with Gemini Web (7.0.76).
+
+Hooks are short attention lines (at most 60 characters) placed where the narration
+needs them: the opening when it is weak, and points where energy drops or a new
+section starts. Gemini Web drafts them after the narration words and the text
+cards exist. Each hook is anchored to a spoken word, so it appears when the
+narrator reaches that moment.
+
+Rules enforced here:
+* at most 6 hooks; at least 10 seconds between hooks; each shown 2.5-3.5 seconds;
+* a hook never covers a text card, a points series, or any other overlay; hooks
+  that would are dropped at render time and counted in the log;
+* if Gemini Web is unavailable, the job continues without hooks.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+from pathlib import Path
+
+MAX_HOOKS = 6
+MIN_GAP_SECONDS = 10.0
+HOLD_SECONDS = 3.0
+MIN_VISIBLE_SECONDS = 2.5
+MAX_CHARS = 60
+VARIANT = "hooks-v1"
+
+
+def hook_prompt(topic, language) -> str:
+    return (
+        "You are a senior short-form video editor. "
+        f"The video topic is: {' '.join(str(topic or '').split())}. "
+        f"Target language: {language}. "
+        "Write attention hooks: short on-screen lines that stop a viewer from scrolling away. "
+        'Return JSON {"hooks":[{"text":"...","start_word":0}]}. '
+        "Choose at most 6 moments in the narration where a hook is genuinely needed: the opening if it is weak, "
+        "and places where the narration loses energy or a new section begins. Spread them out; no two closer than "
+        "10 seconds apart. Each text is at most 60 characters, in the target language, and echoes the narration as "
+        "a question, a contrast, a surprising angle or a clear promise. Use exact zero-based word IDs from the "
+        "supplied words. Do not invent facts, statistics or numbers, and do not repeat the narration word for word. "
+        "An empty list is allowed if no hook is needed.")
+
+
+def _fingerprint(audio, words, script, topic, language) -> str:
+    h = hashlib.sha256()
+    with Path(audio).open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            h.update(chunk)
+    h.update(json.dumps(words, sort_keys=True, ensure_ascii=False).encode())
+    h.update(str(script).encode())
+    h.update(f"{VARIANT}|{' '.join(str(topic or '').split())}|{language}".encode())
+    return h.hexdigest()
+
+
+def anchor_hooks(draft, words, duration):
+    """Validate Gemini's hooks and convert word IDs to timed windows."""
+    from .speech_cards import validate_words
+    validate_words(words, duration)
+    rows = draft.get("hooks") if isinstance(draft, dict) else None
+    if rows is None:
+        rows = []
+    if not isinstance(rows, list) or len(rows) > MAX_HOOKS:
+        raise ValueError(f"Gemini must return at most {MAX_HOOKS} hooks")
+    hooks = []
+    for row in rows:
+        if not isinstance(row, dict):
+            raise ValueError("Each hook must be an object")
+        first = row.get("start_word")
+        text = row.get("text")
+        if type(first) is not int or not 0 <= first < len(words):
+            raise ValueError("A hook refers to an invalid speech word index")
+        if not isinstance(text, str) or not 1 <= len(text.strip()) <= MAX_CHARS or "\n" in text:
+            raise ValueError(f"Each hook must be one line of at most {MAX_CHARS} characters")
+        start = float(words[first]["start"])
+        end = min(float(duration), start + HOLD_SECONDS)
+        if not math.isfinite(start) or end - start < MIN_VISIBLE_SECONDS:
+            raise ValueError("A hook falls too close to the end of the video to be read")
+        hooks.append({"text": text.strip(), "start_word": first, "start": round(start, 3), "end": round(end, 3)})
+    hooks.sort(key=lambda h: h["start"])
+    for before, after in zip(hooks, hooks[1:]):
+        if after["start"] - before["start"] < MIN_GAP_SECONDS:
+            raise ValueError("Hooks must be at least 10 seconds apart")
+    return hooks
+
+
+def draft_hooks(root, audio, words, script, duration, language, *, topic="", cleanup="keep"):
+    """Ask Gemini Web for hooks and save production/hooks.json. Cached by fingerprint."""
+    from .production import save
+    from .speech_cards import validate_words
+    from .planning.script_engine import _extract_json
+    from .studio_review import _draft_generate
+    root = Path(root)
+    target = root / "production" / "hooks.json"
+    key = _fingerprint(audio, words, script, topic, language)
+    if target.is_file():
+        prior = json.loads(target.read_text(encoding="utf-8"))
+        if prior.get("fingerprint") == key:
+            return prior
+    validate_words(words, duration)
+    indexed = [{"id": i, "word": w["word"], "start": w["start"], "end": w["end"]} for i, w in enumerate(words)]
+    user = (f"Duration: {float(duration):.3f}s\nReviewed script:\n{script}\n"
+            "Timed narration words:\n" + json.dumps(indexed, ensure_ascii=False))
+    raw = _draft_generate('gemini-web', hook_prompt(topic, language), user, cleanup=cleanup)
+    save(target.with_name("hooks-draft.json"), {"response": raw, "fingerprint": key})
+    hooks = anchor_hooks(_extract_json(raw), words, duration)
+    result = {"schema_version": 1, "source": "gemini-web-hooks", "fingerprint": key, "duration": float(duration),
+              "language": language, "topic": str(topic or ""), "hooks": hooks}
+    save(target, result)
+    return result
+
+
+def load_hooks(root, audio, words, script, duration, language, *, topic=""):
+    """Saved hooks for the current narration, or None. A stale draft is refused, not reused."""
+    path = Path(root) / "production" / "hooks.json"
+    if not path.is_file():
+        return None
+    data = json.loads(path.read_text(encoding="utf-8"))
+    if data.get("fingerprint") != _fingerprint(audio, words, script, topic, language):
+        raise ValueError("Narration, timings or topic changed after hook drafting. Resume the job to refresh hooks.")
+    return anchor_hooks(data, words, duration)
+
+
+def build_hook_overlays(root, audio, words, script, duration, width, height, style, existing,
+                        *, topic="", language="en"):
+    """Render hook pills and drop any that would cover another overlay. Returns (overlays, dropped)."""
+    from .render.hook_cards import render_hook_png
+    hooks = load_hooks(root, audio, words, script, duration, language, topic=topic)
+    if not hooks:
+        return [], 0
+    blocked = [(float(e["start"]), float(e["end"])) for e in existing if e.get("kind") != "watermark"]
+    overlays, dropped = [], 0
+    for index, hook in enumerate(hooks):
+        if any(hook["start"] < end and start < hook["end"] for start, end in blocked):
+            dropped += 1
+            continue
+        target = Path(root) / "render" / "graphics" / f"hook-{index:02d}.png"
+        overlays.append(render_hook_png(hook, target, int(width), int(height), style=style))
+    return overlays, dropped
diff -ruN a/tests/test_v776_hooks.py b/tests/test_v776_hooks.py
--- a/tests/test_v776_hooks.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_v776_hooks.py	2026-10-21 16:55:00.653697960 +0000
@@ -0,0 +1,196 @@
+"""Hooks drafted with Gemini Web (7.0.76): validation, caching, placement, rendering, settings."""
+import inspect
+import json
+from pathlib import Path
+
+import pytest
+from PIL import Image
+
+from engine import video_hooks as VH
+from engine import studio_config
+from engine.render.hook_cards import render_hook_png
+
+DURATION = 40.0
+
+
+def words(n=80):
+    return [{'word': f'w{i}', 'start': i * .5, 'end': i * .5 + .4} for i in range(n)]
+
+
+def audio_file(tmp_path, data=b'voice-bytes'):
+    path = tmp_path / 'voice.mp3'
+    path.write_bytes(data)
+    return path
+
+
+def good_draft():
+    return {'hooks': [
+        {'text': 'Why does your mind race at night?', 'start_word': 0},
+        {'text': 'The one habit that changes everything', 'start_word': 24},
+    ]}
+
+
+def test_anchor_hooks_maps_word_ids_to_timed_windows():
+    hooks = VH.anchor_hooks(good_draft(), words(), DURATION)
+    assert [h['start_word'] for h in hooks] == [0, 24]
+    assert hooks[0]['start'] == 0.0 and hooks[0]['end'] == 3.0
+    assert hooks[1]['start'] == 12.0 and hooks[1]['end'] == 15.0
+
+
+def test_anchor_hooks_clips_to_video_end_and_refuses_unreadable_tail():
+    tail = {'hooks': [{'text': 'Late hook', 'start_word': 78}]}  # starts 39.0 s, 1.0 s left
+    with pytest.raises(ValueError, match='too close to the end'):
+        VH.anchor_hooks(tail, words(), DURATION)
+    edge = {'hooks': [{'text': 'Late but readable', 'start_word': 76}]}  # 38.0 s, 2.0 s left
+    with pytest.raises(ValueError, match='too close to the end'):
+        VH.anchor_hooks(edge, words(), DURATION)
+    ok = {'hooks': [{'text': 'Just readable', 'start_word': 75}]}  # 37.5 s, 2.5 s left
+    assert VH.anchor_hooks(ok, words(), DURATION)[0]['end'] == 40.0
+
+
+@pytest.mark.parametrize('draft, message', [
+    ({'hooks': [{'text': f'Hook {i}', 'start_word': i * 12} for i in range(7)]}, 'at most 6'),
+    ({'hooks': [{'text': 'x' * 61, 'start_word': 0}]}, 'at most 60'),
+    ({'hooks': [{'text': '   ', 'start_word': 0}]}, 'at most 60'),
+    ({'hooks': [{'text': 'Two\nlines', 'start_word': 0}]}, 'one line'),
+    ({'hooks': [{'text': 'Bad index', 'start_word': 999}]}, 'invalid speech word'),
+    ({'hooks': [{'text': 'Bool index', 'start_word': True}]}, 'invalid speech word'),
+    ({'hooks': [{'text': 'Too close', 'start_word': 0}, {'text': 'Second', 'start_word': 10}]}, 'at least 10 seconds'),
+    ({'hooks': 'nope'}, 'at most 6'),
+])
+def test_anchor_hooks_rejects_invalid_drafts(draft, message):
+    with pytest.raises(ValueError, match=message):
+        VH.anchor_hooks(draft, words(), DURATION)
+
+
+def test_anchor_hooks_accepts_empty_list_and_missing_key():
+    assert VH.anchor_hooks({'hooks': []}, words(), DURATION) == []
+    assert VH.anchor_hooks({}, words(), DURATION) == []
+
+
+def test_draft_hooks_writes_cache_and_reuses_it(tmp_path, monkeypatch):
+    audio = audio_file(tmp_path)
+    calls = []
+
+    def fake_draft(provider, system, user, cleanup='delete-after-read'):
+        calls.append((provider, cleanup))
+        assert 'at most 6' in system and '60 characters' in system
+        assert '"start_word"' in system
+        return json.dumps(good_draft())
+
+    import engine.studio_review as SR
+    monkeypatch.setattr(SR, '_draft_generate', fake_draft)
+    first = VH.draft_hooks(tmp_path, audio, words(), 'script', DURATION, 'en', topic='Sleep', cleanup='keep')
+    assert calls == [('gemini-web', 'keep')]
+    assert len(first['hooks']) == 2 and first['source'] == 'gemini-web-hooks'
+    saved = json.loads((tmp_path / 'production' / 'hooks.json').read_text(encoding='utf-8'))
+    assert saved['hooks'] == first['hooks']
+    assert (tmp_path / 'production' / 'hooks-draft.json').is_file()
+
+    again = VH.draft_hooks(tmp_path, audio, words(), 'script', DURATION, 'en', topic='Sleep')
+    assert len(calls) == 1 and again['fingerprint'] == first['fingerprint']
+
+
+def test_draft_hooks_failure_propagates_so_factory_can_skip(tmp_path, monkeypatch):
+    import engine.studio_review as SR
+
+    def broken(*args, **kwargs):
+        raise RuntimeError('Gemini Web is not signed in')
+
+    monkeypatch.setattr(SR, '_draft_generate', broken)
+    with pytest.raises(RuntimeError, match='not signed in'):
+        VH.draft_hooks(tmp_path, audio_file(tmp_path), words(), 'script', DURATION, 'en')
+    assert not (tmp_path / 'production' / 'hooks.json').exists()
+
+
+def test_changed_narration_refuses_stale_hooks(tmp_path, monkeypatch):
+    import engine.studio_review as SR
+    monkeypatch.setattr(SR, '_draft_generate', lambda *a, **k: json.dumps(good_draft()))
+    audio = audio_file(tmp_path)
+    VH.draft_hooks(tmp_path, audio, words(), 'script', DURATION, 'en', topic='Sleep')
