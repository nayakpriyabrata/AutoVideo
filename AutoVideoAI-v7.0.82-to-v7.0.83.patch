+def reviewed_scripts_for(source_script, source_language, languages):
+    """The narration approved in Create step 4 for this master and language set, or None (7.0.83).
+
+    A job's TTS step uses this snapshot. Before 7.0.83 it could regenerate unreviewed narration in the job folder.
+    """
+    from .finishing_studio import shared_root
+    from .languages import language_pack
+    editions = list(dict.fromkeys(language_pack(x).code for x in languages))
+    source_language = language_pack(source_language).code
+    key = localization_key(source_script, source_language, editions)
+    target = shared_root()/'speech_preparation'/'scripts'/key/'localized_scripts.json'
+    if not target.is_file():
+        return None
+    try:
+        state = json.loads(target.read_text(encoding='utf-8'))
+    except (OSError, ValueError):
+        return None
+    scripts = state.get('scripts') or {}
+    if state.get('phase') != 'scripts_approved' or state.get('fingerprint') != key:
+        return None
+    if any(not str(scripts.get(x, '')).strip() for x in editions):
+        return None
+    if str(scripts.get(source_language, '')).strip() != source_script.strip():
+        return None
+    return {x: str(scripts[x]).strip() for x in editions}
+
