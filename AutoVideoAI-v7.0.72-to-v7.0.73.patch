+def export_kept_videos(folder_path, kept_videos, destination):
+    """Copy each kept video into ``destination`` under its own file name, verified by SHA-256.
+
+    Nothing is overwritten: an existing file with the same name must be byte-identical,
+    otherwise the export stops and the caller deletes nothing. The destination must be
+    outside the job folder.
+    """
+    folder = Path(folder_path).absolute()
+    target_dir = Path(destination).expanduser().absolute()
+    if target_dir == folder or folder in target_dir.parents:
+        raise ValueError('Choose a folder outside the job; the videos would be kept inside it')
+    target_dir.mkdir(parents=True, exist_ok=True)
+    exported = []
+    for rel in kept_videos:
+        source = folder / rel
+        if not source.is_file() or source.is_symlink():
+            raise ValueError('Kept video is missing: ' + rel)
+        target = target_dir / source.name
+        digest = _file_sha256(source)
+        if target.exists():
+            if _file_sha256(target) != digest:
+                raise ValueError('The folder already has a different ' + target.name + '; choose another folder')
+            exported.append({'file': target.name, 'status': 'already there', 'sha256': digest})
+            continue
+        temporary = target.with_name(target.name + '.copying')
+        shutil.copy2(source, temporary)
+        if _file_sha256(temporary) != digest:
+            temporary.unlink(missing_ok=True)
+            raise ValueError('Copy verification failed for ' + target.name + '; nothing was deleted')
+        os.replace(temporary, target)
+        exported.append({'file': target.name, 'status': 'copied', 'sha256': digest})
+    return exported
+
+
+def _file_sha256(path):
+    digest = hashlib.sha256()
+    with open(path, 'rb') as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b''):
+            digest.update(block)
+    return digest.hexdigest()
+
