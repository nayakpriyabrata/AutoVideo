diff -ruN a/tests/test_v770_chatgpt_indus.py b/tests/test_v770_chatgpt_indus.py
--- a/tests/test_v770_chatgpt_indus.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_v770_chatgpt_indus.py	2026-10-20 12:02:37.201363299 +0000
@@ -0,0 +1,252 @@
+"""v7.0.70 drafting: ChatGPT Web (signed-in browser) and Indus AI (Sarvam API).
+
+No live browser or network access: ChatGPT is driven through a fake page, and
+the Sarvam HTTP call is replaced with a fake response.
+"""
+import pytest
+
+from engine import studio_review as sr
+from engine.planning import script_engine as se
+from engine.providers import chatgpt_web as cw
+from engine.providers import flow_browser
+
+
+FINAL = '{"narration": "Hello there.", "scenes": []}'
+
+
+class FakeLocator:
+    def __init__(self, page, selector):
+        self.page = page
+        self.selector = selector
+
+    @property
+    def first(self):
+        return self
+
+    @property
+    def last(self):
+        return self
+
+    def count(self):
+        if self.selector == cw.SELECTORS["assistant"]:
+            return len(self.page.replies)
+        return 1 if self.selector in self.page.visible else 0
+
+    def is_visible(self, timeout=None):
+        if self.selector in cw.SELECTORS["stop"]:
+            if self.page.stop_checks > 0:
+                self.page.stop_checks -= 1
+                return True
+            return False
+        return self.selector in self.page.visible
+
+    def click(self, timeout=None):
+        self.page.clicks.append(self.selector)
+        if self.selector in cw.SELECTORS["send"]:
+            self.page.replies.append("")  # a new assistant turn starts
+
+    def fill(self, text, timeout=None):
+        self.page.filled = text
+
+    def press(self, key):
+        self.page.pressed.append(key)
+
+    def inner_text(self, timeout=None):
+        script = self.page.reply_script
+        value = script.pop(0) if len(script) > 1 else script[0]
+        self.page.replies[-1] = value
+        return value
+
+
+class FakePage:
+    def __init__(self, reply_script, visible=None, stop_checks=0):
+        self.url = "https://chatgpt.com/"
+        self.visible = set(visible if visible is not None else cw.SELECTORS["composer"][:1] + cw.SELECTORS["send"][:1])
+        self.reply_script = list(reply_script)
+        self.replies = []
+        self.stop_checks = stop_checks
+        self.gotos = []
+        self.filled = None
+        self.clicks = []
+        self.pressed = []
+
+    def goto(self, url, timeout=None, wait_until=None):
+        self.gotos.append(url)
+        self.url = url
+
+    def locator(self, selector):
+        return FakeLocator(self, selector)
+
+
+def _browser(page):
+    browser = cw.ChatGPTWebBrowser.__new__(cw.ChatGPTWebBrowser)  # skip Playwright setup
+    browser._page = page
+    return browser
+
+
+@pytest.fixture(autouse=True)
+def _no_sleep(monkeypatch):
+    monkeypatch.setattr(cw.time, "sleep", lambda seconds: None)
+    monkeypatch.setattr(cw, "COMPOSER_WAIT_SECONDS", 0)
+
+
+# --- ChatGPT Web ---------------------------------------------------------------
+
+def test_reply_settles_only_after_three_identical_nonempty_readings():
+    assert cw.reply_settled(['a', 'a', 'a'], generating=False) is True
+    assert cw.reply_settled(['a', 'a', 'a'], generating=True) is False  # still streaming
+    assert cw.reply_settled(['a', 'a'], generating=False) is False
+    assert cw.reply_settled(['a', 'ab', 'ab'], generating=False) is False
+    assert cw.reply_settled(['', '', ''], generating=False) is False
+
+
+def test_ask_returns_the_settled_reply_in_a_temporary_chat():
+    page = FakePage(['{"na', '{"narration": "Hel', FINAL, FINAL, FINAL], stop_checks=2)
+    text = _browser(page).ask("draft", timeout_seconds=30, temporary=True)
+    assert text == FINAL
+    assert page.gotos == [cw.TEMPORARY_CHAT_URL]
+    assert "draft" in page.filled
+    assert "Enter" in page.pressed or cw.SELECTORS["send"][0] in page.clicks
+
+
+def test_ask_without_temporary_uses_the_normal_chat_url():
+    page = FakePage([FINAL])
+    _browser(page).ask("draft", timeout_seconds=30, temporary=False)
+    assert page.gotos == [cw.CHATGPT_URL]
+
+
+def test_ask_reports_sign_in_when_signed_out():
+    page = FakePage([FINAL], visible=set(cw.SELECTORS["login"][:1]))
+    with pytest.raises(cw.ChatGPTWebAuthNeeded):
+        _browser(page).ask("draft", timeout_seconds=5)
+
+
+def test_ask_reports_ui_change_when_no_composer_and_no_login():
+    page = FakePage([FINAL], visible=set())
+    with pytest.raises(cw.ChatGPTWebUIChanged):
+        _browser(page).ask("draft", timeout_seconds=5)
+
+
+def test_ask_times_out_instead_of_waiting_forever():
+    page = FakePage([FINAL])
+    with pytest.raises(cw.ChatGPTWebUIChanged, match="did not finish"):
+        _browser(page).ask("draft", timeout_seconds=0)
+
+
+def test_generate_passes_cleanup_as_temporary_flag(monkeypatch):
+    seen = {}
+
+    class FakeBrowser:
+        def __init__(self, *a, **k):
+            pass
+
+        def ensure_session(self, visible_login_seconds=0):
+            seen["login"] = visible_login_seconds
+
+        def ask(self, prompt, timeout_seconds=0, *, temporary=True):
+            seen["prompt"] = prompt
+            seen["temporary"] = temporary
+            return FINAL
+
+        def close(self):
+            seen["closed"] = True
+
+    monkeypatch.setattr(cw, "ChatGPTWebBrowser", FakeBrowser)
+    assert cw.chatgpt_web_generate("sys", "usr", cleanup="delete-after-read") == FINAL
+    assert seen["temporary"] is True and seen["closed"] is True
+    assert "SYSTEM INSTRUCTIONS" in seen["prompt"] and "USER TASK" in seen["prompt"]
+    cw.chatgpt_web_generate("sys", "usr", cleanup="keep")
+    assert seen["temporary"] is False
+    cw.chatgpt_web_generate("sys", "usr")  # default: temporary
+    assert seen["temporary"] is True
+    with pytest.raises(ValueError):
+        cw.chatgpt_web_generate("sys", "usr", cleanup="shred")
+
+
+def test_browser_builds_from_its_own_config(monkeypatch, tmp_path):
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setattr(flow_browser, "maybe_migrate_profile", lambda: None)
+    browser = cw.ChatGPTWebBrowser(profile_dir=str(tmp_path / "profile"))
+    assert browser.ui["chatgpt_url"] == "https://chatgpt.com/"
+    assert browser.profile_dir == str(tmp_path / "profile")
+    assert (tmp_path / "logs" / "chatgpt").is_dir()
+
+
+def test_studio_routes_chatgpt_web_to_its_adapter(monkeypatch):
+    seen = {}
+    monkeypatch.setattr(cw, "chatgpt_web_generate",
+                        lambda system, user, cleanup=None: seen.update(cleanup=cleanup) or "ok")
+    assert sr._draft_generate("chatgpt-web", "s", "u", cleanup="keep") == "ok"
+    assert seen["cleanup"] == "keep"
+
+
+def test_provider_list_describes_chatgpt_web_session(monkeypatch):
+    options = {key: (ok, note) for key, _l, ok, note in sr.draft_provider_options()}
+    assert options["chatgpt-web"][0] is True
+    assert "temporary chat" in options["chatgpt-web"][1]
+
+
+# --- Indus AI (Sarvam API) -----------------------------------------------------
+
+class FakeResponse:
+    def __init__(self, status_code=200, payload=None):
+        self.status_code = status_code
+        self._payload = payload or {"choices": [{"message": {"content": FINAL}}]}
+
+    def json(self):
+        return self._payload
+
+
+def test_indus_is_unavailable_without_its_key(monkeypatch):
+    monkeypatch.delenv("SARVAM_API_KEY", raising=False)
+    options = {key: (ok, note) for key, _l, ok, note in sr.draft_provider_options()}
+    assert options["indus"][0] is False
+    assert "SARVAM_API_KEY" in options["indus"][1]
+
+
+def test_indus_default_model_and_override(monkeypatch):
+    monkeypatch.delenv("SARVAM_SCRIPT_MODEL", raising=False)
+    assert se._default_model("indus") == "sarvam-105b"
+    monkeypatch.setenv("SARVAM_SCRIPT_MODEL", "sarvam-105b-conversations")
+    assert se._default_model("indus") == "sarvam-105b-conversations"
+
+
+def test_indus_request_uses_bearer_auth_and_no_hidden_reasoning(monkeypatch):
+    monkeypatch.setenv("SARVAM_API_KEY", "sk-test-secret")
+    monkeypatch.delenv("SARVAM_MAX_TOKENS", raising=False)
+    captured = {}
+
+    def fake_post(url, headers=None, json=None, timeout=None):
+        captured.update(url=url, headers=headers, json=json)
+        return FakeResponse()
+
+    monkeypatch.setattr(se.requests, "post", fake_post)
+    assert se._call_provider("indus", "sarvam-105b", "sys", "usr") == FINAL
+    assert captured["url"] == "https://api.sarvam.ai/v1/chat/completions"
+    assert captured["headers"]["Authorization"] == "Bearer sk-test-secret"
+    assert captured["json"]["model"] == "sarvam-105b"
+    assert captured["json"]["reasoning_effort"] is None
+    assert captured["json"]["max_tokens"] == 4096
+    assert captured["json"]["messages"][0] == {"role": "system", "content": "sys"}
+
+
+def test_indus_error_names_the_status_but_never_the_key(monkeypatch):
+    monkeypatch.setenv("SARVAM_API_KEY", "sk-test-secret")
+    monkeypatch.setattr(se.requests, "post", lambda *a, **k: FakeResponse(status_code=401, payload={}))
+    with pytest.raises(RuntimeError) as info:
+        se._call_provider("indus", "sarvam-105b", "sys", "usr")
+    assert "401" in str(info.value)
+    assert "sk-test-secret" not in str(info.value)
+
+
+def test_indus_empty_content_returns_empty_string_for_the_json_check(monkeypatch):
+    monkeypatch.setenv("SARVAM_API_KEY", "sk-test")
+    monkeypatch.setattr(se.requests, "post",
+                        lambda *a, **k: FakeResponse(payload={"choices": [{"message": {"content": None}}]}))
+    assert se._call_provider("indus", "sarvam-105b", "sys", "usr") == ""
+
+
+def test_indus_is_available_when_its_key_is_set(monkeypatch):
+    monkeypatch.setenv("SARVAM_API_KEY", "sk-test")
+    options = {key: ok for key, _l, ok, _n in sr.draft_provider_options()}
+    assert options["indus"] is True
diff -ruN a/tools/update_v769_to_v770.py b/tools/update_v769_to_v770.py
--- a/tools/update_v769_to_v770.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/update_v769_to_v770.py	2026-10-20 12:02:37.201363299 +0000
@@ -0,0 +1,137 @@
+#!/usr/bin/env python3
+"""Apply the v7.0.70 update (ChatGPT Web and Indus AI drafting) to a v7.0.69 installation.
+
+Usage (run from the existing installation folder, after extracting the 7.0.70 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.70/tools/update_v769_to_v770.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.70/tools/update_v769_to_v770.py . --apply    # installs the code
+
+An installation still on 7.0.68 must first run tools/update_v768_to_v769.py from the 7.0.69 folder.
+Only code and documentation are replaced. Outputs, saved jobs, browser profiles,
+music, characters and channel profiles are never copied, moved or deleted.
+A file you changed locally is preserved and the update stops before touching anything.
+"""
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = [
+    'CHATGPT_INDUS_DRAFTING_V7_0_70.md',
+    'VERSION',
+    'app.py',
+    'config/chatgpt_ui.yaml',
+    'engine/planning/script_engine.py',
+    'engine/providers/chatgpt_web.py',
+    'engine/studio_config.py',
+    'engine/studio_review.py',
+    'tests/test_v769_drafting.py',
+    'tests/test_v770_chatgpt_indus.py',
+    'tools/update_v769_to_v770.py',
+]
+# Files that exist in 7.0.69: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['ba7c74e9c9e624af6641a610cb78ed5250d34547990ffbc073542e6503abfc8c'],
+    'app.py': ['b06515d8b85a675d6316d99c6b04f9cb0ceee752047929c33b2c81a3835959d0'],
+    'engine/planning/script_engine.py': ['03a4e297961830dc8bb4eceac112d0cb6f6fc0163a07c7e18de37ff9f67dfec3'],
+    'engine/studio_config.py': ['21a60988af3704998bbffc3dc5036090163ff694dd9bd1fcb874f9e1f673301d'],
+    'engine/studio_review.py': ['37c0a78d85b732c9c92356680415073b5030d0b29bab6057bcb9ff83c1c2f88f'],
+    'tests/test_v769_drafting.py': ['6dc03d532e234f1a9b3f3f26c942a7a22897c6fdfbd83c9b7a9ad4aa5424d8e6'],
+}
+ACCEPTED_INSTALLS = ('7.0.69', '7.0.70')  # 7.0.70 allows a safe re-run after success
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError('This update requires an installed 7.0.69 (found ' + current + '). '
+                         'For 7.0.68 run ../AutoVideoAI-v7.0.69/tools/update_v768_to_v769.py first.')
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the 7.0.70 folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        if destination.exists() and sha(destination) not in ALLOWED.get(name, []) + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+    plan = {'target': str(target), 'installed_version': current, 'apply': args.apply,
+            'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every 7.0.70 code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v7.0.70-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to 7.0.70. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat).')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
+        raise SystemExit(1)
