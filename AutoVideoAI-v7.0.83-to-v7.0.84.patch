+def gemini_env_files() -> list:
+    """The .env files searched for Gemini key profiles, at call time (7.0.84). Tests replace this with an empty list."""
+    from engine.env_config import _candidate_files
+    return [path for path in _candidate_files(None) if path.is_file()]
+
+
+def _gemini_scan() -> tuple[dict, list]:
+    """Return ({profile: (variable, value)}, problems). Names and problems only; values never leave this function.
+
+    The process environment wins over .env files. A .env entry is read at each call, so a key added while the
+    dashboard runs appears on the next page refresh. Editing the value of a key already loaded needs a restart.
+    """
+    from dotenv import dotenv_values
+    rows = [(str(var), str(value)) for var, value in os.environ.items()]
+    for path in gemini_env_files():
+        try:
+            values = dotenv_values(path, encoding="utf-8-sig")
+        except Exception:
+            continue
+        rows.extend((str(key or "").strip().lstrip("\ufeff"), str(value or "")) for key, value in values.items())
+    values, empty = {}, []
+    for var, raw in rows:
+        if not var.upper().startswith("GEMINI_API_KEY"):
+            continue
+        value = raw.strip()
+        if value and var not in values:
+            values[var] = value
+        elif not value and var not in empty:
+            empty.append(var)
+    profiles, problems = {}, []
+    for var, value in values.items():
+        if var.upper() == "GEMINI_API_KEY":
+            profile = "default"
+        else:
+            match = GEMINI_PROFILE_ENV.match(var)
+            if not match:
+                problems.append(var + ": name not recognised; use GEMINI_API_KEY_<NAME>. Ignored.")
+                continue
+            profile = match.group(1).lower()
+        profiles.setdefault(profile, []).append((var, value))
+    result = {}
+    for profile, entries in profiles.items():
+        # Prefer the canonical spelling GEMINI_API_KEY_<NAME> when two entries name the same profile.
+        entries.sort(key=lambda item: (item[0] != item[0].upper(), item[0]))
+        var, value = entries[0]
+        result[profile] = (var, value)
+        if len(entries) > 1:
+            problems.append("two entries define key profile '" + profile + "' (" + ", ".join(v for v, _ in entries)
+                            + "); only " + var + " is used")
+    for var in empty:
+        # A blank GEMINI_API_KEY= line is normal; a blank named profile is worth a warning.
+        if var not in values and var.upper() != "GEMINI_API_KEY" and GEMINI_PROFILE_ENV.match(var):
+            problems.append(var + ": value is empty. Ignored.")
+    return result, problems
+
