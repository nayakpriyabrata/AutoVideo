@@ -0,0 +1,224 @@
+"""v7.0.114: the repair render that stopped half way, and the file it must not hide.
+
+Field report, on 7.0.113 - the release that made a plain render repair a language whose export still carried the
+transcript the job had switched off:
+
+    python3 cli.py v3 language-outputs 20261022-...-9729 --fit-hold 8
+    [ 50%] Rendering Odia edition Odia
+    ...
+    "status": "failed",
+    "error": "FFmpeg failed: av_interleaved_write_frame(): Input/output error
+              Error writing trailer of .../.render-j06ayvm3/picture-fit.mp4: Input/output error"
+
+and then, from the same run:
+
+    Odia: no current video yet
+    ! Odia has no current export, only earlier files. Render that language again.
+
+Three things were wrong with that, and none of them was the repair itself:
+
+* the message named a file inside a temporary folder that had already been deleted, and nothing about the volume it
+  could not write to. "Input/output error" while writing a trailer is what a volume that is full, over quota or
+  read-only looks like to FFmpeg;
+* the working picture was written with ``+faststart``, which rewrites the whole file a second time at exactly the
+  moment the field render failed - twice the writes, on the volume that was already short of room, for a file that
+  is decoded again immediately and never played;
+* a failed render replaced the language's record, so the previous Odia export - still on disk, still complete -
+  became invisible: "no current video yet" when there was one.
+
+These tests hold v7.0.114 to what it promises:
+
+* the working picture is written once, without a pointless second pass;
+* a failed FFmpeg write reports the volume and what to do, instead of only a temp path;
+* a failed repair keeps the previous export visible and named, and says nothing was lost;
+* the next run picks the language up again, so the repair can simply be retried.
+"""
+import json
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+needs_ffmpeg = pytest.mark.skipif(not (shutil.which('ffmpeg') and shutil.which('ffprobe')),
+                                  reason='FFmpeg required')
+os.environ.setdefault('HOME', '/tmp')
+
+WORDS = [{'word': 'ଶବ୍ଦ' + str(i), 'start': 0.3 + i * 0.75, 'end': 0.3 + i * 0.75 + 0.6} for i in range(10)]
+FIT = {'allow_hold': 8.0, 'hold_cap': 8.0}
+FIELD_ERROR = ('FFmpeg failed: av_interleaved_write_frame(): Input/output error\n'
+               'Error writing trailer of /tmp/job/language_editions/x/.render-abc/picture-fit.mp4: '
+               'Input/output error\n')
+
+
+def _job(tmp_path, *, narration_seconds=7.8, picture_seconds=6.0, transcript=None):
+    from engine.production import digest
+    job = tmp_path / 'job'
+    (job / 'render').mkdir(parents=True)
+    (job / 'production').mkdir()
+    picture = job / 'render' / 'visual-master.mp4'
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i',
+                    'testsrc2=size=640x360:rate=24', '-t', str(picture_seconds), '-an',
+                    '-c:v', 'libx264', '-pix_fmt', 'yuv420p', str(picture)], check=True)
+    (job / 'production' / 'visual_master.json').write_text(json.dumps(
+        {'path': str(picture), 'sha256': digest(picture), 'duration': picture_seconds}), encoding='utf-8')
+    folder = job / 'speech-editions' / 'or' / 'key'
+    folder.mkdir(parents=True)
+    voice = folder / 'voice.wav'
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i',
+                    'sine=frequency=700:sample_rate=44100', '-t', str(narration_seconds),
+                    '-c:a', 'pcm_s16le', str(voice)], check=True)
+    (folder / 'words.json').write_text(json.dumps(WORDS, ensure_ascii=False), encoding='utf-8')
+    bundle = {'audio': str(voice), 'audio_sha256': digest(voice), 'duration': narration_seconds,
+              'words': str(folder / 'words.json'), 'script': ' '.join(word['word'] for word in WORDS),
+              'language': 'or', 'timing_source': 'test', 'cards': [], 'text_cards': False}
+    state = {'source_language': 'en', 'editions': ['en', 'or'], 'profiles': {'or': None},
+             'bundles': {'or': bundle}}
+    if transcript is not None:
+        state['transcript'] = {'default': transcript, 'languages': {}}
+    (job / 'production' / 'language_editions.json').write_text(json.dumps(state, ensure_ascii=False),
+                                                               encoding='utf-8')
+    return job
+
+
+def _entry(job, code='or'):
+    from engine.language_editions import _record_path
+    return json.loads(_record_path(job).read_text(encoding='utf-8'))['editions'][code]
+
+
+def _ask_for_no_transcript(job):
+    """The job switches Odia's transcript off, with a record that still claims the captioned file is current."""
+    from engine.language_editions import _record_path
+    state = json.loads((job / 'production' / 'language_editions.json').read_text())
+    state.pop('transcript', None)
+    (job / 'production' / 'language_editions.json').write_text(json.dumps(state, ensure_ascii=False))
+    record = json.loads(_record_path(job).read_text())
+    record['editions']['or']['captions'] = False
+    record['editions']['or'].pop('captions_detected', None)
+    _record_path(job).write_text(json.dumps(record), encoding='utf-8')
+
+
+# --------------------------------------------------------------- the working picture is written once
+
+
+def test_the_working_picture_is_written_once_without_a_faststart_second_pass():
+    """Faststart rewrites the whole file at trailer time - the exact moment the field render failed."""
+    from engine import finishing_studio as finish
+    cmd = finish._fit_picture_cmd('in.mp4', 'out.mp4', picture_scale=1.31, hold_seconds=1.4, seconds=7.8)
+    assert '+faststart' not in ' '.join(cmd)
+    assert '-movflags' not in cmd
+    assert 'tpad=stop_mode=clone:stop_duration=1.400' in cmd[cmd.index('-vf') + 1]
+    assert cmd[cmd.index('-t') + 1] == '7.800'
+    assert '-an' in cmd                                  # the narration is added once, later
+
+
+def test_a_scale_only_fit_needs_no_hold_filter():
+    from engine import finishing_studio as finish
+    cmd = finish._fit_picture_cmd('in.mp4', 'out.mp4', picture_scale=1.2, hold_seconds=0.0, seconds=6.0)
+    chain = cmd[cmd.index('-vf') + 1]
+    assert chain == 'setpts=1.200000*PTS'
+
+
+# --------------------------------------------------------------- a failed write says where and why
+@needs_ffmpeg
+def test_a_write_failure_names_the_volume_and_the_repair(tmp_path):
+    from engine import finishing_studio as finish
+    missing = tmp_path / 'no-such-folder' / 'out.mp4'
+    with pytest.raises(RuntimeError) as failed:
+        finish._run([finish._tool('ffmpeg'), '-y', '-loglevel', 'error', '-f', 'lavfi', '-i',
+                     'testsrc2=size=64x64:rate=5', '-t', '0.4', str(missing)])
+    message = str(failed.value)
+    assert 'Disk free on that volume' in message          # how much room there is, in GB
+    assert str(missing) in message                        # which file FFmpeg could not write
+    assert 'full or read-only volume' in message          # what the error actually means
+    assert 'no Flow credit' in message                    # and that retrying costs nothing
+
+
+# --------------------------------------------------------------- a failed repair keeps the file and says so
+@needs_ffmpeg
+def test_a_failed_repair_keeps_the_previous_export_in_the_record(tmp_path, monkeypatch):
+    from engine import finishing_studio as finish
+    from engine.language_editions import render_job_editions, edition_diagnosis
+    job = _job(tmp_path, transcript=True)
+    first = render_job_editions(job, fit_policy=FIT)
+    before = Path(first['editions']['or']['path'])
+    assert before.is_file()
+    _ask_for_no_transcript(job)
+
+    def explode(*args, **kwargs):
+        raise RuntimeError(FIELD_ERROR)
+    monkeypatch.setattr(finish, 'render', explode)
+    failed = render_job_editions(job, fit_policy=FIT)
+    assert failed['status'] == 'failed'
+    entry = _entry(job)
+    assert entry['status'] == 'failed'
+    assert 'Input/output error' in entry['error']
+    kept = entry['kept_export']
+    assert Path(kept['path']) == before and before.is_file()
+    assert 'did not finish' in kept['note']
+
+    report = edition_diagnosis(job)
+    row = report['editions']['or']
+    assert row['status'] == 'failed'
+    assert row['kept_export'] == str(before)
+    assert 'unchanged at ' + str(before) in row['message']
+    assert 'nothing was lost' in row['message']
+    assert 'language-outputs ' + job.name + ' --fit-hold 8' in row['next_action']
+    assert 'no voice is re-recorded' in row['next_action']
+    assert 'Press' not in row['next_action']
+
+
+@needs_ffmpeg
+def test_the_listing_shows_the_kept_file_instead_of_claiming_there_is_none(tmp_path, monkeypatch):
+    from engine import finishing_studio as finish
+    from engine import edition_files
+    from engine.language_editions import render_job_editions
+    job = _job(tmp_path, transcript=True)
+    first = render_job_editions(job, fit_policy=FIT)
+    before = Path(first['editions']['or']['path'])
+    _ask_for_no_transcript(job)
+    monkeypatch.setattr(finish, 'render', lambda *a, **k: (_ for _ in ()).throw(RuntimeError(FIELD_ERROR)))
+    render_job_editions(job, fit_policy=FIT)
+
+    data = edition_files.report(job)
+    row = data['editions']['or']
+    assert row['current'] is None
+    assert Path(row['kept']['path']) == before
+    assert (row['kept']['captions'] or {}).get('burned') is True     # honest about what that file shows
+    problems = '\n'.join(row['problems'])
+    assert 'the render did not finish' in problems
+    assert str(before) in problems
+    assert 'that is still the version you have, not a repaired one' in problems
+
+    summary = ' '.join(edition_files.summary(job))
+    assert 'repair did not finish' in summary and 'previous file kept' in summary
+    listing = '\n'.join(edition_files.format_report(data))
+    assert 'the render did not finish' in listing
+    assert 'unchanged file from before it: ' + str(before) in listing
+    assert '! Odia has no current export because the render did not finish' in listing
+    # the file described as kept is not also listed as an older, unrelated file
+    assert 'earlier file (not current): ' + str(before) not in listing
+    # the volume that could not take the write is measured now, so the next attempt is a decision, not a guess
+    assert 'Disk free on the volume holding this job right now' in problems
+
+
+@needs_ffmpeg
+def test_the_language_stays_pending_so_the_repair_can_be_retried(tmp_path, monkeypatch):
+    """After the disk is freed, the same command finishes the job - the failure is not sticky."""
+    from engine import finishing_studio as finish
+    from engine.language_editions import render_job_editions
+    job = _job(tmp_path, transcript=True)
+    first = render_job_editions(job, fit_policy=FIT)
+    broken = Path(first['editions']['or']['path'])
+    _ask_for_no_transcript(job)
+    monkeypatch.setattr(finish, 'render', lambda *a, **k: (_ for _ in ()).throw(RuntimeError(FIELD_ERROR)))
+    assert render_job_editions(job, fit_policy=FIT)['status'] == 'failed'
+    monkeypatch.undo()
+
+    again = render_job_editions(job, fit_policy=FIT)
+    assert again['status'] == 'exported'
+    fixed = Path(again['editions']['or']['path'])
+    assert fixed != broken and fixed.is_file() and broken.is_file()
+    assert json.loads(fixed.with_suffix('.provenance.json').read_text())['captions_burned'] is False
+    assert 'kept_export' not in _entry(job)               # the old entry no longer shadows the new file
