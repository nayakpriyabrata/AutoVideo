+# Unicode blocks a reviewed narration must use for its language (7.0.80).
+NATIVE_SCRIPT_RANGES = {'or': (0x0B00, 0x0B7F), 'hi': (0x0900, 0x097F)}
+
+
+def foreign_script_words(text, language):
+    """Words that mix or corrupt scripts inside a native-language narration (7.0.80).
+
+    A 7.0.79 Odia narration contained 'βαğβαğ' in place of an Odia word, which the TTS reads as noise.
+    Flagged: any letter from a non-Latin foreign script (Greek, Cyrillic, ...), or Latin letters mixed into
+    a native word. Pure Latin words (brand names, loanwords such as 'Instagram') are allowed.
+    Digits, punctuation (including the danda) and marks in the native script are ignored.
+    """
+    code = str(language or '').lower()
+    if code not in NATIVE_SCRIPT_RANGES:
+        return []
+    low, high = NATIVE_SCRIPT_RANGES[code]
+    bad = []
+    for word in re.findall(r"\S+", str(text or '')):
+        native = latin = foreign = False
+        for c in word:
+            if not c.isalpha():
+                continue
+            if low <= ord(c) <= high:
+                native = True
+            elif c.isascii() or 'LATIN' in unicodedata.name(c, ''):
+                latin = True
+            else:
