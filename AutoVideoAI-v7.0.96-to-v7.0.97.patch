+def test_the_explicit_override_deletes_a_completed_job_without_a_video(outputs, no_ffprobe):
+    job = _completed_job(outputs, 'job-empty2', None)
+    with pytest.raises(ValueError):                              # never without the override
+        completed_job_delete(outputs, outputs.parent / 'jobs.db', job.name, apply=True,
+                             confirmation=job.name)
