+"""v7.0.88: log-only diagnostics for Flow image downloads. No download behaviour changes."""
+from types import SimpleNamespace
+
+import pytest
+
+from engine import flow_download_diagnostics as diagnostics
+from engine import flow_blob_capture, flow_ui_blob
+from engine.providers.flow_browser import FlowBrowser
+
+
+@pytest.fixture
+def lines(monkeypatch):
+    seen = []
+    monkeypatch.setattr(diagnostics, "runtime_print", lambda *args, **kwargs: seen.append(" ".join(str(a) for a in args)))
+    return seen
+
+
+def test_exception_text_drops_urls_and_caps_length():
+    exc = RuntimeError("Target closed at blob:https://flow.google.com/abc-123 and https://x.example/?token=SECRET " + "z" * 500)
+    text = diagnostics.describe_exception(exc)
+    assert text.startswith("RuntimeError: Target closed at <url> and <url> ")
+    assert "SECRET" not in text and "abc-123" not in text
+    assert len(text) <= len("RuntimeError: ") + 200
+
+
+def test_url_shape_keeps_only_scheme_and_host():
+    assert diagnostics.url_shape("blob:https://flow.google.com/9f8e7d-uuid") == "blob:flow.google.com"
+    assert diagnostics.url_shape("https://lh3.googleusercontent.com/a/b?sig=SECRET") == "https://lh3.googleusercontent.com"
+    assert diagnostics.url_shape("") == "none"
+    assert diagnostics.url_shape("file:///tmp/x") == "other"
+    assert "SECRET" not in diagnostics.url_shape("https://lh3.googleusercontent.com/a?sig=SECRET")
+
+
+def test_page_state_reports_closed_and_unknown():
+    class Closed:
+        def is_closed(self):
+            return True
+
+    class Broken:
+        def is_closed(self):
+            raise RuntimeError("gone")
+
+    assert diagnostics.page_state(None) == "none"
+    assert diagnostics.page_state(Closed()) == "closed"
+    assert diagnostics.page_state(Broken()) == "unknown:RuntimeError"
+
+
+def test_download_owner_is_identified_by_page_identity():
+    class Page:
+        def is_closed(self):
+            return False
+
+    class Closed:
+        def is_closed(self):
+            return True
+
+    class Download:
+        def __init__(self, page):
+            self.page = page
+
+    clicked = Page()
+    assert diagnostics.download_page_state(Download(clicked), clicked) == "clicked-page,open"
+    assert diagnostics.download_page_state(Download(Closed()), clicked) == "other-page,closed"
+
+
+def test_page_watch_records_events_and_removes_listeners(lines):
+    class Emitter:
+        def __init__(self):
+            self.handlers = {}
+            self.removed = []
+
+        def on(self, event, callback):
+            self.handlers[event] = callback
+
+        def remove_listener(self, event, callback):
+            self.removed.append((event, callback))
+
+    page = Emitter()
+    context = Emitter()
+    bridge = SimpleNamespace(_ctx=context, _cdp=None)
+    with diagnostics.PageWatch(bridge, page, "shot_010_open.jpg") as watch:
+        page.handlers["close"](page)
+        context.handlers["close"](context)
+    assert watch.events[0].startswith("page closed +")
+    assert watch.events[1].startswith("browser context closed +")
+    assert any("page closed while saving shot_010_open.jpg" in line for line in lines)
+    assert [event for event, _ in page.removed] == ["close", "crash"]
+
+
+def test_in_page_capture_reports_why_it_gave_up(lines):
+    class Closed:
+        def is_closed(self):
+            return True
+
+    bridge = SimpleNamespace(_page=Closed(), _guard_page=None)
+    download = SimpleNamespace(url="blob:https://flow.google.com/secret-uuid")
+    assert flow_blob_capture.capture(bridge, download, "/tmp/unused-v788.jpg") is None
+    summary = [line for line in lines if "in-page blob capture did not save" in line]
+    assert summary and "page:closed" in summary[0] and "guard:none" in summary[0]
+    assert "secret-uuid" not in summary[0]
+
+
+def test_in_page_capture_names_non_flow_blob(lines):
+    download = SimpleNamespace(url="https://example.com/a.jpg")
+    assert flow_blob_capture.capture(SimpleNamespace(), download, "/tmp/unused-v788.jpg") is None
+    assert any("not_flow_blob_url" in line for line in lines)
+
+
+def test_ui_blob_arm_failure_is_reported(lines, tmp_path):
+    class Page:
+        url = "https://flow.google.com/project/abc"
+
+        def expose_binding(self, *_args):
+            raise RuntimeError("binding refused")
+
+    assert flow_ui_blob.arm(Page(), str(tmp_path / "shot.jpg"), lambda path: True) is None
+    assert any("exact UI blob capture not armed: RuntimeError: binding refused" in line for line in lines)
+
+
+def test_ui_blob_summary_counts_messages_from_other_pages(lines, tmp_path):
+    class Page:
+        url = "https://flow.google.com/project/abc"
+
+    capture = flow_ui_blob.Capture(Page(), str(tmp_path / "shot.jpg"), lambda path: True)
+    other = object()
+    assert capture.receive({"page": other}, {"index": 0, "data": "AA=="}) is False
+    capture.close()
+    summary = [line for line in lines if "exact UI blob capture not-done" in line]
+    assert summary
+    assert "messages=1 foreign=1" in summary[0] and "error=source_page_mismatch" in summary[0]
+
+
+def test_save_failure_keeps_exception_class_and_redacted_text(monkeypatch):
+    import playwright.async_api as async_api
+    monkeypatch.setattr(async_api, "Download", lambda impl: SimpleNamespace(save_as=None))
+    provider = FlowBrowser.__new__(FlowBrowser)
+
+    class FakeImpl:
+        pass
+
+    def fake_sync(coro):
+        coro.close()
+        raise RuntimeError("Target page, context or browser has been closed (https://x.example/?token=SECRET)")
+
+    download = SimpleNamespace(_impl_obj=FakeImpl(), _sync=fake_sync)
+    out = "/tmp/autovideo-v788-unused/shot.jpg"
+    assert provider._save_browser_image_artifact(download, out) is None
+    assert provider._image_artifact_detail == "browser_artifact_target_closed"
+    assert provider._image_artifact_error.startswith("RuntimeError: Target page, context or browser has been closed")
+    assert "SECRET" not in provider._image_artifact_error and "token=" not in provider._image_artifact_error
