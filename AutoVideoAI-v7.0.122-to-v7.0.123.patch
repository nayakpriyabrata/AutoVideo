--- a/engine/channel_profiles.py	1970-01-01 00:00:00.000000000 +0000
+++ b/engine/channel_profiles.py	2026-11-01 12:27:12.000000000 +0000
@@ -0,0 +1,146 @@
+"""Channel branding (name, logo, intro, outro) for a saved job - and for the narration that becomes one.
+
+Two field reports after v7.0.123's predecessor:
+
+* *"I don't see the earlier selected channel profile is attached to either of the language"* - a narration
+  prepared in Create step 4 never recorded the channel profiles chosen in step 3, and a job created from those
+  voices therefore had an empty ``production/language_editions.json``: no name, no logo, no intro, no outro,
+  and the Three-language panel could only answer "no_intro_outro".
+* *"give user option to attach the channel and character if its missing"* - attaching has to be possible after
+  the fact, without re-recording a voice, re-rendering a shot or spending a Flow credit.
+
+This module only writes settings and profile paths. It never copies, re-encodes or deletes media: the existing
+Three-language panel adds the intro/outro and renders the extra editions from the picture the job already has.
+"""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from .production import read, save
+
+
+def saved_profiles(root=None) -> list[dict]:
+    """Every channel profile on this installation: path, name, languages, and what it carries."""
+    from .finishing_studio import profiles as profile_paths
+    rows = []
+    for path in profile_paths(root):
+        data = read(path, {}) or {}
+        assets = data.get('assets') or {}
+        rows.append({
+            'path': str(path),
+            'name': str(data.get('name') or path.parent.name),
+            'names': {str(k): str(v) for k, v in (data.get('names') or {}).items()},
+            'languages': sorted({key.split('-', 1)[1] for key in assets
+                                 if key.startswith('logo-') and len(key.split('-', 1)) == 2}),
+            'logo': bool(assets.get('logo') or any(key.startswith('logo-') for key in assets)),
+            'intro': bool(assets.get('intro')),
+            'outro': bool(assets.get('outro')),
+        })
+    return rows
+
+
+def label(profile) -> str:
+    """One line for a saved profile: its name and the branding it actually carries."""
+    parts = [profile['name']]
+    if profile.get('languages'):
+        parts.append('own logo for ' + ', '.join(profile['languages']))
+    elif profile.get('logo'):
+        parts.append('logo')
+    parts.append('intro' if profile.get('intro') else 'no intro')
+    parts.append('outro' if profile.get('outro') else 'no outro')
+    return ' · '.join(parts)
+
+
+def _editions_file(job_dir) -> Path:
+    return Path(job_dir) / 'production' / 'language_editions.json'
+
+
+def job_profiles(job_dir) -> dict:
+    """The profile each language of this job uses, as saved in the job (never guessed)."""
+    data = read(_editions_file(job_dir), {}) or {}
+    profiles = data.get('profiles') or {}
+    return {str(code): str(path) for code, path in profiles.items() if path}
+
+
+def job_editions(job_dir) -> list[str]:
+    """The editions this job renders, from its saved record (falls back to its manifest language)."""
+    data = read(_editions_file(job_dir), {}) or {}
+    editions = [str(code) for code in (data.get('editions') or []) if code]
+    if editions:
+        return editions
+    manifest = read(Path(job_dir) / 'production_manifest.json', {}) or {}
+    return [str(manifest.get('language') or 'en')]
+
+
+def attach_profiles(job_dir, profiles: dict, *, editions=None) -> dict:
+    """Save one channel profile per language into a job. Settings only - nothing is rendered.
+
+    ``profiles`` maps a language code to a channel profile path (an empty value removes that entry). The
+    Three-language panel reads this file, so a job given its profile here can add the intro/outro and render
+    every edition from the picture it already has - no shot is generated again.
+    """
+    folder = Path(job_dir)
+    if not (folder / 'production_manifest.json').is_file():
+        raise ValueError('No saved job at ' + str(folder) + ' (production_manifest.json is missing).')
+    available = {row['path']: row for row in saved_profiles()}
+    chosen = {}
+    for code, path in (profiles or {}).items():
+        code, path = str(code), str(path or '')
+        if not path:
+            continue
+        if path not in available:
+            raise ValueError('No saved channel profile at ' + path
+                             + '. Choose one from the list (Channel Desk lists them), then save again.')
+        chosen[code] = path
+    record = read(_editions_file(folder), {}) or {}
+    wanted = [str(code) for code in (editions or job_editions(folder))]
+    merged = dict(record.get('profiles') or {})
+    for code, path in chosen.items():
+        merged[code] = path
+    for code in list(merged):
+        if code not in wanted and code not in chosen:
+            merged.pop(code, None)
+    record.update({
+        'source_language': record.get('source_language') or job_editions(folder)[0],
+        'editions': wanted,
+        'profiles': merged,
+        # 'status' belongs to narration preparation and is left alone; branding records its own line.
+        'branding_status': 'channel profiles attached',
+    })
+    record.setdefault('prepare_audio', True)
+    save(_editions_file(folder), record)
+    rows = []
+    for code in wanted:
+        profile = available.get(merged.get(code, ''), {})
+        rows.append({'language': code, 'path': merged.get(code, ''),
+                     'name': str(profile.get('name') or ''),
+                     'channel_name': str((profile.get('names') or {}).get(code) or profile.get('name') or ''),
+                     'intro': bool(profile.get('intro')), 'outro': bool(profile.get('outro')),
+                     'logo': bool(profile.get('logo'))})
+    return {'job_id': folder.name, 'editions': wanted, 'profiles': merged, 'rows': rows,
+            'intro_outro': any(row['intro'] or row['outro'] for row in rows)}
+
+
+def missing(job_dir, editions=None) -> list[str]:
+    """Editions of this job that still have no channel profile."""
+    known = job_profiles(job_dir)
+    return [code for code in (editions or job_editions(job_dir)) if not known.get(code)]
+
+
+def summary(rows) -> str:
+    """Plain sentence for the UI and the CLI: which language uses which channel, and what it carries."""
+    from .languages import language_pack
+    pieces = []
+    for row in rows or []:
+        name = row.get('channel_name') or row.get('name') or ''
+        if not name:
+            continue
+        extras = [word for word, present in (('logo', row.get('logo')), ('intro', row.get('intro')),
+                                             ('outro', row.get('outro'))) if present]
+        try:
+            label = language_pack(row['language']).label
+        except Exception:
+            label = str(row['language'])
+        pieces.append(label + ' → ' + name + (' (' + ', '.join(extras) + ')' if extras else ''))
+    return ' · '.join(pieces)
diff -rN -u '--exclude=outputs' '--exclude=data' '--exclude=logs' '--exclude=__pycache__' '--exclude=.pytest_cache' a/engine/flow_choice.py b/engine/flow_choice.py
--- a/engine/flow_choice.py	1970-01-01 00:00:00.000000000 +0000
+++ b/engine/flow_choice.py	2026-11-01 12:27:28.000000000 +0000
@@ -0,0 +1,134 @@
+"""Keep one of the images a blocked Flow request already saved - locally, without touching Flow.
+
+The failure this answers (v7.0.123), reported from a real job:
+
+    ⚠️ shot_051 opening frame: Flow failed after 1 attempts → free fallback
+    Cause: FlowRequestPending: Two or more real images are saved for shot_051_open.jpg.
+    Recovery stopped without submitting or replacing; review the saved Flow project and choose
+    which image to keep.
+
+The app was right to stop: it cannot prove which of two generated images belongs to that frame, and guessing
+would put the wrong picture in the video. But the images themselves are already downloaded as probe files next
+to the frame, with their checksums recorded in the request journal - so *you* can look at them and pick one.
+That is all this module does: it lists those saved candidates and commits the one you choose, using the same
+``commit_capture`` the automatic path uses (checksum, reference exclusion, journal update). No browser opens, no
+request is submitted, no Flow credit is spent, and the other candidate is left where it is.
+"""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from .flow_image_transaction import commit_capture, journal_path
+from .isolated_frame_regeneration import image_valid, sha
+
+
+def _frames(job_dir) -> list[Path]:
+    """Every frame with a request journal, in shot order.
+
+    The frame file itself need not exist yet - a request that never finished has a journal and saved candidate
+    images but no committed ``.jpg``, which is exactly the case this module exists for.
+    """
+    storyboard = Path(job_dir) / 'storyboard'
+    if not storyboard.is_dir():
+        return []
+    suffix = '.flow-request.json'
+    return sorted(Path(str(path)[:-len(suffix)]) for path in storyboard.glob('*.jpg' + suffix))
+
+
+def _read(path: Path) -> dict:
+    try:
+        return json.loads(journal_path(path).read_text(encoding='utf-8'))
+    except (OSError, ValueError):
+        return {}
+
+
+def candidates(output) -> list[dict]:
+    """The saved images for this frame that are not uploaded references, newest evidence first.
+
+    Each row is one probe the journal already downloaded and checksummed. A row whose bytes no longer match the
+    recorded checksum is reported as ``broken`` instead of being offered: a changed file is not the image the
+    journal saw.
+    """
+    output = Path(output)
+    request = _read(output)
+    rows = []
+    for entry in (request.get('capture_probes') or {}).values():
+        if not isinstance(entry, dict) or entry.get('reference') or not entry.get('file'):
+            continue
+        probe = output.parent / str(entry['file'])
+        exists = probe.is_file() and probe.parent == output.parent
+        valid = bool(exists and image_valid(probe))
+        matches = bool(valid and entry.get('sha256') and sha(probe) == entry['sha256'])
+        rows.append({'file': str(entry['file']), 'path': str(probe), 'exists': exists,
+                     'valid': valid, 'matches_recorded_checksum': matches,
+                     'bytes': probe.stat().st_size if exists else 0,
+                     'signature': str(entry.get('signature') or ''),
+                     'state': str(entry.get('state') or ''),
+                     'usable': bool(valid and matches)})
+    rows.sort(key=lambda row: (not row['usable'], row['file']))
+    return rows
+
+
+def blocked_frames(job_dir) -> list[dict]:
+    """Frames where recovery stopped because more than one real image is saved, plus their candidates."""
+    found = []
+    for output in _frames(job_dir):
+        request = _read(output)
+        if str(request.get('status') or '') == 'downloaded' and output.is_file() and image_valid(output):
+            continue
+        rows = candidates(output)
+        usable = [row for row in rows if row['usable']]
+        if len(usable) < 2:
+            continue
+        found.append({'image': output.name, 'path': str(output), 'shot': output.name.split('.')[0],
+                      'project_url': str(request.get('project_url') or ''),
+                      'prompt': str((request.get('prompt') or request.get('text') or ''))[:400],
+                      'candidates': usable, 'count': len(usable)})
+    return found
+
+
+def all_frames(job_dir) -> list[dict]:
+    """Every unfinished frame with at least one usable saved candidate, for a manual pick."""
+    found = []
+    for output in _frames(job_dir):
+        request = _read(output)
+        if str(request.get('status') or '') == 'downloaded' and output.is_file() and image_valid(output):
+            continue
+        usable = [row for row in candidates(output) if row['usable']]
+        if not usable:
+            continue
+        found.append({'image': output.name, 'path': str(output), 'shot': output.name.split('.')[0],
+                      'project_url': str(request.get('project_url') or ''),
+                      'prompt': str((request.get('prompt') or request.get('text') or ''))[:400],
+                      'candidates': usable, 'count': len(usable)})
+    return found
+
+
+def keep(job_dir, image: str, index: int) -> dict:
+    """Commit the chosen saved image as this frame. ``index`` is the 0-based position in ``candidates``."""
+    job_dir = Path(job_dir)
+    output = job_dir / 'storyboard' / str(image)
+    if not journal_path(output).is_file():
+        raise ValueError('No saved frame with a request journal at ' + str(output))
+    request = _read(output)
+    if str(request.get('status') or '') == 'downloaded' and output.is_file() and image_valid(output):
+        raise ValueError(output.name + ' is already saved as the frame; nothing was changed.')
+    rows = candidates(output)
+    if not rows:
+        raise ValueError('No saved candidate images are recorded for ' + output.name
+                         + ', so there is nothing to choose. Resume the job to ask Flow again.')
+    try:
+        chosen = rows[int(index)]
+    except (IndexError, TypeError, ValueError):
+        raise ValueError('Choose a candidate between 1 and ' + str(len(rows)) + ' for ' + output.name) from None
+    if not chosen['usable']:
+        raise ValueError('Candidate ' + chosen['file'] + ' is missing or no longer matches the checksum recorded '
+                         'when it was saved, so it cannot be used. Nothing was changed.')
+    commit_capture(output, request, chosen['path'], 'reviewed_candidate_choice')
+    request['reviewed_choice'] = {'file': chosen['file'], 'sha256': sha(output)}
+    journal_path(output).write_text(json.dumps(request, indent=2, ensure_ascii=False), encoding='utf-8')
+    return {'image': output.name, 'kept': chosen['file'], 'probe': chosen['path'], 'path': str(output),
+            'sha256': request['media_sha256'], 'candidates': len(rows),
+            'note': 'Saved locally from an image Flow had already produced. No browser opened, no request '
+                    'submitted, no Flow credit spent.'}
