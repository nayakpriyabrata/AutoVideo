--- a/tests/test_v7124_three_language_convergence.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_v7124_three_language_convergence.py	2026-11-02 09:44:13.000000000 +0000
@@ -0,0 +1,224 @@
+"""v7.0.124: a three-language production finishes - and stays finished.
+
+The report was *"I have added some features to generate videos with three languages, however it's not
+generating video with 3 languages."* The editions did render; they just never counted as done.
+
+``_captions_contradict()`` (v7.0.113) compared the burned-caption evidence with the job's wish in
+**both** directions. Only one of them is evidence: a caption is not on screen every second, so sampled
+frames that find no text prove nothing - ``engine/render/caption_check.explain()`` says exactly that,
+and the render loop only ever sets ``captions_disputed`` for the visible-text direction. Comparing both
+ways meant a language whose transcript is ON was pending again on every single run whenever the pixel
+heuristic could not see its glyphs, which a bright, high-contrast picture alone causes:
+
+* the second ``render_job_editions`` re-encoded Hindi into a brand-new export folder;
+* ``_mark_superseded`` stamped the previous file "not the current video" each time, so a user who
+  opened yesterday's Odia file was told it was superseded by one that was itself about to be replaced;
+* the job could never report every selected language as exported, so resumes and repairs kept re-running
+  the render stage instead of finishing.
+
+Real FFmpeg media; no Gemini, TTS or Flow call is made.
+"""
+import hashlib
+import json
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+needs_ffmpeg = pytest.mark.skipif(not (shutil.which('ffmpeg') and shutil.which('ffprobe')),
+                                  reason='FFmpeg required')
+
+
+def _sha(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def _tone(path, frequency, seconds):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi',
+                    '-i', f'sine=frequency={frequency}:sample_rate=44100', '-t', str(seconds),
+                    '-c:a', 'pcm_s16le', str(path)], check=True)
+    return path
+
+
+def _picture(path, seconds=3.0):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi',
+                    '-i', f'testsrc2=size=640x360:rate=24', '-t', str(seconds), '-an',
+                    '-c:v', 'libx264', '-pix_fmt', 'yuv420p', str(path)], check=True)
+    return path
+
+
+def _job(tmp_path, *, transcript=None):
+    """A finished production: clean picture plus a reviewed Hindi and Odia narration."""
+    from engine.production import save
+    job = tmp_path / 'job'
+    (job / 'render').mkdir(parents=True)
+    (job / 'production').mkdir()
+    (job / 'audio').mkdir()
+    visual = _picture(job / 'render' / 'visual-master.mp4')
+    save(job / 'production' / 'visual_master.json',
+         {'path': str(visual), 'sha256': _sha(visual), 'duration': 3.0, 'contains': 'picture only'})
+    bundles = {}
+    for code, freq in (('hi', 660), ('or', 880)):
+        folder = job / 'speech-editions' / code / ('key-' + code)
+        audio = _tone(folder / 'voice.wav', freq, 3.0)
+        words = folder / 'words.json'
+        words.write_text(json.dumps([{'word': 'शब्द', 'start': 0.1, 'end': 0.9},
+                                     {'word': 'दो', 'start': 1.0, 'end': 1.8}], ensure_ascii=False),
+                         encoding='utf-8')
+        bundles[code] = {'audio': str(audio), 'audio_sha256': _sha(audio), 'duration': 3.0,
+                         'words': str(words), 'script': 'स्वीकृत वर्णन', 'language': code,
+                         'timing_source': 'test-measured', 'text_cards': True, 'educational': False,
+                         'hooks': False, 'topic': 't', 'card_provider': 'gemini-web', 'cards': []}
+    state = {'source_language': 'en', 'editions': ['en', 'hi', 'or'], 'profiles': {},
+             'prepare_audio': True, 'bundles': bundles, 'text_cards': True, 'hooks_enabled': False,
+             'educational': False, 'topic': 't'}
+    if transcript is not None:
+        state['transcript'] = transcript
+    save(job / 'production' / 'language_editions.json', state)
+    return job
+
+
+# --------------------------------------------------------------------------- #
+# Convergence
+# --------------------------------------------------------------------------- #
+@needs_ffmpeg
+def test_a_second_run_reuses_every_edition_instead_of_re_encoding_it(tmp_path):
+    from engine.language_editions import render_job_editions
+    job = _job(tmp_path)
+    first = render_job_editions(job)
+    assert first['status'] == 'exported', first
+    assert {code: row['status'] for code, row in first['editions'].items()} == {'hi': 'exported',
+                                                                               'or': 'exported'}
+    second = render_job_editions(job)
+    assert second['status'] == 'exported'
+    for code in ('hi', 'or'):
+        assert second['editions'][code]['path'] == first['editions'][code]['path'], (
+            code + ' was re-rendered although nothing about the job changed')
+        assert Path(second['editions'][code]['path']).is_file()
+    # Nothing was superseded, because nothing was replaced.
+    assert not list(job.glob('language_editions/*/superseded.json'))
+
+
+@needs_ffmpeg
+def test_a_third_run_is_still_the_same_two_files(tmp_path):
+    from engine.language_editions import render_job_editions
+    job = _job(tmp_path)
+    paths = [render_job_editions(job)['editions']['hi']['path'] for _ in range(3)]
+    assert len(set(paths)) == 1
+    exports = sorted(p.name for p in job.glob('language_editions/*/exports/hi-*.mp4'))
+    assert len(exports) == 1                     # one Hindi export, not one per run
+
+
+@needs_ffmpeg
+def test_the_panel_and_the_renderer_agree_that_the_job_is_finished(tmp_path):
+    from engine.language_editions import edition_diagnosis, render_job_editions
+    job = _job(tmp_path)
+    render_job_editions(job)
+    diagnosis = edition_diagnosis(job)
+    assert diagnosis['status'] == 'exported'
+    assert all(row['status'] == 'exported' for row in diagnosis['editions'].values())
+    assert diagnosis['visual_master']['ready'] is True
+    # A finished three-language job must not leave a "needs attention" warning on the job.
+    assert not diagnosis.get('narration_error')
+
+
+# --------------------------------------------------------------------------- #
+# Why it used to loop: an undetected transcript is not a defect
+# --------------------------------------------------------------------------- #
+@needs_ffmpeg
+def test_an_undetected_transcript_does_not_make_the_edition_pending_again(tmp_path):
+    from engine import language_editions as LE
+    job = _job(tmp_path)
+    LE.render_job_editions(job)
+    record = json.loads((job / 'production' / 'language_editions_render.json').read_text(encoding='utf-8'))
+    state = json.loads((job / 'production' / 'language_editions.json').read_text(encoding='utf-8'))
+    for code in ('hi', 'or'):
+        entry = record['editions'][code]
+        wants = LE.transcript_for(state, code)
+        # Whatever the pixel heuristic made of this picture, a transcript that WAS asked for cannot
+        # force another render: absence of detected glyphs proves nothing.
+        assert LE._bundle_is_current(job, code, state['bundles'][code], entry, verify=True,
+                                     transcript=wants, captions_sha=LE.caption_signature(job, code)[0])
+        if wants:
+            assert LE._captions_contradict(job, code, entry, wants=True, measure=True) is False
+
+
+def test_caption_evidence_is_still_only_a_question_never_a_verdict():
+    """The check's own contract, which the render loop must not contradict."""
+    from engine.render.caption_check import explain
+    undetected = {'checked': True, 'looks_like_text': False, 'ratio': 0.16, 'edge_ratio': 0.02,
+                  'detail': 'no burned transcript detected'}
+    detected = {'checked': True, 'looks_like_text': True, 'ratio': 0.16, 'edge_ratio': 0.06}
+    assert explain(undetected, expected=True) == ''          # asked for, not seen: no warning
+    assert explain(detected, expected=False)                 # not asked for, seen: a real defect
+    assert explain(detected, expected=True) == ''
+    assert explain(undetected, expected=False) == ''
+
+
+def test_contradiction_is_one_directional_without_media(tmp_path):
+    """Pure state, no FFmpeg: the direction that used to loop is closed."""
+    from engine import language_editions as LE
+    export = tmp_path / 'hi-export.mp4'
+    export.write_bytes(b'not really a video; only the recorded detection is read here')
+    undetected = {'status': 'exported', 'path': str(export), 'captions': True,
+                  'captions_detected': {'checked': True, 'looks_like_text': False, 'ratio': 0.16,
+                                        'edge_ratio': 0.02, 'detail': 'no burned transcript detected'}}
+    # Asked for a transcript, no glyphs detected: NOT a defect, so no re-render. This is the loop.
+    assert LE._captions_contradict(tmp_path, 'hi', undetected, wants=True, measure=True) is False
+    # The v7.0.113 defect stays fixed: text on screen when the job asked for none IS a re-render.
+    visible = {'status': 'exported', 'path': str(export), 'captions': False,
+               'captions_detected': {'checked': True, 'looks_like_text': True, 'ratio': 0.16,
+                                     'edge_ratio': 0.06, 'detail': 'consistent with a burned transcript'}}
+    assert LE._captions_contradict(tmp_path, 'or', visible, wants=False, measure=False) is True
+    # Once disputed, it is explained instead of re-rendered for ever.
+    assert LE._captions_contradict(tmp_path, 'or', dict(visible, captions_disputed=True),
+                                   wants=False, measure=True) is False
+
+
+def test_an_exported_entry_without_a_readable_file_cannot_break_the_loop(tmp_path):
+    """7.0.124: this raised ValueError('PosixPath(.) has an empty name') out of the whole edition loop."""
+    from engine import language_editions as LE
+    for path in ('', str(tmp_path / 'missing.mp4')):
+        entry = {'status': 'exported', 'path': path, 'captions': False}
+        assert LE._captions_contradict(tmp_path, 'or', entry, wants=False, measure=True) is False
+
