+def watermark_segments(channel_name: str, start: float, end: float, style: str = "playful",
+                       cycle: float = 30.0, closed: float = 0.8) -> list:
+    """Channel-mark events that cover the whole window, opening every ``cycle`` seconds (v7.0.109).
+
+    The old playful plan restarted the mark every 35 s but each run ended after 30 s, so between runs the
+    channel name vanished for five seconds - and with it the only copy of the logo drawn into that badge.
+    These segments are contiguous: closed for ``closed`` seconds, open for the rest of the cycle.
+    """
+    if not str(channel_name or "").strip() or end - start <= 1.0:
+        return []
+    segments = []
+    at = float(start)
+    while at < end - 0.5:
+        chunk = min(float(cycle), end - at)
+        if chunk <= 1.2:
+            break
+        if style == "playful" and chunk > closed + 1.0:
+            segments.append(OverlayEvent("watermark", round(at, 3), round(at + closed, 3), channel_name, "closed",
+                                         fade_in=.2, fade_out=.15))
+            segments.append(OverlayEvent("watermark", round(at + closed, 3), round(at + chunk, 3), channel_name, "",
+                                         fade_in=.25, fade_out=.4))
+        else:
+            segments.append(OverlayEvent("watermark", round(at, 3), round(at + chunk, 3), channel_name, "",
+                                         fade_in=.25, fade_out=.4))
+        at += chunk
+    return segments
+
