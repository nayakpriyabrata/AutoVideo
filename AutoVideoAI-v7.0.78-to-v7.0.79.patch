+"""v7.0.79: Gemini Web sends are verified, unusable text cards are dropped instead of aborting the set,
+Odia captions skip speech recognition, and a slow Gemini answer is not asked for again.
+
+The Gemini tests use a fake page and a fake clock, so no browser or network is needed.
+"""
+import array
+import json
+import math
+import wave
+
+import pytest
+
+from engine import captions as C
+from engine import speech_cards as SC
+import engine.providers.gemini_web as GW
+
+
+class FakeClock:
+    """Replaces ``time`` in a module: time() advances by ``step`` per call, sleep() advances by its argument."""
+
+    def __init__(self, step=0.5):
+        self.now = 1000.0
+        self.step = step
+
+    def time(self):
+        self.now += self.step
+        return self.now
+
+    def sleep(self, seconds):
+        self.now += seconds
+
+
+class Box:
+    """Composer stand-in. ``text`` is what the editor shows; ``readable`` False makes reads fail."""
+
+    def __init__(self, text, readable=True, on_enter=None):
+        self.text = text
+        self.readable = readable
+        self.on_enter = on_enter
+        self.presses = []
+
+    def inner_text(self, timeout=None):
+        if not self.readable:
+            raise RuntimeError('no text')
+        return self.text
+
+    def input_value(self, timeout=None):
+        if not self.readable:
+            raise RuntimeError('no value')
+        return self.text
+
+    def press(self, key):
+        self.presses.append(key)
+        if self.on_enter:
+            self.on_enter(self)
+
+
+class Button:
+    def __init__(self, on_click=None):
+        self.on_click = on_click
+        self.clicks = 0
+
+    def click(self, timeout=None):
+        self.clicks += 1
+        if self.on_click:
+            self.on_click()
+
+
+def _browser(monkeypatch, button, box, generating=False):
+    browser = GW.GeminiWebBrowser.__new__(GW.GeminiWebBrowser)
+    monkeypatch.setattr(browser, '_try_resolve', lambda *a, **k: button, raising=False)
+    monkeypatch.setattr(browser, '_prompt_box', lambda *a, **k: box, raising=False)
+    monkeypatch.setattr(browser, '_generation_in_progress', lambda: generating, raising=False)
+    monkeypatch.setattr(GW, 'time', FakeClock())
+    return browser
+
+
+PROMPT = 'SYSTEM: draft the cards.\nUSER: Language: or\nWrite every card in Odia.'
+
+
+def test_send_click_that_empties_the_composer_is_trusted(monkeypatch):
+    box = Box(PROMPT)
+    button = Button(on_click=lambda: setattr(box, 'text', ''))
+    browser = _browser(monkeypatch, button, box)
+    browser._submit(PROMPT)
+    assert button.clicks == 1
+    assert box.presses == []
+
+
+def test_click_that_does_nothing_is_followed_by_enter(monkeypatch):
+    box = Box(PROMPT, on_enter=lambda b: setattr(b, 'text', ''))
+    button = Button()  # clicking does not send
+    browser = _browser(monkeypatch, button, box)
+    browser._submit(PROMPT)
+    assert button.clicks == 1
+    assert box.presses == ['Enter']
+
+
+def test_prompt_still_in_composer_is_an_error_not_a_silent_submit(monkeypatch):
+    box = Box(PROMPT)  # neither the click nor Enter sends
+    browser = _browser(monkeypatch, Button(), box)
+    with pytest.raises(GW.GeminiWebUIChanged, match='did not send the prompt'):
+        browser._submit(PROMPT)
+    assert box.presses == ['Enter']
+
+
+def test_unreadable_composer_is_never_proof_of_a_send(monkeypatch):
+    box = Box(PROMPT, readable=False)
+    browser = _browser(monkeypatch, Button(), box)
+    with pytest.raises(GW.GeminiWebUIChanged):
+        browser._submit(PROMPT)
+
+
+def test_unreadable_composer_counts_as_sent_only_when_gemini_is_generating(monkeypatch):
+    box = Box(PROMPT, readable=False)
+    browser = _browser(monkeypatch, Button(), box, generating=True)
+    browser._submit(PROMPT)
+    assert box.presses == []
+
+
+def test_missing_send_control_and_composer_fails_before_any_wait(monkeypatch):
+    browser = GW.GeminiWebBrowser.__new__(GW.GeminiWebBrowser)
+    monkeypatch.setattr(browser, '_try_resolve', lambda *a, **k: None, raising=False)
+    monkeypatch.setattr(browser, '_prompt_box', lambda *a, **k: None, raising=False)
+    with pytest.raises(GW.GeminiWebUIChanged, match='send control was not found'):
+        browser._submit(PROMPT)
+
+
+# ---------- text cards: drop the unusable card, keep the set ----------
+
+WORDS = [{'word': f'w{i}', 'start': round(i * .1, 3), 'end': round(i * .1 + .08, 3)} for i in range(160)]
+
+
+def test_long_spoken_phrase_is_clamped_to_six_seconds_not_rejected():
+    draft = {'cards': [{'kind': 'keypoint', 'text': 'A long idea', 'start_word': 0, 'end_word': 80}]}
+    cards = SC.anchor_cards(draft, WORDS, 16.0)
+    assert len(cards) == 1
+    assert cards[0]['end'] - cards[0]['start'] == pytest.approx(6.0, abs=0.01)
+
+
+def test_one_bad_card_is_dropped_and_the_rest_are_kept():
+    draft = {'cards': [
+        {'kind': 'keypoint', 'text': 'Good one', 'start_word': 0, 'end_word': 5},
+        {'kind': 'keypoint', 'text': 'x' * 81, 'start_word': 20, 'end_word': 25},
+        {'kind': 'keypoint', 'text': 'Good two', 'start_word': 60, 'end_word': 65},
+    ]}
+    report = []
+    cards = SC.anchor_cards(draft, WORDS, 16.0, report=report)
+    assert [c['text'] for c in cards] == ['Good one', 'Good two']
+    assert len(report) == 1 and report[0]['index'] == 1
+
+
+def test_overlapping_card_is_dropped_and_reported():
+    draft = {'cards': [
+        {'kind': 'keypoint', 'text': 'First', 'start_word': 0, 'end_word': 20},
+        {'kind': 'keypoint', 'text': 'Second', 'start_word': 5, 'end_word': 25},
+    ]}
+    report = []
+    cards = SC.anchor_cards(draft, WORDS, 16.0, report=report)
+    assert [c['text'] for c in cards] == ['First']
+    assert any(item['reason'] == 'overlaps an earlier card' for item in report)
+
+
+def test_cards_covering_too_much_of_the_video_are_trimmed_not_fatal():
+    # Five non-overlapping 2 s cards (10 s) against a 6 s allowance.
+    draft = {'cards': [{'kind': 'keypoint', 'text': f'Card {i}', 'start_word': i * 30, 'end_word': i * 30 + 3}
+                       for i in range(5)]}
+    report = []
+    cards = SC.anchor_cards(draft, WORDS, 16.0, report=report)
+    assert sum(c['end'] - c['start'] for c in cards) <= max(6, 16.0 * .30) + 1e-6
+    assert any(item['reason'] == 'too much of the video covered' for item in report)
+
+
+# ---------- language retry guard and wrong-script drops ----------
+
+ODIA = 'ଗଭୀର ଶ୍ୱାସ ନିଅନ୍ତୁ'
+ENGLISH = 'Breathe slowly'
+
+
+def _prepare_with(monkeypatch, tmp_path, replies, clock):
+    monkeypatch.setattr(SC, 'time', clock)
+    calls = []
+    queue = list(replies)
+
+    def fake(system, user, cleanup='delete-after-read'):
+        calls.append(user)
+        return queue.pop(0)
+
+    monkeypatch.setattr(GW, 'gemini_web_generate', fake)
+    audio = tmp_path / 'narration.mp3'
+    audio.write_bytes(b'x' * 64)
+    result = SC.prepare(tmp_path, audio, WORDS, 'ନମସ୍କାର', 16.0, 'or')
+    return result, calls
+
+
+def _cards_json(*rows):
+    return json.dumps({'cards': [{'kind': 'takeaway', 'text': text, 'start_word': start, 'end_word': start + 2}
+                                 for text, start in rows], 'series': None})
+
+
+def test_slow_wrong_script_answer_is_not_asked_again_and_is_dropped(monkeypatch, tmp_path):
+    clock = FakeClock(step=200.0)  # every clock read is 200 s later: the first answer "took" minutes
+    result, calls = _prepare_with(monkeypatch, tmp_path, [_cards_json((ENGLISH, 140))], clock)
+    assert len(calls) == 1
+    assert result['cards'] == []
+    assert result['dropped_cards'] and 'not in or' in result['dropped_cards'][0]['reason']
+
+
+def test_partly_wrong_answer_keeps_the_odia_cards_without_a_retry(monkeypatch, tmp_path):
+    clock = FakeClock(step=0.5)
+    reply = json.dumps({'cards': [
+        {'kind': 'takeaway', 'text': ODIA, 'start_word': 140, 'end_word': 142},
+        {'kind': 'takeaway', 'text': ENGLISH, 'start_word': 20, 'end_word': 22},
+    ], 'series': None})
+    result, calls = _prepare_with(monkeypatch, tmp_path, [reply], clock)
+    assert len(calls) == 1
+    assert [c['text'] for c in result['cards']] == [ODIA]
+    assert len(result['dropped_cards']) == 1
+
+
+def test_all_dropped_result_is_not_reused_on_the_next_run(monkeypatch, tmp_path):
+    first, calls = _prepare_with(monkeypatch, tmp_path, [_cards_json((ENGLISH, 140))], FakeClock(step=200.0))
+    assert first['cards'] == [] and len(calls) == 1
+    # Same audio and script: the saved empty result must not be returned as if it were final.
+    second, calls_again = _prepare_with(monkeypatch, tmp_path, [_cards_json((ODIA, 140))], FakeClock(step=0.5))
+    assert len(calls_again) == 1
+    assert [c['text'] for c in second['cards']] == [ODIA]
+
+
+def test_fully_wrong_quick_answer_is_retried_once(monkeypatch, tmp_path):
+    clock = FakeClock(step=0.5)
+    result, calls = _prepare_with(monkeypatch, tmp_path,
+                                  [_cards_json((ENGLISH, 140)), _cards_json((ODIA, 140))], clock)
+    assert len(calls) == 2
+    assert [c['text'] for c in result['cards']] == [ODIA]
+
+
+# ---------- captions: no speech recognition for Odia ----------
+
+
+def _wav(path, seconds=8.0):
+    samples = array.array('h')
+    for i in range(int(seconds * 16000)):
+        samples.append(int(0.3 * 32767 * math.sin(2 * math.pi * 220 * i / 16000)) if (i // 8000) % 2 == 0 else 0)
+    with wave.open(str(path), 'wb') as w:
+        w.setnchannels(1)
+        w.setsampwidth(2)
+        w.setframerate(16000)
+        w.writeframes(samples.tobytes())
+    return path
+
+
+SCRIPT = ' '.join(f'word{i}' for i in range(20)) + '.'
+
+
+def test_auto_skips_groq_and_local_whisper_for_odia(monkeypatch, tmp_path):
+    monkeypatch.setenv('GROQ_API_KEY', 'test-key')
+    audio = _wav(tmp_path / 'narration.wav')
+    calls = []
+    monkeypatch.setattr(C, '_groq_word_timestamps', lambda *a, **k: calls.append('groq') or [])
+    monkeypatch.setattr(C, '_local_word_timestamps', lambda *a, **k: calls.append('local') or [])
+    words = C.get_word_timestamps(str(audio), provider='auto', script_text=SCRIPT, language='or')
+    assert calls == []
+    assert [w['word'] for w in words] == SCRIPT.split()
+    meta = json.loads((tmp_path / 'narration.wav.words.meta.json').read_text(encoding='utf-8'))
+    assert meta['engine'] in ('script-estimated+voiced-spans', 'script-estimated')
+
+
+def test_explicit_groq_for_odia_is_refused_with_a_clear_message(monkeypatch, tmp_path):
+    monkeypatch.setenv('GROQ_API_KEY', 'test-key')
+    audio = _wav(tmp_path / 'narration.wav')
+    with pytest.raises(C.CaptionProviderError, match='does not transcribe or'):
+        C.get_word_timestamps(str(audio), provider='groq', script_text=SCRIPT, language='or')
+
+
+def test_english_still_uses_groq(monkeypatch, tmp_path):
+    monkeypatch.setenv('GROQ_API_KEY', 'test-key')
+    audio = _wav(tmp_path / 'narration.wav')
+    calls = []
+
+    def groq(path, model, language, script):
+        calls.append(language)
+        return [{'word': w, 'start': i * .3, 'end': i * .3 + .25} for i, w in enumerate(SCRIPT.split())]
+
+    monkeypatch.setattr(C, '_groq_word_timestamps', groq)
+    C.get_word_timestamps(str(audio), provider='auto', script_text=SCRIPT, language='en')
+    assert calls == ['en']
