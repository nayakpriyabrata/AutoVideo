+    report = narration_fit.plan(160.0, 100.0, label='Odia')
+    assert report['mode'] == 'refuse'
+    assert report['absorbable_ratio'] == pytest.approx(1.40)
+    assert report['overflow_seconds'] == pytest.approx(20.0)
+    assert report['words_to_cut'] == 48
+    message = report['message']
+    assert '160.0s' in message and '100.0s' in message and '1.60x' in message
+    assert '20.0s' in message and '48' in message and '--fit-max-tempo' in message
