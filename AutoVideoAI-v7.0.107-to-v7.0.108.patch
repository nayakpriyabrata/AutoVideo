@@ -0,0 +1,170 @@
+"""v7.0.108: a fitted narration keeps its drafted cards, and a stale card file is repairable in one command.
+
+Field case: the Odia edition in job 20261022-143856-... started rendering after 7.0.107 fitted its longer
+narration, then failed with "Narration or timings changed after card drafting" - because 7.0.107 rescaled the
+word timings *before* the card renderer, invalidating the fingerprint that proves the cards belong to that
+narration. Cards are now anchored to the reviewed narration and the placed overlays are retimed instead.
+"""
+import json
+from pathlib import Path
+
+import pytest
+
+import engine.finishing_studio as finish
+import engine.speech_cards as SC
+
+WORDS = [{'word': f'w{i}', 'start': i * 0.5, 'end': i * 0.5 + 0.4} for i in range(10)]
+DURATION = 5.0
+SCRIPT = 'स्वीकृत वर्णन • reviewed narration'
+
+
+def _narration(tmp_path):
+    audio = tmp_path / 'voice.mp3'
+    audio.write_bytes(b'voice-bytes-for-hashing')
+    words = tmp_path / 'words.json'
+    words.write_text(json.dumps(WORDS, ensure_ascii=False), encoding='utf-8')
+    return audio, words
+
+
+def _drafted_cards(tmp_path, audio, words, cards):
+    """A speech_cards.json exactly as the drafting stage writes it for this narration."""
+    folder = tmp_path / 'bundle' / 'production'
+    folder.mkdir(parents=True)
+    data = {'schema_version': 1, 'source': 'test', 'cards': cards,
+            'fingerprint': SC.fingerprint(audio, WORDS, SCRIPT, ''),
+            'parts': SC.fingerprint_parts(audio, WORDS, SCRIPT, '')}
+    path = folder / 'speech_cards.json'
+    path.write_text(json.dumps(data, ensure_ascii=False), encoding='utf-8')
+    return path
+
+
+def test_a_fitted_narration_keeps_its_drafted_cards(tmp_path, monkeypatch):
+    audio, words_path = _narration(tmp_path)
+    cards_file = _drafted_cards(tmp_path, audio, words_path,
+                               [{'text': 'Small daily habit', 'start': 0.5, 'end': 2.5,
+                                 'start_word': 1, 'end_word': 4, 'kind': 'keypoint'}])
+    edition = {'speech_cards': {'path': str(cards_file)}, 'hooks': None, 'script': SCRIPT,
+               'educational': False, 'topic': '', 'cards': []}
+    monkeypatch.setattr(finish, '_verified', lambda entry: Path(entry['path']))
+    overlay_root = tmp_path / 'render'
+
+    overlays = finish._edition_overlays(edition, 'or', {'path': str(audio), 'duration': DURATION},
+                                        words_path, 540, 960, overlay_root, [], duration=DURATION)
+
+    assert overlays, 'the drafted cards must render against their own narration'
+    assert overlays[0]['start'] == pytest.approx(0.5) and overlays[0]['end'] == pytest.approx(2.5)
+    assert overlays[0]['anim'] == 'pop' and overlays[0]['box']
+
+    # 1.04x narration speed: the card moves with the words instead of invalidating the draft.
+    retimed = finish._retime_overlays(overlays, 1.04)
+    assert retimed[0]['start'] == pytest.approx(0.481)
+    assert retimed[0]['end'] == pytest.approx(2.404)
+    assert overlays[0]['start'] == pytest.approx(0.5)          # the input list is untouched
+    unchanged = finish._retime_overlays(overlays, 1.0)
+    assert unchanged[0]['start'] == pytest.approx(0.5) and unchanged is not overlays
+
+
+def test_rescaled_words_are_what_broke_the_odias_cards(tmp_path, monkeypatch):
+    """Documents the 7.0.107 defect: feeding rescaled word timings to the card renderer refuses the draft."""
+    audio, words_path = _narration(tmp_path)
+    cards_file = _drafted_cards(tmp_path, audio, words_path,
+                               [{'text': 'Small daily habit', 'start': 0.5, 'end': 2.5,
+                                 'start_word': 1, 'end_word': 4, 'kind': 'keypoint'}])
+    edition = {'speech_cards': {'path': str(cards_file)}, 'hooks': None, 'script': SCRIPT,
+               'educational': False, 'topic': '', 'cards': []}
+    monkeypatch.setattr(finish, '_verified', lambda entry: Path(entry['path']))
+    from engine.narration_fit import scale_words
+    scaled = tmp_path / 'words-fitted.json'
+    scaled.write_text(json.dumps(scale_words(WORDS, 1.04), ensure_ascii=False), encoding='utf-8')
+
+    with pytest.raises(ValueError) as error:
+        finish._edition_overlays(edition, 'or', {'path': str(audio), 'duration': DURATION},
+                                 scaled, 540, 960, tmp_path / 'render2', [], duration=DURATION)
+    message = str(error.value)
+    assert 'drafted from a different narration' in message
+    assert 'word timings changed since the draft' in message
+    assert 'cli.py v3 refresh-cards' in message
+
+
+def test_stale_card_message_is_precise_and_repairable(tmp_path):
+    audio, words_path = _narration(tmp_path)
+    cards_file = _drafted_cards(tmp_path, audio, words_path, [])
+    data = json.loads(cards_file.read_text(encoding='utf-8'))
+    edited_script = SCRIPT + ' (edited)'
+    message = SC.stale_draft_error('Speech cards', cards_file, data, audio, WORDS, edited_script, '',
+                                   language='or')
+    assert 'production/speech_cards.json' in message
+    assert 'the reviewed script changed since the draft' in message
+    assert '10 words' in message and str(len(edited_script.strip())) + ' script characters' in message
+    assert 'python3 cli.py v3 refresh-cards <job> --language or' in message
+    assert 'python3 cli.py v3 language-outputs <job> --fit-hold 8' in message
+    assert 'no new TTS' in message and 'Flow credits' in message
+
+    changed_audio = tmp_path / 'other.mp3'
+    changed_audio.write_bytes(b'different narration bytes')
+    audio_message = SC.stale_draft_error('Speech cards', cards_file, data, changed_audio, WORDS, SCRIPT, '')
+    assert 'the narration audio changed since the draft' in audio_message
+
+
+def test_actions_repair_a_stale_card_file_in_one_command(tmp_path, monkeypatch):
+    """refresh_saved_cards re-drafts from the saved narration: no TTS, one Gemini Web request per language."""
+    import engine.providers.gemini_web as gemini
+    job = tmp_path / 'job'
+    folder = job / 'speech-editions' / 'en' / 'key'
+    folder.mkdir(parents=True)
+    audio = folder / 'voice.mp3'
+    audio.write_bytes(b'odia-voice-bytes')
+    words_path = folder / 'words.json'
+    words_path.write_text(json.dumps(WORDS, ensure_ascii=False), encoding='utf-8')
+    # A stale draft from an earlier script.
+    (folder / 'production').mkdir()
+    (folder / 'production' / 'speech_cards.json').write_text(json.dumps({
+        'fingerprint': 'stale', 'parts': {'audio': 'x', 'words': 'y', 'script': 'z', 'variant': 'v',
+                                          'word_count': 3, 'script_chars': 9},
+        'cards': [{'text': 'Old card', 'start': 0, 'end': 1}]}, ensure_ascii=False), encoding='utf-8')
+    bundle = {'audio': str(audio), 'audio_sha256': SC.fingerprint_parts(audio, WORDS, SCRIPT)['audio'],
+              'duration': DURATION, 'words': str(words_path), 'script': SCRIPT, 'language': 'en',
+              'timing_source': 'test', 'cards': [], 'text_cards': True, 'educational': False, 'hooks': False}
+    (job / 'production').mkdir(exist_ok=True)
+    (job / 'production' / 'language_editions.json').write_text(json.dumps({
+        'source_language': 'en', 'editions': ['en'], 'text_cards': True, 'hooks_enabled': False,
+        'bundles': {'en': bundle}}), encoding='utf-8')
+    calls = []
+
+    def fake_generate(system, user, cleanup='keep'):
+        calls.append(system)
+        return json.dumps({'cards': [{'text': 'Small daily habit', 'start_word': 1, 'end_word': 4}]})
+
+    monkeypatch.setattr(gemini, 'gemini_web_generate', fake_generate)
+
+    report = SC.refresh_saved_cards(job, languages=['en'])
+    assert report['languages']['en']['cards'] == 1
+    assert len(calls) == 1                                   # one request, no repeated drafting
+    saved = json.loads((folder / 'production' / 'speech_cards.json').read_text(encoding='utf-8'))
+    assert saved['cards'] and saved['fingerprint'] == SC.fingerprint(audio, WORDS, SCRIPT, '')
+    assert saved['parts']['word_count'] == len(WORDS)
+    assert json.loads((job / 'production' / 'speech_cards.json').read_text(encoding='utf-8'))['cards']
+    # The refreshed cards now render for this narration without a stale-file refusal.
+    monkeypatch.setattr(finish, '_verified', lambda entry: Path(entry['path']))
+    edition = {'speech_cards': {'path': str(folder / 'production' / 'speech_cards.json')}, 'hooks': None,
+               'script': SCRIPT, 'educational': False, 'topic': '', 'cards': []}
+    overlays = finish._edition_overlays(edition, 'en', {'path': str(audio), 'duration': DURATION},
+                                        words_path, 540, 960, tmp_path / 'render', [], duration=DURATION)
+    assert overlays and overlays[0]['kind'] == 'keypoint'
+
+
+def test_refresh_refuses_a_job_without_saved_narrations(tmp_path):
+    job = tmp_path / 'job'
+    (job / 'production').mkdir(parents=True)
+    with pytest.raises(ValueError) as error:
+        SC.refresh_saved_cards(job)
+    assert 'no prepared language editions' in str(error.value)
+    (job / 'production' / 'language_editions.json').write_text(json.dumps({'bundles': {}}), encoding='utf-8')
+    with pytest.raises(ValueError) as empty:
+        SC.refresh_saved_cards(job)
+    assert 'No prepared narration' in str(empty.value)
+    (job / 'production' / 'language_editions.json').write_text(
+        json.dumps({'bundles': {'hi': {'audio': 'x'}}}), encoding='utf-8')
+    with pytest.raises(ValueError) as unknown:
+        SC.refresh_saved_cards(job, languages=['or'])
+    assert 'Saved languages: hi' in str(unknown.value)
