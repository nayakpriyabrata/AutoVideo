+#!/usr/bin/env python3
+"""Apply the v7.0.91 update (Flow image recovery: uploaded references are identified by their stable
+Flow tile label, AV_<hash>_<filename>, not by asset URL; labelled references are excluded from the
+generation wait and their saved bytes are reused instead of downloaded again; the generation wait
+states why it is waiting; a new archive tool moves an unresolved shot journal aside only with an
+explicit credit-spend flag) to a v7.0.90 installation. Nothing is submitted, generated or charged by
+this update itself.
+
+Usage (run from the existing installation folder, after extracting the 7.0.91 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.91/tools/update_v790_to_v791.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.91/tools/update_v790_to_v791.py . --apply    # installs the code
+
+Only code and documentation are replaced. Outputs, saved jobs, browser profiles,
+music, characters and channel profiles are never copied, moved or deleted.
+Stop the dashboard before --apply.
+"""
+
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = [
+    'FLOW_REFERENCE_LABEL_RECOVERY_V7_0_91.md',
+    'VERSION',
+    'engine/flow_image_transaction.py',
+    'engine/isolated_frame_regeneration.py',
+    'engine/providers/flow_browser.py',
+    'tests/test_v791_reference_labels.py',
+    'tools/archive_uncertain_flow_image.py',
+    'tools/update_v790_to_v791.py',
+]
+# Files as they exist in 7.0.90: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['56278b12d84a8f61c0d521ea34926569d14fb59d45d34230542f0a7a495c5040'],
+    'engine/flow_image_transaction.py': ['acf711178af04be5e80a3c08ab8108646ce1c5779c98ac5016dc1ae44d152b9f'],
+    'engine/isolated_frame_regeneration.py': ['5751842ccb90f78a6ee800c63809582438778712d2661ac7e207b6922883f7a6'],
+    'engine/providers/flow_browser.py': ['3aeb8fb12c0adf3fb57c7b3d092e8c69365238152c66ce7c127685b1ccb415d2'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.90', '7.0.91')  # 7.0.91 allows a safe re-run after success
+
+# The 7.0.89 to 7.0.90 update ships in the 7.0.90 zip. Apply it first on an older installation.
+EARLIER_STEPS = [
+    ('7.0.89', '7.0.90', 'tools/update_v789_to_v790.py'),
+]
+
+
+def chain_message(current):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.90 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.90 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.90 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this 7.0.91 update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current))
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the 7.0.91 folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        if destination.exists() and sha(destination) not in ALLOWED.get(name, []) + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+    plan = {'target': str(target), 'installed_version': current, 'apply': args.apply,
+            'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every 7.0.91 code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v7.0.90-to-v7.0.91-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to 7.0.91. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat).')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
+        raise SystemExit(1)
