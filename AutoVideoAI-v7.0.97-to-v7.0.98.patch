+#!/usr/bin/env python3
+"""Apply the v7.0.98 update to a v7.0.97 installation.
+
+A blocked Resume now describes the request it is actually stuck on:
+
+- an **image** journal keeps the free-image advice (one new image request needs no credit approval);
+- a **video** journal says what is true: a new Flow video spends credits, so nothing is resubmitted
+  automatically. The panel offers download-only recovery first (`cli.py v3 recover-flow-video`, then the
+  exact reviewed editor URL), and names the archive command only as a PAID action that needs
+  --confirm-new-credit-spend;
+- journals from older releases are classified by their path, so `flow/shots/<shot>/take_*.mp4` is a video
+  request even without a recorded kind;
+- the Queue panel lets the unresolved journal decide which shot it names, drops commands for requests that
+  are already resolved, and labels the two actions honestly;
+- `tools/flow_resume_preflight.py` prints the same split.
+
+Nothing is generated, rendered or charged by this update itself.
+
+Usage (run from the existing installation folder, after extracting the 7.0.98 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.98/tools/update_v797_to_v798.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.98/tools/update_v797_to_v798.py . --apply    # installs the code
+
+Only code and documentation are replaced. Outputs, saved jobs, Flow journals, browser profiles and
+Clip Studio folders are never copied, moved or deleted. Stop the dashboard before --apply.
+"""
+
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = ['VIDEO_BLOCKED_RESUME_V7_0_98.md', 'VERSION', 'app.py',
+           'engine/factory.py', 'engine/flow_request_archive.py', 'engine/flow_resume_safety.py',
+           'tests/test_v798_video_blocked_message.py', 'tools/flow_resume_preflight.py',
+           'tools/update_v797_to_v798.py']
+# Files as they exist in 7.0.97: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['1887e5c0ca98f8eb824ba6556bbf61dbff7a9e4094cf49cd1b81e31041841e65'],
+    'app.py': ['e0a573f61a45a2d2d5cfa2c20a9d76e18ef2733b96607a8d3cccb92a0b3932a8'],
+    'engine/factory.py': ['1eab3e974b91916aeeeabe85f3a04baa8d07bab9f6b7482afcb09d80fed1dd19'],
+    'engine/flow_request_archive.py': ['46c8e28a0a91fab04061acff7a388d01404cd9580b8dda18764a7d2143f2503a'],
+    'engine/flow_resume_safety.py': ['1b83f095d178e7aeedcb279d60031db5fb9db2da1305796a5b7dd15c5d281fe3'],
+    'tools/flow_resume_preflight.py': ['4b792ffa4e1f9c6f68cd02519e6f75ea819dbc62c1b114539f469a0d59f583e7'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.97', '7.0.98')  # 7.0.98 allows a safe re-run after success
+
+# The 7.0.97 to 7.0.98 update ships in the 7.0.98 zip. Apply it first on an older installation.
+EARLIER_STEPS = [
+    ('7.0.96', '7.0.97', 'tools/update_v796_to_v797.py'),
+]
+
+
+def chain_message(current):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.97 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.97 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.97 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this 7.0.98 update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current))
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the 7.0.98 folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        if destination.exists() and sha(destination) not in ALLOWED.get(name, []) + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+    plan = {'target': str(target), 'installed_version': current, 'apply': args.apply,
+            'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every 7.0.98 code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v7.0.97-to-v7.0.98-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to 7.0.98. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat).')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
+        raise SystemExit(1)
