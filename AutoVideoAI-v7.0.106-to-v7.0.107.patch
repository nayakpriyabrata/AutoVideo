+def _sound_policy(settings) -> dict:
+    """How the music sits under the voice (v7.0.107).
+
+    Field report: the music never seemed to drop while the narrator talked. The bed is now ducked by
+    ``music_duck_ratio`` (12:1 ≈ 13 dB) whenever the voice passes ``music_duck_threshold``, released in
+    ``music_duck_release_ms`` so it comes back in the pauses, and fades in/out at the ends of the video.
+    Every value can be set per job; bad values fall back to the default instead of failing the render.
+    """
+    settings = settings or {}
+
+    def number(key, default, low, high):
+        try:
+            value = float(settings.get(key, default))
+        except (TypeError, ValueError):
+            return float(default)
+        if not (low <= value <= high):
+            return float(default)
+        return value
+
+    return {
+        'duck_ratio': number('music_duck_ratio', 12.0, 1.0, 20.0),
+        'duck_threshold': number('music_duck_threshold', 0.02, 0.0005, 0.5),
+        'duck_attack_ms': int(number('music_duck_attack_ms', 15.0, 1.0, 2000.0)),
+        'duck_release_ms': int(number('music_duck_release_ms', 550.0, 50.0, 5000.0)),
+        'music_fade_in': number('music_fade_in', 1.0, 0.0, 30.0),
+        'music_fade_out': number('music_fade_out', 2.5, 0.0, 30.0),
+        'sfx_gain': number('sfx_gain', 0.65, 0.0, 1.0),
+    }
+
+
+def _edition_fit_policy(settings) -> dict:
+    """Bounded retiming budget for a longer edition narration (v7.0.107).
+
+    ``edition_fit_max_tempo`` (default 1.12), ``edition_fit_hold_seconds`` (default 0 = never hold the last
+    frame) and ``edition_fit_max_picture_stretch`` (default 1.25) can be set per job. Together they decide how
+    much longer a narration may be before the edition is refused with exact numbers.
+    """
+    settings = settings or {}
+    def number(key, default):
+        try:
+            value = float(settings.get(key, default))
+        except (TypeError, ValueError):
+            return float(default)
+        return value if value > 0 else float(default)
+    hold = settings.get('edition_fit_hold_seconds', 0)
+    try:
+        hold = max(0.0, float(hold))
+    except (TypeError, ValueError):
+        hold = 0.0
+    return {'max_picture_stretch': number('edition_fit_max_picture_stretch', 1.25),
+            'max_tempo': number('edition_fit_max_tempo', 1.12),
+            'allow_hold': hold > 0, 'hold_cap': hold or 20.0}
+
+
 def _setting_int(settings, key, default):
     value = (settings or {}).get(key)
     return int(default if value is None else value)
