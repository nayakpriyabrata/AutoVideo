+def hidden_window_args():
+    """Chromium args that park a headed window outside every display, and mute it.
+
+    Deliberately *not* ``--headless``: Google refuses a headless sign-in, and a headless session also
+    loses the downloads and dialogs Flow relies on. An off-screen headed window keeps the real browser
+    and the real login, and is simply never on screen.
+    """
+    return ['--window-position=%d,%d' % (OFFSCREEN, OFFSCREEN),
+            '--window-size=1920,1080',
+            '--mute-audio',
+            '--hide-crash-restore-bubble',
+            '--disable-session-crashed-bubble']
+
+
+def _free_port():
+    with socket.socket() as sock:
+        sock.bind(('127.0.0.1', 0))
+        return sock.getsockname()[1]
+
+
+def debug_port_args():
+    """Loopback debugging port so *Show browser* can move this window without restarting it.
+
+    Best effort and strictly optional: when no port can be allocated the browser is still hidden, only
+    the reveal button loses its handle. Chromium binds this to 127.0.0.1 only.
+    """
+    try:
+        port = _free_port()
+    except OSError:
+        return [], 0
+    return ['--remote-debugging-port=%d' % port, '--remote-debugging-address=127.0.0.1'], port
+
+
+def launch_plan(config=None, *, record=True):
+    """``{'transport', 'args', 'env', 'debug_port'}`` for a quiet launch on this OS.
+
+    Returns ``None`` when quiet mode is off. Never opens a visible window and never silently downgrades
+    to headless. ``record=False`` is for short-lived helper browsers (music search) that must not
+    overwrite the Flow window handle the *Show browser* button reads.
+    """
+    if not quiet_enabled(config):
+        return None
+    if uses_virtual_display():
+        return {'transport': 'quiet-x11', 'args': ['--ozone-platform=x11', '--disable-gpu'],
+                'env': browser_environment(), 'debug_port': 0}
+    args = list(hidden_window_args())
+    port = 0
+    if record:
+        extra, port = debug_port_args()
+        args += extra
+        if port:
+            _save_window_state({'port': port, 'pid': os.getpid(), 'platform': platform(), 'hidden': True,
+                                'started_at': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())})
+    return {'transport': 'quiet-hidden-window', 'args': args, 'env': None, 'debug_port': port}
+
+
+def fallback_plan(config=None):
+    """The same hidden window without the debugging port, if that argument ever breaks a launch."""
+    if not quiet_enabled(config) or uses_virtual_display():
+        return None
+    return {'transport': 'quiet-hidden-window-noport', 'args': list(hidden_window_args()),
+            'env': None, 'debug_port': 0}
