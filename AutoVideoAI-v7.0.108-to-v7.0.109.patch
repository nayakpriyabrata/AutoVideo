+@needs_ffmpeg
+def test_the_edition_carries_the_animated_badge_and_a_logo_for_the_whole_video(tmp_path):
+    """The Odia field video had plain white text and a logo only while it was drawn into the badge."""
+    from engine.render.graphics import OverlayEvent, render_overlay_png, watermark_segments
+    from PIL import Image
+    logo = tmp_path / 'logo.png'
+    Image.new('RGBA', (160, 160), (255, 0, 0, 255)).save(logo)
+    frames = []
+    for index, event in enumerate(watermark_segments('Odia Pragati', 0.0, 8.0)):
+        out = tmp_path / f'badge-{index}.png'
+        render_overlay_png(event, str(out), 640, 360, style='playful')
+        frames.append((out, event))
+    picture = tmp_path / 'clip.mp4'
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i',
+                    'color=c=black:size=640x360:rate=30', '-t', '8', '-c:v', 'libx264', '-pix_fmt', 'yuv420p',
+                    str(picture)], check=True)
+    command = ['ffmpeg', '-y', '-loglevel', 'error', '-i', str(picture), '-loop', '1', '-i', str(logo)]
+    for path, _ in frames:
+        command += ['-loop', '1', '-i', str(path)]
+    filters = ['[0:v][1:v]overlay=x=W-w-8:y=H-h-8[v0]']
+    for index, (_, event) in enumerate(frames, start=1):
+        filters.append(f"[v{index - 1}][{index + 1}:v]overlay=0:0:"
+                       f"enable='between(t,{event.start:.3f},{event.end:.3f})'[v{index}]")
+    command += ['-filter_complex', ';'.join(filters), '-map', f'[v{len(frames)}]', '-t', '8',
+                '-c:v', 'libx264', '-pix_fmt', 'yuv420p', str(tmp_path / 'out.mp4')]
+    subprocess.run(command, check=True)
+
+    def red_at(t):
+        raw = subprocess.run(['ffmpeg', '-loglevel', 'error', '-ss', str(t), '-i', str(tmp_path / 'out.mp4'),
+                              '-frames:v', '1', '-f', 'rawvideo', '-pix_fmt', 'rgb24', '-'],
+                             capture_output=True, check=True).stdout
+        width = 640
+        x, y = width - 20, 360 - 20
+        offset = (y * width + x) * 3
+        return raw[offset:offset + 3]
+
+    # 6.5 s is inside one of the old plan's five-second gaps; the logo must be there anyway.
+    red = red_at(6.5)
+    assert red[0] > 200 and red[1] < 40 and red[2] < 40, red
