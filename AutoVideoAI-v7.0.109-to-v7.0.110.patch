+def gemini_shot_panel(job_id, *, expanded=False):
+    """Choose exactly which shots Gemini Web generates instead of Flow (v7.0.109, surfaced in the job panel).
+
+    The setting used to be a number only: "use Gemini for up to N shots", and the first N eligible Flow shots
+    were taken silently. This panel lists every shot with its verdict, saves the user's choice, and submits
+    nothing - a shot with an accepted take or an existing Flow request is never offered.
+    """
+    from engine.providers.gemini_video import choose_shots, gemini_shot_plan
+    from engine.production_lock import production_slot
+    job_dir = Path(F.pm.job_dir(job_id))
+    manifest = F.pm.load_manifest(job_id)
+    cap = int((F._settings(job_id) or {}).get('gemini_video_count', 0) or 0)
+    plan = gemini_shot_plan(job_dir, manifest.shots, cap)
+    chosen = plan['chosen']
+    heading = 'Gemini Web video shots · ' + (', '.join(chosen) if chosen else 'none chosen') + \
+              f' · {len(plan["eligible"])} eligible'
+    with st.expander(heading, expanded=expanded):
+        st.caption(f'This job sends up to **{cap}** shot(s) to Gemini Web instead of Flow '
+                   f'(Create · "Use Gemini Web for up to this many AI video shots"). '
+                   + (f'Choice: {plan["source"]}. ' if cap else
+                      'The cap is 0, so every shot goes to Flow. Raise it in Create to offer shots here. ')
+                   + 'A shot with an accepted take or an existing Flow request is never offered, so nothing can '
+                     'be generated twice.')
+        eligible = plan['eligible']
+        if eligible:
+            picked = st.multiselect('Shots for Gemini (maximum 4)', options=eligible,
+                                    default=[shot for shot in chosen if shot in eligible],
+                                    key=f'gemini-shots-{job_id}')
+            left, right = st.columns([1, 1])
+            if left.button('Save Gemini choice', key=f'gemini-save-{job_id}'):
+                try:
+                    with production_slot(job_dir):
+                        saved = choose_shots(job_dir, manifest.shots, picked)
+                    st.success('Gemini will generate: ' + (', '.join(saved['chosen']) or 'nothing') +
+                               '. Saved in ' + saved['selection_file'] + '; no request was submitted.')
+                    st.rerun()
+                except ValueError as error:
+                    st.error(str(error))
+            if right.button('Clear the choice', key=f'gemini-clear-{job_id}',
+                            disabled=not plan['selection_saved']):
+                with production_slot(job_dir):
+                    choose_shots(job_dir, manifest.shots, [])
+                st.success('Choice cleared; the first eligible shots are used again.')
+                st.rerun()
+        else:
+            st.info('No shot is eligible for Gemini in this job: every Flow shot has an accepted take or a '
+                    'pending request of its own.')
+        rows = [{'shot': row['shot_id'], 'chosen': row['shot_id'] in chosen,
+                 'eligible': row['eligible'], 'why': row['reason'], 'prompt': row['prompt'][:90]}
+                for row in plan['shots']]
+        st.dataframe(rows, width='stretch', hide_index=True)
+        st.caption('Command line: `python3 cli.py v3 gemini-shots ' + job_id + ' --choose shot_003,shot_007`')
+
