+def _cleanup_panel(st, selected, by_key):
+    """Free regenerable media after a video is finished. Keeps final videos and records.
+
+    Review first, then confirm; apply refuses if the folder changed since review.
+    """
+    from engine import post_job_cleanup as pjc
+    rows = [by_key[key] for key in selected if by_key[key]['kind'] in ('Job', 'Clip folder')]
+    if not rows:
+        return
+    with st.expander('Free space after finishing · keeps the final video and records', expanded=False):
+        st.caption('Removes regenerable media only. Jobs: Flow takes, downloads, storyboard frames, narration and audio, '
+                   'stock copies, interrupted render temp files. Clip folders: the downloaded source video and batch work. '
+                   'Final videos, JSON, subtitles, logs and Flow request journals stay. Blocked while a job is unfinished, '
+                   'a Flow request is pending, or production is active.')
+        for row in rows:
+            digest_key = 'cleanup-plan-' + hashlib.sha256(row['key'].encode()).hexdigest()[:16]
+            kind = 'clip' if row['kind'] == 'Clip folder' else 'job'
+            st.markdown(f"**{row['kind']} · {row['label']}**")
+            if st.button('Review cleanup', key='cleanup-review-' + digest_key):
+                try:
+                    st.session_state[digest_key] = (pjc.plan_clip_folder(row['path']) if kind == 'clip'
+                                                    else pjc.plan_job(row['path']))
+                except (OSError, ValueError) as error:
+                    st.session_state.pop(digest_key, None)
+                    st.error(str(error))
+            plan = st.session_state.get(digest_key)
+            if not plan:
+                continue
+            if plan['blocked']:
+                for reason in plan['blocked']:
+                    st.warning(reason)
+                st.caption('Cleanup is blocked for this item. Nothing will be deleted.')
+                continue
+            st.info(f"Would free {plan['reclaimable_bytes'] / 1024**3:.2f} GB. Kept: "
+                    + (', '.join(plan['kept_videos']) or 'none'))
+            st.dataframe([{'category': name, 'files': info['files'], 'MB': round(info['bytes'] / 1024**2, 1)}
+                          for name, info in sorted(plan['categories'].items())], hide_index=True)
+            confirmed = st.checkbox('I understand the listed media is removed and the final video is kept',
+                                    key='cleanup-confirm-' + digest_key + plan['digest'])
+            if st.button('Free space now', disabled=not confirmed, key='cleanup-apply-' + digest_key + plan['digest']):
+                try:
+                    report = pjc.apply_plan(row['path'], plan['digest'], kind=kind)
+                    st.session_state.pop(digest_key, None)
+                    st.success(f"Freed {report['freed_bytes'] / 1024**3:.2f} GB; removed {report['removed_count']} file(s).")
+                    for problem in report['errors']:
+                        st.error(f"Not removed: {problem['path']} ({problem['error']})")
+                except (OSError, ValueError) as error:
+                    st.error(str(error))
+
