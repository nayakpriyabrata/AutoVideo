+def test_tools_folder_ships_only_the_current_updater():
+    # A release folder (the zip carries RELEASE_MANIFEST.json) ships only the current updater. An installed copy keeps
+    # the updaters it already had, because updates never delete files, so only the current one is required there.
+    updaters = sorted(p.name for p in (ROOT / 'tools').glob('update_v*.py'))
+    assert 'update_v776_to_v777.py' in updaters
+    manifest = ROOT / 'RELEASE_MANIFEST.json'
+    if manifest.is_file() and json.loads(manifest.read_text(encoding='utf-8'))['version'] == (ROOT / 'VERSION').read_text(encoding='utf-8').strip():
+        assert updaters == ['update_v776_to_v777.py']
+
