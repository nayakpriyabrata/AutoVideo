+class ApprovalCardLimitReached(ValueError):
+    """A further credit card appeared for a request that is already approved (v7.0.105).
+
+    ``cards`` is how many cards were already reserved for this saved request. A caller must NOT click; it may
+    keep waiting for the request it already paid for.
