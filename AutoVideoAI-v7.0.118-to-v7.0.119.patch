+#!/usr/bin/env python3
+"""Apply the v7.0.119 update to a v7.0.118 installation.
+
+The field report after v7.0.118: "when I tried to recover it with queue and resume, i don't see the audio and
+completed steps, instead it is showing the last successful job details."
+
+Three separate things produced that Queue page. This release fixes all three; it renders, re-records and
+charges nothing, and it changes no saved job.
+
+1. Speech batches identify themselves. Every Create step 4 batch of the installation used to be rendered fully
+   expanded whenever no Active job was selected, each line reading only "Create step 4 · English, Hindi, Odia ·
+   ready" - no time, no topic. Now each line carries its exact time, its topic, its languages, its state and
+   where its voices ended up ("not part of any job yet", "voices in job <id>", or "saved in <job> · voices not
+   copied into the job yet"), the newest one is the one open, and the panel says in plain words that a batch is
+   not a job. The creation time is recorded once in batch.json (`created_at`) and preserved across a resume.
+
+2. A ready batch plays its audio. Before it showed only "tick 'reuse this exact batch'" - never the voices it
+   holds. It now shows one player per language with its length, plus the narration text of each language.
+
+3. Queue & Resume shows the job it opens. The completed step row (SCRIPT · VOICE · STORYBOARD · FLOW · QC ·
+   RENDER) is now in Queue above the monitor, and VOICE no longer means "narration/voice.mp3 exists": a job
+   whose narration came from a prepared batch keeps its voices in speech-editions/<language>/ and
+   production/prepared_speech.json, so the step showed a dash although the narration was there. The new
+   engine/narration_assets.py finds every voice a job holds, the step row names them, and a new Narration
+   section plays each one. With no Active job, Queue offers an "Open a saved job" picker.
+
+Usage (run from the existing installation folder, after extracting the 7.0.119 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.119-Queue-Narration-And-Steps/tools/update_v7118_to_v7119.py .            # dry run
+    python3 ../AutoVideoAI-v7.0.119-Queue-Narration-And-Steps/tools/update_v7118_to_v7119.py . --apply    # install
+
+Only code, documentation and tests are replaced. Outputs, saved jobs, speech batches, Flow journals, browser
+profiles and ``music_library/`` are never copied, moved or deleted. Stop the dashboard before --apply.
+"""
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = [
+    'VERSION', 'app.py',
+    'engine/speech_batches.py', 'engine/speech_cards.py', 'engine/narration_assets.py',
+    'tests/test_v7119_queue_narration_and_steps.py',
+    'QUEUE_NARRATION_AND_STEPS_V7_0_119.md', 'tools/update_v7118_to_v7119.py',
+]
+# Files as they exist in 7.0.118: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['4cc89575ac6c0616189c321827e79b8695532d36ee67227755dc81ec87f8f4c4'],
+    'app.py': ['89f839abf87866371babc22c990bbddef001fcee1aab73d9993c9e29ba251445'],
+    'engine/speech_batches.py': ['6ead501d7e8ab0bd20eb98db8a391a1594fc4517c929e8ad8f7344b18faf9de0'],
+    'engine/speech_cards.py': ['95755b11026b2fbaf230ea00da56993b4fe4215159f18319d609cdb861bb0fdf'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.118', '7.0.119')  # 7.0.119 allows a safe re-run after success
+
+# The 7.0.119 zip carries the 7.0.118 update; apply that first on an older installation.
+EARLIER_STEPS = [
+    ('7.0.117', '7.0.118', 'tools/update_v7117_to_v7118.py'),
+]
+
+
+def chain_message(current, version):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.118 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.118 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.118 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this ' + version + ' update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current, source.name or '7.0.119'))
+    new_version = (source / 'VERSION').read_text(encoding='utf-8').strip()
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the ' + new_version +
+                         ' folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        allowed = ALLOWED.get(name, [])
+        if destination.exists() and allowed and sha(destination) not in allowed + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+        if destination.exists() and not allowed and sha(destination) != expected[name]:
+            # A file this release introduces (engine/narration_assets.py) must not overwrite a different file
+            # that already sits at that path - the same promise as for an edited file, applied to a new one.
+            raise ValueError('A different file already exists where this update installs ' + name +
+                             '; preserved it and changed nothing. Move it aside and run the update again.')
+    plan = {'target': str(target), 'installed_version': current, 'new_version': new_version,
+            'apply': args.apply, 'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every ' + new_version + ' code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v' + current + '-to-v' + new_version + '-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to ' + new_version + '. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat), then check the install with:')
+        print('    python3 cli.py v3 self-check')
+        print('In Queue & Resume, pick the job in "Active job" (or the new "Open a saved job" list): the step row '
+              'shows what is done, the Narration section plays the saved voices, and Speech batches now say when '
+              'each batch was made, for which topic, and whether a job already holds its voices. Nothing was '
+              're-rendered, no voice was re-recorded and no Flow credit was spent.')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
+        raise SystemExit(1)
