+def test_clip_inventory_names_every_category(clip_folder):
+    report = clip_cleanup.folder_inventory(clip_folder)
+    assert report['is_clip_output'] is True and report['running'] is False
+    keys = [row['key'] for row in report['categories']]
+    assert keys == ['work', 'render_state', 'history', 'reviews', 'clips']
+    work = next(row for row in report['categories'] if row['key'] == 'work')
+    assert work['bytes'] == 10000
