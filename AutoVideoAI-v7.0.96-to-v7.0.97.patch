+def test_an_unresolved_flow_request_still_blocks_deletion(outputs, no_ffprobe):
+    job = _completed_job(outputs, 'job-pending-request', 'job-pending-request-final.mp4')
+    (job / 'storyboard').mkdir()
+    (job / 'storyboard' / 'shot_001_open.jpg.flow-request.json').write_text(
+        json.dumps({'status': 'pending', 'phase': 'submitted'}))
+    preview = completed_job_delete(outputs, outputs.parent / 'jobs.db', job.name, allow_missing_final=True)
+    assert preview['eligible'] is False
