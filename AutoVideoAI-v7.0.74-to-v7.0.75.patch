+def anchor_series(draft, words, duration):
+    """Validate the educational points series. Returns None when the draft has no series."""
+    series = draft.get('series') if isinstance(draft, dict) else None
+    if not series:
+        return None
+    if not isinstance(series, dict):
+        raise ValueError('The points series must be an object')
+    title = series.get('title')
+    if not isinstance(title, str) or not 1 <= len(title.strip()) <= MAX_POINT_CHARS or '\n' in title:
+        raise ValueError(f'The series title must be one line of at most {MAX_POINT_CHARS} characters')
+    points = series.get('points')
+    if not isinstance(points, list) or not MIN_POINTS <= len(points) <= MAX_POINTS:
+        raise ValueError(f'A points series needs {MIN_POINTS} to {MAX_POINTS} points')
+    rows, previous_end = [], -1.0
+    for point in points:
+        if not isinstance(point, dict):
+            raise ValueError('Each point must be an object')
+        first, last = _word_span(point, words)
+        text = point.get('text')
+        if not isinstance(text, str) or not 1 <= len(text.strip()) <= MAX_POINT_CHARS or '\n' in text:
+            raise ValueError(f'Each point must be one short line of at most {MAX_POINT_CHARS} characters')
+        start = float(words[first]['start'])
+        end = max(float(words[last]['end']), start + SERIES_MIN_SECONDS)
+        if start < previous_end - .05:
+            raise ValueError('Series points overlap or are out of spoken order')
+        previous_end = end
+        rows.append({'text': text.strip(), 'start_word': first, 'end_word': last,
+                     'start': round(start, 3), 'end': round(min(end, duration), 3)})
+    if rows[0]['start'] > duration * .25 or rows[-1]['end'] < duration * .70:
+        raise ValueError('The points must cover the whole video: start in the first quarter and end after 70%')
+    return {'title': title.strip(), 'points': rows,
+            'start': rows[0]['start'], 'end': round(min(duration, rows[-1]['end'] + SERIES_HOLD_SECONDS), 3)}
+
+
+def series_segments(series):
+    """Each point owns the time from its start until the next point starts."""
+    out = []
+    points = series['points']
+    for i, point in enumerate(points):
+        end = points[i+1]['start'] if i + 1 < len(points) else series['end']
+        out.append({'index': i, 'count': len(points), 'title': series['title'], 'text': point['text'],
+                    'points': points, 'start': point['start'], 'end': round(end, 3)})
+    return out
+
+
+def _overlaps(card, series):
+    return card['start'] < series['end'] and series['start'] < card['end']
+
+
+def _series_record(series):
+    """Compact, re-validatable form saved in speech_cards.json."""
+    return {'title': series['title'], 'points': [{'text': p['text'], 'start_word': p['start_word'],
+                                                 'end_word': p['end_word']} for p in series['points']]}
+
+
