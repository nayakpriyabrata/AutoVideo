+
+def wait_decision(confirmation) -> str:
+    """What a generation wait does after one approval probe (v7.0.105).
+
+    ``'continue'``     nothing blocked; keep the normal loop
+    ``'keep_waiting'`` a further card appeared for a request that was already approved: never click it, and keep
+                       waiting for the video that was paid for
+    ``'stop'``         the wait must end; no card was approved, so nothing was submitted
+    """
+    confirm = confirmation or {}
+    if not confirm.get('blocked'):
+        return 'continue'
+    if confirm.get('card_limit_reached') and int(confirm.get('approved_cards') or 0) >= 1:
+        return 'keep_waiting'
+    return 'stop'
+
