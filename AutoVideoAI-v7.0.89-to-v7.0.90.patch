diff -ruN -x RELEASE_MANIFEST.json -x '*.pyc' -x __pycache__ -x code-update-backups a/tests/test_v790_reference_tile_recovery.py b/tests/test_v790_reference_tile_recovery.py
--- a/tests/test_v790_reference_tile_recovery.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_v790_reference_tile_recovery.py	2026-10-25 04:52:48.588011220 +0000
@@ -0,0 +1,152 @@
+"""v7.0.90: a saved image request whose uploaded references re-appear as project tiles.
+
+Field case (shot_020, 2026-10-25): after the project reopened, both uploaded references
+(location_master and character-aradhya) were listed as new tiles under new URLs. The pre-submit
+baseline did not match them, the generation wait treated them as fresh output and gave up after
+30 s ("Multiple distinct images require exact request correlation"). Recovery then never reached
+the exact classifier. Recovery must classify the references by checksum, exclude them from the
+wait, and commit exactly one non-reference image. Two real outputs must stay blocked.
+No test here submits a prompt or spends generation credits.
+"""
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+from PIL import Image
+
+from engine import flow_image_transaction as tx
+from engine.providers import flow_browser
+from engine.providers.flow_browser import FlowBrowser, FlowRequestPending
+
+PROJECT = 'https://flow.google.com/project/bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb'
+
+
+def picture(path, color):
+    Image.new('RGB', (128, 96), color).save(path)
+    return str(path)
+
+
+class Bridge:
+    normalize_project_url = staticmethod(FlowBrowser.normalize_project_url)
+
+    def __init__(self, refs, generated):
+        self.refs = refs            # tile signature -> file served for that tile
+        self.generated = generated  # file served for any other tile
+        self.assets = list(refs)
+        self.project = PROJECT
+        self.wait_calls = []
+        self.generation_finishes = None  # signatures appended when the wait runs
+        self.downloads = []
+
+    def current_project_url(self): return self.project
+    def ensure_project(self, *a, **k): self.project = k.get('project_url') or PROJECT
+    def media_assets(self): return [{'kind': 'image', 'sig': x} for x in self.assets]
+
+    def download_latest_asset(self, path, preferred_signature, **kw):
+        self.downloads.append(preferred_signature)
+        source = self.refs.get(preferred_signature, self.generated)
+        Path(path).write_bytes(Path(source).read_bytes())
+
+    def wait_for_agent_generation(self, **kw):
+        self.wait_calls.append(kw)
+        if self.generation_finishes:
+            self.assets = self.assets + list(self.generation_finishes)
+            self.generation_finishes = None
+        return True
+
+
+class Provider:
+    def __init__(self, bridge): self.bridge = bridge
+    def _ensure(self): return self.bridge
+    def close(self): pass
+
+
+@pytest.fixture
+def case(tmp_path):
+    r1 = picture(tmp_path / 'location_master.jpg', 'red')
+    r2 = picture(tmp_path / 'character.png', 'blue')
+    generated = picture(tmp_path / 'scene.jpg', 'green')
+    output = tmp_path / 'shot_020_open.jpg'
+    refs = {'tile-location': r1, 'tile-character': r2}
+    request = {'schema_version': 1, 'scope': tx.SCOPE, 'kind': 'image', 'status': 'pending',
+               'phase': 'submission_uncertain', 'project_url': PROJECT, 'project_name': 'AutoVideo-Image-test',
+               'reference_hashes': {r1: tx.sha(r1), r2: tx.sha(r2)},
+               'baseline': ['old-location', 'old-character'], 'signature': '', 'submitted_prompt': 'x'}
+    return output, refs, generated, request
+
+
+def test_known_references_come_only_from_checked_probes_of_this_project(case):
+    _, _, _, request = case
+    request['capture_probes'] = {
+        'a': {'project_url': PROJECT, 'signature': 'tile-location', 'reference': '/refs/location_master.jpg'},
+        'b': {'project_url': PROJECT, 'signature': 'tile-generated', 'reference': None},
+        'c': {'project_url': 'https://flow.google.com/project/other', 'signature': 'tile-other', 'reference': '/refs/x.jpg'},
+    }
+    assert tx.known_reference_signatures(request) == {'tile-location'}
+    assert 'old-location' in tx.wait_baseline(request) and 'tile-location' in tx.wait_baseline(request)
+    assert 'tile-generated' not in tx.wait_baseline(request)
+
+
+def test_recovery_classifies_references_then_commits_the_one_real_output(case):
+    output, refs, generated, request = case
+    bridge = Bridge(refs, generated)
+    bridge.generation_finishes = ['tile-generated']  # appears while the wait runs
+    tx.recover(Provider(bridge), request, output, compiled={})
+    assert tx.completed(output, request)
+    assert output.read_bytes() == Path(generated).read_bytes()
+    # The first wait saw both references as already classified, and the transactional hand-off was requested.
+    assert len(bridge.wait_calls) == 1
+    assert bridge.wait_calls[0]['transactional_images'] is True
+    assert {'old-location', 'old-character'} | {'tile-location', 'tile-character'} <= set(bridge.wait_calls[0]['before_assets'])
+    assert request['signature'] == 'tile-generated'
+
+
+def test_two_real_outputs_stay_blocked_and_no_file_is_written(case):
+    output, refs, generated, request = case
+    bridge = Bridge(refs, generated)
+    bridge.assets = list(refs) + ['tile-generated-a', 'tile-generated-b']
+    bridge.refs.update({'tile-generated-a': generated, 'tile-generated-b': generated})
+    with pytest.raises(FlowRequestPending):
+        tx.recover(Provider(bridge), request, output, compiled={})
+    assert not output.exists()
+    assert not tx.completed(output, request)
+
+
+def test_a_generation_wait_that_sees_only_references_does_not_commit(case):
+    output, refs, generated, request = case
+    bridge = Bridge(refs, generated)  # nothing new was generated
+    with pytest.raises(FlowRequestPending):
+        tx.recover(Provider(bridge), request, output, compiled={})
+    assert not output.exists()
+
+
+class _Clock:
+    def __init__(self): self.now = 10_000.0
+    def time(self): return self.now
+    def advance(self, seconds): self.now += seconds
+
+
+def _waiter(clock, assets):
+    b = FlowBrowser.__new__(FlowBrowser)
+    b.ui = {'actions': {}, 'timeouts': {'generation': 300, 'poll_interval': 8}}
+    b._page = SimpleNamespace(inner_text=lambda selector: 'Done',
+                              wait_for_timeout=lambda ms: clock.advance(ms / 1000.0))
+    b.detect_failure = lambda: None
+    b.detect_service_busy = lambda: None
+    b.media_assets = lambda: [{'kind': 'image', 'sig': s} for s in assets]
+    return b
+
+
+def test_waiter_hands_over_stable_candidates_only_for_the_transaction(monkeypatch):
+    clock = _Clock()
+    monkeypatch.setattr(flow_browser.time, 'time', clock.time)
+    assets = ['tile-location', 'tile-character']
+    handed_over = _waiter(clock, assets).wait_for_agent_generation(
+        before_assets=set(), timeout_s=300, required_kind='image', transactional_images=True)
+    assert handed_over is True
+
+    clock = _Clock()
+    monkeypatch.setattr(flow_browser.time, 'time', clock.time)
+    legacy = _waiter(clock, assets)
+    assert legacy.wait_for_agent_generation(before_assets=set(), timeout_s=300, required_kind='image') is False
+    assert legacy.last_agent_failure == 'Multiple distinct images require exact request correlation'
