+#!/usr/bin/env python3
+"""Apply the v7.0.107 update to a v7.0.106 installation.
+
+Three field problems from one three-language job:
+
+1. **A 30% longer Odia narration produced no video.** The edition render only allowed the picture to be slowed
+   by 25% and then refused with one line that stated neither the overrun nor any way out. A narration is now
+   fitted by bounded retiming (picture up to 1.25x, pitch-preserving narration speed up to 1.12x, optional
+   cloned last frame), word timings follow the narration speed, and anything beyond the budget is refused with
+   the seconds, the ratio, the number of words to cut and the exact flags that would accept it.
+2. **Cards and hooks were missing or unconvincing.** Hooks and speech cards default to on; reviewed speech cards
+   are used for every language edition (not only educational videos); plain cards are drawn as real animated
+   pop-ups instead of static lower-third strips; editions keep their own card kind and palette; a failed card
+   draft no longer kills the render. Every render writes ``production/graphics_audit.json`` explaining what was
+   requested, prepared and placed, and ``graphics-audit --check`` proves from the finished file whether each
+   card is visible.
+3. **The music did not drop under speech.** The bed is ducked ~13 dB (12:1) with a 15 ms attack and 550 ms
+   release, fades in and out with the video length, effects sit at 0.65x, and editions are normalised to
+   -14 LUFS. ``cli.py v3 tune`` adjusts all of it without spending credits.
+
+Plus a curated royalty-free music guide (``docs/MUSIC_LIBRARY.md``) with ``music-suggest`` and ``music-check``.
+
+Nothing is generated, rendered or charged by this update itself.
+
+Usage (run from the existing installation folder, after extracting the 7.0.107 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.107/tools/update_v7106_to_v7107.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.107/tools/update_v7106_to_v7107.py . --apply    # installs the code
+
+Only code and documentation are replaced. Outputs, saved jobs, Flow journals, browser profiles and
+``music_library/`` are never copied, moved or deleted. Stop the dashboard before --apply.
+"""
+
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = [
+    'VERSION', 'app.py', 'cli.py',
+    'engine/factory.py', 'engine/finishing_studio.py', 'engine/language_editions.py', 'engine/speech_cards.py',
+    'engine/render/ffmpeg_renderer.py', 'engine/render/educational_cards.py', 'engine/studio_config.py',
+    'tools/build_release.py',
+    # new in 7.0.107
+    'engine/narration_fit.py', 'engine/graphics_audit.py', 'engine/render/graphic_visibility.py',
+    'engine/audio/music_catalog.py', 'docs/MUSIC_LIBRARY.md',
+    'tests/test_v7107_fit_cards_music.py', 'tests/test_v768_language_editions_render.py',
+    'tests/test_v774_educational_cards.py', 'tests/test_v776_hooks.py',
+    'NARRATION_FIT_CARDS_AND_MUSIC_V7_0_107.md', 'tools/update_v7106_to_v7107.py',
+]
+# Files as they exist in 7.0.106: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['67e44222f8fd091c4c50137e42e63fb8eb8352a62191439773a2c98bcd2e4c6f'],
+    'app.py': ['f0205cdbafdbe17c2a703ecb876beb44866479e34c94df66549cd1795db0c738'],
+    'cli.py': ['270a986484693bc88ce223eb3b3708cc9b6a092c6690e9c0b68793c58df38c3a'],
+    'engine/factory.py': ['b290d6121cfbc5d34c8aecfd59c353a56ee36b1f0fb6763ffd9879ac28077fde'],
+    'engine/finishing_studio.py': ['de583f869e2419c3ad583bc245145be9ef22c7ec78b413768f1c998180682032'],
+    'engine/language_editions.py': ['2c75676748358f1e43830d3c2907c7c9f15392606d109668ed034811fe10ad4b'],
+    'engine/render/educational_cards.py': ['061d5400abf011aac692126d6446046d4cbd5e9b52dc8b5984cff27cef38194d'],
+    'engine/render/ffmpeg_renderer.py': ['0c1ab0c0bc784d707c276e0d72cebf82e682a52cc0f21b396a62507bfd7816fa'],
+    'engine/speech_cards.py': ['8bc73052097fcd4086f11c974daefc4d1d4663de7ef3720fc5a997cb9d23492e'],
+    'engine/studio_config.py': ['8058025a234f1654798dcd225bedf7c1e46e1c480a305b414b8db273c87440eb'],
+    'tools/build_release.py': ['92923e9433f401a9e36c655fbab0a993b6b747fe76c8f187cfd7d85da4b22f41'],
+    'tests/test_v768_language_editions_render.py': ['30b8da8eb7f87975b1c7277934a0cc6b0086993c4435a6eae16bdb8d39bcd9ae'],
+    'tests/test_v774_educational_cards.py': ['22f46d0fb9beafbd3b9146aefa91cb1385f2a17999525d04c7ce055faf739be4'],
+    'tests/test_v776_hooks.py': ['de7973e2772a58aff068d12fefc257d60278f50523bdede4667c3c9f87b45719'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.106', '7.0.107')  # 7.0.107 allows a safe re-run after success
+
+# The 7.0.106 zip carries the 7.0.105 to 7.0.106 update; apply that first on an older installation.
+EARLIER_STEPS = [
+    ('7.0.105', '7.0.106', 'tools/update_v7105_to_v7106.py'),
+]
+
+
+def chain_message(current, version):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.106 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.106 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.106 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this ' + version + ' update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current, source.name or '7.0.107'))
+    new_version = (source / 'VERSION').read_text(encoding='utf-8').strip()
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the ' + new_version +
+                         ' folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        allowed = ALLOWED.get(name, [])
+        if destination.exists() and allowed and sha(destination) not in allowed + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+    plan = {'target': str(target), 'installed_version': current, 'new_version': new_version,
+            'apply': args.apply, 'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every ' + new_version + ' code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v' + current + '-to-v' + new_version + '-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to ' + new_version + '. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat).')
+        print('Nothing was re-rendered and no Flow credit was spent. Existing jobs keep their saved takes.')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
+        raise SystemExit(1)
