@@ -154,6 +154,46 @@ def job_audio_shas(job_dir) -> set:
     return shas
 
 
+def job_stage(job_dir) -> dict:
+    """What a saved job already has, so a stopped TTS run can be judged against it (v7.0.121)."""
+    root = Path(job_dir)
+    try:
+        manifest = json.loads((root / 'production_manifest.json').read_text(encoding='utf-8'))
+    except (OSError, ValueError):
+        manifest = {}
+    from . import narration_assets
+    voices = narration_assets.voices(root)
+    return {'status': str(manifest.get('status') or ''),
+            'shots': len(manifest.get('shots') or []),
+            'narrated': bool(voices), 'voices': [row['label'] for row in voices],
+            'prepared': (root / 'production' / 'prepared_speech.json').is_file()}
+
+
+def stale_reason(row, job_dirs=()) -> str:
+    """Why this stopped batch is no longer on the way to a video, or '' when it still is.
+
+    A Create step 4 batch that stopped during TTS and lives inside a job is listed for ever otherwise: the
+    job can finish with other voices (or its own narration), and the abandoned run keeps asking to be resumed.
+    Nothing is deleted - the batch is only described truthfully and moved out of the to-do list.
+    """
+    origin = str(row.get('origin') or '')
+    if not origin.startswith('Job ') or row.get('ready'):
+        return ''
+    job_id = origin[4:]
+    folder = next((Path(job) for job in job_dirs if Path(job).name == job_id), None)
+    if folder is None or not folder.is_dir():
+        return ''
+    stage = job_stage(folder)
+    if stage['shots'] or stage['status'] in ('narrated', 'planned', 'generating', 'review', 'rendering', 'done'):
+        narrated = (' Its narration is already saved (' + ' · '.join(stage['voices']) + ').'
+                    if stage['narrated'] else '')
+        return ('This job is already past narration (status "' + (stage['status'] or 'planned') + '", '
+                + str(stage['shots']) + ' scene(s) planned).' + narrated + ' This stopped TTS run is not needed '
+                'to resume the job; it is kept here, nothing was deleted. Use “Resume / continue job” on the job '
+                'itself.')
+    return ''
+
+
 def with_attachments(rows, job_dirs=()) -> list[dict]:
     """Say which job (if any) already contains each batch's voices (v7.0.119).
 
@@ -175,9 +215,22 @@ def with_attachments(rows, job_dirs=()) -> list[dict]:
             attached |= owners.get(sha, set())
         row['attached_to'] = sorted(attached)
         row['attached'] = bool(attached)
+        row['stale_reason'] = stale_reason(row, job_dirs)
+        row['stale'] = bool(row['stale_reason'])
     return rows
 
 
+def actionable(rows) -> list[dict]:
+    """Batches that are still the way to a video: ready to use, or stopped for a reason worth fixing."""
+    return [row for row in rows or [] if not row.get('stale')]
+
+
+def usable_now(rows) -> list[dict]:
+    """Ready batches whose voices no job holds yet, newest first: the ones a job can be made from."""
+    ready = [row for row in rows or [] if row.get('ready') and not row.get('attached') and not row.get('stale')]
+    return sorted(ready, key=lambda row: -(row.get('created_ts') or 0))
+
+
 def display_label(row, *, newest=False) -> str:
     """One identifying line for a batch: time, topic, languages, state, and whether a job holds it."""
     parts = [row.get('origin') or 'Create step 4', row.get('created') or 'time not recorded']
