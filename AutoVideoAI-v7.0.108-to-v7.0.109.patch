+def test_the_logo_is_a_separate_overlay_that_spans_the_video(tmp_path):
+    from engine.render.graphics import OverlayEvent, render_overlay_png
+    from PIL import Image
+    logo = tmp_path / 'logo.png'
+    Image.new('RGBA', (160, 160), (255, 0, 0, 255)).save(logo)
+    badge = tmp_path / 'badge.png'
+    badge_logo = tmp_path / 'badge-logo.png'
+    render_overlay_png(OverlayEvent('watermark', 0, 10, 'Odia Pragati'), str(badge), 1280, 720, style='playful')
+    render_overlay_png(OverlayEvent('logo', 0, 10, '', ''), str(badge_logo), 1280, 720, logo_path=str(logo))
+    with Image.open(badge) as b, Image.open(badge_logo) as l:
+        assert b.getpixel((5, 5))[3] == 0                     # the badge PNG stays transparent outside the pill
+        assert l.getpixel((5, 5))[3] == 0                     # the logo PNG only paints the corner
+        assert l.getpixel((l.width - 60, l.height - 60))[:3] == (255, 0, 0)   # logo is bottom-right
+    assert badge.read_bytes() != badge_logo.read_bytes()
