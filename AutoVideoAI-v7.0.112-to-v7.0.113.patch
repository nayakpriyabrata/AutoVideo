+#!/usr/bin/env python3
+"""Apply the v7.0.113 update to a v7.0.112 installation.
+
+One field report, traced to its cause:
+
+* **"The Odia video still has the transcript, in language_editions and in render."** v7.0.112 added a picture check,
+  and it agreed with the report: the current export really does carry burned captions although the job asks for
+  none. The cause is one line - when a narration is longer than the picture, the render fits it, and then handed
+  the retimed word file to the caption stage unconditionally. A language whose transcript was switched off got its
+  captions back the moment its narration had to be fitted. Every language needing a fit was affected from 7.0.107
+  (when fitting landed) to 7.0.112.
+
+v7.0.113 does four things:
+
+1. **The fit step only decides about timing.** Captions are burned when the job asks for them, and not otherwise.
+2. **A plain render repairs the job.** A language whose current export shows a transcript while the job asks for
+   none is treated as out of date, rendered again (that language only), and the earlier file is kept.
+3. **No repair loop.** If a fresh render still disagrees, the file is kept, marked, and explained - it is not
+   rendered again for ever.
+4. **The messages name the cause**, instead of asking you to re-check the switch you already checked.
+
+Nothing is generated, re-recorded or charged by this update, and the repair itself re-records nothing either: it
+reuses the saved narration and the approved picture.
+
+Usage (run from the existing installation folder, after extracting the 7.0.113 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.113/tools/update_v7112_to_v7113.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.113/tools/update_v7112_to_v7113.py . --apply    # installs the code
+
+Only code, documentation and tests are replaced. Outputs, saved jobs, Flow journals, browser profiles and
+``music_library/`` are never copied, moved or deleted. Stop the dashboard before --apply.
+
+(v7.0.113 also corrects the first line of the 7.0.112 updater's own description, which still said 7.0.111; the
+update itself behaved correctly.)
+"""
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = [
+    'VERSION', 'cli.py',
+    'engine/finishing_studio.py', 'engine/language_editions.py', 'engine/edition_files.py',
+    'engine/render/caption_check.py',
+    'tests/test_v7113_fit_captions_repair.py', 'tests/test_v7112_card_band_and_picture_check.py',
+    'FIT_CAPTIONS_AND_REPAIR_V7_0_113.md', 'tools/update_v7112_to_v7113.py',
+]
+# Files as they exist in 7.0.110: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['ea5b506226f6439c37c835e00b7e801fced56093374b03ff5e7922b963ddd9d6'],
+    'cli.py': ['704deada71d8ede4ada180aff4ccc07831bc7b2220516f106e0e95c0f2032d03'],
+    'engine/finishing_studio.py': ['f014d64d5413b71f760c5ec3b57d1ad2ccc4097df140185963b87ad67e760179'],
+    'engine/language_editions.py': ['3814db96520bff5464f093a3fdd066b9f8d3f3c638e4c8dc824c1f964726e195'],
+    'engine/edition_files.py': ['550abc371c869ec68d4e85e20ec30f01d1ced7810eb3e8b761db898bc3210594'],
+    'engine/render/caption_check.py': ['3d101ec50f16c055258e13d62281af79926213783a02ede66e2929b2c2da7206'],
+    'tests/test_v7112_card_band_and_picture_check.py': ['19d9a48ef28f60bed09f886fe694616175bc9bc633c84d080bd022a8a94f0633'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.112', '7.0.113')  # 7.0.113 allows a safe re-run after success
+
+# The 7.0.113 zip carries the 7.0.112 update; apply that first on an older installation.
+EARLIER_STEPS = [
+    ('7.0.111', '7.0.112', 'tools/update_v7111_to_v7112.py'),
+]
+
+
+def chain_message(current, version):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.112 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.112 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.112 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this ' + version + ' update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current, source.name or '7.0.113'))
+    new_version = (source / 'VERSION').read_text(encoding='utf-8').strip()
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the ' + new_version +
+                         ' folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        allowed = ALLOWED.get(name, [])
+        if destination.exists() and allowed and sha(destination) not in allowed + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+    plan = {'target': str(target), 'installed_version': current, 'new_version': new_version,
+            'apply': args.apply, 'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
