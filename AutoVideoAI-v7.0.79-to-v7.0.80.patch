+# 7.0.80: one request per sentence group. A 330-second Odia narration in one request timed out at 180 s
+# (the 7.0.79 run). Each part is cached on disk, so a retry redoes only the part that failed.
+GEMINI_TTS_CHUNK_CHARS = 1200
+GEMINI_TTS_TIMEOUT = (30, 240)        # (connect, read) seconds per part
+GEMINI_TTS_ATTEMPTS = 3
+GEMINI_TTS_RETRY_STATUS = {408, 429, 500, 502, 503, 504}
+
+
+def split_speech_text(text: str, limit: int = GEMINI_TTS_CHUNK_CHARS) -> list[str]:
+    """Split narration into parts of at most ``limit`` characters, on sentence ends where possible.
+
+    Sentence ends include the Devanagari/Odia danda (।) and the double danda (॥).
+    """
+    sentences = [s.strip() for s in re.split(r"(?<=[.!?।॥])\s+", str(text or "").strip()) if s.strip()]
+    parts: list[str] = []
+    current = ""
+    for sentence in sentences:
+        while len(sentence) > limit:  # no sentence end inside the limit: split on a space
+            cut = sentence.rfind(" ", 0, limit)
+            cut = cut if cut > 0 else limit
+            piece, sentence = sentence[:cut].strip(), sentence[cut:].strip()
+            if current:
+                parts.append(current)
+                current = ""
+            parts.append(piece)
+        if current and len(current) + 1 + len(sentence) > limit:
+            parts.append(current)
+            current = sentence
+        else:
+            current = (current + " " + sentence).strip()
+    if current:
+        parts.append(current)
+    return parts
+
