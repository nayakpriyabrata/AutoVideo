+def render_series(series: dict, path, width: int, height: int, style: str, active: int) -> dict:
+    """One frame of the points series with point ``active`` (zero-based) highlighted.
+
+    Points are numbered and wrapped; the font shrinks (never below 34 px at 1080 wide) so
+    up to eight points fit. The active point gets a soft highlight bar.
+    """
+    from .typography import resolve_style, PALETTES, draw_text
+    style = resolve_style(style)
+    palette = PALETTES[style]
+    img = Image.new("RGBA", (width, height), (0, 0, 0, 0))
+    d = ImageDraw.Draw(img)
+    vertical = height > width
+    scale = min(width, height) / 1080.0
+    left, top = int(width * .065), int(height * .12)
+    panel_w = int(width * (.80 if vertical else .70))
+    pad, stroke = max(12, int(28 * scale)), max(1, int(3 * scale))
+    gap = max(6, int(12 * scale))
+    _, title, rows, panel_h = _series_layout(d, series, width, height, style, palette, scale)
+    d.rounded_rectangle((left, top, left + panel_w, top + panel_h), radius=int(28 * scale),
+                        fill=palette["panel"], outline=(255, 255, 255, 65), width=max(1, int(2 * scale)))
+    boxes = []
+    y = top + pad
+    boxes.append(draw_text(d, title, (left + pad, y, left + panel_w - pad, y + title.height), palette["accent"]))
+    y += title.height + gap
+    for index, layout in enumerate(rows):
+        if index == active:
+            d.rounded_rectangle((left + pad // 2, y - gap // 3, left + panel_w - pad // 2, y + layout.height + gap // 3),
+                                radius=max(6, int(14 * scale)), fill=(255, 255, 255, 46))
+        color = palette["secondary"] if index == active else (255, 255, 255, 215)
+        boxes.append(draw_text(d, layout, (left + pad, y, left + panel_w - pad, y + layout.height), color))
+        y += layout.height + gap
+    Path(path).parent.mkdir(parents=True, exist_ok=True)
+    img.save(path)
+    return {"kind": "list", "path": str(path), "start": series["start"], "end": series["end"],
+            "title": series["title"], "opacity": 1, "anchor": "center", "fade_in": .18, "fade_out": .18,
+            "box": [left, top, panel_w, panel_h],
+            "layout": {"style": style, "font_sizes": [title.size] + [r.size for r in rows],
+                       "text_boxes": boxes, "canvas": [width, height], "active": active}}
 
 
