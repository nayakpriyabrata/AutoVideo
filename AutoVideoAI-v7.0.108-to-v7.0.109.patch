+def _edition_job(tmp_path, code='hi'):
+    """A finished production with the clean picture and one reviewed language narration."""
+    from engine import finishing_studio as finish
+    from engine.production import digest
+    job = tmp_path / 'job'
+    (job / 'render').mkdir(parents=True)
+    (job / 'production').mkdir()
+    picture = job / 'render' / 'visual-master.mp4'
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i',
+                    'testsrc2=size=640x360:rate=24', '-t', '3', '-an', '-c:v', 'libx264',
+                    '-pix_fmt', 'yuv420p', str(picture)], check=True)
+    (job / 'production' / 'visual_master.json').write_text(json.dumps(
+        {'path': str(picture), 'sha256': finish._hash(picture), 'duration': 3.0,
+         'contains': 'picture only'}), encoding='utf-8')
+    folder = job / 'speech-editions' / code / 'key'
+    folder.mkdir(parents=True)
+    voice = folder / 'voice.wav'
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i',
+                    'sine=frequency=660:sample_rate=44100', '-t', '3', '-c:a', 'pcm_s16le', str(voice)],
+                   check=True)
+    words = [{'word': w, 'start': i * 0.5, 'end': (i + 1) * 0.5}
+             for i, w in enumerate(['निजर', 'स्वास्थ्य', 'प्रति', 'ध्यान', 'दो', 'तीन'])]
+    words_path = folder / 'words.json'
+    words_path.write_text(json.dumps(words, ensure_ascii=False), encoding='utf-8')
+    bundle = {'audio': str(voice), 'audio_sha256': digest(voice), 'duration': 3.0, 'words': str(words_path),
+              'script': 'निजर स्वास्थ्य प्रति ध्यान दो तीन', 'language': code, 'timing_source': 'test',
+              'cards': [], 'text_cards': False}
+    (job / 'production' / 'language_editions.json').write_text(json.dumps(
+        {'source_language': 'en', 'editions': ['en', code], 'profiles': {code: None},
+         'prepare_audio': True, 'bundles': {code: bundle}}), encoding='utf-8')
+    return job
+
+
+@needs_ffmpeg
+def test_hindi_renders_with_its_transcript_by_default(tmp_path):
+    from engine.language_editions import render_job_editions
+    job = _edition_job(tmp_path)
+    first = render_job_editions(job)
+    assert first['status'] == 'exported', first
+    burned = Path(first['editions']['hi']['path'])
+    provenance = json.loads(burned.with_suffix('.provenance.json').read_text(encoding='utf-8'))
+    assert provenance['captions_burned'] is True
+    assert provenance['captions_from_reviewed_script'] is True
+    assert first['editions']['hi']['captions'] is True
+
+@needs_ffmpeg
+def test_switching_the_transcript_re_renders_only_that_language(tmp_path):
+    from engine.language_editions import render_job_editions, set_transcript
+    job = _edition_job(tmp_path)
+    render_job_editions(job)
+    silent = render_job_editions(job)     # nothing changed: no new export
+    assert silent['status'] == 'exported'
+    exports = sorted((job / 'language_editions').glob('*/exports/*.mp4'))
+    assert len(exports) == 1
+
+    set_transcript(job, languages={'hi': False})
+    again = render_job_editions(job)
+    assert again['status'] == 'exported', again
+    exports = sorted((job / 'language_editions').glob('*/exports/*.mp4'))
+    assert len(exports) == 2, 'the no-transcript version must be a new export, never an overwrite'
+    newest = Path(again['editions']['hi']['path'])
+    assert newest != exports[0]
+    provenance = json.loads(newest.with_suffix('.provenance.json').read_text(encoding='utf-8'))
+    assert provenance['captions_burned'] is False
+
+    set_transcript(job, languages={'hi': True})
+    back = render_job_editions(job)
+    assert back['status'] == 'exported', back
+    exports = sorted((job / 'language_editions').glob('*/exports/*.mp4'))
+    assert len(exports) == 3, 'putting the transcript back renders a third file and keeps the other two'
+    with_captions = json.loads(Path(back['editions']['hi']['path']).with_suffix('.provenance.json')
+                               .read_text(encoding='utf-8'))
+    assert with_captions['captions_burned'] is True
+    assert with_captions['captions_from_reviewed_script'] is True
