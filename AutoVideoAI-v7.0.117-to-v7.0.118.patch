@@ -0,0 +1,193 @@
+"""v7.0.118: "Create production" must not die, and the Gemini shots must be findable.
+
+The field failure was `TypeError: Factory.create_job() got an unexpected keyword argument
+'flow_auto_approve_video_requests'` on submit. `engine/studio_config.DEFAULTS` had grown the key in
+v7.0.106; `create_job()` never learned it, so the Streamlit form - the only caller that sends the
+whole config - was broken for every release from 7.0.106 to 7.0.117 while the CLI kept working.
+"""
+import inspect
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from engine import self_check, studio_config
+from engine.factory import Factory, job_setting_keys
+from engine.flow_approval_once import auto_allowed
+
+ROOT = Path(__file__).resolve().parent.parent
+
+
+def _studio_cfg(**overrides):
+    cfg = dict(studio_config.DEFAULTS)
+    cfg.update({"topic": "self-check topic", "production_mode": "youtube_pro",
+                "production_mode_engine": "youtube_pro", "theme": "motivational",
+                "duration": 360, "profile": "STORYBOARD_ECONOMY", "language": "en",
+                "aspect": "16:9", "video_type": "faceless_youtube"})
+    cfg.update(overrides)
+    return cfg
+
+
+def test_the_studio_form_sends_only_keywords_create_job_accepts():
+    """The exact regression: every DEFAULTS key reaches create_job as a keyword."""
+    kwargs = studio_config.config_to_factory_kwargs(_studio_cfg())
+    assert 'flow_auto_approve_video_requests' in kwargs
+    accepted = set(inspect.signature(Factory.create_job).parameters)
+    assert sorted(set(kwargs) - accepted) == []
+    assert self_check.create_job_mismatch() == []
+
+
+def test_a_new_studio_default_is_also_a_job_setting_the_engine_reads_back():
+    """The setting must survive into settings.json, or turning it off would do nothing."""
+    assert 'flow_auto_approve_video_requests' in job_setting_keys()
+
+
+@pytest.mark.parametrize('value,allowed', [(True, True), (None, True), (False, False)])
+def test_create_job_saves_the_automatic_approval_choice(tmp_path, monkeypatch, value, allowed):
+    monkeypatch.chdir(tmp_path)
+    factory = Factory()
+    kwargs = {} if value is None else {'flow_auto_approve_video_requests': value}
+    job = factory.create_job('A short test topic', profile='FLOW_ECONOMY', target_seconds=30,
+                             dry_run=True, **kwargs)
+    settings = factory._settings(job)
+    if value is None:
+        assert settings['flow_auto_approve_video_requests'] is None
+    else:
+        assert settings['flow_auto_approve_video_requests'] is value
+    allow, why = auto_allowed(settings)
+    assert allow is allowed, why
+
+
+def test_the_whole_studio_submit_path_creates_a_plan_only_job(tmp_path, monkeypatch):
+    """What the user did: fill the form, ask for "Create plan only", press the button."""
+    monkeypatch.chdir(tmp_path)
+    factory = Factory()
+    cfg = _studio_cfg(plan_only=True, flow_approval='once', flow_auto_approve_video_requests=True,
+                      flow_approval_cards=1, max_credits=300, gemini_video_count=2)
+    kwargs = studio_config.config_to_factory_kwargs(cfg)
+    job = factory.create_job(topic=cfg["topic"], video_type=cfg["video_type"],
+                             aspect=cfg["aspect"], **kwargs)
+    settings = factory._settings(job)
+    assert settings['flow_auto_approve_video_requests'] is True
+    assert settings['flow_approval'] == 'once'
+    assert settings['flow_approval_cards'] == 1
+    assert settings['gemini_video_count'] == 2
+
+
+def test_a_mixed_install_names_the_key_the_file_and_the_repair(tmp_path, monkeypatch):
+    """If app.py and engine/ ever disagree again, say so - do not raise a bare TypeError."""
+    def old_create_job(self, topic, video_type='shorts'):
+        return 'never reached'
+
+    monkeypatch.setattr(Factory, 'create_job', old_create_job)
+    with pytest.raises(ValueError) as error:
+        studio_config.config_to_factory_kwargs(_studio_cfg())
+    text = str(error.value)
+    assert 'flow_auto_approve_video_requests' in text
+    assert 'Nothing was created' in text
+    assert 'python3 cli.py v3 self-check' in text
+    assert not text.startswith('create_job() got an unexpected keyword argument')
+
+
+def test_self_check_turns_a_mixed_install_into_a_failing_row(monkeypatch):
+    def old_create_job(self, topic):
+        return 'never reached'
+
+    monkeypatch.setattr(Factory, 'create_job', old_create_job)
+    report = self_check.rows()
+    row = next(item for item in report if item['check'] == 'Studio ↔ create_job keywords')
+    assert row['ok'] is False
+    assert 'flow_auto_approve_video_requests' in row['detail']
+    assert row['repair']
+    rendered = self_check.format_report(report)
+    assert 'FAIL' in rendered and 'repair:' in rendered
+
+
+def test_self_check_passes_on_this_tree():
+    assert self_check.create_job_mismatch() == []
+
+
+def test_the_gemini_video_control_is_a_visible_section_not_a_collapsed_cleanup_option():
+    source = (ROOT / 'app.py').read_text(encoding='utf-8')
+    assert "st.subheader('3b · AI video shots · Flow or Gemini Web')" in source
+    start = source.index("st.subheader('3b · AI video shots")
+    end = source.index("with st.expander('Gemini project cleanup · optional'", start)
+    block = source[start:end]
+    assert "'Gemini Web AI video shots (0-4)'" in block
+    assert 'expanded=False' not in block          # the old control was collapsed
+    assert "st.expander('Gemini video and project cleanup'" not in source
+    assert "key='studio-gemini-video-count'" in block
+    # and the choice is saved in the job, not only in the widget
+    assert '"gemini_video_count": int(gemini_video_count)' in source
+
+
+def test_the_create_success_message_says_where_the_gemini_shots_are_chosen():
+    source = (ROOT / 'app.py').read_text(encoding='utf-8')
+    created = source.index('st.success(f"Job created: `{job_id}`")')
+    following = source[created:created + 900]
+    assert 'Gemini Web is set for up to' in following
+    assert 'Gemini Web video shots' in following
+
+
+def test_the_approval_switch_is_visible_in_create_and_saved_in_the_job():
+    source = (ROOT / 'app.py').read_text(encoding='utf-8')
+    assert "Approve each saved Flow video request once, automatically" in source
+    assert '"flow_auto_approve_video_requests": bool(flow_auto_approve_video_requests)' in source
+
+
+def test_cli_has_the_switch_and_the_self_check_command():
+    help_text = subprocess.run([sys.executable, 'cli.py', 'v3', 'create', '--help'],
+                               cwd=str(ROOT), capture_output=True, text=True, timeout=120)
+    assert help_text.returncode == 0, help_text.stderr
+    assert '--no-auto-approve-flow-videos' in help_text.stdout
+    run = subprocess.run([sys.executable, 'cli.py', 'v3', 'self-check'],
+                         cwd=str(ROOT), capture_output=True, text=True, timeout=180)
+    assert run.returncode == 0, run.stdout + run.stderr
+    assert 'All checks passed.' in run.stdout
+    assert 'Studio ↔ create_job keywords' in run.stdout
+
+
+def test_the_gemini_cap_can_be_changed_on_a_saved_job(tmp_path, monkeypatch):
+    """A saved job that said 0 used to stay at 0 with no way to change it."""
+    from engine.providers.gemini_video import set_count
+
+    monkeypatch.chdir(tmp_path)
+    factory = Factory()
+    job = factory.create_job('A saved job with no Gemini shots', profile='FLOW_ECONOMY',
+                             target_seconds=30, dry_run=True)
+    job_dir = Path(factory.pm.job_dir(job))
+    assert factory._settings(job)['gemini_video_count'] == 0
+    assert set_count(job_dir, 3) == 3
+    assert factory._settings(job)['gemini_video_count'] == 3
+    with pytest.raises(ValueError) as error:
+        set_count(job_dir, 5)
+    assert 'zero to four' in str(error.value)
+    assert factory._settings(job)['gemini_video_count'] == 3      # a refused change changes nothing
+
+
+def test_the_picker_panel_offers_the_cap_and_describes_a_job_without_a_storyboard(tmp_path, monkeypatch):
+    source = (ROOT / 'app.py').read_text(encoding='utf-8')
+    assert "'Gemini Web shots this job may use (0-4)'" in source
+    assert 'Save the Gemini cap for this job' in source
+    assert 'This job has no storyboard yet, so there are no shots to choose between' in source
+    # the old, false explanation for an empty storyboard must be gone
+    assert "No shot is eligible for Gemini in this job: every Flow shot has an accepted take" in source
+    panel = source[source.index('def gemini_shot_panel'):source.index('def graphics_audit_panel')]
+    no_shots = panel.index("if not plan['shots']:")
+    all_ineligible = panel.index('No shot is eligible for Gemini in this job')
+    assert no_shots < all_ineligible
+
+
+def test_cli_changes_the_cap_of_a_saved_job(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    factory = Factory()
+    job = factory.create_job('A job for the cli cap', profile='FLOW_ECONOMY', target_seconds=30,
+                             dry_run=True)
+    run = subprocess.run([sys.executable, str(ROOT / 'cli.py'), 'v3', 'gemini-shots', job,
+                          '--count', '2'], cwd=str(tmp_path), capture_output=True, text=True,
+                         timeout=180)
+    assert run.returncode == 0, run.stdout + run.stderr
+    assert 'Gemini cap for this job: 2 shot(s)' in run.stdout
+    assert factory._settings(job)['gemini_video_count'] == 2
