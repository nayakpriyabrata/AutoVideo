+def test_a_saved_choice_wins_and_can_be_switched_back(tmp_path):
+    from engine.language_editions import set_transcript, transcript_plan
+    job = _state_job(tmp_path)
+    assert set_transcript(job, languages={'or': True}) == {'default': True, 'languages': {'or': True}}
+    assert transcript_plan(job)['editions'] == {'hi': True, 'or': True}
+    # Switching every language off, then turning Hindi back on, leaves Odia off.
+    set_transcript(job, default=False)
+    assert transcript_plan(job)['editions'] == {'hi': False, 'or': False}
+    set_transcript(job, languages={'hi': True})
+    assert transcript_plan(job)['editions'] == {'hi': True, 'or': False}
