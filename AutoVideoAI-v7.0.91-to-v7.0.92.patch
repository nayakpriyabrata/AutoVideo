+#!/usr/bin/env python3
+"""Apply the v7.0.92 update (a stalled Flow image request stops after one generation wait with an explicit
+reason; uploaded references are recognised by their AV_ tile label and never downloaded, including for
+journals written before the label existed; `cli.py v3 archive-request` archives an unresolved request so one
+explicit new submission can be approved; the blocked-Resume message names that command) to a v7.0.91
+installation. Nothing is submitted, generated or charged by this update itself.
+
+Usage (run from the existing installation folder, after extracting the 7.0.92 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.92/tools/update_v791_to_v792.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.92/tools/update_v791_to_v792.py . --apply    # installs the code
+
+Only code and documentation are replaced. Outputs, saved jobs, browser profiles,
+music, characters and channel profiles are never copied, moved or deleted.
+Stop the dashboard before --apply.
+"""
+
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = [
+    'FLOW_STALLED_RECOVERY_V7_0_92.md',
+    'VERSION',
+    'cli.py',
+    'engine/flow_image_transaction.py',
+    'engine/flow_request_archive.py',
+    'engine/flow_resume_safety.py',
+    'tests/test_v791_reference_labels.py',
+    'tests/test_v792_stalled_recovery.py',
+    'tools/archive_uncertain_flow_image.py',
+    'tools/update_v791_to_v792.py',
+]
+# Files as they exist in 7.0.91: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['d24f03cdb49a7441b0d1d1d2a6d05d2639229c15bc929f1017d7b4345c5e99ca'],
+    'cli.py': ['907ec7165e1d16c8b2316fbd2eac2a2b4f759ace3dbc322aa722f61ff99f481f'],
+    'engine/flow_image_transaction.py': ['f97880f34641cd22551bb08b349b956686d8ae551c61fa432b8eda3cac6a927b'],
+    'engine/flow_resume_safety.py': ['135454428b131e14e872dcdfe1e55322bc7886d50d897a6c639a3d2591a927b8'],
+    'tests/test_v791_reference_labels.py': ['9b21c3b8519877d4cd917f686da1157de48c3401b3ad1bca801dc9f8cd9eabf1'],
+    'tools/archive_uncertain_flow_image.py': ['f08301d04b5a62efd81d2f2508990f9e05550b5d58e8479811f882635c6b29f0'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.91', '7.0.92')  # 7.0.92 allows a safe re-run after success
+
+# The 7.0.90 to 7.0.91 update ships in the 7.0.91 zip. Apply it first on an older installation.
+EARLIER_STEPS = [
+    ('7.0.90', '7.0.91', 'tools/update_v790_to_v791.py'),
+]
+
+
+def chain_message(current):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.91 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.91 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.91 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this 7.0.92 update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current))
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the 7.0.92 folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        if destination.exists() and sha(destination) not in ALLOWED.get(name, []) + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+    plan = {'target': str(target), 'installed_version': current, 'apply': args.apply,
+            'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every 7.0.92 code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v7.0.91-to-v7.0.92-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to 7.0.92. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat).')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
+        raise SystemExit(1)
