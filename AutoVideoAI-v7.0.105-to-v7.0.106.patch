+++ b/tests/test_v7106_approval_and_backups.py	2026-10-27 08:39:52.000000000 +0000
@@ -0,0 +1,458 @@
+"""v7.0.106 — one approval per Flow video request, and a rendered video that survives cleanup.
+
+Field report: a job needs eight Flow videos; the first request is approved automatically and the rest wait
+for a human click. "Always approve" is not acceptable (it would also confirm a request nobody planned).
+
+The rule is per *saved request*: exactly one click when its card is visible with a readable cost inside the
+job's per-take cap, never a second click for the same request, never the "Always approve" label, and nothing
+at all when ``flow_approval`` is ``manual``.
+
+The second half covers the cleanup question: where does a rendered video go? Before v7.0.106 it went nowhere -
+the completed-job deletion removed the folder that held it, and Clip Studio cleanup unlinked its clips.
+
+No browser is opened, no credit is spent and no real render is produced here.
+"""
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from engine import flow_approval_once as once
+from engine.render_backup import backup_files, backup_root, inventory, plan, restore
+
+JOB = '20261022-143856-7-small-daily-habits-tha-9729'
+CARD = {'visible': True, 'cost': 6, 'video': True, 'labels': ['Approve', 'Reject'],
+        'question': 'Would you like me to kick off this 1 video generation, costing 6 credits?'}
+
+
+def _job(tmp_path):
+    root = tmp_path / 'outputs' / JOB
+    (root / 'flow' / 'shots' / 'shot_020').mkdir(parents=True)
+    return root
+
+
+def _journal(root, name='take_01.mp4', **fields):
+    path = root / 'flow' / 'shots' / 'shot_020' / (name + '.flow-request.json')
+    payload = {'kind': 'video', 'phase': 'submitted', 'status': 'pending',
+               'project_url': 'https://flow.google.com/project/fe1ccc67-bf80-4948-8530-0bf9c39e5a17',
+               'approval_reservations': []}
+    payload.update(fields)
+    path.write_text(json.dumps(payload))
+    return path
+
+
+def _ledger(journal, *events):
+    journal.with_name(journal.name[:-len('.flow-request.json')] + '.submit-ledger.jsonl').write_text(
+        ''.join(json.dumps({'event': event}) + '\n' for event in events))
+
+
+# --------------------------------------------------------------- the decision
+
+def test_a_visible_affordable_card_is_approved_once(tmp_path):
+    journal = _journal(_job(tmp_path))
+    decision = once.plan(journal, CARD)
+    assert decision['action'] == 'approve'
+    assert decision['cost'] == 6 and decision['clicks'] == 0
+    assert 'one approval will be clicked' in decision['reason']
+
+
+@pytest.mark.parametrize('probe, action, needle', [
+    ({}, 'no_card', 'no clickable Approve'),
+    ({'visible': True, 'cost': None, 'video': True}, 'no_cost', 'readable credit cost'),
+    ({'visible': True, 'cost': 6, 'video': False}, 'not_video', 'not a video generation request'),
+])
+def test_a_card_that_cannot_be_read_safely_is_left_alone(tmp_path, probe, action, needle):
+    journal = _journal(_job(tmp_path))
+    decision = once.plan(journal, probe)
+    assert decision['action'] == action
+    assert needle in decision['reason']
+
+
+def test_a_card_above_the_per_take_cap_is_refused(tmp_path):
+    journal = _journal(_job(tmp_path))
+    decision = once.plan(journal, dict(CARD, cost=25), cap=10)
+    assert decision['action'] == 'over_cap'
+    assert 'above this job' in decision['reason'] and '10-credit cap' in decision['reason']
+
+
+def test_manual_mode_never_approves(tmp_path):
+    journal = _journal(_job(tmp_path))
+    assert once.plan(journal, CARD, setting='manual')['action'] == 'manual'
+    allow, why = once.auto_allowed({'flow_approval': 'manual'})
+    assert allow is False and 'manual' in why
+
+
+def test_automatic_approval_can_be_switched_off_for_a_job(tmp_path):
+    allow, why = once.auto_allowed({'flow_approval': 'once', 'flow_auto_approve_video_requests': False})
+    assert allow is False and 'flow_auto_approve_video_requests' in why
+    assert once.auto_allowed({'flow_approval': 'once'})[0] is True
+
+
+def test_a_recorded_click_makes_every_later_card_a_duplicate(tmp_path):
+    root = _job(tmp_path)
+    journal = _journal(root)
+    once.record_click(journal, label='Approve', cost=6)
+    decision = once.plan(journal, CARD)
+    assert decision['action'] == 'duplicate'
+    assert 'already approved once' in decision['reason']
+
+
+def test_a_ledger_approval_from_an_older_build_counts_as_the_one_click(tmp_path):
+    journal = _journal(_job(tmp_path), approval_clicks=0)
+    _ledger(journal, 'intent', 'submitted', 'approval')
+    assert once.clicks_for(journal)['clicks'] == 1
+    assert once.plan(journal, CARD)['action'] == 'duplicate'
+
+
+def test_an_older_reservation_counts_as_the_one_click(tmp_path):
+    journal = _journal(_job(tmp_path), approval_reservations=[{'key': 'x', 'cost': 6}])
+    assert once.plan(journal, CARD)['action'] == 'duplicate'
+
+
+def test_each_request_has_its_own_one_click(tmp_path):
+    root = _job(tmp_path)
+    first = _journal(root, name='take_01.mp4')
+    second = _journal(root, name='take_02.mp4')
+    once.record_click(first, label='Approve', cost=6)
+    assert once.plan(first, CARD)['action'] == 'duplicate'
+    assert once.plan(second, CARD)['action'] == 'approve'
+
+
+def test_the_click_is_written_to_the_journal_and_the_job_audit(tmp_path):
+    root = _job(tmp_path)
+    journal = _journal(root)
+    audit = once.record_click(journal, label='Approve', cost=5)
+    assert audit['clicks_after'] == 1 and audit['cost'] == 5
+    saved = json.loads(journal.read_text())
+    assert saved['approval_clicks'] == 1 and saved['approval_cost'] == 5
+    assert saved['approval_label'] == 'Approve'
+    rows = once.audit_rows(root)
+    assert len(rows) == 1 and rows[0]['cost'] == 5
+    assert rows[0]['max_clicks_per_request'] == 1
+
+
+def test_the_audit_file_is_inside_the_job_folder(tmp_path):
+    root = _job(tmp_path)
+    once.record_click(_journal(root), label='Approve', cost=6)
+    assert once.audit_path(root).name == 'flow_approvals.jsonl'
+    assert once.audit_path(root).is_file()
+
+
+def test_never_always_approve():
+    assert once.safe_label('once') == 'Approve'
+    assert once.safe_label('manual') == 'Approve'
+    assert once.safe_label('always') == 'Always approve'      # only when the user asked for it
+
+
+# --------------------------------------------------------------- the provider guard
+
+def test_the_browser_refuses_a_second_click_for_the_same_request(tmp_path):
+    """The provider-level guard must not depend on the approval module's own bookkeeping."""
+    from engine.providers.flow_browser import FlowBrowser
+
+    root = _job(tmp_path)
+    journal = _journal(root)
+    once.record_click(journal, label='Approve', cost=6)
+
+    browser = FlowBrowser.__new__(FlowBrowser)
+    browser._approval_journal = str(journal)
+    browser._awaiting_request_id = 'req-1'
+    browser._approval_card_limit = 1
+    browser.last_agent_confirmation = {'approval': 'once', 'cost': 6, 'clicked': None, 'blocked': False}
+    browser._page = SimpleNamespace(inner_text=lambda selector: CARD['question'])
+    clicked = {'count': 0}
+    browser._approval_labels = lambda approval='once': ['Approve']
+    browser._clickable_action = lambda label: SimpleNamespace(click=lambda timeout=1200: clicked.update(
+        count=clicked['count'] + 1))
+    browser._log_approval_click = lambda label: None
+    browser._record_approval_once = lambda label: None
+    browser._looks_like_browser_closed_error = lambda error: False
+    browser.network_issue_detected = lambda: False
+
+    result = browser.confirm_agent_generation(timeout_s=1, approval='once', max_credits=10)
+    assert result is False and clicked['count'] == 0
+    assert browser.last_agent_confirmation['blocked'] is True
+    assert browser.last_agent_confirmation.get('card_limit_reached') is True
+    assert browser.last_agent_confirmation.get('approved_cards') == 1
+
+
+# --------------------------------------------------------------- recovery wiring
+
+class FakeProvider:
+    """The smallest provider that can approve a saved request: no browser, no network."""
+
+    def __init__(self, probe=None, clicks=None, raises=None):
+        self.probe = probe if probe is not None else dict(CARD)
+        self.clicks = clicks
+        self.raises = raises
+        self.approved = []
+
+    def normalize_project_url(self, url):
+        return str(url or '')
+
+    def inspect_recorded_approval(self, project, request_path, *, project_url):
+        if self.raises:
+            raise self.raises
+        return dict(self.probe)
+
+    def approve_recorded_card(self, project, request_path, *, project_url, confirm_credits):
+        self.approved.append(int(confirm_credits))
+        return {'clicked': 'Approve', 'cost': int(confirm_credits)}
+
+    def recover_recorded_video(self, project, output, request_path, *, project_url, wait_s):
+        self.recovered = {'wait_s': wait_s, 'journal': str(request_path)}
+        Path(output).parent.mkdir(parents=True, exist_ok=True)
+        Path(output).write_bytes(b'\x00' * 2048)
+        return {'path': output}
+
+
+def test_a_saved_video_request_is_approved_once_then_never_again(tmp_path):
+    root = _job(tmp_path)
+    journal = _journal(root)
+    provider = FakeProvider()
+    first = once.approve_saved_video_request(provider, journal, settings={'flow_approval': 'once'})
+    assert first['clicked'] is True and first['cost'] == 6
+    assert provider.approved == [6]
+    second = once.approve_saved_video_request(provider, journal, settings={'flow_approval': 'once'})
+    assert second['clicked'] is False and second['action'] == 'duplicate'
+    assert provider.approved == [6]                       # nothing clicked the second time
+
+
+def test_manual_settings_stop_the_automatic_click(tmp_path):
+    journal = _journal(_job(tmp_path))
+    provider = FakeProvider()
+    result = once.approve_saved_video_request(provider, journal, settings={'flow_approval': 'manual'})
+    assert result['clicked'] is False and result['action'] == 'manual'
+    assert provider.approved == []
+
+
+def test_an_unreadable_project_is_reported_not_raised(tmp_path):
+    journal = _journal(_job(tmp_path))
+    provider = FakeProvider(raises=RuntimeError('project not found'))
+    result = once.approve_saved_video_request(provider, journal, settings={})
+    assert result['clicked'] is False and result['action'] == 'probe_failed'
+    assert 'project not found' in result['reason']
+    assert provider.approved == []
+
+
+def test_an_image_request_never_asks_for_a_card(tmp_path):
+    journal = _journal(_job(tmp_path), kind='image')
+    provider = FakeProvider()
+    result = once.approve_saved_video_request(provider, journal, settings={})
+    assert result['clicked'] is False and result['action'] == 'not_video'
+    assert provider.approved == []
+
+
+def test_resume_reconciliation_approves_the_pending_video_card(tmp_path, monkeypatch):
+    """The resume path must click the card of its own saved request, not wait for a human."""
+    from engine import flow_resume_recovery
+
+    root = _job(tmp_path)
+    (root / 'production_manifest.json').write_text(json.dumps({'job_id': JOB, 'shots': []}))
+    journal = _journal(root)
+    _ledger(journal, 'intent', 'submitted')
+    provider = FakeProvider()
+
+    report = flow_resume_recovery.reconcile_job(root, {'flow_approval': 'once'},
