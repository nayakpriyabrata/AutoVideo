+    assert render_job_editions(job)['status'] == 'single_language'
+    assert render_job_editions(tmp_path / 'no-selection')['status'] == 'not_requested'
+
+
+@needs_ffmpeg
+def test_manual_edition_never_borrows_the_source_voice(tmp_path):
+    """Finishing Studio: a Hindi edition without its own narration is refused, not exported in English."""
+    source = _picture(tmp_path / 'source.mp4', 2.0)
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-i', str(source), '-f', 'lavfi', '-i', 'sine=frequency=440',
+                    '-t', '2', '-c:v', 'copy', '-c:a', 'aac', '-shortest', str(tmp_path / 'with-voice.mp4')], check=True)
+    profile = finish.save_profile('Guard', root=tmp_path / 'profiles')
+    plan = finish.create_plan(tmp_path / 'with-voice.mp4', profile, languages=['en', 'hi'],
+                              output_root=tmp_path / 'out', source_language='en')
+    finish.set_edition(plan, 'hi', cards=[], reviewed=True)
+    with pytest.raises(ValueError, match='no reviewed narration'):
+        finish.render(plan, 'hi')
+    finish.set_edition(plan, 'en', cards=[], reviewed=True)
+    assert finish.render(plan, 'en').is_file()        # the source-language edition keeps its own audio
+
+
+@needs_ffmpeg
+def test_edition_without_a_channel_profile_renders_without_a_mark(tmp_path):
