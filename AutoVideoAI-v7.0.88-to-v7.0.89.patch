+    """Exception class plus a URL-free, length-capped message.
+
+    v7.0.89: Playwright appends the browser's own stderr after "Browser logs:". That
+    tail is where a browser crash names itself, so the last lines are kept (capped),
+    not dropped with the rest of the message.
+    """
+    raw = str(exc)
+    head, marker, tail = raw.partition("Browser logs:")
+    text = _URL_RE.sub("<url>", " ".join(head.split()))[:limit]
     name = type(exc).__name__
-    return f"{name}: {text}" if text else name
+    out = f"{name}: {text}" if text else name
+    if marker:
+        lines = [line.strip() for line in tail.splitlines() if line.strip()]
+        shown = _URL_RE.sub("<url>", " | ".join(lines[-10:]))[:log_limit]
+        if shown:
+            out += " | browser logs (last lines): " + shown
+    return out
 
 
