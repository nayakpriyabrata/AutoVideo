+#!/usr/bin/env python3
+"""Apply the v7.0.105 update to a v7.0.104 installation.
+
+Field log (job ``20261022-143856-7-small-daily-habits-tha-9729``, 2026-10-27): Flow produced the shot_020 video,
+the app approved its 6 credits, and then walked away from it after 29 seconds because a *second* approval card
+appeared - while the request still had ~870 s of high-demand queue left. The follow-up recovery counted a
+queueing request as "no progress", gave up after five gallery scans, and paused with "no single identifiable
+asset". A 45 s composer check had also declared shot_020's references unattached although the upload had landed.
+
+v7.0.105:
+
+- a further approval card for an already-approved request is never clicked, and the wait continues for the video
+  that was paid for (`ApprovalCardLimitReached`, `wait_decision()`);
+- a request Flow is still queueing is exempt from the no-progress retry budget (1 500 s wall clock, total
+  attempt bound unchanged), with 30/60/90 s backoff;
+- the composer attachment check waits 90 s and, if it still fails, attaches the same alias from the project's
+  uploaded media once instead of failing the shot;
+- ``python3 cli.py v3 status`` prints the current pause via ``pause_guidance_lines()`` - the superseded notice is
+  marked, the manifest's accepted count is used, and unresolved journals are listed.
+
+Nothing is generated, rendered or charged by this update itself.
+
+Usage (run from the existing installation folder, after extracting the 7.0.105 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.105/tools/update_v7104_to_v7105.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.105/tools/update_v7104_to_v7105.py . --apply    # installs the code
+
+Only code and documentation are replaced. Outputs, saved jobs, Flow journals, browser profiles and
+Clip Studio folders are never copied, moved or deleted. Stop the dashboard before --apply.
+"""
+
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = ['QUEUED_REQUEST_V7_0_105.md', 'VERSION', 'cli.py', 'engine/automatic_recovery.py',
+           'engine/flow_approval.py', 'engine/providers/flow_browser.py',
+           'tests/test_v7105_queued_approval.py', 'tools/update_v7104_to_v7105.py']
+# Files as they exist in 7.0.104: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['0f224c1ea5d3d73fcac3128abbdbcca73a3d11b3f26c20724234bb508e92be2b'],
+    'cli.py': ['993aa778128ccfa9c7e50c53c6592927a7b4f5129363788d4e52e93133d40d12'],
+    'engine/automatic_recovery.py': ['84056dd21d62010673691733c0fabb6309f0b830e35b2ee9a991d7b72249fd66'],
+    'engine/flow_approval.py': ['86a336002610137b0ce1ce1c28869b935627cd55acef8b82643608c530d6e7c5'],
+    'engine/providers/flow_browser.py': ['041ea957abde9ec172fe9d8365f5a951ee942bb0728e3829c46fe51c48acad14'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.104', '7.0.105')  # 7.0.105 allows a safe re-run after success
+
+# The 7.0.104 zip carries the 7.0.103 to 7.0.104 update; apply that first on an older installation.
+EARLIER_STEPS = [
+    ('7.0.103', '7.0.104', 'tools/update_v7103_to_v7104.py'),
+]
+
+
+def chain_message(current):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.104 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.104 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.104 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this 7.0.105 update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current))
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the 7.0.105 folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        if destination.exists() and sha(destination) not in ALLOWED.get(name, []) + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+    plan = {'target': str(target), 'installed_version': current, 'apply': args.apply,
+            'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every 7.0.105 code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v7.0.104-to-v7.0.105-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to 7.0.105. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat).')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
+        raise SystemExit(1)
