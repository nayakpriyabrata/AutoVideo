+    journal.write_text(json.dumps({'approval_reservations': [
+        {'key': 'other', 'cost': 6, 'status': 'reserved'}]}))
+    with pytest.raises(fa.ApprovalCardLimitReached) as caught:
+        fa.reserve(journal, QUESTION, 6, 60, 1)
+    assert caught.value.cards == 1
+    # nothing was written: the refused card never reaches the journal
+    assert len(json.loads(journal.read_text())['approval_reservations']) == 1
