diff -ruN a/tests/test_v781_quota_retry.py b/tests/test_v781_quota_retry.py
--- a/tests/test_v781_quota_retry.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_v781_quota_retry.py	2026-10-22 11:56:03.122030459 +0000
@@ -0,0 +1,106 @@
+"""v7.0.81: a daily Gemini TTS limit (HTTP 429 'requests per day') stops the run at once.
+
+7.0.80 retried every 429 three times; each retry is a counted request, so one exhausted daily quota
+turned into three wasted requests per failing part. A per-minute 429 is still retried, after a wait.
+No network: requests.post is replaced.
+"""
+import base64
+
+import pytest
+import requests
+
+import engine.audio.tts as TTS
+
+DAILY_BODY = ('{"error":{"message":"Rate limit exceeded for model gemini-3.8-flash-tts (limit: 10 requests per day '
+              'on Free Tier). Please retry later.","status":"RESOURCE_EXHAUSTED"}}')
+MINUTE_BODY = '{"error":{"message":"Rate limit exceeded: 10 requests per minute.","status":"RESOURCE_EXHAUSTED"}}'
+
+
+class FakeResponse:
+    def __init__(self, status=200, body=None, text=""):
+        self.status_code = status
+        self._body = body
+        self.text = text
+
+    def json(self):
+        return self._body
+
+
+def _ok():
+    return FakeResponse(200, {"audio": base64.b64encode(b"\x00\x20" * 12000).decode()})
+
+
+@pytest.fixture
+def gemini(monkeypatch):
+    monkeypatch.setenv("GEMINI_API_KEY", "test-key")
+    sleeps = []
+    monkeypatch.setattr(TTS.time, "sleep", lambda seconds: sleeps.append(seconds))
+    calls = []
+
+    def install(responses):
+        calls.clear()
+        queue = list(responses)
+
+        def fake_post(url, headers=None, json=None, timeout=None):
+            calls.append(json)
+            item = queue.pop(0) if queue else _ok()
+            if isinstance(item, BaseException):
+                raise item
+            return item
+
+        monkeypatch.setattr(requests, "post", fake_post)
+        return calls
+
+    return install, sleeps
+
+
+def test_daily_limit_is_sent_once_and_stops_the_run(gemini, tmp_path):
+    install, sleeps = gemini
+    calls = install([FakeResponse(429, {"error": {}}, DAILY_BODY)] * 3)
+    with pytest.raises(TTS.GeminiQuotaExceeded, match="daily request limit reached"):
+        TTS.GeminiTTSProvider().synth("Short line.", "voice", str(tmp_path / "out.mp3"), language="en", style="")
+    assert len(calls) == 1          # no retries: each retry would be another counted request
+    assert sleeps == []
+
+
+def test_per_minute_limit_waits_a_minute_and_retries(gemini, tmp_path):
+    install, sleeps = gemini
+    calls = install([FakeResponse(429, {"error": {}}, MINUTE_BODY), _ok()])
+    result = TTS.GeminiTTSProvider().synth("Short line.", "voice", str(tmp_path / "out.mp3"), language="en", style="")
+    assert len(calls) == 2
+    assert sleeps == [TTS.GEMINI_TTS_MINUTE_WAIT]
+    assert result["duration"] > 0
+
+
+def test_daily_limit_partway_keeps_saved_parts_and_resumes(gemini, tmp_path):
+    install, _ = gemini
+    text = " ".join(f"This is sentence number {i} of the narration." for i in range(200))
+    total = len(TTS.split_speech_text(text))
+    out = str(tmp_path / "out.mp3")
+    calls = install([_ok(), FakeResponse(429, {"error": {}}, DAILY_BODY)])
+    with pytest.raises(TTS.GeminiQuotaExceeded) as info:
+        TTS.GeminiTTSProvider().synth(text, "voice", out, language="en", style="")
+    assert len(calls) == 2
+    assert "1 of " + str(total) + " narration parts are saved" in str(info.value)
+    assert "continues from part 2" in str(info.value)
+    # The next run (after the quota resets) sends only the parts that were not saved.
+    calls = install([])
+    result = TTS.GeminiTTSProvider().synth(text, "voice", out, language="en", style="")
+    assert len(calls) == total - 1
+    assert result["duration"] > 0
+
+
+def test_odia_daily_limit_is_reported_as_a_quota_not_a_voice_file_problem(gemini, tmp_path):
+    install, _ = gemini
+    install([FakeResponse(429, {"error": {}}, DAILY_BODY)])
+    with pytest.raises(TTS.GeminiQuotaExceeded, match="daily request limit reached"):
+        TTS.synthesize_narration("ଆମେ କଥା କହିବା।", "gemini-native-odia", str(tmp_path / "o.mp3"),
+                                 provider="gemini", language="or", style="")
+
+
+def test_other_rejections_still_fail_at_once(gemini, tmp_path):
+    install, _ = gemini
+    calls = install([FakeResponse(400, None, "bad request")])
+    with pytest.raises(RuntimeError, match="rejected the request \\(HTTP 400\\)"):
+        TTS.GeminiTTSProvider().synth("Short line.", "voice", str(tmp_path / "out.mp3"), language="en", style="")
+    assert len(calls) == 1
