+def _series_layout(d, series, width, height, style, palette, scale):
+    """Largest row size whose wrapped points fit the panel; returns (size, title, rows, panel_h)."""
+    from .typography import fit
+    vertical = height > width
+    max_h = height * (.66 if vertical else .76)
+    content_w = int(width * (.80 if vertical else .70)) - 2 * max(12, int(28 * scale))
+    stroke = max(1, int(3 * scale))
+    gap = max(6, int(12 * scale))
+    for size in range(int(52 * scale), int(34 * scale) - 1, -max(1, int(2 * scale))):
+        try:
+            title = fit(d, series["title"], content_w, int(height * .14), size=76 * scale, minimum=52 * scale,
+                        style=style, bold=True, headline=True, max_lines=2, stroke=stroke)
+            rows = [fit(d, f"{i + 1}. {p['text']}", content_w, int(height * .5), size=size, minimum=size,
+                        style=style, bold=True, max_lines=2, stroke=stroke)
+                    for i, p in enumerate(series["points"])]
+        except ValueError:
+            continue
+        pad = max(12, int(28 * scale))
+        total = 2 * pad + title.height + gap + sum(r.height for r in rows) + gap * (len(rows) - 1) + pad // 2
+        if total <= max_h:
+            return size, title, rows, int(total)
+    raise ValueError("Points list is too long for one card: shorten the points or use fewer of them")
