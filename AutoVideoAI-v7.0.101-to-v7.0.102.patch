+#!/usr/bin/env python3
+"""Apply the v7.0.102 update to a v7.0.101 installation.
+
+Why the video scan reported "no verified match" while the clip was in the saved project:
+
+- a video request is stored as a full envelope ("Create exactly 1 VIDEO clip. ... exactly as the creative
+  brief: <brief>"), while a tile's Reuse prompt usually returns only the brief, so equality against the
+  envelope could never hold even when the prompt was read successfully;
+- several fresh assets (the same clip as a <video> node and as its poster) are not several clips, but the
+  scan only accepted a single verified candidate.
+
+v7.0.102:
+
+- ``FlowBrowser.video_creative_brief()`` parses our own video envelope and
+  ``same_video_generation_prompt()`` compares exactly on either side (model labels with dots included);
+- when several candidates verify with the same prompt, the one Flow renders as a real video element wins;
+  two genuinely different clips still refuse;
+- every fresh candidate the scan considered is printed with its prompt, size and - when the tile exposes it -
+  its own /edit/ URL, and the failure text hands over a ready
+  ``--asset-url ... --asset-reviewed`` command per candidate. The new ``edit_url`` is read-only context and
+  is not part of the persisted signature, so existing baselines keep matching.
+
+Nothing is generated, rendered or charged by this update itself.
+
+Usage (run from the existing installation folder, after extracting the 7.0.102 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.102/tools/update_v7101_to_v7102.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.102/tools/update_v7101_to_v7102.py . --apply    # installs the code
+
+Only code and documentation are replaced. Outputs, saved jobs, Flow journals, browser profiles and
+Clip Studio folders are never copied, moved or deleted. Stop the dashboard before --apply.
+"""
+
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = ['VERSION', 'VIDEO_PROMPT_MATCH_V7_0_102.md', 'engine/providers/flow_browser.py',
+           'tests/test_v7102_video_prompt_brief.py', 'tools/update_v7101_to_v7102.py']
+# Files as they exist in 7.0.101: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['f068874b2f0363b02752b73dd8704696627f4ed21ce1264a910ffdef22737d22'],
+    'engine/providers/flow_browser.py': ['424fe3492ff652e32a5e0a734ce30255fffd32ba50f503dfadbcbe14b303bdfc'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.101', '7.0.102')  # 7.0.102 allows a safe re-run after success
+
+# The 7.0.101 zip carries the 7.0.100 to 7.0.101 update; apply that first on an older installation.
+EARLIER_STEPS = [
+    ('7.0.100', '7.0.101', 'tools/update_v7100_to_v7101.py'),
+]
+
+
+def chain_message(current):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.101 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.101 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.101 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this 7.0.102 update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current))
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the 7.0.102 folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        if destination.exists() and sha(destination) not in ALLOWED.get(name, []) + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+    plan = {'target': str(target), 'installed_version': current, 'apply': args.apply,
+            'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every 7.0.102 code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v7.0.101-to-v7.0.102-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to 7.0.102. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat).')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
+        raise SystemExit(1)
