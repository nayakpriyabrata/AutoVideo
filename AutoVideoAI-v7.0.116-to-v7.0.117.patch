+#!/usr/bin/env python3
+"""Apply the v7.0.117 update to a v7.0.116 installation.
+
+The field sequence that produced this release: v7.0.116 made an edition draw one card at a time, and the Odia video
+that came back was rendered by 7.0.115 - its record had no card audit at all. Nothing said so. A missing field looked
+exactly like "checked, fine", and the only way to find out was another hour-long render.
+
+v7.0.117 makes that question answerable in seconds, before a render:
+
+1. ``python3 cli.py v3 language-outputs <job> --card-audit`` - read-only. It lists, per language, the job's copied
+   cards and the edition's own drafted cards, every pair that would share the screen (with the overlap in seconds),
+   and exactly what a render will draw. It encodes nothing, writes nothing into the job, spends no Flow credit and
+   uses no voice.
+2. The file listing says **"cards: not recorded - this file was rendered before 7.0.116"** instead of staying
+   silent, and "cards: one at a time" when the file does carry the record. Silence is never shown as a pass again.
+
+Nothing is rendered, re-recorded or charged by this update. To see the one-card fix in a video, that language still
+has to be rendered again - after ``--card-audit`` says it is worth doing.
+
+Usage (run from the existing installation folder, after extracting the 7.0.117 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.117/tools/update_v7116_to_v7117.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.117/tools/update_v7116_to_v7117.py . --apply    # installs the code
+
+Only code, documentation and tests are replaced. Outputs, saved jobs, Flow journals, browser profiles and
+``music_library/`` are never copied, moved or deleted. Stop the dashboard before --apply.
+"""
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = [
+    'VERSION', 'cli.py',
+    'engine/edition_files.py', 'engine/card_audit.py', 'engine/render/card_slots.py',
+    'tests/test_v7117_card_audit.py',
+    'CARD_AUDIT_V7_0_117.md', 'tools/update_v7116_to_v7117.py',
+]
+# Files as they exist in 7.0.110: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['879aad20f466cd8f29e3dbda4ee951bcaf030a89417701485108111d64b5203a'],
+    'cli.py': ['cbd9087bad41fed7630111bd3aa2b06c1e35fcc90d1e92825d74d74099bd1d16'],
+    'engine/edition_files.py': ['965ef0e6b4b90fa63f551982d5c6de80e3411502ddf85643b8300e2ce0607280'],
+    'engine/render/card_slots.py': ['1ca496fa8b072bdc3c78238cf8cd4ded25627550a7b91d4d462be3a23a565543'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.116', '7.0.117')  # 7.0.117 allows a safe re-run after success
+
+# The 7.0.117 zip carries the 7.0.116 update; apply that first on an older installation.
+EARLIER_STEPS = [
+    ('7.0.115', '7.0.116', 'tools/update_v7115_to_v7116.py'),
+]
+
+
+def chain_message(current, version):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.116 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.116 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.116 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this ' + version + ' update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current, source.name or '7.0.117'))
+    new_version = (source / 'VERSION').read_text(encoding='utf-8').strip()
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the ' + new_version +
+                         ' folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        allowed = ALLOWED.get(name, [])
+        if destination.exists() and allowed and sha(destination) not in allowed + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+        if destination.exists() and not allowed and sha(destination) != expected[name]:
+            # v7.0.117: a file this release introduces (engine/card_audit.py) must not overwrite a different file
+            # that already sits at that path - the same promise as for an edited file, applied to a new one.
+            raise ValueError('A different file already exists where this update installs ' + name +
+                             '; preserved it and changed nothing. Move it aside and run the update again.')
+    plan = {'target': str(target), 'installed_version': current, 'new_version': new_version,
+            'apply': args.apply, 'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every ' + new_version + ' code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v' + current + '-to-v' + new_version + '-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
