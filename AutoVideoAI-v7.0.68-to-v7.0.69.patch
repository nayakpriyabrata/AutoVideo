--- a/tools/update_v768_to_v769.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/update_v768_to_v769.py	2026-10-20 11:21:38.000000000 +0000
@@ -0,0 +1,139 @@
+#!/usr/bin/env python3
+"""Apply the v7.0.69 update (automatic resume, channel setup, drafting models) to a v7.0.68 installation.
+
+Usage (run from the existing installation folder, after extracting the 7.0.69 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.69/tools/update_v768_to_v769.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.69/tools/update_v768_to_v769.py . --apply    # installs the code
+
+An installation still on 7.0.67 must first run tools/update_v767_to_v768.py from the 7.0.68 folder.
+Only code and documentation are replaced. Outputs, saved jobs, browser profiles,
+music, characters and channel profiles are never copied, moved or deleted.
+A file you changed locally is preserved and the update stops before touching anything.
+"""
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = [
+    'AUTO_RESUME_AND_DRAFTING_V7_0_69.md',
+    'VERSION',
+    'app.py',
+    'engine/auto_resume.py',
+    'engine/automatic_recovery.py',
+    'engine/channel_branding.py',
+    'engine/factory.py',
+    'engine/job_monitor.py',
+    'engine/studio_review.py',
+    'tests/test_v769_auto_resume.py',
+    'tests/test_v769_channel_branding.py',
+    'tests/test_v769_drafting.py',
+    'tools/update_v768_to_v769.py',
+]
+# Files that exist in 7.0.68: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['d4019fe552d665f3c34e1313a6e5e872e63f4adcc798cef146f3d49d3b7db39d'],
+    'app.py': ['c9775a4979231c1e967aad09ab533b2f07eb2ee43fa267c9fe3b75a4b0c4201c'],
+    'engine/automatic_recovery.py': ['63fd47c746fdf5b896ca2301ae2c66827fd4d2fc220c0c9a7fa97a33bd50bc9c'],
+    'engine/factory.py': ['fda39eb38f6725fb6a8b7766052b2468cfdb7f3c2e73fb4990e8de58eff5dcce'],
+    'engine/job_monitor.py': ['7ccb012f3f13c151c3e652623f9f5ed44b545c249dac52a119496d4f8b38d0db'],
+    'engine/studio_review.py': ['4c61eab86151a686c109c5c8d01107d4dddf8898c18e63ea9d2250d3148e346a'],
+}
+ACCEPTED_INSTALLS = ('7.0.68', '7.0.69')  # 7.0.69 allows a safe re-run after success
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError('This update requires an installed 7.0.68 (found ' + current + '). '
+                         'For 7.0.67 run ../AutoVideoAI-v7.0.68/tools/update_v767_to_v768.py first.')
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the 7.0.69 folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
