+def caption_block_top(W: int, H: int, *, aspect: str = "16:9", template: str = "HORMOZI",
+                       lines: int = 2) -> int:
+    """The highest pixel a burned caption can reach, so a card can stay above it (v7.0.112).
+
+    Uses the same numbers ``build_captions`` uses - the template's font size scaled to the frame, the safe zone's
+    bottom margin, and the two lines a phrase wraps to - with line spacing taken as 1.3x the font size, a little
+    more than libass draws, so the answer is on the safe side.
+    """
+    zone = aspect if aspect in SAFE_ZONES else "9:16"
+    rw, rh = REFERENCE_SIZE[zone]
+    scale = min(int(W) / rw, int(H) / rh)
+    T = TEMPLATES.get(str(template).upper(), TEMPLATES["HORMOZI"])
+    fontsize = max(8, round(T["Fontsize"] * scale))
+    margin_v = round(SAFE_ZONES[zone]["MarginV"] * int(H) / rh)
+    return max(0, int(H) - margin_v - int(round(max(1, lines) * fontsize * 1.3)))
+
+
