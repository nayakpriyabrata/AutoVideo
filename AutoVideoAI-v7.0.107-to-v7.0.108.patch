+def refresh_saved_cards(job_root, languages=None, cleanup='delete-after-read', progress=None):
+    """Re-draft a saved job's cards and hooks from its saved narrations (7.0.108).
+
+    The documented repair when a card or hook file was drafted from a different narration. It calls no TTS, opens
+    no video request, spends no Flow credit, and makes one Gemini Web card request per selected language. The
+    cards are anchored to each language's own saved word timings, so the edition renders with correct timings
+    straight afterwards.
+    """
+    from .production import save
+    root = Path(job_root)
+    state_path = root / 'production' / 'language_editions.json'
+    if not state_path.is_file():
+        raise ValueError('This job has no prepared language editions, so there is nothing to re-draft here. '
+                         'Its cards live in ' + str(root / 'production' / 'speech_cards.json') +
+                         '; press Resume in the app to draft them again for the saved narration.')
+    state = json.loads(state_path.read_text(encoding='utf-8'))
+    bundles = state.get('bundles') or {}
+    if not bundles:
+        raise ValueError('No prepared narration is saved for this job yet. Prepare the language narrations first '
+                         '(Create step 4, or Jobs & Recovery > Speech batches).')
+    wanted = list(dict.fromkeys(languages or list(bundles)))
+    unknown = [code for code in wanted if code not in bundles]
+    if unknown:
+        raise ValueError('No saved narration for ' + ', '.join(unknown) + '. Saved languages: ' + ', '.join(bundles))
+    emit = progress or (lambda *args: None)
+    summary = {}
+    for index, code in enumerate(wanted):
+        bundle = dict(bundles[code])
+        if bundle.get('hooks') is None:
+            bundle['hooks'] = bool(state.get('hooks_enabled', False))
+        if bundle.get('text_cards') is None:
+            bundle['text_cards'] = bool(state.get('text_cards', True))
+        emit('Re-drafting saved cards', int(100 * index / max(1, len(wanted))), code.upper())
+        refreshed = complete_edition_cards(bundle, cleanup)
+        bundles[code] = refreshed
+        folder = Path(refreshed['audio']).parent
