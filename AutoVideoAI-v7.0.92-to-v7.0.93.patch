+"""v7.0.93: image requests are free in Flow, so a saved image request with no output is replaced by a fresh one.
+
+Field case (shot_022 and shot_020, 2026-10-25): the saved Flow project held only the uploaded references after
+the wait, so the run failed and needed a manual archive command. Image requests cost no Flow credits, so the app
+now archives such a request and submits one fresh image request, up to three submissions per shot.
+
+Safety rules tested here (fakes only; no browser, no submission, no credits):
+- Only "no generated image" may trigger a fresh request. Two or more real outputs stay blocked and are never
+  resubmitted, replaced or waited on again.
+- Video requests are never archived or resubmitted automatically.
+- The Resume gate passes an unresolved image request only when no local image exists, so generation can handle it.
+"""
+import json
+from pathlib import Path
+
+import pytest
+from PIL import Image
+
+from engine import flow_image_transaction as tx
+from engine.flow_request_archive import archive_uncertain_request
+from engine.flow_resume_safety import check_job
+from engine.providers.flow_browser import FlowBrowser, FlowRequestPending
+
+PROJECT = 'https://flow.google.com/project/dddddddd-dddd-dddd-dddd-dddddddddddd'
+LOCATION_LABEL = 'AV_197ff6e22dbe_location_master.jpg'
+CHARACTER_LABEL = 'AV_5a1ca5dde04e_character-aradhya-aaa37613-0.jpg'
+
+
+def picture(path, color):
+    Image.new('RGB', (128, 96), color).save(path)
+    return str(path)
+
+
+def tile(sig, label=''):
+    hint = "Tile displaying a user's image " + label if label else 'Tile displaying a generated image'
+    return {'kind': 'image', 'sig': sig, 'tile_hint': hint, 'hint': hint}
+
+
+class Bridge:
+    normalize_project_url = staticmethod(FlowBrowser.normalize_project_url)
+
+    def __init__(self, tiles, served):
+        self.tiles = list(tiles)
+        self.served = served
+        self.project = PROJECT
+        self.downloads = []
+        self.wait_calls = 0
+
+    def current_project_url(self): return self.project
+    def ensure_project(self, *a, **k): self.project = k.get('project_url') or PROJECT
+    def media_assets(self): return [dict(t) for t in self.tiles]
+
+    def download_latest_asset(self, path, preferred_signature, **kw):
+        self.downloads.append(preferred_signature)
+        Path(path).write_bytes(Path(self.served[preferred_signature]).read_bytes())
+
+    def wait_for_agent_generation(self, **kw):
+        self.wait_calls += 1
+        return False
+
+
+class Provider:
+    def __init__(self, bridge): self.bridge = bridge
+    def _ensure(self): return self.bridge
+    def close(self): pass
+
+
+def journal(output, **extra):
+    data = {'schema_version': 1, 'scope': tx.SCOPE, 'kind': 'image', 'status': 'pending',
+            'phase': 'submission_uncertain', 'submission_acknowledged': False, 'project_url': PROJECT,
+            'project_name': 'AutoVideo-Image-test', 'capture_probes': {}, 'baseline': [], 'signature': '',
+            'submitted_prompt': 'x', 'reference_hashes': {}}
+    data.update(extra)
+    tx.write_json(tx.journal_path(output), data)
+    return data
+
+
+@pytest.fixture
+def shot(tmp_path):
+    job = tmp_path / 'job-fresh'
+    (job / 'storyboard').mkdir(parents=True)
+    output = job / 'storyboard' / 'shot_022_open.jpg'
+    location = picture(tmp_path / 'location_master.jpg', 'red')
+    character = picture(tmp_path / 'character.png', 'blue')
+    generated_a = picture(tmp_path / 'scene_a.jpg', 'green')
+    generated_b = picture(tmp_path / 'scene_b.jpg', 'yellow')
+    refs = [location, character]
+    journal(output, reference_hashes={p: tx.sha(p) for p in refs})
+    return output, refs, (generated_a, generated_b)
+
+
+def test_two_real_outputs_stay_blocked_with_no_wait_archive_or_resubmit(shot):
+    output, (location, character), (gen_a, gen_b) = shot
+    bridge = Bridge([tile('/asb/new-location', LOCATION_LABEL), tile('/asb/out-a'), tile('/asb/out-b')],
+                    {'/asb/out-a': gen_a, '/asb/out-b': gen_b})
+    request = json.loads(tx.journal_path(output).read_text())
+    with pytest.raises(FlowRequestPending) as info:
+        tx.recover(Provider(bridge), request, output, compiled={})
+    assert not getattr(info.value, 'fresh_request_allowed', False)
+    assert 'Two or more real images are saved' in str(info.value)
+    assert bridge.wait_calls == 0
+    assert tx.journal_path(output).is_file()
+    assert tx.fresh_request_count(output) == 0
+    assert not output.exists()
+
+
+def test_more_than_one_extra_image_is_also_blocked(shot):
+    output, (location, character), (gen_a, gen_b) = shot
+    bridge = Bridge([tile('/asb/new-location', LOCATION_LABEL), tile('/asb/new-character', CHARACTER_LABEL),
+                     tile('/asb/out-a'), tile('/asb/out-b')],
+                    {'/asb/out-a': gen_a, '/asb/out-b': gen_b})
+    request = json.loads(tx.journal_path(output).read_text())
+    with pytest.raises(FlowRequestPending) as info:
+        tx.recover(Provider(bridge), request, output, compiled={})
+    assert not getattr(info.value, 'fresh_request_allowed', False)
+    assert bridge.wait_calls == 0
+
+
+def test_only_references_after_the_wait_allows_exactly_one_fresh_request(shot):
+    output, (location, character), _ = shot
+    bridge = Bridge([tile('/asb/new-location', LOCATION_LABEL), tile('/asb/new-character', CHARACTER_LABEL)], {})
+    request = json.loads(tx.journal_path(output).read_text())
+    with pytest.raises(FlowRequestPending) as info:
+        tx.recover(Provider(bridge), request, output, compiled={})
+    assert info.value.fresh_request_allowed is True
+    assert bridge.wait_calls == 1
+
+
+def _fake_submission(calls, succeed_on=None):
+    def fake(provider, shot, compiled, output, vertical, request_hash):
+        output = Path(output)
+        journal(output, phase='submission_uncertain', request_hash=request_hash)
+        calls.append(output.name)
+        if succeed_on and len(calls) == succeed_on:
+            return 'generated'
+        pending = FlowRequestPending('No generated image is in the saved Flow project')
+        pending.fresh_request_allowed = True
+        raise pending
+    return fake
+
+
+def test_fresh_requests_stop_at_three_submissions_per_shot(shot, monkeypatch):
+    output, _, _ = shot
+    calls = []
+    monkeypatch.setattr(tx, '_generate_once', _fake_submission(calls))
+    with pytest.raises(FlowRequestPending) as info:
+        tx.generate(None, None, {}, output, False, 'hash')
+    assert len(calls) == 3
+    assert tx.fresh_request_count(output) == 2                  # two old requests kept; the third is still open
+    assert tx.journal_path(output).is_file()
+    assert 'stopped after 3 submission(s)' in str(info.value)
+
+
+def test_a_fresh_request_that_produces_an_image_returns_normally(shot, monkeypatch):
+    output, _, _ = shot
+    calls = []
+    monkeypatch.setattr(tx, '_generate_once', _fake_submission(calls, succeed_on=2))
+    assert tx.generate(None, None, {}, output, False, 'hash') == 'generated'
+    assert len(calls) == 2
+    assert tx.fresh_request_count(output) == 1
+
+
+def test_a_blocked_request_is_never_resubmitted_by_generate(shot, monkeypatch):
+    output, _, _ = shot
+    calls = []
+
+    def blocked(provider, shot, compiled, output, vertical, request_hash):
+        calls.append(1)
+        raise FlowRequestPending('Two or more real images are saved')  # no fresh_request_allowed flag
+    monkeypatch.setattr(tx, '_generate_once', blocked)
+    with pytest.raises(FlowRequestPending):
+        tx.generate(None, None, {}, output, False, 'hash')
+    assert len(calls) == 1
+    assert tx.fresh_request_count(output) == 0
+
+
+def test_archive_refuses_when_a_valid_non_reference_image_is_saved(shot):
+    output, _, _ = shot
+    probe = picture(output.parent / 'shot_022_open.jpg.probe-aaaa.jpg', 'green')
+    journal(output, capture_probes={'k': {'file': Path(probe).name, 'reference': None}})
+    with pytest.raises(RuntimeError, match='recover it instead of resubmitting'):
+        tx.archive_saved_request(output)
+    assert tx.journal_path(output).is_file()
+
+
+def test_video_requests_are_never_archived_automatically(tmp_path):
+    output = tmp_path / 'take_01.mp4'
+    journal(output, scope='video_flow_v1', kind='video')
+    with pytest.raises(RuntimeError, match='Only a saved image request'):
+        tx.archive_saved_request(output)
+    assert tx.journal_path(output).is_file()
+
+
+def test_resume_gate_passes_an_image_request_without_a_local_image_only(tmp_path):
+    job = tmp_path / 'job-gate'
+    (job / 'storyboard').mkdir(parents=True)
+    (job / 'production_manifest.json').write_text('{}')
+    image = job / 'storyboard' / 'shot_022_open.jpg'
+    journal(image)
+    assert check_job(job)['safe_to_generate'] is True          # image, no local file: generate() will handle it
+
+    tx.journal_path(image).unlink()
+    journal(image, phase='submitted')
+    assert check_job(job)['safe_to_generate'] is False         # acknowledged submit: 7.0.87 download-only wait applies
+
+    tx.journal_path(image).unlink()
+    journal(image, scope='video_flow_v1', kind='video')
+    assert check_job(job)['safe_to_generate'] is False         # video journals keep blocking Resume
+
+    tx.journal_path(image).unlink()
+    picture(image, 'green')
+    journal(image)
+    assert check_job(job)['safe_to_generate'] is False         # a local image exists: reconcile first
+
+
+def test_two_archives_in_the_same_second_do_not_overwrite_each_other(tmp_path):
+    output = tmp_path / 'shot_022_open.jpg'
+    for _ in range(2):
+        journal(output)
+        code, _lines = archive_uncertain_request(output, confirm_new_credit_spend=True)
+        assert code == 0
+    assert len(list(tmp_path.glob('shot_022_open.jpg.flow-request.archived-*.json'))) == 2
