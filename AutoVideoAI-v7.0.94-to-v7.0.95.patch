+#!/usr/bin/env python3
+"""Apply the v7.0.95 update to a v7.0.94 installation.
+
+A production that selects English, Hindi and Odia now really produces three videos:
+
+- one language can no longer block the others. A missing narration, a rejected
+  plan or a failed render is recorded for that language only;
+- a prepared batch whose text-card or points flags differ is a warning on that
+  edition instead of a refusal that stopped every language;
+- the extra language narrations are prepared during production even when
+  "Also prepare every selected language automatically" was never ticked, and a
+  localization/TTS failure no longer stops the primary master;
+- every job that selected editions shows a "Three-language output" panel naming
+  each language's status and the one action that unblocks it
+  (also `python3 cli.py v3 language-outputs <job> --explain`, read-only);
+- one channel profile can carry a logo per language (logo-en, logo-hi, logo-or).
+  The Create page saves all three logos in one step and shows, per language, the
+  profile, channel name and the exact logo the video will use. Finishing Studio
+  shows the same three logo fields.
+
+Nothing is generated, rendered or charged by this update itself.
+
+Usage (run from the existing installation folder, after extracting the 7.0.95 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.95/tools/update_v794_to_v795.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.95/tools/update_v794_to_v795.py . --apply    # installs the code
+
+Only code and documentation are replaced. Outputs, saved jobs, browser profiles,
+music, characters and channel profiles are never copied, moved or deleted.
+Stop the dashboard before --apply.
+"""
+
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = ['THREE_LANGUAGE_RENDER_FIX_V7_0_95.md', 'VERSION', 'app.py', 'cli.py', 'engine/channel_branding.py', 'engine/factory.py', 'engine/finishing_studio.py', 'engine/finishing_ui.py', 'engine/language_editions.py', 'engine/speech_cards.py', 'tests/test_v768_language_editions_render.py', 'tests/test_v769_channel_branding.py', 'tests/test_v777_edition_cards_hooks.py', 'tests/test_v795_three_language_render.py', 'tools/update_v794_to_v795.py']
+# Files as they exist in 7.0.94: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['f2c80e5bb10454c8254680c30ab06253294864e666ae96504814c57c54e9217a'],
+    'app.py': ['61f814a94dbf347e395aa8db72995de516d2d0efcf0a177507f162ef166f39f1'],
+    'cli.py': ['f166c3c70ab365bf9eeee62074388ecb54360b62072b0a3fb40006cac8c07794'],
+    'engine/channel_branding.py': ['62536373092d9116028bcd8f1bf83ffd0f8b0f240a085cd7e2adcf6361cbba0b'],
+    'engine/factory.py': ['d170a4a7914c29e5074c49def730788ba3c4ab428add13fe1b5d81915488165f'],
+    'engine/finishing_studio.py': ['2579f855da8d9ef719232196b05b7df00fa418fd05f8a00b325d3d42cb512fff'],
+    'engine/finishing_ui.py': ['d0519ca0d3d8b483af6b09377f7ed9623cf8f83d9de1779e602bb16a6f007e78'],
+    'engine/language_editions.py': ['e4dba5d9176e1b4b91e2e315e8401de48c66cbd789a27e620d0df54c444ef0da'],
+    'engine/speech_cards.py': ['ed9a42bae3d305f152920eb949f4f89d2141c400a36b5f007eb8656f4b42e67a'],
+    'tests/test_v768_language_editions_render.py': ['ff9bae7bf525bff97b1b00f0ab915d404e075da2343f80857796e26fa3099e77'],
+    'tests/test_v769_channel_branding.py': ['f1f7bd051960af6ae3ab3ffac883f715448b9395bfa382adb8e89f43f8f02679'],
+    'tests/test_v777_edition_cards_hooks.py': ['fc44fc314c9d64ad3c489642a3a8c7c2c25752db09fa0f4dd3ed534722d40a38'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.94', '7.0.95')  # 7.0.95 allows a safe re-run after success
+
+# The 7.0.94 to 7.0.95 update ships in the 7.0.95 zip. Apply it first on an older installation.
+EARLIER_STEPS = [
+    ('7.0.93', '7.0.94', 'tools/update_v793_to_v794.py'),
+]
+
+
+def chain_message(current):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.94 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.94 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.94 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this 7.0.95 update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current))
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the 7.0.95 folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        if destination.exists() and sha(destination) not in ALLOWED.get(name, []) + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+    plan = {'target': str(target), 'installed_version': current, 'apply': args.apply,
+            'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every 7.0.95 code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v7.0.94-to-v7.0.95-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to 7.0.95. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat).')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
+        raise SystemExit(1)
