+#!/usr/bin/env python3
+"""Apply the v7.0.101 update to a v7.0.100 installation.
+
+Wording that could mislead, corrected:
+
+- "no approval click is recorded" is evidence, not proof: a card approved directly in the Flow UI leaves no
+  trace here, and the clip is often ready seconds later. The blocked-Resume message, the Queue panel, the
+  panel's next action and ``tools/flow_resume_preflight.py`` now say so, and put the free download first;
+- a chat turn that says the generation is "queued due to high demand" is a snapshot from submit time and stays
+  in the chat after the clip is finished, so ``recover-flow-video`` no longer tells the user to wait on it: it
+  points at the project's media grid and at ``--asset-url ... --asset-reviewed``.
+
+Nothing is generated, rendered or charged by this update itself.
+
+Usage (run from the existing installation folder, after extracting the 7.0.101 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.101/tools/update_v7100_to_v7101.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.101/tools/update_v7100_to_v7101.py . --apply    # installs the code
+
+Only code and documentation are replaced. Outputs, saved jobs, Flow journals, browser profiles and
+Clip Studio folders are never copied, moved or deleted. Stop the dashboard before --apply.
+"""
+
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = ['APPROVAL_NOT_FINAL_V7_0_101.md', 'VERSION', 'app.py', 'engine/factory.py',
+           'engine/flow_pending_approval.py', 'engine/flow_resume_safety.py',
+           'tests/test_v7101_approval_not_final.py', 'tests/test_v799_approval_pending.py',
+           'tools/flow_resume_preflight.py', 'tools/update_v7100_to_v7101.py']
+# Files as they exist in 7.0.100: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['25ed9a324442540579e2ffa96084371bb6ab4c0dbc53ea39595ed0901c9dd032'],
+    'app.py': ['6bc71f731bdc4ad9022e9e7a72221c2fa3a543abdb712941fd677163bf05f02f'],
+    'engine/factory.py': ['54ba61da90646058df64607d3d04bfc3e04612c8c6475e06f71396b32adc954d'],
+    'engine/flow_pending_approval.py': ['9debc4229642ea3072664d268ccefe5076c1ed846e5639eab4546942626a92f9'],
+    'engine/flow_resume_safety.py': ['2fd666e332357077aa430f8877401427835334e4ea4984ae4444d151372df1e1'],
