+def test_fit_not_needed_when_the_narration_fits_the_picture():
+    report = narration_fit.plan(100.0, 100.0, label='Odia')
+    assert report['mode'] == 'none'
+    assert report['ratio'] == 1.0 and report['picture_scale'] == 1.0 and report['tempo'] == 1.0
+
+
+def test_fit_slows_the_picture_only_inside_the_old_25_percent_limit():
+    report = narration_fit.plan(110.0, 100.0, label='Hindi')
+    assert report['mode'] == 'fit'
+    assert report['picture_scale'] == pytest.approx(1.10)
+    assert report['tempo'] == pytest.approx(1.0)
+
+
+def test_fit_combines_picture_stretch_and_pitch_preserving_narration_speed():
+    # The field failure: an Odia script 30% longer than the approved picture used to be a dead end.
+    report = narration_fit.plan(130.0, 100.0, label='Odia')
+    assert report['mode'] == 'fit'
+    assert report['picture_scale'] == pytest.approx(1.25)
+    assert report['tempo'] == pytest.approx(1.04)
