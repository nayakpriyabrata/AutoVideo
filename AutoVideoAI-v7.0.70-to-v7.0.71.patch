+"""v7.0.71 Flow duplicate-spend guard.
+
+A fake Flow bridge counts every Send. No browser, network or credits are used.
+"""
+import json
+import os
+import sys
+from types import SimpleNamespace
+
+import pytest
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+if ROOT not in sys.path:
+    sys.path.insert(0, ROOT)
+
+from engine import flow_submit_guard as guard  # noqa: E402
+from engine.providers import flow_browser as fb  # noqa: E402
+from engine.providers.flow_browser import FlowBrowser, FlowBrowserProvider, FlowRequestPending  # noqa: E402
+
+
+PROJECT_URL = "https://flow.google.com/project/11111111-2222-3333-4444-555555555555"
+
+
+class FakeBridge:
+    """Counts credit-bearing actions. Each submit_prepared call is one Send."""
+
+    def __init__(self, prompt_occurrences=0, approval_label="Approve"):
+        self.sends = 0
+        self.approvals = 0
+        self.prompt_occurrences = prompt_occurrences
+        self.approval_label = approval_label
+        self.last_agent_confirmation = {}
+        self.last_agent_queue_observed = False
+        self.last_agent_failure = ""
+        self.last_generated_asset_signature = "sig-1"
+        self.fail_submit = False
+        self.bridge = None
+        self._page = None
+
+    # project and composer
+    def ensure_project(self, project, project_url=None):
+        return True
+
+    def current_project_url(self):
+        return PROJECT_URL
+
+    def prepare_text_video(self, aspect="9:16", model_label="", duration=8, count=1):
+        return "agent"
+
+    def media_asset_signatures(self):
+        return set()
+
+    def fill_text_video_prompt(self, prompt, strategy, **kwargs):
+        return True
+
+    def agent_submission_state(self, prompt):
+        return {"composer_matches": False, "composer_empty": True,
+                "prompt_occurrences": self.prompt_occurrences}
+
+    def submit_prepared_text_video(self, strategy):
+        if self.fail_submit:
+            raise RuntimeError("send button detached")
+        self.sends += 1
+
+    def confirm_agent_generation(self, timeout_s=12, approval="once", max_credits=None):
+        if not (getattr(self, "_approval_journal", None) and getattr(self, "_awaiting_request_id", None)):
+            # Mirrors the production refusal path for unsolicited cards.
+            self.last_agent_confirmation = {"approval": approval, "cost": None,
+                                            "clicked": None, "blocked": True,
+                                            "reason": "no outstanding request"}
+            return False
+        self.approvals += 1
+        self.last_agent_confirmation = {"approval": approval, "cost": 6, "clicked": self.approval_label,
+                                        "blocked": False}
+        # The production click path logs through the real bridge method.
+        FlowBrowser._log_approval_click(self, self.approval_label)
+        return True
+
+    def wait_for_agent_generation(self, **kwargs):
+        return True
+
+    def download_latest_asset(self, out_path, **kwargs):
+        with open(out_path, "wb") as handle:
+            handle.write(b"video")
+
+
+@pytest.fixture
+def provider(monkeypatch):
+    monkeypatch.setattr(FlowBrowserProvider, "_is_valid_video_file", staticmethod(lambda p: os.path.exists(p)))
+    monkeypatch.setattr(FlowBrowserProvider, "_asset_valid", lambda self, p, k: os.path.exists(p))
+    prov = FlowBrowserProvider.__new__(FlowBrowserProvider)
+    prov._last_video_shot_id = ""
+    prov._last_video_request_at = 0.0
+    prov._last_video_baseline = set()
+    prov._last_video_project_url = ""
+    prov._active_request_hash = "hash-test"
+    prov._awaiting_request_id = None
+    prov._fake = FakeBridge()
+    prov.bridge = prov._fake  # as in production: _ensure() returns self.bridge
+    prov._ensure = lambda: prov._fake
+    return prov
