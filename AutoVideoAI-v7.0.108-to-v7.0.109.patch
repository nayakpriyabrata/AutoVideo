+                     'prompt': str(getattr(shot, 'prompt', '') or '')[:160],
+                     'provider': str(getattr(shot, 'provider', '')),
+                     'accepted': bool(getattr(shot, 'accepted_take', '')),
+                     'eligible': reason == 'eligible', 'reason': reason})
