+def _span(value, default=0.0):
+    try:
+        return float(value)
+    except (TypeError, ValueError):
+        return float(default)
+
+
+def _stream_seconds(info):
+    """How long each track of a file really is, from the streams (v7.0.115).
+
+    ``format.duration`` is the container's opinion, and it is a single number for two tracks that can differ.
+    The export check needs them apart: a picture that stops early and a narration that stops early are different
+    defects with different repairs, and a container that merely disagrees with both is neither.
+    """
+    spans = {}
+    for stream in (info or {}).get('streams') or []:
+        kind = str(stream.get('codec_type') or '')
+        if kind not in ('video', 'audio'):
+            continue
+        seconds = _span(stream.get('duration'))
+        if seconds <= 0:
+            seconds = _span(stream.get('tags', {}).get('DURATION_TS') if isinstance(stream.get('tags'), dict)
+                            else 0)
+        if seconds > 0 and seconds > spans.get(kind, 0.0):
+            spans[kind] = seconds
+    return spans
+
+
+def _clock(seconds):
+    """m:ss, for a message a person reads."""
+    seconds = max(0.0, _span(seconds))
+    return f'{int(seconds // 60)}:{seconds % 60:04.1f}'
+
+
+def export_qc_report(path, expected, *, fit_report=None, video_padded=0.0, tolerance=0.8):
+    """Compare a finished export's two tracks with the timeline it was built from (v7.0.115).
+
+    The old check was one line - ``if abs(duration - expected) > 0.8 or no audio: raise ValueError('Export QC
+    failed: duration or audio')`` - and it threw away the finished file with the temporary folder. After a
+    fifty-nine minute render the field report was therefore five words long and the video no longer existed.
+    Now the numbers are kept, the file is kept, and the reason is named.
+
+    ``problems`` is what must stop the export; ``notes`` is what is worth saying but does not.
+    """
+    info, container = _probe(path)
+    spans = _stream_seconds(info)
+    kinds = {str(stream.get('codec_type') or '') for stream in (info or {}).get('streams') or []}
+    container = _span(container)
+    # A stream that does not state its own duration is not a broken stream: fall back to the container rather than
+    # inventing a defect. Only a track that is *absent* is a finding.
+    video = spans.get('video') or (container if 'video' in kinds else 0.0)
+    audio = (spans.get('audio') or container) if 'audio' in kinds else None
+    problems, notes = [], []
+    if audio is None:
+        problems.append('the finished file has no audio track')
+    if video <= 0:
+        problems.append('the finished file has no readable picture')
+    duration = round(container, 3)
+    if video > 0 and video < expected - tolerance:
+        problems.append(f'the picture stops at {_clock(video)} but the timeline runs to {_clock(expected)}')
+    if audio is not None and audio < expected - tolerance:
+        problems.append(f'the audio stops at {_clock(audio)} but the timeline runs to {_clock(expected)}')
+    if not problems and abs(duration - expected) > tolerance:
+        # Both tracks are right and only the container's own duration disagrees. That is a muxer quirk, not a
+        # broken video, and re-rendering it for an hour would produce the same file.
+        notes.append(f'the file header says {_clock(duration)} while its tracks run to {_clock(max(video, audio or 0))}'
+                     '; the tracks are what plays')
+    fit = dict(fit_report or {})
+    report = {'expected_seconds': round(_span(expected), 3), 'container_seconds': duration,
+              'video_seconds': round(video, 3), 'audio_seconds': None if audio is None else round(audio, 3),
+              'tolerance_seconds': tolerance, 'problems': problems, 'notes': notes,
+              'video_padded_seconds': round(_span(video_padded), 3),
+              'fit_mode': fit.get('mode'), 'fit_picture_scale': fit.get('picture_scale'),
+              'fit_tempo': fit.get('tempo'), 'fit_hold_seconds': fit.get('hold_seconds'),
+              'checked_at': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}
+    return report
+
+
+def export_qc_message(report, *, language_label='this language', kept_path=''):
+    """The sentence a failed export is reported with: the numbers, the cause, and where the file went."""
+    problems = list(report.get('problems') or [])
+    lines = ['Export QC failed: ' + '; '.join(problems) + '.',
+             f'Expected a {_clock(report["expected_seconds"])} {language_label} video and got '
+             f'{_clock(report["container_seconds"])} (picture {_clock(report["video_seconds"])}, '
+             + ('no audio' if report.get('audio_seconds') is None else 'audio ' + _clock(report['audio_seconds']))
+             + ').']
+    if report.get('fit_mode') and report.get('fit_mode') != 'none':
+        lines.append(f'The narration had been fitted to the picture (picture x{report.get("fit_picture_scale")}, '
+                     f'narration x{report.get("fit_tempo")}'
+                     + (f', last frame held {report.get("fit_hold_seconds")}s'
+                        if report.get('fit_hold_seconds') else '') + ').')
+    if report.get('video_padded_seconds'):
+        lines.append(f'The picture was already extended by {report["video_padded_seconds"]:.2f}s to meet the '
+                     'narration, and it still came up short.')
+    if kept_path:
+        lines.append('The file this render produced is kept at ' + str(kept_path) +
+                     ' - it is complete enough to play, but it is not marked current because it failed this check.')
+    lines.append('Nothing was deleted. The check compares the finished file with the timeline it was built from, '
+                 'so a language can be rendered again from its saved narration: no voice is re-recorded and no '
+                 'Flow credit is spent.')
+    return '\n'.join(lines)
+
