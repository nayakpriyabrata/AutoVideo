@@ -0,0 +1,298 @@
+"""v7.0.115: the export check that said five words, and deleted the video it was checking.
+
+Field report, on 7.0.114 - the release that finally made a plain render repair the Odia edition:
+
+    [ 73%] Rendering Odia edition Odia
+    [100%] Language editions finished
+    "status": "failed",
+    "error": "Export QC failed: duration or audio"
+
+Fifty-nine minutes of rendering, and that was everything the user learned. The check itself was one line:
+
+    if abs(final_duration - full_duration) > 0.8 or not any(s.get('codec_type') == 'audio' ...):
+        raise ValueError('Export QC failed: duration or audio')
+
+and it ran inside the ``try`` whose ``finally`` deletes the temporary folder - so the finished ``result.mp4`` was
+deleted with it. No numbers, no file, no cause, nothing to play and nothing to inspect.
+
+v7.0.115 changes three things, and these tests hold them:
+
+* **measure the two tracks separately.** "The picture stops early" and "the narration stops early" are different
+  defects with different repairs, and a container whose header merely disagrees with both is neither - that one is
+  accepted with a note instead of costing another hour;
+* **keep the file.** A failed check copies the finished video beside the plan as ``result-<lang>.qc-failed.mp4``
+  and writes ``qc-<lang>.json`` with the numbers, so the job can say "the render did produce a file, here it is";
+* **pad the picture to the timeline before the expensive pass.** When the concatenated picture is even slightly
+  shorter than the container says, the last frame is extended (free) instead of the export landing short and
+  failing after the encode.
+"""
+import json
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+needs_ffmpeg = pytest.mark.skipif(not (shutil.which('ffmpeg') and shutil.which('ffprobe')),
+                                  reason='FFmpeg required')
+os.environ.setdefault('HOME', '/tmp')
+
+WORDS = [{'word': 'ଶବ୍ଦ' + str(i), 'start': 0.3 + i * 0.75, 'end': 0.3 + i * 0.75 + 0.6} for i in range(10)]
+FIT = {'allow_hold': 8.0, 'hold_cap': 8.0}
+
+
+def _video(path, seconds, *, audio=False):
+    cmd = ['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i',
+           f'testsrc2=size=640x360:rate=24:duration={seconds}']
+    if audio:
+        cmd += ['-f', 'lavfi', '-i', f'sine=frequency=440:sample_rate=48000:duration={seconds}',
+                '-c:a', 'aac', '-map', '0:v:0', '-map', '1:a:0']
+    else:
+        cmd += ['-an']
+    cmd += ['-c:v', 'libx264', '-pix_fmt', 'yuv420p', str(path)]
+    subprocess.run(cmd, check=True)
+    return path
+
+
+def _job(tmp_path, *, narration_seconds=7.8, picture_seconds=6.0, transcript=False):
+    from engine.production import digest
+    job = tmp_path / 'job'
+    (job / 'render').mkdir(parents=True)
+    (job / 'production').mkdir()
+    picture = _video(job / 'render' / 'visual-master.mp4', picture_seconds)
+    (job / 'production' / 'visual_master.json').write_text(json.dumps(
+        {'path': str(picture), 'sha256': digest(picture), 'duration': picture_seconds}), encoding='utf-8')
+    folder = job / 'speech-editions' / 'or' / 'key'
+    folder.mkdir(parents=True)
+    voice = folder / 'voice.wav'
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-f', 'lavfi', '-i',
+                    'sine=frequency=700:sample_rate=44100', '-t', str(narration_seconds),
+                    '-c:a', 'pcm_s16le', str(voice)], check=True)
+    (folder / 'words.json').write_text(json.dumps(WORDS, ensure_ascii=False), encoding='utf-8')
+    bundle = {'audio': str(voice), 'audio_sha256': digest(voice), 'duration': narration_seconds,
+              'words': str(folder / 'words.json'), 'script': ' '.join(word['word'] for word in WORDS),
+              'language': 'or', 'timing_source': 'test', 'cards': [], 'text_cards': False}
+    state = {'source_language': 'en', 'editions': ['en', 'or'], 'profiles': {'or': None},
+             'bundles': {'or': bundle}, 'transcript': {'default': transcript, 'languages': {}}}
+    (job / 'production' / 'language_editions.json').write_text(json.dumps(state, ensure_ascii=False),
+                                                               encoding='utf-8')
+    return job
+
+
+def _entry(job, code='or'):
+    from engine.language_editions import _record_path
+    return json.loads(_record_path(job).read_text(encoding='utf-8'))['editions'][code]
+
+
+# ------------------------------------------------------------------ the check itself, with numbers
+
+
+@needs_ffmpeg
+def test_a_good_export_passes_without_notes(tmp_path):
+    from engine.finishing_studio import export_qc_report
+    path = _video(tmp_path / 'ok.mp4', 6.0, audio=True)
+    report = export_qc_report(path, 6.0)
+    assert report['problems'] == [] and report['notes'] == []
+    assert report['audio_seconds'] and report['video_seconds']
+    assert report['expected_seconds'] == 6.0
+
+
+@needs_ffmpeg
+def test_a_missing_audio_track_is_named(tmp_path):
+    from engine.finishing_studio import export_qc_report, export_qc_message
+    path = _video(tmp_path / 'silent.mp4', 6.0, audio=False)
+    report = export_qc_report(path, 6.0)
+    assert 'the finished file has no audio track' in report['problems']
+    message = export_qc_message(report)
+    assert 'no audio' in message and 'Expected a 0:06.0' in message
+
+
+@needs_ffmpeg
+def test_a_picture_that_stops_early_says_so_in_seconds(tmp_path):
+    from engine.finishing_studio import export_qc_report, export_qc_message
+    path = _video(tmp_path / 'short.mp4', 4.0, audio=True)
+    report = export_qc_report(path, 6.0)
+    problem = ' '.join(report['problems'])
+    assert 'the picture stops at 0:04.0' in problem and 'runs to 0:06.0' in problem
+    message = export_qc_message(report, language_label='Odia', kept_path=str(tmp_path / 'kept.mp4'))
+    assert 'Export QC failed' in message
+    assert 'Odia' in message and str(tmp_path / 'kept.mp4') in message
+    assert 'No voice is re-recorded' not in message        # sentence case, but the promise is there
+    assert 'no voice is re-recorded' in message and 'no Flow credit' in message
+
+
+def test_a_container_that_disagrees_with_its_own_tracks_is_a_note_not_a_failure(monkeypatch):
+    """An mp4 header can be off by a second while both tracks are right - do not re-render an hour for that."""
+    from engine import finishing_studio as finish
+    monkeypatch.setattr(finish, '_probe', lambda path: (
+        {'streams': [{'codec_type': 'video', 'duration': '300.0'},
+                     {'codec_type': 'audio', 'duration': '300.0'}],
+         'format': {'duration': '297.5'}}, 297.5))
+    report = finish.export_qc_report('anything.mp4', 300.0)
+    assert report['problems'] == []
+    assert 'the file header says' in ' '.join(report['notes'])
+    assert 'tracks are what plays' in ' '.join(report['notes'])
+
+
+def test_a_stream_that_does_not_state_a_duration_is_not_a_defect(monkeypatch):
+    """Some mp4s omit per-stream durations. Falling back to the container must never fail a good export."""
+    from engine import finishing_studio as finish
+    monkeypatch.setattr(finish, '_probe', lambda path: (
+        {'streams': [{'codec_type': 'video'}, {'codec_type': 'audio'}],
+         'format': {'duration': '300.0'}}, 300.0))
+    report = finish.export_qc_report('anything.mp4', 300.0)
+    assert report['problems'] == []
+    assert report['video_seconds'] == 300.0 and report['audio_seconds'] == 300.0
+
+
+def test_a_fitted_export_that_comes_up_short_names_the_fit(monkeypatch):
+    from engine import finishing_studio as finish
+    monkeypatch.setattr(finish, '_probe', lambda path: (
+        {'streams': [{'codec_type': 'video', 'duration': '250.0'},
+                     {'codec_type': 'audio', 'duration': '300.0'}],
+         'format': {'duration': '300.0'}}, 300.0))
+    report = finish.export_qc_report('anything.mp4', 300.0, fit_report={
+        'mode': 'hold', 'picture_scale': 1.25, 'tempo': 1.12, 'hold_seconds': 14.0}, video_padded=0.5)
+    message = finish.export_qc_message(report, language_label='Odia')
+    assert 'picture x1.25' in message and 'narration x1.12' in message
+    assert 'last frame held 14.0s' in message
+    assert 'already extended by 0.50s' in message
+
+
+def test_a_picture_that_lost_frames_is_extended_to_the_timeline(tmp_path):
+    """The cheap repair: the fitted/concat picture is short of the timeline, so clone its last frame."""
+    from engine import finishing_studio as finish
+    joined = _video(tmp_path / 'joined.mp4', 6.0, audio=True)
+    info, duration = finish._probe(joined)
+    spans = finish._stream_seconds(info)
+    assert spans['video'] > 5.0 and abs(duration - 6.0) < 0.3
+    # exactly what render() computes before the expensive pass
+    padded = round(max(0.0, duration - spans['video']), 3)
+    assert padded < 0.04                   # a healthy file needs no padding
+    # and a file whose picture is 1.2s shorter does
+    assert round(max(0.0, 6.0 - 4.8), 3) == 1.2
+
+
+# ------------------------------------------------------------------ the render keeps what it made
+
+
+@needs_ffmpeg
+def test_a_successful_render_records_its_own_check(tmp_path):
+    from engine.language_editions import render_job_editions
+    job = _job(tmp_path)
+    report = render_job_editions(job, fit_policy=FIT)
+    assert report['status'] == 'exported', report
+    entry = _entry(job)
+    plan_folder = Path(entry['plan']).parent
+    qc = json.loads((plan_folder / 'qc-or.json').read_text(encoding='utf-8'))
+    assert qc['problems'] == []
+    assert abs(qc['expected_seconds'] - qc['video_seconds']) < 0.8
+    provenance = json.loads(Path(entry['path']).with_suffix('.provenance.json').read_text(encoding='utf-8'))
+    checked = provenance['export_qc']
+    assert checked['video_padded_seconds'] == 0.0 and checked['notes'] == []
+    assert checked['expected_seconds'] == qc['expected_seconds']
+    assert provenance['duration'] == checked['container_seconds']
+    assert provenance['captions_burned'] is False
+
+
+@needs_ffmpeg
+def test_a_failed_check_keeps_the_video_and_the_numbers(tmp_path, monkeypatch):
+    from engine import finishing_studio as finish
+    from engine.language_editions import render_job_editions
+    job = _job(tmp_path)
+    real = finish.export_qc_report
+
+    def strict(path, expected, **kwargs):
+        report = real(path, expected, **kwargs)
+        # the same shape the field failure had: the picture is short of the timeline
+        report['problems'] = ['the picture stops at 0:54.0 but the timeline runs to 1:01.4']
+        return report
+    monkeypatch.setattr(finish, 'export_qc_report', strict)
+    failed = render_job_editions(job, fit_policy=FIT)
+    assert failed['status'] == 'failed'
+    entry = _entry(job)
+    assert entry['status'] == 'failed'
+    assert 'the picture stops at 0:54.0' in entry['error']
+    assert 'The file this render produced is kept at' in entry['error']
+    kept = Path(entry['qc_failed_export'])
+    assert kept.is_file() and kept.suffix == '.mp4' and kept.stat().st_size > 0
+    assert 'qc-failed' in kept.name
+    qc = json.loads((Path(entry['plan']).parent / 'qc-or.json').read_text(encoding='utf-8'))
+    assert qc['problems'] and qc['kept'] == str(kept)
+    assert qc['expected_seconds'] > 0 and qc['video_seconds'] > 0
+    # the temporary folder is gone, the evidence is not
+    assert not list(Path(entry['plan']).parent.glob('.render-*'))
+
+
+@needs_ffmpeg
+def test_the_job_says_the_failed_render_did_produce_a_file(tmp_path, monkeypatch):
+    from engine import finishing_studio as finish
+    from engine import edition_files
+    from engine.language_editions import render_job_editions, edition_diagnosis
+    job = _job(tmp_path)
+
+    real = finish.export_qc_report
+
+    def strict(path, expected, **kwargs):
+        report = dict(real(path, expected, **kwargs))
+        report['problems'] = ['the picture stops at 0:54.0 but the timeline runs to 1:01.4']
+        return report
+    monkeypatch.setattr(finish, 'export_qc_report', strict)
+    render_job_editions(job, fit_policy=FIT)
+    entry = _entry(job)
+    assert entry['qc_failed_export']
+
+    row = edition_diagnosis(job)['editions']['or']
+    assert 'The render did produce a file' in row['message']
+    assert entry['qc_failed_export'] in row['message']
+    assert 'not marked current' in row['message']
+
+    data = edition_files.report(job)
+    problems = '\n'.join(data['editions']['or']['problems'])
+    assert 'failed the export check' in problems
+    assert entry['qc_failed_export'] in problems
+    assert 'Play it before spending another render on it' in problems
+    listing = '\n'.join(edition_files.format_report(data))
+    assert 'the render produced a file that failed the export check: ' + entry['qc_failed_export'] in listing
+
+
+@needs_ffmpeg
+def test_no_current_export_but_files_on_disk_are_named(tmp_path):
+    """Three field reports in a row said "no current video yet" while finished videos sat in the folder."""
+    from engine import edition_files
+    from engine.language_editions import render_job_editions, _record_path
+    job = _job(tmp_path, transcript=True)
+    first = render_job_editions(job, fit_policy=FIT)
+    old = Path(first['editions']['or']['path'])
+    assert old.is_file()
+    record = json.loads(_record_path(job).read_text(encoding='utf-8'))
+    record['editions']['or'] = {'status': 'failed', 'error': 'FFmpeg failed: something', 'captions': True}
+    _record_path(job).write_text(json.dumps(record), encoding='utf-8')
+
+    data = edition_files.report(job)
+    row = data['editions']['or']
+    assert row['current'] is None
+    problems = '\n'.join(row['problems'])
+    assert 'has no current export, but one finished Odia video is still on disk' in problems
+    assert str(old) in problems and 'captions: yes' in problems
+    summary = ' '.join(edition_files.summary(job))
+    assert 'no current video · newest one on disk: ' + old.name in summary
+    assert 'captions: yes' in summary
+
+
+@needs_ffmpeg
+def test_a_language_that_failed_can_still_be_rendered_again(tmp_path, monkeypatch):
+    from engine import finishing_studio as finish
+    from engine.language_editions import render_job_editions
+    job = _job(tmp_path)
+    real = finish.export_qc_report
+    monkeypatch.setattr(finish, 'export_qc_report',
+                        lambda path, expected, **kwargs: dict(real(path, expected, **kwargs)) | {
+                            'problems': ['the picture stops at 0:02.0 but the timeline runs to 0:06.0']})
+    assert render_job_editions(job, fit_policy=FIT)['status'] == 'failed'
+    monkeypatch.undo()
+    again = render_job_editions(job, fit_policy=FIT)
+    assert again['status'] == 'exported'
+    assert Path(again['editions']['or']['path']).is_file()
+    assert 'qc_failed_export' not in _entry(job)
