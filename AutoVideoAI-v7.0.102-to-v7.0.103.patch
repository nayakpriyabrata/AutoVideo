+#!/usr/bin/env python3
+"""Apply the v7.0.103 update to a v7.0.102 installation.
+
+Field case: a production stopped with
+
+    Video Flow project must differ from storyboard image project
+
+and the job stayed ``status=planned``, so it was impossible to tell whether it was still running. Root cause:
+v7.0.99's video recovery wrote the *video* project into the job's **stills** binding, so the next run found both
+roles on one project and refused to start.
+
+v7.0.103:
+
+- ``flow_project_bindings()`` / ``flow_project_conflict_message()`` name both roles, the file each value comes
+  from, whether they collide and the exact repair commands;
+- the guard pauses the job (never leaves it "planned"), logs ``flow_project_conflict`` and raises the full
+  explanation - nothing is generated or charged;
+- ``recover_flow_video`` binds the video role only, so recovery can no longer overwrite the stills binding;
+- ``cli.py v3 flow-projects <job>`` reports both bindings and repairs them explicitly
+  (``--set-stills``, ``--set-video``, ``--clear-stills``, ``--clear-video``, each needing ``--confirm``);
+- ``cli.py v3 status <job>`` says whether a live process holds the job, and if not, what stopped it and why;
+- the Job panel shows both bindings, the explanation and the copy-ready repairs.
+
+Nothing is generated, rendered or charged by this update itself.
+
+Usage (run from the existing installation folder, after extracting the 7.0.103 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.103/tools/update_v7102_to_v7103.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.103/tools/update_v7102_to_v7103.py . --apply    # installs the code
+
+Only code and documentation are replaced. Outputs, saved jobs, Flow journals, browser profiles and
+Clip Studio folders are never copied, moved or deleted. Stop the dashboard before --apply.
+"""
+
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = ['FLOW_PROJECT_CONFLICT_V7_0_103.md', 'VERSION', 'app.py', 'cli.py', 'engine/factory.py',
+           'engine/flow_projects_cli.py', 'engine/job_activity.py',
+           'tests/test_v7103_project_conflict.py', 'tools/update_v7102_to_v7103.py']
+# Files as they exist in 7.0.102: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['17f2d0e934c795eaa2a9235cfd235c863775ba5813a51abe2cc520c1ee8652a4'],
+    'app.py': ['165370aaa52a8b1a86c5e1a8f75cf3d5259f35de4c8fe8c7c675a66e92d5df43'],
+    'cli.py': ['f5dffa264ead90d9bf984d42d5989640bad2dc8a88523c5256d792576829718a'],
+    'engine/factory.py': ['08732c159629b6b3b7e9673994d2aba88050a72462823f96a644d1f0dc191edf'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.102', '7.0.103')  # 7.0.103 allows a safe re-run after success
+
+# The 7.0.102 zip carries the 7.0.101 to 7.0.102 update; apply that first on an older installation.
+EARLIER_STEPS = [
+    ('7.0.101', '7.0.102', 'tools/update_v7101_to_v7102.py'),
+]
+
+
+def chain_message(current):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.102 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.102 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.102 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this 7.0.103 update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current))
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the 7.0.103 folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        if destination.exists() and sha(destination) not in ALLOWED.get(name, []) + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+    plan = {'target': str(target), 'installed_version': current, 'apply': args.apply,
+            'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every 7.0.103 code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v7.0.102-to-v7.0.103-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix='.code-update-')
+                with os.fdopen(descriptor, 'wb') as handle:
+                    handle.write((source / name).read_bytes())
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, destination)
+                installed.append((name, existed))
+        except Exception:
+            for name, existed in reversed(installed):
+                if existed:
+                    shutil.copy2(backup / name, target / name)
+                else:
+                    (target / name).unlink(missing_ok=True)
+            raise
+        print('Updated to 7.0.103. Code backup: ' + str(backup))
+        print('Restart the dashboard (./dashboard.sh or dashboard.bat).')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, RuntimeError, OSError) as error:
+        print('Update stopped: ' + str(error))
+        raise SystemExit(1)
