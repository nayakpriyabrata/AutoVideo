# AutoVideoAI v5 - every API integration is optional.
# Copy this file to .env and add only the services you want.

# ---------- Free-first script + Gemini TTS ----------
# Google AI Studio API key. Separate from Gemini browser subscriptions.
GEMINI_API_KEY=
# GOOGLE_API_KEY=                 # accepted alias for GEMINI_API_KEY
# Select actual available IDs: python3 -m engine.providers.gemini_models
GEMINI_SCRIPT_MODEL=
GEMINI_CLIP_MODEL=
GEMINI_TTS_VOICE=Kore

# ---------- Groq: script fallback + excellent caption timing ----------
GROQ_API_KEY=
GROQ_SCRIPT_MODEL=openai/gpt-oss-120b
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy

# ---------- Optional premium script providers ----------
OPENAI_API_KEY=
OPENAI_SCRIPT_MODEL=gpt-6-luna
XAI_API_KEY=
XAI_SCRIPT_MODEL=grok-4-fast

# ---------- Optional ElevenLabs narration ----------
ELEVENLABS_API_KEY=
# ELEVENLABS_KEY=                 # accepted alias
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# ---------- Local/free script + narration ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_SCRIPT_MODEL=llama3.2
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0

# ---------- AI video / stock (existing) ----------
VEO_MODEL=veo-3.1-fast-generate-preview
FAL_KEY=
FAL_ENDPOINT=
PEXELS_API_KEY=
PIXABAY_API_KEY=
COMFY_URL=http://127.0.0.1:8188
COMFY_WORKFLOW=assets/comfy_workflow.json

# ---------- v5.1 storage safety ----------
# Auto mode does NOT load Kokoro/Torch unless explicitly enabled. This avoids
# multi-GB CUDA/model downloads on storage-constrained laptops.
AUTOVIDEO_ENABLE_LOCAL_TTS=0
AUTOVIDEO_MIN_FREE_GB=1.5
AUTOVIDEO_WARN_FREE_GB=5.0

# MovieFlow Studio browser automation (optional cartoon provider)
# By default MovieFlow reuses the normal browser/CDP setup. Set these only if
# you want a different debug Chrome/session for MovieFlow.
MOVIEFLOW_BROWSER_MODE=
MOVIEFLOW_CDP_URL=
MOVIEFLOW_BROWSER_CHANNEL=
MOVIEFLOW_BROWSER_EXE=

# v5.5 Gemini Web writer (no API key required; manual Google sign-in once)
# Explicit --script-provider gemini-web always enables it.
AUTOVIDEO_ENABLE_GEMINI_WEB=0
GEMINI_WEB_RESPONSE_TIMEOUT=300
GEMINI_WEB_LOGIN_WAIT=300
# Optional independent browser transport overrides:
GEMINI_WEB_BROWSER_MODE=auto
GEMINI_WEB_CDP_URL=
