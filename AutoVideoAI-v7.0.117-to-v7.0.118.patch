+#!/usr/bin/env python3
+"""Apply the v7.0.118 update to a v7.0.117 installation.
+
+The field sequence that produced this release: a 3-language job (English/Hindi/Odia, 360 s, Storyboard Economy,
+"Create plan only", Flow approval "once") died on the final submit of the Create page with
+
+    TypeError: Factory.create_job() got an unexpected keyword argument 'flow_auto_approve_video_requests'
+
+and the Gemini video option could not be found in the app at all.
+
+1. Every "Create production" submit since v7.0.106 was broken. ``engine/studio_config.DEFAULTS`` had carried
+   ``flow_auto_approve_video_requests`` since v7.0.106, and the Studio form sends the whole config to
+   ``Factory.create_job()`` - which never learned the keyword. The CLI passes its arguments one by one, so it kept
+   working; only the app failed, and it failed *after* the form was filled in.
+   - ``create_job()`` now accepts the keyword, saves it in the job's ``settings.json`` and reads it back, so
+     unticking the switch really does turn automatic approval off.
+   - ``python3 cli.py v3 self-check`` answers "is this folder one consistent release?" in seconds: VERSION,
+     engine imports, the Studio <-> ``create_job()`` keyword agreement, and the render/edition modules. A mismatch
+     now names the setting, the file and the repair instead of raising a bare TypeError.
+   - ``python3 cli.py v3 create --no-auto-approve-flow-videos`` writes the same choice from the command line.
+
+2. The Gemini video shots were in the app, inside a collapsed expander called "Gemini video and project
+   cleanup" - it read as a cleanup option. It is now a visible section, **3b · AI video shots · Flow or
+   Gemini Web**, with the shot count, the approval switch and a plain explanation of where the *exact* shots are
+   picked. The job panel's "Gemini Web video shots" picker can also change the cap of an existing job
+   (``--count 0-4`` on the CLI), and a job with no storyboard now says so instead of claiming every shot already
+   has a video.
+
+Nothing is rendered, re-recorded or charged by this update. No job is created. This release only makes the Create
+button work and the Gemini choice findable.
+
+Usage (run from the existing installation folder, after extracting the 7.0.118 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.118/tools/update_v7117_to_v7118.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.118/tools/update_v7117_to_v7118.py . --apply    # installs the code
+
+Only code, documentation and tests are replaced. Outputs, saved jobs, Flow journals, browser profiles and
+``music_library/`` are never copied, moved or deleted. Stop the dashboard before --apply.
+"""
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = [
+    'VERSION', 'app.py', 'cli.py',
+    'engine/factory.py', 'engine/studio_config.py', 'engine/self_check.py',
+    'engine/providers/gemini_video.py',
+    'tests/test_v7118_studio_create_and_gemini_ui.py',
+    'STUDIO_SUBMIT_AND_GEMINI_V7_0_118.md', 'tools/update_v7117_to_v7118.py',
+]
+# Files as they exist in 7.0.117: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['7b35e40ad39ee364d9acdadf65478b1eeb83d096f492dc8655243c35aa71437b'],
+    'app.py': ['6aee28eabf0e07d590771d365ef18cfbe99ab71b26ba37b29f336ff0e041781a'],
+    'cli.py': ['2ad9e2ccce9964efeccbe08c820eb1ac77313c1c0d53464e79103c54a8f33bd2'],
+    'engine/factory.py': ['68201714056f62c4b1dfc0c88ae6a4163b2b1d2b192ad2e034b6bac106e53ddb'],
+    'engine/studio_config.py': ['c3d5b51dc7a771976213cf67b47eaab69ea7c8c873d435bcabb05f62bcf7c0dd'],
+    'engine/providers/gemini_video.py': ['e8f8692ce596e5e9b533b2ccfa0552a3ad3b280f54756cb5602d9338efdc1504'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.117', '7.0.118')  # 7.0.118 allows a safe re-run after success
+
+# The 7.0.118 zip carries the 7.0.117 update; apply that first on an older installation.
+EARLIER_STEPS = [
+    ('7.0.116', '7.0.117', 'tools/update_v7116_to_v7117.py'),
+]
+
+
+def chain_message(current, version):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.117 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.117 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.117 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this ' + version + ' update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current, source.name or '7.0.118'))
+    new_version = (source / 'VERSION').read_text(encoding='utf-8').strip()
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the ' + new_version +
+                         ' folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
+            raise ValueError('Refusing symlink code target: ' + name)
+        allowed = ALLOWED.get(name, [])
+        if destination.exists() and allowed and sha(destination) not in allowed + [expected[name]]:
+            raise ValueError('Unexpected local code changes; preserved: ' + name + '. Nothing was changed.')
+        if destination.exists() and not allowed and sha(destination) != expected[name]:
+            # A file this release introduces (engine/self_check.py) must not overwrite a different file that
+            # already sits at that path - the same promise as for an edited file, applied to a new one.
+            raise ValueError('A different file already exists where this update installs ' + name +
+                             '; preserved it and changed nothing. Move it aside and run the update again.')
+    plan = {'target': str(target), 'installed_version': current, 'new_version': new_version,
+            'apply': args.apply, 'code_files': CHANGES, 'runtime_data_copied': False}
+    print(json.dumps(plan, indent=2))
+    if not args.apply:
+        print('Dry run only. Run again with --apply to install. Stop the dashboard first.')
+        return
+
+    lockroot = Path.home() / '.local/share/autovideoai'
+    lockroot.mkdir(parents=True, exist_ok=True)
+    with (lockroot / 'production.lock').open('a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('Production is active; stop it before updating')
+        pending = [name for name in CHANGES
+                   if not ((target / name).is_file() and sha(target / name) == expected[name])]
+        if not pending:
+            print('Already up to date: every ' + new_version + ' code file is installed. Nothing was changed.')
+            return
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
+        backup = target / 'code-update-backups' / ('v' + current + '-to-v' + new_version + '-' + stamp)
+        installed = []
+        try:
+            for name in pending:
+                destination = target / name
+                existed = destination.exists()
+                if existed:
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(destination, saved)
