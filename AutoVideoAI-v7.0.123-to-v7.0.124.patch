diff -rN -u '--exclude=outputs' '--exclude=data' '--exclude=logs' '--exclude=__pycache__' '--exclude=.pytest_cache' a/tests/test_v7124_quiet_browser_all_os.py b/tests/test_v7124_quiet_browser_all_os.py
--- a/tests/test_v7124_quiet_browser_all_os.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_v7124_quiet_browser_all_os.py	2026-11-02 09:30:43.000000000 +0000
@@ -0,0 +1,347 @@
+"""v7.0.124: Quiet browser hides the window on every OS, and never on a headless login.
+
+The field report was exact: *"can we do something which will not show me the annoying pop-up chromium
+browser during the video generation process … this creates an issue when I am sharing my screen."*
+Quiet browser existed but raised ``Quiet browser currently supports Linux/WSL only`` everywhere else,
+so on Windows the popup was unavoidable - and the SETTINGS box said so.
+
+These tests pin the cross-platform contract:
+
+* Windows/macOS park a **headed** window off-screen and mute it - never ``--headless``, because Google
+  refuses a headless sign-in and Flow needs real downloads;
+* Linux/WSL keeps the private hidden X display exactly as before;
+* ``browser_environment()`` still refuses to fall back to a visible browser when Xvfb is missing;
+* a caller can force a visible window for the one thing that needs it - the first manual sign-in;
+* *Show browser* moves the **same running window** (CDP bounds), never a restart;
+* a sign-in wall reveals the hidden window by itself and hides it again once signed in;
+* Flow Music is quiet too, without stealing the Flow window handle.
+"""
+import json
+
+import pytest
+
+from engine import quiet_browser as quiet
+from engine.providers.flow_browser import FlowBrowser
+
+
+@pytest.fixture()
+def on_windows(monkeypatch):
+    """Pretend to be Windows. Only the two probes quiet mode branches on are patched - touching
+    ``os.name`` would break ``pathlib`` for the whole interpreter."""
+    monkeypatch.setattr(quiet, 'platform', lambda: 'windows')
+    monkeypatch.setattr(quiet, 'uses_virtual_display', lambda: False)
+
+
+@pytest.fixture()
+def on_linux_display(monkeypatch):
+    monkeypatch.setattr(quiet, 'platform', lambda: 'linux')
+    monkeypatch.setattr(quiet, 'uses_virtual_display', lambda: True)
+
+
+# --------------------------------------------------------------------------- #
+# The hidden window is headed, off-screen and silent
+# --------------------------------------------------------------------------- #
+def test_hidden_window_is_off_screen_and_muted():
+    args = quiet.hidden_window_args()
+    assert '--window-position=-32000,-32000' in args
+    assert '--mute-audio' in args
+    assert not any('headless' in arg for arg in args)
+
+
+def test_quiet_launch_on_windows_hides_the_window_without_headless(on_windows, monkeypatch):
+    monkeypatch.setattr(quiet, 'debug_port_args', lambda: ([], 0))
+    plan = quiet.launch_plan({'quiet': True})
+    assert plan['transport'] == 'quiet-hidden-window'
+    assert plan['env'] is None
+    assert '--window-position=-32000,-32000' in plan['args']
+    assert not any('headless' in arg for arg in plan['args'])
+
+
+def test_quiet_launch_on_linux_still_uses_the_private_display(on_linux_display, monkeypatch):
+    monkeypatch.setattr(quiet, 'browser_environment', lambda: {'DISPLAY': ':81'})
+    plan = quiet.launch_plan({'quiet': True})
+    assert plan['transport'] == 'quiet-x11' and plan['env'] == {'DISPLAY': ':81'}
+    assert '--ozone-platform=x11' in plan['args']
+
+
+def test_quiet_off_launches_nothing_special(on_windows):
+    assert quiet.launch_plan({'quiet': False}) is None
+    assert quiet.launch_plan({}) is None
+
+
+def test_a_missing_virtual_display_never_opens_a_visible_browser(on_linux_display, monkeypatch):
+    monkeypatch.setattr(quiet.shutil, 'which', lambda name: None)
+    with pytest.raises(RuntimeError, match='did not open a visible browser'):
+        quiet.browser_environment()
+
+
+def test_the_display_helper_stays_linux_only(on_windows):
+    with pytest.raises(RuntimeError, match='did not open a visible browser'):
+        quiet.browser_environment()
+
+
+def test_settings_explains_this_os(on_windows):
+    text = quiet.status_text({'quiet': True})
+    assert 'off-screen' in text and 'screen share' in text
+    assert 'Linux/WSL' not in text
+    assert 'off' in quiet.status_text({'quiet': False})
+
+
+# --------------------------------------------------------------------------- #
+# The launcher really uses it
+# --------------------------------------------------------------------------- #
+class _FakeContext:
+    def __init__(self):
+        self.pages = []
+
+    def new_page(self):
+        return object()
+
+    def close(self):
+        pass
+
+
+class _FakePlaywright:
+    def __init__(self):
+        self.calls = []
+        self.chromium = self
+
+    def launch_persistent_context(self, profile, **kwargs):
+        self.calls.append(kwargs)
+        return _FakeContext()
+
+
+def _browser(tmp_path, monkeypatch, bcfg, headless=False, override=None):
+    monkeypatch.setattr(quiet, 'debug_port_args', lambda: ([], 0))
+    browser = FlowBrowser.__new__(FlowBrowser)
+    browser.bcfg = bcfg
+    browser.headless = headless
+    browser.profile_dir = str(tmp_path / 'profile')
+    browser._pw = _FakePlaywright()
+    browser._ctx = browser._page = None
+    browser._guard_page = None
+    browser._own_context = False
+    browser.active_browser = '?'
+    if override is not None:
+        browser.quiet_override = override
+    return browser
+
+
+def test_a_quiet_job_launches_headed_and_off_screen(tmp_path, monkeypatch, on_windows):
+    browser = _browser(tmp_path, monkeypatch, {'quiet': True, 'mode': 'bundled'})
+    browser._launch_persistent({'kind': 'bundled'})
+    call = browser._pw.calls[0]
+    assert call['headless'] is False                       # never a headless Google session
+    assert '--window-position=-32000,-32000' in call['args']
+    assert '--mute-audio' in call['args']
+    assert 'quiet-hidden-window' in browser.active_browser
+
+
+def test_an_ordinary_job_is_untouched_by_quiet_mode(tmp_path, monkeypatch, on_windows):
+    browser = _browser(tmp_path, monkeypatch, {'mode': 'bundled'})
+    browser._launch_persistent({'kind': 'bundled'})
+    call = browser._pw.calls[0]
+    assert not any('window-position' in arg for arg in call['args'])
+    assert call['headless'] is False and browser.active_browser.endswith('[native]')
+
+
+def test_a_login_can_force_a_visible_window(tmp_path, monkeypatch, on_windows):
+    browser = _browser(tmp_path, monkeypatch, {'quiet': True, 'mode': 'bundled'}, override=False)
+    assert browser.quiet_on() is False
+    browser._launch_persistent({'kind': 'bundled'})
+    assert not any('window-position' in arg for arg in browser._pw.calls[0]['args'])
+
+
+def test_quiet_still_refuses_to_hide_a_cdp_browser_you_own(tmp_path, monkeypatch, on_windows):
+    browser = _browser(tmp_path, monkeypatch, {'quiet': True, 'mode': 'cdp'})
+    with pytest.raises(RuntimeError, match='CDP'):
+        browser._launch_options()
+
+
+def test_quiet_still_ignores_a_windows_chrome_exe_from_wsl():
+    browser = FlowBrowser.__new__(FlowBrowser)
+    browser.bcfg = {'quiet': True, 'mode': 'auto', 'executable': '/mnt/c/Chrome.exe'}
+    assert browser._launch_options() == [{'kind': 'bundled'}]
+
+
+def test_a_failed_debug_port_still_hides_the_window(tmp_path, monkeypatch, on_windows):
+    """Losing the reveal handle must never cost the user a hidden browser."""
+    browser = _browser(tmp_path, monkeypatch, {'quiet': True, 'mode': 'bundled'})
+    # After _browser, which stubs the port away: this launch really does get a debugging port.
+    monkeypatch.setattr(quiet, 'debug_port_args', lambda: (['--remote-debugging-port=1'], 1))
+    calls = []
+
+    class _RefusingPort:
+        def launch_persistent_context(self, profile, **kwargs):
+            calls.append(kwargs)
+            if '--remote-debugging-port=1' in kwargs['args']:
+                raise RuntimeError('port refused')
+            return _FakeContext()
+
+    browser._pw = type('PW', (), {'chromium': _RefusingPort()})()
+    browser._launch_persistent({'kind': 'bundled'})
+    assert len(calls) == 2
+    assert '--remote-debugging-port=1' in calls[0]['args']
+    assert not any('remote-debugging' in arg for arg in calls[1]['args'])
+    assert '--window-position=-32000,-32000' in calls[1]['args']   # still hidden
+    assert calls[1]['headless'] is False                          # still headed
+    assert browser.active_browser.endswith('[quiet-hidden-window-noport]')
+
+
+# --------------------------------------------------------------------------- #
+# Show browser moves the SAME window - it never restarts one
+# --------------------------------------------------------------------------- #
+class _FakeSession:
+    def __init__(self, log):
+        self.log = log
+
+    def send(self, method, params=None):
+        self.log.append((method, params))
+        if method == 'Target.getTargets':
+            return {'targetInfos': [{'type': 'page', 'targetId': 'T1'}, {'type': 'background_page'}]}
+        if method == 'Browser.getWindowForTarget':
+            return {'windowId': 7, 'bounds': {'windowState': 'normal'}}
+        return {}
+
+
+class _FakeBrowser:
+    def __init__(self, log):
+        self.log = log
+
+    def new_browser_cdp_session(self):
+        return _FakeSession(self.log)
+
+    def close(self):
+        self.log.append(('closed', None))
+
+
+def test_reveal_moves_the_running_window_on_screen(tmp_path, monkeypatch, on_windows):
+    monkeypatch.setattr(quiet, '_root', lambda: tmp_path)
+    (tmp_path / quiet.WINDOW_STATE_NAME).write_text(json.dumps({'port': 9333, 'hidden': True}))
+    log = []
+    import playwright.sync_api as sync_api
+
+    class _Chromium:
+        @staticmethod
+        def connect_over_cdp(url, **kwargs):
+            log.append(('connect', url))
+            return _FakeBrowser(log)
+
+    class _Pw:
+        chromium = _Chromium()
+
+    class _Manager:
+        def __enter__(self):
+            return _Pw()
+
+        def __exit__(self, *args):
+            return False
+
+    monkeypatch.setattr(sync_api, 'sync_playwright', lambda: _Manager())
+    assert quiet.reveal_window()['status'] == 'revealed'
+    bounds = [params for method, params in log if method == 'Browser.setWindowBounds']
+    assert bounds and bounds[-1]['windowId'] == 7
+    assert bounds[-1]['bounds']['left'] == 80 and bounds[-1]['bounds']['windowState'] == 'normal'
+    assert log[0][1] == 'http://127.0.0.1:9333'          # the same process, not a new browser
+    assert json.loads((tmp_path / quiet.WINDOW_STATE_NAME).read_text())['hidden'] is False
+    assert quiet.window_is_revealed() is True
+
+
+def test_hide_puts_the_same_window_back(tmp_path, monkeypatch, on_windows):
+    monkeypatch.setattr(quiet, '_root', lambda: tmp_path)
+    (tmp_path / quiet.WINDOW_STATE_NAME).write_text(json.dumps({'port': 9333, 'hidden': False}))
+    log = []
+    monkeypatch.setattr(quiet, '_set_window_bounds', lambda port, bounds: log.append(bounds) or True)
+    assert quiet.hide_browser()['status'] == 'hidden'
+    assert log[-1]['left'] == quiet.OFFSCREEN and log[-1]['top'] == quiet.OFFSCREEN
+    assert json.loads((tmp_path / quiet.WINDOW_STATE_NAME).read_text())['hidden'] is True
+    assert quiet.window_is_revealed() is False
+
+
+def test_reveal_without_a_running_window_says_so(tmp_path, monkeypatch, on_windows):
+    monkeypatch.setattr(quiet, '_root', lambda: tmp_path)
+    with pytest.raises(RuntimeError, match='No hidden browser window is recorded'):
+        quiet.reveal_window()
+
+
+def test_the_linux_viewer_path_is_unchanged(tmp_path, monkeypatch, on_linux_display):
+    monkeypatch.setattr(quiet, '_root', lambda: tmp_path)
+    monkeypatch.setattr(quiet, '_dependencies', lambda names: None)
+    monkeypatch.setattr(quiet, '_live', lambda pid, token: True)
+    (tmp_path / 'display.json').write_text(json.dumps({'pid': 41, 'display': ':81'}))
+    (tmp_path / 'viewer.json').write_text(json.dumps({'pid': 42, 'port': 5909}))
+    (tmp_path / 'vnc-password').write_bytes(b'private-password')
+    commands = []
+    monkeypatch.setattr(quiet.subprocess, 'Popen', lambda args, **kw: commands.append(args))
+    quiet.show_browser()
+    assert len(commands) == 1 and commands[0][0] == 'vncviewer'
+    assert commands[0][-1] == '127.0.0.1::5909'
+
+
+# --------------------------------------------------------------------------- #
+# A sign-in wall reveals itself, then hides again
+# --------------------------------------------------------------------------- #
+def _counting_clock(ticks):
+    values = iter(range(ticks + 1))
+    return staticmethod(lambda: next(values, ticks))
+
+
+def test_a_login_wall_reveals_the_hidden_window_and_hides_it_after(monkeypatch, on_windows):
+    moves = []
+    monkeypatch.setattr(quiet, 'reveal_window', lambda: moves.append('reveal') or {'status': 'revealed'})
+    monkeypatch.setattr(quiet, 'conceal_window', lambda: moves.append('conceal') or {'status': 'hidden'})
+    from engine.providers import flow_browser as fb
+    monkeypatch.setattr(fb, 'time', type('T', (), {'monotonic': _counting_clock(6)})())
+    browser = FlowBrowser.__new__(FlowBrowser)
+    browser.bcfg = {'quiet': True}
+    browser._set = lambda state: None
+    states = iter([False, False, True])
+    browser.is_logged_in = lambda: next(states, True)
+    browser._page = type('P', (), {'url': 'https://flow.google.com/', 'is_closed': lambda self: False,
+                                   'goto': lambda self, url, **kw: None,
+                                   'wait_for_timeout': lambda self, ms: None})()
+    assert browser._post_connect(5) is True
+    assert moves == ['reveal', 'conceal']
+
+
+def test_an_already_signed_in_quiet_session_is_never_revealed(monkeypatch, on_windows):
+    moves = []
+    monkeypatch.setattr(quiet, 'reveal_window', lambda: moves.append('reveal'))
+    monkeypatch.setattr(quiet, 'conceal_window', lambda: moves.append('conceal'))
+    browser = FlowBrowser.__new__(FlowBrowser)
+    browser.bcfg = {'quiet': True}
+    browser._set = lambda state: None
+    browser.is_logged_in = lambda: True
+    browser._page = type('P', (), {'url': 'https://flow.google.com/project/x', 'is_closed': lambda self: False,
+                                   'goto': lambda self, url, **kw: None,
+                                   'wait_for_timeout': lambda self, ms: None})()
+    assert browser._post_connect(5) is True
+    assert moves == []
+
+
+# --------------------------------------------------------------------------- #
+# Flow Music is quiet too, and does not steal the Flow window handle
+# --------------------------------------------------------------------------- #
+def test_flow_music_is_quiet_on_windows_without_touching_the_flow_handle(monkeypatch, on_windows):
+    from engine import flow_music
+    saved = []
+    monkeypatch.setattr(quiet, '_save_window_state', lambda state: saved.append(state))
+    options = flow_music.music_launch_options({'quiet': True}, login=False)
+    assert '--window-position=-32000,-32000' in options['args']
+    assert not any('ozone-platform' in arg for arg in options['args'])
+    assert saved == []                                  # the Flow reveal handle is not overwritten
+    assert '--window-position=-32000,-32000' not in flow_music.music_launch_options(
+        {'quiet': True}, login=True)['args']            # a music login stays visible
+
+
+# --------------------------------------------------------------------------- #
+# The UI no longer says "Linux/WSL only"
+# --------------------------------------------------------------------------- #
+def test_settings_no_longer_calls_quiet_mode_linux_only():
+    from pathlib import Path
+    app = (Path(__file__).resolve().parents[1] / 'app.py').read_text(encoding='utf-8')
+    assert 'Quiet browser · experimental (Linux/WSL)' not in app
+    assert 'Quiet browser · no visible window (all OS)' in app
+    assert 'Hide quiet browser · same session' in app
+    # The manual login button must stay visible even with Quiet browser on.
+    assert 'FlowBrowser(headless=False, quiet=False)' in app
