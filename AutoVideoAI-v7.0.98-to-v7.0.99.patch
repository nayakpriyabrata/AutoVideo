+#!/usr/bin/env python3
+"""Apply the v7.0.99 update to a v7.0.98 installation.
+
+A Flow *video* request is confirmed by a click, not by a wait. v7.0.98 named the right request but only
+offered download-only recovery, so a job whose card was never approved paused again and again ("0 fresh
+candidates, no verified match"). v7.0.99 makes the card visible and resolvable:
+
+- new ``engine/flow_pending_approval``: read-only evidence (submit ledger + journal reservations) that a
+  submitted video request was never approved, so a card is probably still waiting;
+- the Queue panel, the blocked-Resume message and ``tools/flow_resume_preflight.py`` say so, and offer the
+  approve command;
+- ``flow_browser.pending_approval_card()`` reads the newest card's cost without clicking;
+- ``cli.py v3 approve-request <job> --shot-id <shot> --confirm-credits N`` approves ONE card
+  (``Approve``, never ``Always approve``) after every guard has passed, then downloads it for free;
+  ``--inspect`` is read-only.
+
+Nothing is generated, rendered or charged by this update itself.
+
+Usage (run from the existing installation folder, after extracting the 7.0.99 zip beside it):
+
+    python3 ../AutoVideoAI-v7.0.99/tools/update_v798_to_v799.py .            # dry run: shows the plan
+    python3 ../AutoVideoAI-v7.0.99/tools/update_v798_to_v799.py . --apply    # installs the code
+
+Only code and documentation are replaced. Outputs, saved jobs, Flow journals, browser profiles and
+Clip Studio folders are never copied, moved or deleted. Stop the dashboard before --apply.
+"""
+
+
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+CHANGES = ['VIDEO_APPROVAL_PENDING_V7_0_99.md', 'VERSION', 'app.py', 'cli.py',
+           'engine/factory.py', 'engine/flow_pending_approval.py', 'engine/flow_resume_safety.py',
+           'engine/providers/flow_browser.py', 'tests/test_v799_approval_pending.py',
+           'tools/flow_resume_preflight.py', 'tools/update_v798_to_v799.py']
+# Files as they exist in 7.0.98: the only hashes this updater will replace.
+# A hash outside this list means local edits; the file is preserved and nothing is applied.
+ALLOWED = {
+    'VERSION': ['32b1d7eec2cf5ccb1d26e5ecffbdf1f6ccc8412cad8d8631e1ae1d064bd32bec'],
+    'app.py': ['e3b89efcfed9e85bad707dfcb75b57211861f86e9a37823489ad44f5f2c17171'],
+    'cli.py': ['ea0f73b25a2d6e9c438a9c6c40872ef04464ffbd550474b75c46656717a9c85f'],
+    'engine/factory.py': ['6a0f1e1c4638e1857c792a966478f7c6c04a6dc9f4e09bcc37ba0933b2471ddc'],
+    'engine/flow_resume_safety.py': ['6848a974a84cb46fd470d2fefff283bedcb4894923ced6b457e722efe3f0320f'],
+    'engine/providers/flow_browser.py': ['66edec36373e60477eaccb162aa3e5e2a6961b48027e3913d122f09ab9350e8d'],
+    'tools/flow_resume_preflight.py': ['b03b2f1e25bfb8599cf3fe791d7a3b8b65c04eb43f76e73e6652317b35a72769'],
+}
+
+ACCEPTED_INSTALLS = ('7.0.98', '7.0.99')  # 7.0.99 allows a safe re-run after success
+
+# The 7.0.98 zip carries the 7.0.97 to 7.0.98 update; apply that first on an older installation.
+EARLIER_STEPS = [
+    ('7.0.97', '7.0.98', 'tools/update_v797_to_v798.py'),
+]
+
+
+def chain_message(current):
+    steps = [step for step in EARLIER_STEPS if step[0] == current]
+    if not steps:
+        return ('This update requires an installed 7.0.98 (found ' + current + '). '
+                'Earlier releases must be updated first, one zip at a time.')
+    start, end, path = steps[0]
+    return ('This update requires an installed 7.0.98 (found ' + current + '). Apply the earlier update first, '
+            'from the 7.0.98 zip folder extracted beside this installation:\n'
+            '    python3 ../AutoVideoAI-v' + end + '/' + path + ' . --apply\n'
+            'Then run this 7.0.99 update.')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('target')
+    parser.add_argument('--apply', action='store_true')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1]
+    target = Path(args.target).resolve()
+    if source == target:
+        raise ValueError('Extract the update beside the existing installation, then run it from that installation folder')
+    version_file = target / 'VERSION'
+    if not version_file.is_file():
+        raise ValueError('Target is not an AutoVideoAI installation: VERSION not found')
+    current = version_file.read_text(encoding='utf-8').strip()
+    if current not in ACCEPTED_INSTALLS:
+        raise ValueError(chain_message(current))
+    manifest_path = source / 'RELEASE_MANIFEST.json'
+    if not manifest_path.is_file():
+        raise ValueError('RELEASE_MANIFEST.json is missing from the 7.0.99 folder; extract the complete zip')
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    expected = {row['path']: row['sha256'] for row in manifest['files']}
+    for name in CHANGES:
+        if name not in expected or sha(source / name) != expected[name]:
+            raise ValueError('Update source checksum failed: ' + name)
+        destination = target / name
+        if destination.is_symlink():
