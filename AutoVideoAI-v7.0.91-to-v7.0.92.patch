+    assert bridge.wait_calls == 1                                  # no second six-minute wait, no retries
+    message = str(info.value)
+    assert 'No generated image is in the saved Flow project' in message
+    assert 'archive-request 20261022-143856-7-small-daily-habits-tha-9729 storyboard/shot_020_open.jpg' in message
+    assert '--confirm-new-credit-spend' in message
+    assert request['recovery_state'] == 'no_generated_output_in_project'
+    assert json.loads(tx.journal_path(output).read_text())['recovery_state'] == 'no_generated_output_in_project'
