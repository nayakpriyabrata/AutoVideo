+"""v7.0.116: two cards on screen at the same time.
+
+Field report, Odia edition, with a screenshot: one frame showed **two** pop-up cards overlapping - the bold KEY POINT
+panel with its Odia text, and behind it, a fraction of a second out of step, a second panel of the same shape carrying
+the rest of the sentence.
+
+Both were real, and both came from the same render writing to the same frame from two different lists:
+
+* ``bundle['cards']`` - the job's copied cards, drafted from the original English card pass and stored on the
+  language's narration. ``render()`` draws each one as a full-frame image in its own loop;
+* ``production/speech_cards.json`` - the edition's own cards, drafted for this language from its own reviewed
+  narration, drawn by ``speech_cards.render()``.
+
+They are anchored to the same spoken sentence, so when their windows differ by even a few tenths of a second they
+overlap - two panels, one behind the other. Nothing compared the two lists; only hooks were ever checked against
+cards. Reproduced on the 7.0.115 tree with a 20 s Odia narration: the same two panels at 1.2 s.
+
+v7.0.116 draws **one card at a time**, from either source, and records which one gave way. These tests hold it:
+
+* the rule itself (overlap, gap, priority, duplicates) without any video;
+* a real edition render draws a single card and says so in ``graphics-<lang>.json`` and its provenance;
+* the picture is *identical* to the same edition rendered without the copied job cards - the extra panel is gone;
+* hooks are never dropped by the rule - they are pills in their own band;
+* an educational points series and a single card cannot be on screen together either;
+* the job record and the listing carry the note, so nothing changes silently.
+"""
+import json
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+needs_ffmpeg = pytest.mark.skipif(not (shutil.which('ffmpeg') and shutil.which('ffprobe')),
+                                  reason='FFmpeg required')
+os.environ.setdefault('HOME', '/tmp')
+
+SCRIPT = ('ଅଭ୍ୟାସ ଏକ କହିବା ପର୍ବରୁ ସାମାନ୍ୟ ଆଟକନ୍ତୁ ଏବଂ ଧୀରେ ଚାଲନ୍ତୁ ତାପରେ ଅଭ୍ୟାସ ଦୁଇ ଭଲ ଘୁମନ୍ତୁ')
+
+
+def _words():
+    parts = SCRIPT.split()
+    return [{'word': word, 'start': round(0.4 + i * 0.55, 3), 'end': round(0.4 + i * 0.55 + 0.5, 3)}
+            for i, word in enumerate(parts)]
+
+
+# --------------------------------------------------------------------------- the rule, without a video
+
+
+def test_a_second_card_is_dropped_while_the_first_is_still_showing():
+    from engine.render.card_slots import max_at_once, resolve
+    report = {}
+    cards = [{'kind': 'keypoint', 'start': 0.4, 'end': 2.6, 'title': 'first'},
