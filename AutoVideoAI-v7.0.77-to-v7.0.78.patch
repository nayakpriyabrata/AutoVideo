+def test_indic_font_glyphs_sit_inside_the_ascender_line(font_file, sample):
+    """7.0.77 drew Indic glyphs one ascender too high and gave Pillow no metrics,
+    so Odia/Hindi titles overlapped the lines beneath them."""
+    from PIL import Image, ImageDraw
+    from engine.render.indic_font import IndicFont
+    path = Path(__file__).resolve().parents[1] / 'assets' / 'fonts' / font_file
+    face = IndicFont(path, 66, bold=True)
+    ascent, descent = face.getmetrics()
+    assert ascent > 0 and descent > 0
+    img = Image.new('L', (900, 200), 0)
+    ImageDraw.Draw(img).text((10, 40), sample, font=face, fill=255)
+    rows = [y for y in range(img.height) if img.crop((0, y, img.width, y + 1)).getbbox()]
+    assert rows, 'no ink drawn'
+    top, bottom = rows[0] - 40, rows[-1] - 40
+    assert top >= 0, f'glyph ink rises {-top}px above the ascender line'
+    assert bottom <= ascent + descent, 'glyph ink falls below the font box'
