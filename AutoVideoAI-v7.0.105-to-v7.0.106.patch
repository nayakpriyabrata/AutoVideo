+def _video(path, payload=b'\x00' * 2048):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(payload)
+    return path
+
+
+def test_the_default_backup_folder_is_inside_outputs(tmp_path):
